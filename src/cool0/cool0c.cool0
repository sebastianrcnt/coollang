// ===========================================================================
// cool0c -- the cool0 compiler, written in cool0
//
// It implements spec/ and must emit byte-identical output to cool0.py
// (implementation.md S8).
//
// This file uses cool0 the way cool0 is meant to be used. That is the point of
// it existing at all -- a compiler is the program cool0 was designed for, so
// the compiler is the proof:
//
//     struct        records with named fields, not u32 arrays and offsets
//     enum + match  every sum type is a real sum type, dispatched by match
//     []T / []mut T arenas are slices, so every index is bounds-checked
//     &T / &mut T   the compiler context is borrowed, not global
//     slice_mut     the one place raw memory becomes a checked arena
//
// `unsafe` appears in exactly two kinds of place: the raw byte accessors used
// to write the output buffer, and the arena constructors in `compile`. Nothing
// in the lexer, parser, checker, or emitter dereferences a raw pointer.
//
// cool0 has no mutable globals, so state lives in one `Ctx` that is threaded
// through as `&mut Ctx`. That is not a workaround -- it is what makes the data
// flow visible.
// ===========================================================================

// --- memory map (implementation.md S7) -------------------------------------

const OUT_PTR_ADDR: u32 = 0x0000;
const OUT_LEN_ADDR: u32 = 0x0004;
const SRC: u32 = 0x1000;

// gh #5 B. `compile_n(nsrc)` reads `nsrc` (ptr, len) pairs from here. The
// one-buffer entry point `compile(len)` writes a single pair and calls it, so
// there is one code path, not two.
const SRCTAB: u32 = 0x0080;

// Debug window. The workbench (tests/test_cool0c.py) reads these to compare
// stages against the oracle. They are written once per stage and never read
// by the compiler itself.
const G_ERR: u32 = 0x0014;
const G_NTOK: u32 = 0x002C;
const G_TOKS: u32 = 0x0030;
const G_DECLS: u32 = 0x0040;
const G_NODES: u32 = 0x0044;
const G_NMEM: u32 = 0x0048;   // interned name bytes (gh #5 A)
const G_NTAB: u32 = 0x004C;   // interned name table

// regions
const S1: u32 = 0x0E00_0000;   // scratch for one function body
const S2: u32 = 0x0F00_0000;   // scratch for one section payload
const OUT: u32 = 0x0101_0000;  // final output; 0x0100_0000 is this module's rodata

const NONE: u32 = 0xFFFF_FFFF;

// sizes of the two arenas that are laid out by hand (implementation.md S2)
const SIZEOF_TOKEN: u32 = 36;
const SIZEOF_NODE: u32 = 56;

// --- raw memory ------------------------------------------------------------
//
// The only raw pointers in the compiler. Everything above this line is a
// slice, and every slice index is checked.

fn ldb(a: u32) -> u32 { unsafe { let p: *u8 = a as *u8; return p.^; } }

fn stb(a: u32, v: u32) { unsafe { let p: *u8 = a as *u8; p.^ = v; } }

fn ldw(a: u32) -> u32 { unsafe { let p: *u32 = a as *u32; return p.^; } }

fn align4(v: u32) -> u32 { return (v + 3) / 4 * 4; }

// ===========================================================================
// The compiler context
// ===========================================================================

struct Ctx {
    // The source buffer being lexed right now, and the cursor into it. After
    // lexing and interning, nothing reads either one again (gh #5 B).
    src: []u8,
    pos: u32,
    line: u32,
    col: u32,

    // Node counts, accumulated as bodies are parsed and dropped (gh #5 C).
    // The checker tables are sized from these, so they have to survive the
    // body whose nodes they counted.
    ck_tys: u32,
    ck_fields: u32,
    ck_structs: u32,
    ck_variants: u32,
    ck_enums: u32,
    ck_consts: u32,
    ck_params: u32,
    ck_fns: u32,
    ck_lets: u32,
    ck_binds: u32,
    ck_strs: u32,

    // all of the buffers (gh #5 B)
    nsrc: u32,
    srctok: []mut u32,   // token index where each buffer's tokens start

    // tokens
    toks: []mut Token,
    ntok: u32,

    // interned names (gh #5 A). A name is an index into `ntab`; index 0 means
    // "none". The bytes live in `nmem`, copied out of the source, so a name
    // outlives the buffer it was written in.
    nmem: []mut u8,
    nmem_n: u32,
    ntab: []mut NameEnt,
    ntab_n: u32,
    nhash: []mut u32,   // open addressing, power-of-two size, 0 = empty

    // names the compiler itself has to recognise. Interned up front so
    // they exist whether or not the source happens to mention them.
    id_i32: u32,
    id_u32: u32,
    id_bool: u32,
    id_u8: u32,
    id_under: u32,
    id_len: u32,
    id_ptr: u32,

    // AST arena and parser cursor. Node index 0 means "none".
    nodes: []mut Node,
    nnode: u32,
    ti: u32,
    edepth: u32,
    bdepth: u32,
    decls: u32,

    // checker tables. Each is an arena whose index 0 means "none".
    types: []mut Ty,
    nty: u32,
    fields: []mut FieldI,
    nfield: u32,
    structs: []mut StructI,
    nstruct: u32,
    variants: []mut VariantI,
    nvariant: u32,
    enums: []mut EnumI,
    nenum: u32,
    consts: []mut ConstI,
    nconst: u32,
    params: []mut ParamI,
    nparam: u32,
    fns: []mut FnI,
    nfn: u32,
    locals: []mut LocalI,
    nlocal: u32,
    strs: []mut StrI,
    nstr: u32,
    taken: []mut NameI,
    ntaken: u32,
    tynames: []mut NameI,
    ntyname: u32,
    scalars: []mut NameI,   // names of the scalar enums, filled before layout
    nscalar: u32,
    rodata: u32,
    cety: u32,      // const_expr's second result

    // lexical scope: a stack of local ids, and a stack of marks into it
    scope: []mut u32,
    scope_n: u32,
    marks: []mut u32,
    marks_n: u32,
    curfn: u32,
    loopd: u32,
    unsafed: u32,
    place_mut: u32,   // check_place's second result
    place_root: u32,  // ... and its third
    nfns: u32,        // how many functions the module has

    // emitter
    wb: u32,          // cursor into S1, one function body
    ws: u32,          // cursor into S2, one section payload
    sigs: []mut u32,  // interned signatures, three words each
    nsigs: u32,
    ntemp: u32,
    free: []mut u32,
    free_n: u32,
    ctrl: []mut u32,
    ctrl_n: u32,
    efn: u32,

    // bump heap for string literal bodies. Nothing is ever freed -- the
    // compiler runs once and the host reclaims the memory.
    heap: u32,

    // diagnostics. Only the first error writes; the rest are dropped.
    err: u32,
    out: u32,
}

// --- output buffer ---------------------------------------------------------

fn out_reset(c: &mut Ctx) { c.^.out = OUT; }

fn put_ch(c: &mut Ctx, ch: u32) {
    stb(c.^.out, ch);
    c.^.out = c.^.out + 1;
}

fn put_str(c: &mut Ctx, s: []u8) {
    for let mut i: u32 = 0; i < s.len; i += 1 { put_ch(c, s[i]); }
}

fn put_num(c: &mut Ctx, v: u32) {
    if v >= 10 { put_num(c, v / 10); }
    put_ch(c, '0' + v % 10);
}

// --- diagnostics (implementation.md S9) ------------------------------------

fn failed(c: &Ctx) -> bool { return c.^.err != 0; }

// Stop at the first error. Only the winner writes its message.
fn err_open(c: &mut Ctx, line: u32, col: u32) -> bool {
    if failed(c) { return false; }
    c.^.err = 1;
    out_reset(c);
    put_num(c, line);
    put_ch(c, ':');
    put_num(c, col);
    put_ch(c, ':');
    put_ch(c, ' ');
    return true;
}

fn err_end(c: &mut Ctx) { put_ch(c, '\n'); }

// A diagnostic that is just one fixed phrase
fn err_msg(c: &mut Ctx, line: u32, col: u32, s: []u8) {
    if err_open(c, line, col) {
        put_str(c, s);
        err_end(c);
    }
}

// ===========================================================================
// Tokens (language.md S2)
// ===========================================================================

enum TokKind {
    // What a token is. TK_EOF is tag 0 on purpose: reading past the
    // end of the array yields zeroed memory, which reads as end of file.
    TK_EOF,
    TK_IDENT,
    TK_INT,
    TK_CHAR,
    TK_STR,
    TK_KW,
    TK_PUNCT,
}

struct Token {
    kind: TokKind,
    start: u32,
    len: u32,
    value: u32,   // int/char value, keyword id, or string body address
    line: u32,
    col: u32,
    aux: u32,     // decoded length of a string literal
    punct: Punct, // TK_PUNCT only. Its own field: an enum cannot live in a u32
    kw: Kw,       // TK_KW only. Same reason -- and it cannot share with punct
}

// keyword ids -- the order language.md S2 lists them in
enum Kw {
    // The keywords (language.md S2). NoKw is last so the keyword tags
    // keep the order they are declared in.
    K_FN,
    K_STRUCT,
    K_ENUM,
    K_CONST,
    K_LET,
    K_MUT,
    K_IF,
    K_ELSE,
    K_FOR,
    K_BREAK,
    K_CONTINUE,
    K_RETURN,
    K_MATCH,
    K_UNSAFE,
    K_AS,
    K_TRUE,
    K_FALSE,
    K_SLICE,
    K_SLICE_MUT,
    K_OFFSET,
    NoKw,
}

// punctuation, in longest-match order (language.md S2). `NoPunct` goes last
// so every real one keeps the tag it had.
enum Punct {
    ShlEq,
    ShrEq,
    Arrow,
    FatArrow,
    EqEq,
    Ne,
    Le,
    Ge,
    AndAnd,
    OrOr,
    Shl,
    Shr,
    AddEq,
    SubEq,
    MulEq,
    DivEq,
    ModEq,
    AndEq,
    OrEq,
    XorEq,
    LParen,
    RParen,
    LBrace,
    RBrace,
    LBrack,
    RBrack,
    Comma,
    Semi,
    Colon,
    Dot,
    Eq,
    Lt,
    Gt,
    Add,
    Sub,
    Mul,
    Div,
    Mod,
    And,
    Or,
    Xor,
    Not,
    NoPunct,
}

// ===========================================================================
// Lexer (language.md S2)
// ===========================================================================

// Byte predicates. Source is ASCII only.
fn is_alpha(b: u32) -> bool {
    return b >= 'A' && b <= 'Z' || b >= 'a' && b <= 'z';
}

fn is_digit(b: u32) -> bool { return b >= '0' && b <= '9'; }

fn is_ident_start(b: u32) -> bool { return is_alpha(b) || b == '_'; }

fn is_ident_cont(b: u32) -> bool { return is_alpha(b) || is_digit(b) || b == '_'; }

fn at(c: &Ctx, i: u32) -> u32 { return c.^.src[i]; }

fn adv(c: &mut Ctx, k: u32) {
    for let mut t: u32 = 0; t < k; t += 1 {
        let p: u32 = c.^.pos;
        if c.^.src[p] == '\n' {
            c.^.line = c.^.line + 1;
            c.^.col = 1;
        } else {
            c.^.col = c.^.col + 1;
        }
        c.^.pos = p + 1;
    }
}

// does source [start, start+len) equal s
fn src_eq(c: &Ctx, start: u32, len: u32, s: []u8) -> bool {
    if len != s.len { return false; }
    for let mut i: u32 = 0; i < len; i += 1 {
        if c.^.src[start + i] != s[i] { return false; }
    }
    return true;
}

// does source at i start with s
fn src_has(c: &Ctx, i: u32, s: []u8) -> bool {
    if i + s.len > c.^.src.len { return false; }
    for let mut k: u32 = 0; k < s.len; k += 1 {
        if c.^.src[i + k] != s[k] { return false; }
    }
    return true;
}

fn kw_id(c: &Ctx, start: u32, len: u32) -> Kw {
    if src_eq(c, start, len, "fn") { return Kw.K_FN; }
    if src_eq(c, start, len, "struct") { return Kw.K_STRUCT; }
    if src_eq(c, start, len, "enum") { return Kw.K_ENUM; }
    if src_eq(c, start, len, "const") { return Kw.K_CONST; }
    if src_eq(c, start, len, "let") { return Kw.K_LET; }
    if src_eq(c, start, len, "mut") { return Kw.K_MUT; }
    if src_eq(c, start, len, "if") { return Kw.K_IF; }
    if src_eq(c, start, len, "else") { return Kw.K_ELSE; }
    if src_eq(c, start, len, "for") { return Kw.K_FOR; }
    if src_eq(c, start, len, "break") { return Kw.K_BREAK; }
    if src_eq(c, start, len, "continue") { return Kw.K_CONTINUE; }
    if src_eq(c, start, len, "return") { return Kw.K_RETURN; }
    if src_eq(c, start, len, "match") { return Kw.K_MATCH; }
    if src_eq(c, start, len, "unsafe") { return Kw.K_UNSAFE; }
    if src_eq(c, start, len, "as") { return Kw.K_AS; }
    if src_eq(c, start, len, "true") { return Kw.K_TRUE; }
    if src_eq(c, start, len, "false") { return Kw.K_FALSE; }
    if src_eq(c, start, len, "slice") { return Kw.K_SLICE; }
    if src_eq(c, start, len, "slice_mut") { return Kw.K_SLICE_MUT; }
    if src_eq(c, start, len, "offset") { return Kw.K_OFFSET; }
    return Kw.NoKw;
}

// longest match (language.md S2)
fn punct_id(c: &Ctx, i: u32) -> Punct {
    if src_has(c, i, "<<=") { return Punct.ShlEq; }
    if src_has(c, i, ">>=") { return Punct.ShrEq; }
    if src_has(c, i, "->") { return Punct.Arrow; }
    if src_has(c, i, "=>") { return Punct.FatArrow; }
    if src_has(c, i, "==") { return Punct.EqEq; }
    if src_has(c, i, "!=") { return Punct.Ne; }
    if src_has(c, i, "<=") { return Punct.Le; }
    if src_has(c, i, ">=") { return Punct.Ge; }
    if src_has(c, i, "&&") { return Punct.AndAnd; }
    if src_has(c, i, "||") { return Punct.OrOr; }
    if src_has(c, i, "<<") { return Punct.Shl; }
    if src_has(c, i, ">>") { return Punct.Shr; }
    if src_has(c, i, "+=") { return Punct.AddEq; }
    if src_has(c, i, "-=") { return Punct.SubEq; }
    if src_has(c, i, "*=") { return Punct.MulEq; }
    if src_has(c, i, "/=") { return Punct.DivEq; }
    if src_has(c, i, "%=") { return Punct.ModEq; }
    if src_has(c, i, "&=") { return Punct.AndEq; }
    if src_has(c, i, "|=") { return Punct.OrEq; }
    if src_has(c, i, "^=") { return Punct.XorEq; }
    if src_has(c, i, "(") { return Punct.LParen; }
    if src_has(c, i, ")") { return Punct.RParen; }
    if src_has(c, i, "{") { return Punct.LBrace; }
    if src_has(c, i, "}") { return Punct.RBrace; }
    if src_has(c, i, "[") { return Punct.LBrack; }
    if src_has(c, i, "]") { return Punct.RBrack; }
    if src_has(c, i, ",") { return Punct.Comma; }
    if src_has(c, i, ";") { return Punct.Semi; }
    if src_has(c, i, ":") { return Punct.Colon; }
    if src_has(c, i, ".") { return Punct.Dot; }
    if src_has(c, i, "=") { return Punct.Eq; }
    if src_has(c, i, "<") { return Punct.Lt; }
    if src_has(c, i, ">") { return Punct.Gt; }
    if src_has(c, i, "+") { return Punct.Add; }
    if src_has(c, i, "-") { return Punct.Sub; }
    if src_has(c, i, "*") { return Punct.Mul; }
    if src_has(c, i, "/") { return Punct.Div; }
    if src_has(c, i, "%") { return Punct.Mod; }
    if src_has(c, i, "&") { return Punct.And; }
    if src_has(c, i, "|") { return Punct.Or; }
    if src_has(c, i, "^") { return Punct.Xor; }
    if src_has(c, i, "!") { return Punct.Not; }
    return Punct.NoPunct;
}

fn punct_len(id: Punct) -> u32 {
    return match id {
        ShlEq | ShrEq => 3,
        Arrow | FatArrow | EqEq | Ne | Le | Ge | AndAnd | OrOr | Shl | Shr
        | AddEq | SubEq | MulEq | DivEq | ModEq | AndEq | OrEq | XorEq => 2,
        _ => 1,
    };
}

fn push_tok(c: &mut Ctx, kind: TokKind, start: u32, len: u32, value: u32,
            line: u32, col: u32, aux: u32) {
    let n: u32 = c.^.ntok;
    c.^.toks[n] = Token{
        kind: kind, start: start, len: len, value: value,
        line: line, col: col, aux: aux, punct: Punct.NoPunct, kw: Kw.NoKw,
    };
    c.^.ntok = n + 1;
}

fn push_punct(c: &mut Ctx, start: u32, len: u32, p: Punct, line: u32, col: u32) {
    let n: u32 = c.^.ntok;
    c.^.toks[n] = Token{
        kind: TokKind.TK_PUNCT, start: start, len: len, value: 0,
        line: line, col: col, aux: 0, punct: p, kw: Kw.NoKw,
    };
    c.^.ntok = n + 1;
}

fn push_kw(c: &mut Ctx, start: u32, len: u32, k: Kw, line: u32, col: u32) {
    let n: u32 = c.^.ntok;
    c.^.toks[n] = Token{
        kind: TokKind.TK_KW, start: start, len: len, value: 0,
        line: line, col: col, aux: 0, punct: Punct.NoPunct, kw: k,
    };
    c.^.ntok = n + 1;
}

// One escape. Strings allow one more than chars do (language.md S2).
fn escape_of(e: u32, in_string: bool) -> u32 {
    if e == 'n' { return 10; }
    if e == 't' { return 9; }
    if e == 'r' { return 13; }
    if e == '0' { return 0; }
    if e == '\\' { return 92; }
    if e == '\'' { return 39; }
    if in_string && e == '"' { return 34; }
    return NONE;
}

fn lex_ident(c: &mut Ctx) {
    let sl: u32 = c.^.line;
    let sc: u32 = c.^.col;
    let i: u32 = c.^.pos;
    let n: u32 = c.^.src.len;
    let mut j: u32 = i;
    for j < n && is_ident_cont(c.^.src[j]) { j += 1; }
    let id: Kw = kw_id(c, i, j - i);
    adv(c, j - i);
    if id == Kw.NoKw {
        push_tok(c, TokKind.TK_IDENT, i, j - i, 0, sl, sc, 0);
    } else {
        push_kw(c, i, j - i, id, sl, sc);
    }
}

fn digit_val(ch: u32, base: u32) -> u32 {
    if is_digit(ch) {
        if ch - '0' < base { return ch - '0'; }
        return NONE;
    }
    if base == 16 {
        if ch >= 'a' && ch <= 'f' { return ch - 'a' + 10; }
        if ch >= 'A' && ch <= 'F' { return ch - 'A' + 10; }
    }
    return NONE;
}

fn lex_number(c: &mut Ctx) {
    let sl: u32 = c.^.line;
    let sc: u32 = c.^.col;
    let i: u32 = c.^.pos;
    let n: u32 = c.^.src.len;
    let mut base: u32 = 10;
    let mut j: u32 = i;
    if c.^.src[i] == '0' && i + 1 < n {
        let b: u32 = c.^.src[i + 1];
        if b == 'x' || b == 'X' { base = 16; j = i + 2; }
        if b == 'b' || b == 'B' { base = 2; j = i + 2; }
    }
    let mut ndigits: u32 = 0;
    let mut value: u32 = 0;
    let mut over: bool = false;
    // `_` separates digits, so it cannot come first -- grammar.ebnf spells the
    // prefix forms as `"0x", hex_digit, { hex_digit | "_" }`
    for j < n {
        let b: u32 = c.^.src[j];
        if b == '_' && ndigits != 0 {
            j += 1;
        } else {
            let d: u32 = digit_val(b, base);
            if d == NONE { break; }
            // detect overflow past 32 bits; the value itself is then meaningless
            if value > (0xFFFF_FFFF - d) / base { over = true; }
            value = value * base + d;
            ndigits += 1;
            j += 1;
        }
    }
    if j < n && is_ident_cont(c.^.src[j]) {
        err_msg(c, sl, sc, "invalid digit in integer literal");
        return;
    }
    if ndigits == 0 {
        err_msg(c, sl, sc, "integer literal has no digits");
        return;
    }
    if over {
        err_msg(c, sl, sc, "integer literal out of range");
        return;
    }
    adv(c, j - i);
    push_tok(c, TokKind.TK_INT, i, j - i, value, sl, sc, 0);
}

fn lex_char(c: &mut Ctx) {
    let sl: u32 = c.^.line;
    let sc: u32 = c.^.col;
    let start: u32 = c.^.pos;
    let n: u32 = c.^.src.len;
    adv(c, 1);
    if c.^.pos >= n {
        err_msg(c, sl, sc, "unterminated character literal");
        return;
    }
    if c.^.src[c.^.pos] == '\'' {
        err_msg(c, sl, sc, "empty character literal");
        return;
    }
    let mut value: u32 = 0;
    if c.^.src[c.^.pos] == '\\' {
        adv(c, 1);
        if c.^.pos >= n {
            err_msg(c, sl, sc, "unterminated character literal");
            return;
        }
        let e: u32 = escape_of(c.^.src[c.^.pos], false);
        if e == NONE {
            let el: u32 = c.^.line;
            let ec: u32 = c.^.col;
            err_msg(c, el, ec, "unknown escape sequence");
            return;
        }
        value = e;
        adv(c, 1);
    } else {
        value = c.^.src[c.^.pos];
        if value < 0x20 || value > 0x7E {
            let el: u32 = c.^.line;
            let ec: u32 = c.^.col;
            err_msg(c, el, ec, "invalid character in character literal");
            return;
        }
        adv(c, 1);
    }
    if c.^.pos >= n {
        err_msg(c, sl, sc, "unterminated character literal");
        return;
    }
    if c.^.src[c.^.pos] != '\'' {
        err_msg(c, sl, sc, "unterminated character literal");
        return;
    }
    adv(c, 1);
    let end: u32 = c.^.pos;
    push_tok(c, TokKind.TK_CHAR, start, end - start, value, sl, sc, 0);
}

fn lex_string(c: &mut Ctx) {
    let sl: u32 = c.^.line;
    let sc: u32 = c.^.col;
    let start: u32 = c.^.pos;
    let n: u32 = c.^.src.len;
    adv(c, 1);
    let buf: u32 = c.^.heap;
    let mut k: u32 = 0;
    for {
        if c.^.pos >= n {
            err_msg(c, sl, sc, "unterminated string literal");
            return;
        }
        let b: u32 = c.^.src[c.^.pos];
        if b == '\n' {
            err_msg(c, sl, sc, "unterminated string literal");
            return;
        }
        if b == '"' {
            adv(c, 1);
            break;
        }
        if b == '\\' {
            adv(c, 1);
            if c.^.pos >= n {
                err_msg(c, sl, sc, "unterminated string literal");
                return;
            }
            let e: u32 = escape_of(c.^.src[c.^.pos], true);
            if e == NONE {
                let el: u32 = c.^.line;
                let ec: u32 = c.^.col;
                err_msg(c, el, ec, "unknown escape sequence");
                return;
            }
            stb(buf + k, e);
            k += 1;
            adv(c, 1);
        } else {
            if b < 0x20 || b > 0x7E {
                let el: u32 = c.^.line;
                let ec: u32 = c.^.col;
                err_msg(c, el, ec, "invalid character in string literal");
                return;
            }
            stb(buf + k, b);
            k += 1;
            adv(c, 1);
        }
    }
    c.^.heap = align4(buf + k);
    let end: u32 = c.^.pos;
    push_tok(c, TokKind.TK_STR, start, end - start, buf, sl, sc, k);
}

fn lex_comment(c: &mut Ctx) {
    let n: u32 = c.^.src.len;
    for c.^.pos < n && c.^.src[c.^.pos] != '\n' {
        let b: u32 = c.^.src[c.^.pos];
        if b != 9 && b != 13 && (b < 0x20 || b > 0x7E) {
            let el: u32 = c.^.line;
            let ec: u32 = c.^.col;
            err_msg(c, el, ec, "non-ascii byte in source");
            return;
        }
        adv(c, 1);
    }
}

// One buffer. The caller has already pointed `c.src` at it and set the line
// number this buffer starts on.
fn lex_one(c: &mut Ctx) {
    let n: u32 = c.^.src.len;
    c.^.pos = 0;
    c.^.col = 1;

    for c.^.pos < n && !failed(c) {
        let i: u32 = c.^.pos;
        let b: u32 = c.^.src[i];

        if b != 9 && b != 10 && b != 13 && (b < 0x20 || b > 0x7E) {
            let el: u32 = c.^.line;
            let ec: u32 = c.^.col;
            err_msg(c, el, ec, "non-ascii byte in source");
            return;
        }
        if b == 9 || b == 10 || b == 13 || b == 32 {
            adv(c, 1);
            continue;
        }
        if b == '/' && i + 1 < n && c.^.src[i + 1] == '/' {
            lex_comment(c);
            continue;
        }
        if is_ident_start(b) { lex_ident(c); continue; }
        if is_digit(b) { lex_number(c); continue; }
        if b == '\'' { lex_char(c); continue; }
        if b == '"' { lex_string(c); continue; }

        let p: Punct = punct_id(c, i);
        if p == Punct.NoPunct {
            let el: u32 = c.^.line;
            let ec: u32 = c.^.col;
            err_msg(c, el, ec, "unexpected character");
            return;
        }
        let sl: u32 = c.^.line;
        let sc: u32 = c.^.col;
        adv(c, punct_len(p));
        push_punct(c, i, punct_len(p), p, sl, sc);
    }
}

// Every buffer, in order. Line numbers continue from one to the next, as if the
// buffers had been concatenated with a newline between them -- so a diagnostic
// still reads `L:C: message` and the host, which knows how long each buffer is,
// can map the line back to a file. cool0 has no file names to print.
fn lex_all(c: &mut Ctx) {
    c.^.ntok = 0;
    c.^.line = 1;
    for let mut i: u32 = 0; i < c.^.nsrc && !failed(c); i += 1 {
        c.^.srctok[i] = c.^.ntok;
        let p: u32 = ldw(SRCTAB + i * 8);
        let n: u32 = ldw(SRCTAB + i * 8 + 4);
        unsafe { c.^.src = slice(p as *u8, n); }
        lex_one(c);
        // a newline *between* buffers, not after the last one -- the eof
        // token below has to land on the line the source really ended on
        if i + 1 < c.^.nsrc { c.^.line = c.^.line + 1; }
    }
    c.^.srctok[c.^.nsrc] = c.^.ntok;
    if failed(c) { return; }
    let ep: u32 = c.^.pos;
    let el: u32 = c.^.line;
    let ec: u32 = c.^.col;
    push_tok(c, TokKind.TK_EOF, ep, 0, 0, el, ec, 0);
}

// ===========================================================================
// AST (language.md S4, S5, S6)
// ===========================================================================
//
// One arena of one record shape, indexed by u32. Index 0 means "none" -- the
// arena starts filling at 1 so a real node can never be 0.
//
// This is a struct and not an enum, and the reason is worth writing down: the
// checker annotates nodes in place (ty, aux, aux2) and language.md S4 forbids
// a struct field from holding an aggregate, so an enum's payload cannot carry
// mutable annotations. The sum type that *is* an enum here is Ty -- see below.

struct Node {
    kind: NodeKind,
    line: u32,
    col: u32,
    a: u32,
    b: u32,
    c: u32,
    d: u32,
    e: u32,
    next: u32,   // sibling in a list
    ty: u32,     // checker: type id
    aux: u32,    // checker: local, field, fn, ...
    aux2: u32,
    depth: u32,  // expression tree depth (language.md S9)
    op: Punct,   // NodeKind.E_BINARY, NodeKind.E_UNARY, NodeKind.S_ASSIGN. An enum cannot live in a u32
}

// expressions
enum NodeKind {
    // Node index 0 means none, and a child slot of 0 does get read
    // (`nodes[base].kind == E_IDENT` where base may be 0). Tag 0 has
    // to stay unmatched by any real kind.
    NoKind,
    E_INT,        // A value
    E_CHAR,       // A value
    E_STR,        // A bytes, B len; AUX rodata address
    E_BOOL,       // A 0/1
    E_IDENT,      // A name start, B name len; AUX local or const value
    E_UNARY,      // A op(punct), B operand
    E_BINARY,     // A op(punct), B lhs, C rhs, D operand type
    E_BORROW,     // A mut, B operand, D root local
    E_CAST,       // A operand, B type node
    E_CALL,       // A callee, B args, D fn info
    E_INDEX,      // A base, B index, D element size
    E_FIELD,      // A base, B name start, C name len, D field info
    E_DEREF,      // A base
    E_STRUCTLIT,  // A name start, B name len, C fields, D struct info
    E_LITFIELD,   // A name start, B name len, C value
    E_SLICE,      // A mut, B ptr, C len          (language.md S5)
    E_OFFSET,     // A ptr, B index, D stride     (language.md S5)
    T_PRIM,       // A 0=i32 1=u32 2=bool 3=u8
    T_NAMED,      // A name start, B name len
    T_SLICE,      // A inner, B mut
    T_REF,        // A inner, B mut
    T_PTR,        // A inner
    S_LET,        // A name start, B name len, C type, D init, E mut
    S_ASSIGN,     // A target, B op(punct), C value
    S_EXPR,       // A call; AUX discard
    S_IF,         // A cond, B then, C else, D has-else
    S_FOR,        // A init, B cond, C post, D body
    S_BREAK,      
    S_CONTINUE,   
    S_RETURN,     // A value
    S_MATCH,      // A scrutinee, B arms, C enum info, D has-wild
    S_UNSAFE,     // A body
    S_ARM,        // A name start, B name len, C binds, D body, E wild
    S_BIND,       // A name start, B name len; AUX local
    S_ALT,        // A name start, B name len; AUX variant. the tail of `A | B`
    D_FN,         // A name start, B name len, C params, D ret, E body
    D_STRUCT,     // A name start, B name len, C fields; AUX struct info
    D_ENUM,       // A name start, B name len, C variants; AUX enum info
    D_CONST,      // A name start, B name len, C type, D value
    D_PARAM,      // A name start, B name len, C type; AUX local
    D_FIELD,      // A name start, B name len, C type
    D_VARIANT,    // A name start, B name len, C payload types
}

const MAX_DEPTH: u32 = 64;

fn node(c: &mut Ctx, kind: NodeKind, line: u32, col: u32) -> u32 {
    let n: u32 = c.^.nnode;
    c.^.nodes[n] = Node{
        kind: kind, line: line, col: col,
        a: 0, b: 0, c: 0, d: 0, e: 0,
        next: 0, ty: 0, aux: 0, aux2: 0, depth: 1, op: Punct.NoPunct,
    };
    c.^.nnode = n + 1;
    return n;
}

// --- token cursor ----------------------------------------------------------

fn cur_kind(c: &Ctx) -> TokKind { return c.^.toks[c.^.ti].kind; }

fn cur_val(c: &Ctx) -> u32 { return c.^.toks[c.^.ti].value; }

fn cur_punct(c: &Ctx) -> Punct { return c.^.toks[c.^.ti].punct; }

fn cur_kw(c: &Ctx) -> Kw { return c.^.toks[c.^.ti].kw; }

fn cur_line(c: &Ctx) -> u32 { return c.^.toks[c.^.ti].line; }

fn cur_col(c: &Ctx) -> u32 { return c.^.toks[c.^.ti].col; }

fn bump(c: &mut Ctx) { c.^.ti = c.^.ti + 1; }

fn at_p(c: &Ctx, p: Punct) -> bool {
    return cur_kind(c) == TokKind.TK_PUNCT && cur_punct(c) == p;
}

fn at_kw(c: &Ctx, k: Kw) -> bool {
    return cur_kind(c) == TokKind.TK_KW && cur_kw(c) == k;
}

fn eat_p(c: &mut Ctx, p: Punct) -> bool {
    if at_p(c, p) { bump(c); return true; }
    return false;
}

fn eat_kw(c: &mut Ctx, k: Kw) -> bool {
    if at_kw(c, k) { bump(c); return true; }
    return false;
}

// --- rendering tokens into diagnostics -------------------------------------

// `put_str` takes a slice, and a match expression cannot produce one
// (language.md S5) -- so this stays an if-chain, like `put_kw` below it.
fn put_punct(c: &mut Ctx, p: Punct) {
    match p {
        ShlEq => { put_str(c, "<<="); }
        ShrEq => { put_str(c, ">>="); }
        Arrow => { put_str(c, "->"); }
        FatArrow => { put_str(c, "=>"); }
        EqEq => { put_str(c, "=="); }
        Ne => { put_str(c, "!="); }
        Le => { put_str(c, "<="); }
        Ge => { put_str(c, ">="); }
        AndAnd => { put_str(c, "&&"); }
        OrOr => { put_str(c, "||"); }
        Shl => { put_str(c, "<<"); }
        Shr => { put_str(c, ">>"); }
        AddEq => { put_str(c, "+="); }
        SubEq => { put_str(c, "-="); }
        MulEq => { put_str(c, "*="); }
        DivEq => { put_str(c, "/="); }
        ModEq => { put_str(c, "%="); }
        AndEq => { put_str(c, "&="); }
        OrEq => { put_str(c, "|="); }
        XorEq => { put_str(c, "^="); }
        LParen => { put_str(c, "("); }
        RParen => { put_str(c, ")"); }
        LBrace => { put_str(c, "{"); }
        RBrace => { put_str(c, "}"); }
        LBrack => { put_str(c, "["); }
        RBrack => { put_str(c, "]"); }
        Comma => { put_str(c, ","); }
        Semi => { put_str(c, ";"); }
        Colon => { put_str(c, ":"); }
        Dot => { put_str(c, "."); }
        Eq => { put_str(c, "="); }
        Lt => { put_str(c, "<"); }
        Gt => { put_str(c, ">"); }
        Add => { put_str(c, "+"); }
        Sub => { put_str(c, "-"); }
        Mul => { put_str(c, "*"); }
        Div => { put_str(c, "/"); }
        Mod => { put_str(c, "%"); }
        And => { put_str(c, "&"); }
        Or => { put_str(c, "|"); }
        Xor => { put_str(c, "^"); }
        Not => { put_str(c, "!"); }
        NoPunct => { }
    }
}

fn put_kw(c: &mut Ctx, k: Kw) {
    match k {
        K_FN => { put_str(c, "fn"); }
        K_STRUCT => { put_str(c, "struct"); }
        K_ENUM => { put_str(c, "enum"); }
        K_CONST => { put_str(c, "const"); }
        K_LET => { put_str(c, "let"); }
        K_MUT => { put_str(c, "mut"); }
        K_IF => { put_str(c, "if"); }
        K_ELSE => { put_str(c, "else"); }
        K_FOR => { put_str(c, "for"); }
        K_BREAK => { put_str(c, "break"); }
        K_CONTINUE => { put_str(c, "continue"); }
        K_RETURN => { put_str(c, "return"); }
        K_MATCH => { put_str(c, "match"); }
        K_UNSAFE => { put_str(c, "unsafe"); }
        K_AS => { put_str(c, "as"); }
        K_TRUE => { put_str(c, "true"); }
        K_FALSE => { put_str(c, "false"); }
        K_SLICE => { put_str(c, "slice"); }
        K_SLICE_MUT => { put_str(c, "slice_mut"); }
        K_OFFSET => { put_str(c, "offset"); }
        NoKw => { }
    }
}

// Token.describe() in cool0.py
//
// Nothing here reads the source. After lexing, an identifier is an interned
// name and a keyword or punctuation mark spells itself, so a diagnostic can
// be written without the buffer the token came from (gh #5 B).
fn put_describe(c: &mut Ctx, i: u32) {
    match c.^.toks[i].kind {
        TK_EOF => { put_str(c, "end of file"); }
        TK_INT => { put_str(c, "integer literal"); }
        TK_CHAR => { put_str(c, "character literal"); }
        TK_STR => { put_str(c, "string literal"); }
        TK_IDENT => {
            let nm: u32 = c.^.toks[i].value;
            put_ch(c, 96);
            put_name(c, nm);
            put_ch(c, 96);
        }
        TK_KW => {
            let kw: Kw = c.^.toks[i].kw;
            put_ch(c, 96);
            put_kw(c, kw);
            put_ch(c, 96);
        }
        TK_PUNCT => {
            let pp: Punct = c.^.toks[i].punct;
            put_ch(c, 96);
            put_punct(c, pp);
            put_ch(c, 96);
        }
    }
}

fn e_expected_p(c: &mut Ctx, p: Punct) {
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    let i: u32 = c.^.ti;
    if err_open(c, line, col) {
        put_str(c, "expected ");
        put_ch(c, 96);
        put_punct(c, p);
        put_ch(c, 96);
        put_str(c, ", found ");
        put_describe(c, i);
        err_end(c);
    }
}

fn e_expected_kw(c: &mut Ctx, k: Kw) {
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    let i: u32 = c.^.ti;
    if err_open(c, line, col) {
        put_str(c, "expected ");
        put_ch(c, 96);
        put_kw(c, k);
        put_ch(c, 96);
        put_str(c, ", found ");
        put_describe(c, i);
        err_end(c);
    }
}

fn e_expected_str(c: &mut Ctx, s: []u8) {
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    let i: u32 = c.^.ti;
    if err_open(c, line, col) {
        put_str(c, s);
        put_str(c, ", found ");
        put_describe(c, i);
        err_end(c);
    }
}

fn expect_p(c: &mut Ctx, p: Punct) {
    if failed(c) { return; }
    if at_p(c, p) { bump(c); return; }
    e_expected_p(c, p);
}

fn expect_kw(c: &mut Ctx, k: Kw) {
    if failed(c) { return; }
    if at_kw(c, k) { bump(c); return; }
    e_expected_kw(c, k);
}

// Returns the token index of the identifier, or NONE.
fn expect_ident(c: &mut Ctx) -> u32 {
    if failed(c) { return NONE; }
    if cur_kind(c) != TokKind.TK_IDENT {
        e_expected_str(c, "expected identifier");
        return NONE;
    }
    let i: u32 = c.^.ti;
    bump(c);
    return i;
}

// --- depth guards (language.md S9) -----------------------------------------

fn e_deep_expr(c: &mut Ctx, line: u32, col: u32) {
    err_msg(c, line, col, "expression nests too deeply");
}

// Set a composite node's tree depth, guarding the limit.
fn deep(c: &mut Ctx, n: u32, maxd: u32) -> u32 {
    if maxd + 1 > MAX_DEPTH {
        let line: u32 = c.^.nodes[n].line;
        let col: u32 = c.^.nodes[n].col;
        e_deep_expr(c, line, col);
        return n;
    }
    c.^.nodes[n].depth = maxd + 1;
    return n;
}

fn depth_of(c: &Ctx, n: u32) -> u32 {
    if n == 0 { return 0; }
    return c.^.nodes[n].depth;
}

fn max2(a: u32, b: u32) -> u32 { if a > b { return a; } return b; }

fn depth_list(c: &Ctx, head: u32) -> u32 {
    let mut d: u32 = 0;
    let mut p: u32 = head;
    for p != 0 {
        d = max2(d, depth_of(c, p));
        p = c.^.nodes[p].next;
    }
    return d;
}

// --- types (language.md S3) ------------------------------------------------

fn parse_ty(c: &mut Ctx) -> u32 {
    if failed(c) { return 0; }
    if c.^.edepth >= MAX_DEPTH {
        let line: u32 = cur_line(c);
        let col: u32 = cur_col(c);
        err_msg(c, line, col, "type nests too deeply");
        return 0;
    }
    c.^.edepth = c.^.edepth + 1;
    let t: u32 = parse_ty_inner(c);
    c.^.edepth = c.^.edepth - 1;
    return t;
}

fn parse_ty_inner(c: &mut Ctx) -> u32 {
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    if eat_p(c, Punct.LBrack) {
        expect_p(c, Punct.RBrack);
        let n: u32 = node(c, NodeKind.T_SLICE, line, col);
        if eat_kw(c, Kw.K_MUT) { c.^.nodes[n].b = 1; }
        let inner: u32 = parse_ty(c);
        c.^.nodes[n].a = inner;
        return n;
    }
    if eat_p(c, Punct.And) {
        let n: u32 = node(c, NodeKind.T_REF, line, col);
        if eat_kw(c, Kw.K_MUT) { c.^.nodes[n].b = 1; }
        let inner: u32 = parse_ty(c);
        c.^.nodes[n].a = inner;
        return n;
    }
    if eat_p(c, Punct.Mul) {
        let n: u32 = node(c, NodeKind.T_PTR, line, col);
        let inner: u32 = parse_ty(c);
        c.^.nodes[n].a = inner;
        return n;
    }
    if cur_kind(c) == TokKind.TK_IDENT {
        let s: u32 = c.^.toks[c.^.ti].value;
        bump(c);
        if s == c.^.id_i32 {
            let n: u32 = node(c, NodeKind.T_PRIM, line, col);
            c.^.nodes[n].a = 0;
            return n;
        }
        if s == c.^.id_u32 {
            let n: u32 = node(c, NodeKind.T_PRIM, line, col);
            c.^.nodes[n].a = 1;
            return n;
        }
        if s == c.^.id_bool {
            let n: u32 = node(c, NodeKind.T_PRIM, line, col);
            c.^.nodes[n].a = 2;
            return n;
        }
        if s == c.^.id_u8 {
            let n: u32 = node(c, NodeKind.T_PRIM, line, col);
            c.^.nodes[n].a = 3;
            return n;
        }
        let n: u32 = node(c, NodeKind.T_NAMED, line, col);
        c.^.nodes[n].a = s;
        return n;
    }
    e_expected_str(c, "expected type");
    return 0;
}

// --- expressions (language.md S5) ------------------------------------------

const CMP_LEVEL: u32 = 2;
const NLEVELS: u32 = 9;

fn is_cmp(p: Punct) -> bool {
    return match p {
        EqEq | Ne | Lt | Gt | Le | Ge => true,
        _ => false,
    };
}

fn op_at_level(p: Punct, level: u32) -> bool {
    return match p {
        OrOr => level == 0,
        AndAnd => level == 1,
        Or => level == 3,
        Xor => level == 4,
        And => level == 5,
        Shl | Shr => level == 6,
        Add | Sub => level == 7,
        Mul | Div | Mod => level == 8,
        _ => false,
    };
}

fn parse_expr(c: &mut Ctx, asl: bool) -> u32 { return parse_bin(c, 0, asl); }

fn parse_bin(c: &mut Ctx, level: u32, asl: bool) -> u32 {
    if failed(c) { return 0; }
    if level == CMP_LEVEL { return parse_cmp(c, asl); }
    if level >= NLEVELS { return parse_unary(c, asl); }
    let mut lhs: u32 = parse_bin(c, level + 1, asl);
    for !failed(c) && cur_kind(c) == TokKind.TK_PUNCT && op_at_level(cur_punct(c), level) {
        let line: u32 = cur_line(c);
        let col: u32 = cur_col(c);
        let op: Punct = cur_punct(c);
        bump(c);
        let rhs: u32 = parse_bin(c, level + 1, asl);
        let n: u32 = node(c, NodeKind.E_BINARY, line, col);
        c.^.nodes[n].op = op;
        c.^.nodes[n].b = lhs;
        c.^.nodes[n].c = rhs;
        let dl: u32 = depth_of(c, lhs);
        let dr: u32 = depth_of(c, rhs);
        lhs = deep(c, n, max2(dl, dr));
    }
    return lhs;
}

fn parse_cmp(c: &mut Ctx, asl: bool) -> u32 {
    let lhs: u32 = parse_bin(c, CMP_LEVEL + 1, asl);
    if failed(c) { return 0; }
    if cur_kind(c) == TokKind.TK_PUNCT && is_cmp(cur_punct(c)) {
        let line: u32 = cur_line(c);
        let col: u32 = cur_col(c);
        let op: Punct = cur_punct(c);
        bump(c);
        let rhs: u32 = parse_bin(c, CMP_LEVEL + 1, asl);
        if failed(c) { return 0; }
        if cur_kind(c) == TokKind.TK_PUNCT && is_cmp(cur_punct(c)) {
            let el: u32 = cur_line(c);
            let ec: u32 = cur_col(c);
            err_msg(c, el, ec, "comparison operators cannot be chained");
            return 0;
        }
        let n: u32 = node(c, NodeKind.E_BINARY, line, col);
        c.^.nodes[n].op = op;
        c.^.nodes[n].b = lhs;
        c.^.nodes[n].c = rhs;
        let dl: u32 = depth_of(c, lhs);
        let dr: u32 = depth_of(c, rhs);
        return deep(c, n, max2(dl, dr));
    }
    return lhs;
}

// The `as` level. Unary binds tighter than `as` (language.md S5).
fn parse_unary(c: &mut Ctx, asl: bool) -> u32 {
    let mut e: u32 = parse_prefix(c, asl);
    for !failed(c) && at_kw(c, Kw.K_AS) {
        let line: u32 = cur_line(c);
        let col: u32 = cur_col(c);
        bump(c);
        let t: u32 = parse_ty(c);
        let n: u32 = node(c, NodeKind.E_CAST, line, col);
        c.^.nodes[n].a = e;
        c.^.nodes[n].b = t;
        let d: u32 = depth_of(c, e);
        e = deep(c, n, d);
    }
    return e;
}

fn parse_prefix(c: &mut Ctx, asl: bool) -> u32 {
    if failed(c) { return 0; }
    if c.^.edepth >= MAX_DEPTH {
        let line: u32 = cur_line(c);
        let col: u32 = cur_col(c);
        e_deep_expr(c, line, col);
        return 0;
    }
    c.^.edepth = c.^.edepth + 1;
    let e: u32 = parse_prefix_inner(c, asl);
    c.^.edepth = c.^.edepth - 1;
    return e;
}

fn parse_prefix_inner(c: &mut Ctx, asl: bool) -> u32 {
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    if at_p(c, Punct.Sub) {
        bump(c);
        let k: u32 = parse_prefix(c, asl);
        let n: u32 = node(c, NodeKind.E_UNARY, line, col);
        c.^.nodes[n].op = Punct.Sub;
        c.^.nodes[n].b = k;
        let d: u32 = depth_of(c, k);
        return deep(c, n, d);
    }
    if at_p(c, Punct.Not) {
        bump(c);
        let k: u32 = parse_prefix(c, asl);
        let n: u32 = node(c, NodeKind.E_UNARY, line, col);
        c.^.nodes[n].op = Punct.Not;
        c.^.nodes[n].b = k;
        let d: u32 = depth_of(c, k);
        return deep(c, n, d);
    }
    if at_p(c, Punct.And) {
        bump(c);
        let n: u32 = node(c, NodeKind.E_BORROW, line, col);
        if eat_kw(c, Kw.K_MUT) { c.^.nodes[n].a = 1; }
        let k: u32 = parse_prefix(c, asl);
        c.^.nodes[n].b = k;
        let d: u32 = depth_of(c, k);
        return deep(c, n, d);
    }
    return parse_postfix(c, asl);
}

fn parse_postfix(c: &mut Ctx, asl: bool) -> u32 {
    let mut e: u32 = parse_primary(c, asl);
    for !failed(c) {
        let line: u32 = cur_line(c);
        let col: u32 = cur_col(c);
        if at_p(c, Punct.LParen) {
            // inside brackets the struct-literal restriction lifts (language.md S5)
            bump(c);
            let mut head: u32 = 0;
            let mut tail: u32 = 0;
            for !failed(c) && !at_p(c, Punct.RParen) {
                let a: u32 = parse_expr(c, true);
                if head == 0 { head = a; } else { c.^.nodes[tail].next = a; }
                tail = a;
                if !eat_p(c, Punct.Comma) { break; }
            }
            expect_p(c, Punct.RParen);
            let n: u32 = node(c, NodeKind.E_CALL, line, col);
            c.^.nodes[n].a = e;
            c.^.nodes[n].b = head;
            let de: u32 = depth_of(c, e);
            let dh: u32 = depth_list(c, head);
            e = deep(c, n, max2(de, dh));
        } else if at_p(c, Punct.LBrack) {
            bump(c);
            let idx: u32 = parse_expr(c, true);
            expect_p(c, Punct.RBrack);
            let n: u32 = node(c, NodeKind.E_INDEX, line, col);
            c.^.nodes[n].a = e;
            c.^.nodes[n].b = idx;
            let de: u32 = depth_of(c, e);
            let di: u32 = depth_of(c, idx);
            e = deep(c, n, max2(de, di));
        } else if at_p(c, Punct.Dot) {
            bump(c);
            if eat_p(c, Punct.Xor) {
                let n: u32 = node(c, NodeKind.E_DEREF, line, col);
                c.^.nodes[n].a = e;
                let d: u32 = depth_of(c, e);
                e = deep(c, n, d);
            } else {
                let it: u32 = expect_ident(c);
                if it == NONE { return e; }
                let n: u32 = node(c, NodeKind.E_FIELD, line, col);
                c.^.nodes[n].a = e;
                let s: u32 = c.^.toks[it].value;
                c.^.nodes[n].b = s;
                let d: u32 = depth_of(c, e);
                e = deep(c, n, d);
            }
        } else {
            return e;
        }
    }
    return e;
}

fn parse_primary(c: &mut Ctx, asl: bool) -> u32 {
    if failed(c) { return 0; }
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    let k: TokKind = cur_kind(c);
    if k == TokKind.TK_INT {
        let n: u32 = node(c, NodeKind.E_INT, line, col);
        let v: u32 = cur_val(c);
        c.^.nodes[n].a = v;
        bump(c);
        return n;
    }
    if k == TokKind.TK_CHAR {
        let n: u32 = node(c, NodeKind.E_CHAR, line, col);
        let v: u32 = cur_val(c);
        c.^.nodes[n].a = v;
        bump(c);
        return n;
    }
    if k == TokKind.TK_STR {
        let n: u32 = node(c, NodeKind.E_STR, line, col);
        let v: u32 = cur_val(c);
        let aux: u32 = c.^.toks[c.^.ti].aux;
        c.^.nodes[n].a = v;
        c.^.nodes[n].b = aux;
        bump(c);
        return n;
    }
    if at_kw(c, Kw.K_TRUE) {
        let n: u32 = node(c, NodeKind.E_BOOL, line, col);
        c.^.nodes[n].a = 1;
        bump(c);
        return n;
    }
    if at_kw(c, Kw.K_FALSE) {
        let n: u32 = node(c, NodeKind.E_BOOL, line, col);
        c.^.nodes[n].a = 0;
        bump(c);
        return n;
    }
    if at_kw(c, Kw.K_SLICE) || at_kw(c, Kw.K_SLICE_MUT) {
        let is_mut: bool = at_kw(c, Kw.K_SLICE_MUT);
        bump(c);
        expect_p(c, Punct.LParen);
        let p: u32 = parse_expr(c, true);
        expect_p(c, Punct.Comma);
        let ln: u32 = parse_expr(c, true);
        expect_p(c, Punct.RParen);
        let n: u32 = node(c, NodeKind.E_SLICE, line, col);
        if is_mut { c.^.nodes[n].a = 1; }
        c.^.nodes[n].b = p;
        c.^.nodes[n].c = ln;
        let dp: u32 = depth_of(c, p);
        let dl: u32 = depth_of(c, ln);
        return deep(c, n, max2(dp, dl));
    }
    if at_kw(c, Kw.K_OFFSET) {
        bump(c);
        expect_p(c, Punct.LParen);
        let p: u32 = parse_expr(c, true);
        expect_p(c, Punct.Comma);
        let ix: u32 = parse_expr(c, true);
        expect_p(c, Punct.RParen);
        let n: u32 = node(c, NodeKind.E_OFFSET, line, col);
        c.^.nodes[n].a = p;
        c.^.nodes[n].b = ix;
        let dp: u32 = depth_of(c, p);
        let di: u32 = depth_of(c, ix);
        return deep(c, n, max2(dp, di));
    }
    if at_kw(c, Kw.K_MATCH) { return parse_match_expr(c); }
    if at_p(c, Punct.LParen) {
        bump(c);
        let e: u32 = parse_expr(c, true);
        expect_p(c, Punct.RParen);
        return e;
    }
    if k == TokKind.TK_IDENT {
        let s: u32 = c.^.toks[c.^.ti].value;
        bump(c);
        if asl && at_p(c, Punct.LBrace) { return parse_struct_lit(c, line, col, s); }
        let n: u32 = node(c, NodeKind.E_IDENT, line, col);
        c.^.nodes[n].a = s;
        return n;
    }
    e_expected_str(c, "expected expression");
    return 0;
}

fn parse_struct_lit(c: &mut Ctx, line: u32, col: u32, s: u32) -> u32 {
    expect_p(c, Punct.LBrace);
    let mut head: u32 = 0;
    let mut tail: u32 = 0;
    for !failed(c) && !at_p(c, Punct.RBrace) {
        let fline: u32 = cur_line(c);
        let fcol: u32 = cur_col(c);
        let it: u32 = expect_ident(c);
        if it == NONE { break; }
        expect_p(c, Punct.Colon);
        let v: u32 = parse_expr(c, true);
        let f: u32 = node(c, NodeKind.E_LITFIELD, fline, fcol);
        let fs: u32 = c.^.toks[it].value;
        c.^.nodes[f].a = fs;
        c.^.nodes[f].c = v;
        let dv: u32 = depth_of(c, v);
        c.^.nodes[f].depth = dv;
        if head == 0 { head = f; } else { c.^.nodes[tail].next = f; }
        tail = f;
        if !eat_p(c, Punct.Comma) { break; }
    }
    expect_p(c, Punct.RBrace);
    let n: u32 = node(c, NodeKind.E_STRUCTLIT, line, col);
    c.^.nodes[n].a = s;
    c.^.nodes[n].c = head;
    let dh: u32 = depth_list(c, head);
    return deep(c, n, dh);
}

// --- statements (language.md S6) -------------------------------------------

fn parse_block(c: &mut Ctx) -> u32 {
    if failed(c) { return 0; }
    if c.^.bdepth >= MAX_DEPTH {
        let line: u32 = cur_line(c);
        let col: u32 = cur_col(c);
        err_msg(c, line, col, "block nests too deeply");
        return 0;
    }
    c.^.bdepth = c.^.bdepth + 1;
    expect_p(c, Punct.LBrace);
    let mut head: u32 = 0;
    let mut tail: u32 = 0;
    for !failed(c) && !at_p(c, Punct.RBrace) {
        if cur_kind(c) == TokKind.TK_EOF {
            e_expected_p(c, Punct.RBrace);
            return 0;
        }
        let s: u32 = parse_stmt(c);
        if failed(c) { return 0; }
        if head == 0 { head = s; } else { c.^.nodes[tail].next = s; }
        tail = s;
    }
    expect_p(c, Punct.RBrace);
    c.^.bdepth = c.^.bdepth - 1;
    return head;
}

fn is_assign_op(p: Punct) -> bool {
    return match p {
        Eq | AddEq | SubEq | MulEq | DivEq | ModEq
        | AndEq | OrEq | XorEq | ShlEq | ShrEq => true,
        _ => false,
    };
}

fn parse_stmt(c: &mut Ctx) -> u32 {
    if failed(c) { return 0; }
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    if at_kw(c, Kw.K_LET) {
        let s: u32 = parse_let(c);
        expect_p(c, Punct.Semi);
        return s;
    }
    if at_kw(c, Kw.K_IF) { return parse_if(c); }
    if at_kw(c, Kw.K_FOR) { return parse_for(c); }
    if at_kw(c, Kw.K_MATCH) { return parse_match(c); }
    if at_kw(c, Kw.K_UNSAFE) {
        bump(c);
        let n: u32 = node(c, NodeKind.S_UNSAFE, line, col);
        let b: u32 = parse_block(c);
        c.^.nodes[n].a = b;
        return n;
    }
    if eat_kw(c, Kw.K_BREAK) {
        expect_p(c, Punct.Semi);
        return node(c, NodeKind.S_BREAK, line, col);
    }
    if eat_kw(c, Kw.K_CONTINUE) {
        expect_p(c, Punct.Semi);
        return node(c, NodeKind.S_CONTINUE, line, col);
    }
    if eat_kw(c, Kw.K_RETURN) {
        let n: u32 = node(c, NodeKind.S_RETURN, line, col);
        if eat_p(c, Punct.Semi) { return n; }
        let v: u32 = parse_expr(c, false);
        c.^.nodes[n].a = v;
        expect_p(c, Punct.Semi);
        return n;
    }
    let s: u32 = parse_simple_stmt(c);
    expect_p(c, Punct.Semi);
    return s;
}

// Assignment or a call statement. The caller eats the `;` -- the for header
// needs the same production without one.
fn parse_simple_stmt(c: &mut Ctx) -> u32 {
    if failed(c) { return 0; }
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    let e: u32 = parse_expr(c, false);
    if failed(c) { return 0; }
    if cur_kind(c) == TokKind.TK_PUNCT && is_assign_op(cur_punct(c)) {
        let op: Punct = cur_punct(c);
        bump(c);
        let v: u32 = parse_expr(c, true);
        let n: u32 = node(c, NodeKind.S_ASSIGN, line, col);
        c.^.nodes[n].a = e;
        c.^.nodes[n].op = op;
        c.^.nodes[n].c = v;
        return n;
    }
    if c.^.nodes[e].kind != NodeKind.E_CALL {
        err_msg(c, line, col, "expression statement must be a call");
        return 0;
    }
    let n: u32 = node(c, NodeKind.S_EXPR, line, col);
    c.^.nodes[n].a = e;
    return n;
}

fn parse_let(c: &mut Ctx) -> u32 {
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    expect_kw(c, Kw.K_LET);
    let n: u32 = node(c, NodeKind.S_LET, line, col);
    if eat_kw(c, Kw.K_MUT) { c.^.nodes[n].e = 1; }
    let it: u32 = expect_ident(c);
    if it == NONE { return n; }
    let s: u32 = c.^.toks[it].value;
    c.^.nodes[n].a = s;
    if eat_p(c, Punct.Colon) {
        let t: u32 = parse_ty(c);
        c.^.nodes[n].c = t;
    }
    expect_p(c, Punct.Eq);
    let init: u32 = parse_expr(c, true);
    c.^.nodes[n].d = init;
    return n;
}

fn parse_if(c: &mut Ctx) -> u32 {
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    expect_kw(c, Kw.K_IF);
    let n: u32 = node(c, NodeKind.S_IF, line, col);
    let cond: u32 = parse_expr(c, false);
    c.^.nodes[n].a = cond;
    let then: u32 = parse_block(c);
    c.^.nodes[n].b = then;
    if eat_kw(c, Kw.K_ELSE) {
        c.^.nodes[n].d = 1;
        if at_kw(c, Kw.K_IF) {
            // an else-if chain is recursion too; it counts as block nesting
            if c.^.bdepth >= MAX_DEPTH {
                let el: u32 = cur_line(c);
                let ec: u32 = cur_col(c);
                err_msg(c, el, ec, "block nests too deeply");
                return n;
            }
            c.^.bdepth = c.^.bdepth + 1;
            let els: u32 = parse_if(c);
            c.^.nodes[n].c = els;
            c.^.bdepth = c.^.bdepth - 1;
        } else {
            let els: u32 = parse_block(c);
            c.^.nodes[n].c = els;
        }
    }
    return n;
}

fn parse_for(c: &mut Ctx) -> u32 {
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    expect_kw(c, Kw.K_FOR);
    let n: u32 = node(c, NodeKind.S_FOR, line, col);
    if at_p(c, Punct.LBrace) {
        let body: u32 = parse_block(c);
        c.^.nodes[n].d = body;
        return n;
    }
    if at_kw(c, Kw.K_LET) {
        let init: u32 = parse_let(c);
        c.^.nodes[n].a = init;
        expect_p(c, Punct.Semi);
        let cond: u32 = parse_expr(c, false);
        c.^.nodes[n].b = cond;
        expect_p(c, Punct.Semi);
        let post: u32 = parse_simple_stmt(c);
        c.^.nodes[n].c = post;
        let body: u32 = parse_block(c);
        c.^.nodes[n].d = body;
        return n;
    }
    let cond: u32 = parse_expr(c, false);
    c.^.nodes[n].b = cond;
    let body: u32 = parse_block(c);
    c.^.nodes[n].d = body;
    return n;
}

// Parses the pattern part of one arm (`_`, `A`, `A | B`, or `A(x, y)`) into
// `arm`'s name/alt/bind fields. The caller parses `=>` and the body -- a block
// for a statement match, a value for an expression match (language.md S5, S6).
fn parse_arm_pattern(c: &mut Ctx, arm: u32) {
    let ts: u32 = c.^.toks[c.^.ti].value;
    if cur_kind(c) == TokKind.TK_IDENT && ts == c.^.id_under {
        bump(c);
        c.^.nodes[arm].e = 1;
        return;
    }
    let it: u32 = expect_ident(c);
    if it == NONE { return; }
    let s: u32 = c.^.toks[it].value;
    c.^.nodes[arm].a = s;
    if !at_p(c, Punct.LParen) {
        // `A | B | C` -- only variants that carry no payload can be joined
        let mut ah: u32 = 0;
        let mut at2: u32 = 0;
        for eat_p(c, Punct.Or) {
            let ai: u32 = expect_ident(c);
            if ai == NONE { break; }
            let al: u32 = c.^.toks[ai].line;
            let ac: u32 = c.^.toks[ai].col;
            let alt: u32 = node(c, NodeKind.S_ALT, al, ac);
            let as2: u32 = c.^.toks[ai].value;
            c.^.nodes[alt].a = as2;
            if ah == 0 { ah = alt; } else { c.^.nodes[at2].next = alt; }
            at2 = alt;
        }
        c.^.nodes[arm].aux2 = ah;
    }
    if eat_p(c, Punct.LParen) {
        let mut bh: u32 = 0;
        let mut bt: u32 = 0;
        for !failed(c) && !at_p(c, Punct.RParen) {
            let bline: u32 = cur_line(c);
            let bcol: u32 = cur_col(c);
            let bi: u32 = expect_ident(c);
            if bi == NONE { break; }
            let b: u32 = node(c, NodeKind.S_BIND, bline, bcol);
            let bs: u32 = c.^.toks[bi].value;
            c.^.nodes[b].a = bs;
            if bh == 0 { bh = b; } else { c.^.nodes[bt].next = b; }
            bt = b;
            if !eat_p(c, Punct.Comma) { break; }
        }
        expect_p(c, Punct.RParen);
        c.^.nodes[arm].c = bh;
    }
}

fn parse_match(c: &mut Ctx) -> u32 {
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    expect_kw(c, Kw.K_MATCH);
    let n: u32 = node(c, NodeKind.S_MATCH, line, col);
    let scr: u32 = parse_expr(c, false);
    c.^.nodes[n].a = scr;
    expect_p(c, Punct.LBrace);
    let mut head: u32 = 0;
    let mut tail: u32 = 0;
    for !failed(c) && !at_p(c, Punct.RBrace) {
        let aline: u32 = cur_line(c);
        let acol: u32 = cur_col(c);
        let arm: u32 = node(c, NodeKind.S_ARM, aline, acol);
        parse_arm_pattern(c, arm);
        expect_p(c, Punct.FatArrow);
        let body: u32 = parse_block(c);
        c.^.nodes[arm].d = body;
        if head == 0 { head = arm; } else { c.^.nodes[tail].next = arm; }
        tail = arm;
    }
    expect_p(c, Punct.RBrace);
    c.^.nodes[n].b = head;
    return n;
}

// The expression form (language.md S5): arms are comma-separated and each
// body is a value, not a block.
fn parse_match_expr(c: &mut Ctx) -> u32 {
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    expect_kw(c, Kw.K_MATCH);
    let n: u32 = node(c, NodeKind.S_MATCH, line, col);
    c.^.nodes[n].e = 1;
    let scr: u32 = parse_expr(c, false);
    c.^.nodes[n].a = scr;
    expect_p(c, Punct.LBrace);
    let mut head: u32 = 0;
    let mut tail: u32 = 0;
    let mut maxd: u32 = depth_of(c, scr);
    for !failed(c) && !at_p(c, Punct.RBrace) {
        let aline: u32 = cur_line(c);
        let acol: u32 = cur_col(c);
        let arm: u32 = node(c, NodeKind.S_ARM, aline, acol);
        parse_arm_pattern(c, arm);
        expect_p(c, Punct.FatArrow);
        let value: u32 = parse_expr(c, true);
        c.^.nodes[arm].d = value;
        maxd = max2(maxd, depth_of(c, value));
        if head == 0 { head = arm; } else { c.^.nodes[tail].next = arm; }
        tail = arm;
        if !eat_p(c, Punct.Comma) { break; }
    }
    expect_p(c, Punct.RBrace);
    c.^.nodes[n].b = head;
    return deep(c, n, maxd);
}

// --- declarations (language.md S4) -----------------------------------------

fn parse_fn(c: &mut Ctx) -> u32 {
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    expect_kw(c, Kw.K_FN);
    let n: u32 = node(c, NodeKind.D_FN, line, col);
    let it: u32 = expect_ident(c);
    if it == NONE { return n; }
    let s: u32 = c.^.toks[it].value;
    c.^.nodes[n].a = s;
    expect_p(c, Punct.LParen);
    let mut head: u32 = 0;
    let mut tail: u32 = 0;
    for !failed(c) && !at_p(c, Punct.RParen) {
        let pline: u32 = cur_line(c);
        let pcol: u32 = cur_col(c);
        let pi: u32 = expect_ident(c);
        if pi == NONE { break; }
        expect_p(c, Punct.Colon);
        let p: u32 = node(c, NodeKind.D_PARAM, pline, pcol);
        let ps: u32 = c.^.toks[pi].value;
        c.^.nodes[p].a = ps;
        let pt: u32 = parse_ty(c);
        c.^.nodes[p].c = pt;
        if head == 0 { head = p; } else { c.^.nodes[tail].next = p; }
        tail = p;
        if !eat_p(c, Punct.Comma) { break; }
    }
    expect_p(c, Punct.RParen);
    c.^.nodes[n].c = head;
    if eat_p(c, Punct.Arrow) {
        let r: u32 = parse_ty(c);
        c.^.nodes[n].d = r;
    }
    // The body is parsed here so that syntax errors still come out in source
    // order, counted so the checker tables can be sized, and then dropped --
    // only the token index where it starts survives. It is parsed again, one
    // at a time, in the emit loop (gh #5 C).
    c.^.nodes[n].b = c.^.ti;
    let mark: u32 = c.^.nnode;
    let body: u32 = parse_block(c);
    count_range(c, mark, c.^.nnode);
    c.^.nnode = mark;
    c.^.nodes[n].e = 0;
    return n;
}

// Re-parse one body, into the space above the declarations.
fn parse_fn_body(c: &mut Ctx, fi: u32) {
    let d: u32 = c.^.fns[fi].decl;
    c.^.ti = c.^.nodes[d].b;
    c.^.edepth = 0;
    c.^.bdepth = 0;
    let body: u32 = parse_block(c);
    c.^.nodes[d].e = body;
}

fn parse_struct(c: &mut Ctx) -> u32 {
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    expect_kw(c, Kw.K_STRUCT);
    let n: u32 = node(c, NodeKind.D_STRUCT, line, col);
    let it: u32 = expect_ident(c);
    if it == NONE { return n; }
    let s: u32 = c.^.toks[it].value;
    c.^.nodes[n].a = s;
    expect_p(c, Punct.LBrace);
    let mut head: u32 = 0;
    let mut tail: u32 = 0;
    for !failed(c) && !at_p(c, Punct.RBrace) {
        let fline: u32 = cur_line(c);
        let fcol: u32 = cur_col(c);
        let fi: u32 = expect_ident(c);
        if fi == NONE { break; }
        expect_p(c, Punct.Colon);
        let f: u32 = node(c, NodeKind.D_FIELD, fline, fcol);
        let fs: u32 = c.^.toks[fi].value;
        c.^.nodes[f].a = fs;
        let ft: u32 = parse_ty(c);
        c.^.nodes[f].c = ft;
        if head == 0 { head = f; } else { c.^.nodes[tail].next = f; }
        tail = f;
        if !eat_p(c, Punct.Comma) { break; }
    }
    expect_p(c, Punct.RBrace);
    c.^.nodes[n].c = head;
    return n;
}

fn parse_enum(c: &mut Ctx) -> u32 {
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    expect_kw(c, Kw.K_ENUM);
    let n: u32 = node(c, NodeKind.D_ENUM, line, col);
    let it: u32 = expect_ident(c);
    if it == NONE { return n; }
    let s: u32 = c.^.toks[it].value;
    c.^.nodes[n].a = s;
    expect_p(c, Punct.LBrace);
    let mut head: u32 = 0;
    let mut tail: u32 = 0;
    for !failed(c) && !at_p(c, Punct.RBrace) {
        let vline: u32 = cur_line(c);
        let vcol: u32 = cur_col(c);
        let vi: u32 = expect_ident(c);
        if vi == NONE { break; }
        let v: u32 = node(c, NodeKind.D_VARIANT, vline, vcol);
        let vs: u32 = c.^.toks[vi].value;
        c.^.nodes[v].a = vs;
        if eat_p(c, Punct.LParen) {
            let mut ph: u32 = 0;
            let mut pt: u32 = 0;
            for !failed(c) && !at_p(c, Punct.RParen) {
                let t: u32 = parse_ty(c);
                if t == 0 { break; }
                if ph == 0 { ph = t; } else { c.^.nodes[pt].next = t; }
                pt = t;
                if !eat_p(c, Punct.Comma) { break; }
            }
            expect_p(c, Punct.RParen);
            c.^.nodes[v].c = ph;
        }
        if head == 0 { head = v; } else { c.^.nodes[tail].next = v; }
        tail = v;
        if !eat_p(c, Punct.Comma) { break; }
    }
    expect_p(c, Punct.RBrace);
    c.^.nodes[n].c = head;
    return n;
}

fn parse_const(c: &mut Ctx) -> u32 {
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    expect_kw(c, Kw.K_CONST);
    let n: u32 = node(c, NodeKind.D_CONST, line, col);
    let it: u32 = expect_ident(c);
    if it == NONE { return n; }
    let s: u32 = c.^.toks[it].value;
    c.^.nodes[n].a = s;
    expect_p(c, Punct.Colon);
    let t: u32 = parse_ty(c);
    c.^.nodes[n].c = t;
    expect_p(c, Punct.Eq);
    let v: u32 = parse_expr(c, false);
    c.^.nodes[n].d = v;
    expect_p(c, Punct.Semi);
    return n;
}

fn parse_program(c: &mut Ctx) {
    c.^.ti = 0;
    c.^.edepth = 0;
    c.^.bdepth = 0;
    let mut head: u32 = 0;
    let mut tail: u32 = 0;
    for !failed(c) && cur_kind(c) != TokKind.TK_EOF {
        let mut d: u32 = 0;
        if at_kw(c, Kw.K_FN) {
            d = parse_fn(c);
        } else if at_kw(c, Kw.K_STRUCT) {
            d = parse_struct(c);
        } else if at_kw(c, Kw.K_ENUM) {
            d = parse_enum(c);
        } else if at_kw(c, Kw.K_CONST) {
            d = parse_const(c);
        } else {
            e_expected_str(c, "expected `fn`, `struct`, `enum` or `const`");
            return;
        }
        if failed(c) { return; }
        if head == 0 { head = d; } else { c.^.nodes[tail].next = d; }
        tail = d;
    }
    c.^.decls = head;
}

// ===========================================================================
// Types, interned (language.md S3)
// ===========================================================================
//
// This is the sum type the compiler leans on hardest, so this is where cool0's
// enum earns its keep. Structural types are hash-consed: equality is index
// equality, and `match` reads the shape off directly instead of switching on a
// tag word and then trusting that the other words mean what you think.

enum Ty {
    I32,
    U32,
    Bool,
    U8,
    Void,
    IntLit,           // an integer literal that has not settled yet
    Slice(u32, u32),  // element type, mut
    Ref(u32, u32),    // inner type, mut
    Ptr(u32),         // inner type
    Named(u32),       // interned name (gh #5 A)
}

// The primitives get fixed indices so they need no lookup.
const TY_I32: u32 = 1;
const TY_U32: u32 = 2;
const TY_BOOL: u32 = 3;
const TY_U8: u32 = 4;
const TY_VOID: u32 = 5;
const TY_INTLIT: u32 = 6;
const TY_FIRST: u32 = 7;   // interned types start here

// Kind tags, used only where a type has to be compared or built from parts.
const TYK_I32: u32 = 0;
const TYK_U32: u32 = 1;
const TYK_BOOL: u32 = 2;
const TYK_U8: u32 = 3;
const TYK_VOID: u32 = 4;
const TYK_INTLIT: u32 = 5;
const TYK_SLICE: u32 = 6;
const TYK_REF: u32 = 7;
const TYK_PTR: u32 = 8;
const TYK_NAMED: u32 = 9;

fn ty_kind(c: &Ctx, t: u32) -> u32 {
    match c.^.types[t] {
        I32 => { return TYK_I32; }
        U32 => { return TYK_U32; }
        Bool => { return TYK_BOOL; }
        U8 => { return TYK_U8; }
        Void => { return TYK_VOID; }
        IntLit => { return TYK_INTLIT; }
        Slice(e, m) => { return TYK_SLICE; }
        Ref(i, m) => { return TYK_REF; }
        Ptr(i) => { return TYK_PTR; }
        Named(s) => { return TYK_NAMED; }
    }
}

fn ty_arg(c: &Ctx, t: u32) -> u32 {
    match c.^.types[t] {
        Slice(e, m) => { return e; }
        Ref(i, m) => { return i; }
        Ptr(i) => { return i; }
        Named(s) => { return s; }
        _ => { return 0; }
    }
}

fn ty_flag(c: &Ctx, t: u32) -> u32 {
    match c.^.types[t] {
        Slice(e, m) => { return m; }
        Ref(i, m) => { return m; }
        _ => { return 0; }
    }
}

fn ty_put(c: &mut Ctx, kind: u32, arg: u32, flag: u32) -> u32 {
    let n: u32 = c.^.nty;
    if kind == TYK_SLICE { c.^.types[n] = Ty.Slice(arg, flag); }
    else if kind == TYK_REF { c.^.types[n] = Ty.Ref(arg, flag); }
    else if kind == TYK_PTR { c.^.types[n] = Ty.Ptr(arg); }
    else { c.^.types[n] = Ty.Named(arg); }
    c.^.nty = n + 1;
    return n;
}

fn ty_intern(c: &mut Ctx, kind: u32, arg: u32, flag: u32) -> u32 {
    let n: u32 = c.^.nty;
    for let mut p: u32 = TY_FIRST; p < n; p += 1 {
        if ty_kind(c, p) == kind && ty_arg(c, p) == arg && ty_flag(c, p) == flag {
            return p;
        }
    }
    return ty_put(c, kind, arg, flag);
}

// ===========================================================================
// Interned names (gh #5 A)
// ===========================================================================
//
// A name used to be (start, len) into the source. That is fine while there is
// exactly one source buffer and it lives as long as the compiler does. Both
// multi-source input (gh #5 B) and per-function arena reuse (gh #5 C) need to
// let go of a buffer, so names have to be owned by the compiler instead.
//
// Interning runs once, over the token array, after lexing and before parsing.
// Not during lexing: only once the tokens exist are the exact byte count and
// name count knowable, and knowing them lets these arenas be sized exactly
// rather than bounded by the source length.

struct NameEnt {
    off: u32,   // into c.nmem
    len: u32,
}

const FNV_OFFSET: u32 = 2166136261;
const FNV_PRIME: u32 = 16777619;

// "i32" "u32" "bool" "u8" "_" "len" "ptr"
const WELLKNOWN_COUNT: u32 = 7;
const WELLKNOWN_BYTES: u32 = 19;

fn name_hash(s: []u8) -> u32 {
    let mut h: u32 = FNV_OFFSET;
    for let mut i: u32 = 0; i < s.len; i += 1 {
        h = h ^ s[i];
        h = h * FNV_PRIME;
    }
    return h;
}

fn name_is(c: &Ctx, id: u32, s: []u8) -> bool {
    if c.^.ntab[id].len != s.len { return false; }
    let off: u32 = c.^.ntab[id].off;
    for let mut i: u32 = 0; i < s.len; i += 1 {
        if c.^.nmem[off + i] != s[i] { return false; }
    }
    return true;
}

fn intern(c: &mut Ctx, s: []u8) -> u32 {
    let mask: u32 = c.^.nhash.len - 1;
    let mut i: u32 = name_hash(s) & mask;
    for {
        let id: u32 = c.^.nhash[i];
        if id == 0 {
            let n: u32 = c.^.ntab_n;
            let off: u32 = c.^.nmem_n;
            for let mut k: u32 = 0; k < s.len; k += 1 {
                let b: u32 = s[k];
                c.^.nmem[off + k] = b;
            }
            c.^.nmem_n = off + s.len;
            c.^.ntab[n] = NameEnt{ off: off, len: s.len };
            c.^.ntab_n = n + 1;
            c.^.nhash[i] = n;
            return n;
        }
        if name_is(c, id, s) { return id; }
        i = (i + 1) & mask;
    }
}

fn put_name(c: &mut Ctx, id: u32) {
    let off: u32 = c.^.ntab[id].off;
    let l: u32 = c.^.ntab[id].len;
    for let mut i: u32 = 0; i < l; i += 1 {
        let b: u32 = c.^.nmem[off + i];
        put_ch(c, b);
    }
}

fn put_q_name(c: &mut Ctx, id: u32) { put_ch(c, 96); put_name(c, id); put_ch(c, 96); }

// Every identifier token carries its name id in `value` from here on.
fn intern_idents(c: &mut Ctx) {
    // A token's `start` is an offset into the buffer it came from, so this
    // walks buffer by buffer rather than token by token (gh #5 B). After it
    // returns, no name refers to a source buffer any more.
    for let mut b: u32 = 0; b < c.^.nsrc; b += 1 {
        let lo: u32 = c.^.srctok[b];
        let hi: u32 = c.^.srctok[b + 1];
        // hoisted: `c` may not appear twice in one argument list (language.md S7)
        let sp: *u8 = ldw(SRCTAB + b * 8) as *u8;
        for let mut i: u32 = lo; i < hi; i += 1 {
            if c.^.toks[i].kind == TokKind.TK_IDENT {
                let st: u32 = c.^.toks[i].start;
                let ln: u32 = c.^.toks[i].len;
                unsafe {
                    let txt: []u8 = slice(offset(sp, st), ln);
                    let id: u32 = intern(c, txt);
                    c.^.toks[i].value = id;
                }
            }
        }
    }
}

// Named types compare by interned name, not by where the name was written.
fn ty_named(c: &mut Ctx, name: u32) -> u32 {
    let n: u32 = c.^.nty;
    for let mut p: u32 = TY_FIRST; p < n; p += 1 {
        if ty_kind(c, p) == TYK_NAMED && ty_arg(c, p) == name { return p; }
    }
    return ty_put(c, TYK_NAMED, name, 0);
}

fn is_int_ty(c: &Ctx, t: u32) -> bool {
    match c.^.types[t] {
        I32 => { return true; }
        U32 => { return true; }
        IntLit => { return true; }
        _ => { return false; }
    }
}

// Does this type live only in memory? A scalar enum is a value, so it does not.
fn is_aggregate(c: &Ctx, t: u32) -> bool {
    match c.^.types[t] {
        Named(s) => { return !find_scalar(c, s); }
        _ => { return false; }
    }
}

fn is_scalar_enum(c: &Ctx, t: u32) -> bool {
    match c.^.types[t] {
        Named(s) => { return find_scalar(c, s); }
        _ => { return false; }
    }
}

// The type a place yields when read: u8 reads as u32 (language.md S3).
fn read_ty(c: &Ctx, t: u32) -> u32 {
    match c.^.types[t] {
        U8 => { return TY_U32; }
        _ => { return t; }
    }
}

fn slot_count(c: &Ctx, t: u32) -> u32 {
    match c.^.types[t] {
        Slice(e, m) => { return 2; }
        _ => { return 1; }
    }
}

// ty_str() in cool0.py
fn put_ty(c: &mut Ctx, t: u32) {
    let k: u32 = ty_kind(c, t);
    let arg: u32 = ty_arg(c, t);
    let flag: u32 = ty_flag(c, t);
    if k == TYK_I32 { put_str(c, "i32"); return; }
    if k == TYK_U32 { put_str(c, "u32"); return; }
    if k == TYK_BOOL { put_str(c, "bool"); return; }
    if k == TYK_U8 { put_str(c, "u8"); return; }
    if k == TYK_VOID { put_str(c, "void"); return; }
    if k == TYK_INTLIT { put_str(c, "integer literal"); return; }
    if k == TYK_SLICE {
        if flag != 0 { put_str(c, "[]mut "); } else { put_str(c, "[]"); }
        put_ty(c, arg);
        return;
    }
    if k == TYK_REF {
        if flag != 0 { put_str(c, "&mut "); } else { put_str(c, "&"); }
        put_ty(c, arg);
        return;
    }
    if k == TYK_PTR {
        put_str(c, "*");
        put_ty(c, arg);
        return;
    }
    put_name(c, arg);
}

fn put_q_ty(c: &mut Ctx, t: u32) { put_ch(c, 96); put_ty(c, t); put_ch(c, 96); }


// ===========================================================================
// Declaration tables
// ===========================================================================
//
// Every table is a slice arena of records with named fields. Index 0 is "none"
// in each, so every arena starts filling at 1.

struct FieldI {   // a struct field, or one payload slot of an enum variant
    name: u32,
    ty: u32,
    off: u32,
    next: u32,
}

struct StructI {
    name: u32,
    fields: u32,
    bytes: u32,
    align: u32,
    next: u32,
}

struct VariantI {
    name: u32,
    tag: u32,
    payload: u32,
    nargs: u32,
    next: u32,
}

struct EnumI {
    name: u32,
    variants: u32,
    bytes: u32,
    align: u32,
    nvar: u32,
    scalar: u32,   // no payload anywhere means the tag is the value (language.md S3)
    next: u32,
}

struct ConstI {
    name: u32,
    ty: u32,
    value: u32,
    state: u32,   // 0 pending, 1 busy, 2 done
    decl: u32,
    next: u32,
}

struct ParamI {
    name: u32,
    ty: u32,
    next: u32,
}

struct FnI {
    name: u32,
    params: u32,
    nparams: u32,
    ret: u32,
    index: u32,
    decl: u32,
    locals: u32,
    ltail: u32,
    frame: u32,
    npslot: u32,
    nlslot: u32,
    next: u32,
}

struct LocalI {
    name: u32,
    ty: u32,
    is_mut: u32,
    is_param: u32,
    addr: u32,    // address-taken (implementation.md S6)
    slot: u32,
    foff: u32,
    next: u32,
}

struct StrI {
    ptr: u32,
    len: u32,
    addr: u32,
    next: u32,
}

struct NameI {   // a claimed top-level name, or a type name
    name: u32,
    next: u32,
}

const RODATA: u32 = 0x1000_0000;

// --- lookups ---------------------------------------------------------------

fn find_struct(c: &Ctx, s: u32) -> u32 {
    for let mut p: u32 = 1; p < c.^.nstruct; p += 1 {
        let ns: u32 = c.^.structs[p].name;
        if ns == s { return p; }
    }
    return 0;
}

fn find_enum(c: &Ctx, s: u32) -> u32 {
    for let mut p: u32 = 1; p < c.^.nenum; p += 1 {
        let ns: u32 = c.^.enums[p].name;
        if ns == s { return p; }
    }
    return 0;
}

fn find_const(c: &Ctx, s: u32) -> u32 {
    for let mut p: u32 = 1; p < c.^.nconst; p += 1 {
        let ns: u32 = c.^.consts[p].name;
        if ns == s { return p; }
    }
    return 0;
}

fn find_fn(c: &Ctx, s: u32) -> u32 {
    for let mut p: u32 = 1; p < c.^.nfn; p += 1 {
        let ns: u32 = c.^.fns[p].name;
        if ns == s { return p; }
    }
    return 0;
}

fn find_type_name(c: &Ctx, s: u32) -> bool {
    for let mut p: u32 = 1; p < c.^.ntyname; p += 1 {
        let ns: u32 = c.^.tynames[p].name;
        if ns == s { return true; }
    }
    return false;
}

// Scalar-ness is readable from the syntax alone, and a struct field or an enum
// payload may name a scalar enum, so this has to answer before any layout runs.
fn find_scalar(c: &Ctx, s: u32) -> bool {
    for let mut p: u32 = 1; p < c.^.nscalar; p += 1 {
        let ns: u32 = c.^.scalars[p].name;
        if ns == s { return true; }
    }
    return false;
}

fn find_taken(c: &Ctx, s: u32) -> bool {
    for let mut p: u32 = 1; p < c.^.ntaken; p += 1 {
        let ns: u32 = c.^.taken[p].name;
        if ns == s { return true; }
    }
    return false;
}

// The aggregate info behind a named type
fn agg_struct(c: &Ctx, t: u32) -> u32 {
    let s: u32 = ty_arg(c, t);
    let l: u32 = ty_flag(c, t);
    return find_struct(c, s);
}

fn agg_enum(c: &Ctx, t: u32) -> u32 {
    let s: u32 = ty_arg(c, t);
    let l: u32 = ty_flag(c, t);
    return find_enum(c, s);
}

fn size_of(c: &Ctx, t: u32) -> u32 {
    match c.^.types[t] {
        Bool => { return 1; }
        U8 => { return 1; }
        Slice(e, m) => { return 8; }
        Named(ns) => {
            if find_scalar(c, ns) { return 4; }
            let s: u32 = find_struct(c, ns);
            if s != 0 { return c.^.structs[s].bytes; }
            let e2: u32 = find_enum(c, ns);
            if e2 != 0 { return c.^.enums[e2].bytes; }
            return 0;
        }
        _ => { return 4; }
    }
}

fn align_of(c: &Ctx, t: u32) -> u32 {
    match c.^.types[t] {
        Bool => { return 1; }
        U8 => { return 1; }
        Named(ns) => {
            if find_scalar(c, ns) { return 4; }
            let s: u32 = find_struct(c, ns);
            if s != 0 { return c.^.structs[s].align; }
            let e2: u32 = find_enum(c, ns);
            if e2 != 0 { return c.^.enums[e2].align; }
            return 1;
        }
        _ => { return 4; }
    }
}

fn align_up(x: u32, a: u32) -> u32 { return (x + a - 1) / a * a; }

// --- resolving type syntax to types ----------------------------------------

fn e_unknown_type(c: &mut Ctx, line: u32, col: u32, s: u32) {
    if err_open(c, line, col) {
        put_str(c, "unknown type ");
        put_q_name(c, s);
        err_end(c);
    }
}

fn resolve_ty(c: &mut Ctx, t: u32) -> u32 {
    if t == 0 { return TY_VOID; }
    let k: NodeKind = c.^.nodes[t].kind;
    let a: u32 = c.^.nodes[t].a;
    let b: u32 = c.^.nodes[t].b;
    if k == NodeKind.T_PRIM {
        if a == 0 { return TY_I32; }
        if a == 1 { return TY_U32; }
        if a == 2 { return TY_BOOL; }
        return TY_U8;
    }
    if k == NodeKind.T_NAMED {
        if find_type_name(c, a) { return ty_named(c, a); }
        let line: u32 = c.^.nodes[t].line;
        let col: u32 = c.^.nodes[t].col;
        e_unknown_type(c, line, col, a);
        return TY_I32;
    }
    if k == NodeKind.T_SLICE {
        let inner: u32 = resolve_ty(c, a);
        return ty_intern(c, TYK_SLICE, inner, b);
    }
    if k == NodeKind.T_REF {
        let inner: u32 = resolve_ty(c, a);
        return ty_intern(c, TYK_REF, inner, b);
    }
    let inner: u32 = resolve_ty(c, a);
    return ty_intern(c, TYK_PTR, inner, 0);
}

// --- string interning (implementation.md S4) -------------------------------

fn bytes_eq(p1: u32, l1: u32, p2: u32, l2: u32) -> bool {
    if l1 != l2 { return false; }
    for let mut i: u32 = 0; i < l1; i += 1 {
        if ldb(p1 + i) != ldb(p2 + i) { return false; }
    }
    return true;
}

// rodata grows up and the shadow-stack floor is above it (implementation.md S7).
// If they meet, the compiled program's literals overlap its own frames.
fn intern_string(c: &mut Ctx, ptr: u32, len: u32, line: u32, col: u32) -> u32 {
    for let mut p: u32 = 1; p < c.^.nstr; p += 1 {
        let sp: u32 = c.^.strs[p].ptr;
        let sl: u32 = c.^.strs[p].len;
        if bytes_eq(sp, sl, ptr, len) { return c.^.strs[p].addr; }
    }
    let n: u32 = c.^.nstr;
    let addr: u32 = c.^.rodata;
    if addr + len > SHADOW_FLOOR {
        err_msg(c, line, col, "string literals do not fit below the shadow stack");
        return addr;
    }
    c.^.strs[n] = StrI{ ptr: ptr, len: len, addr: addr, next: 0 };
    c.^.nstr = n + 1;
    c.^.rodata = addr + len;
    return addr;
}

// ===========================================================================
// Declaration collection (language.md S4)
// ===========================================================================

fn e_dup_toplevel(c: &mut Ctx, line: u32, col: u32, s: u32) {
    if err_open(c, line, col) {
        put_str(c, "duplicate top-level name ");
        put_q_name(c, s);
        err_end(c);
    }
}

fn e_builtin_name(c: &mut Ctx, line: u32, col: u32, s: u32) {
    if err_open(c, line, col) {
        put_q_name(c, s);
        put_str(c, " is a built-in type name");
        err_end(c);
    }
}

fn claim(c: &mut Ctx, d: u32) {
    let s: u32 = c.^.nodes[d].a;
    let line: u32 = c.^.nodes[d].line;
    let col: u32 = c.^.nodes[d].col;
    if find_taken(c, s) {
        e_dup_toplevel(c, line, col, s);
        return;
    }
    if s == c.^.id_i32 || s == c.^.id_u32 || s == c.^.id_bool
        || s == c.^.id_u8 {
        e_builtin_name(c, line, col, s);
        return;
    }
    let n: u32 = c.^.ntaken;
    c.^.taken[n] = NameI{ name: s, next: 0 };
    c.^.ntaken = n + 1;
}

// Scalar when no variant carries a payload -- visible in the syntax alone.
fn if_scalar(c: &Ctx, d: u32) -> u32 {
    let mut v: u32 = c.^.nodes[d].c;
    for v != 0 {
        if c.^.nodes[v].c != 0 { return 0; }
        v = c.^.nodes[v].next;
    }
    return 1;
}

fn add_scalar_name(c: &mut Ctx, d: u32) {
    if if_scalar(c, d) == 0 { return; }
    let s: u32 = c.^.nodes[d].a;
    let l: u32 = c.^.nodes[d].b;
    let n: u32 = c.^.nscalar;
    c.^.scalars[n] = NameI{ name: s, next: 0 };
    c.^.nscalar = n + 1;
}

fn add_type_name(c: &mut Ctx, d: u32) {
    let s: u32 = c.^.nodes[d].a;
    let l: u32 = c.^.nodes[d].b;
    let n: u32 = c.^.ntyname;
    c.^.tynames[n] = NameI{ name: s, next: 0 };
    c.^.ntyname = n + 1;
}

fn e_field_ty(c: &mut Ctx, line: u32, col: u32, what: u32, kind: u32, t: u32) {
    if err_open(c, line, col) {
        if what == 0 { put_str(c, "struct field"); } else { put_str(c, "enum payload"); }
        if kind == 0 { put_str(c, " cannot have aggregate type "); }
        else { put_str(c, " cannot have borrow type "); }
        put_q_ty(c, t);
        err_end(c);
    }
}

// Fields and payloads hold no aggregates and no borrows (language.md S4).
fn check_field_ty(c: &mut Ctx, t: u32, line: u32, col: u32, what: u32) {
    if is_aggregate(c, t) { e_field_ty(c, line, col, what, 0, t); return; }
    if ty_kind(c, t) == TYK_REF { e_field_ty(c, line, col, what, 1, t); }
}

fn e_dup_field(c: &mut Ctx, line: u32, col: u32, s: u32) {
    if err_open(c, line, col) {
        put_str(c, "duplicate field ");
        put_q_name(c, s);
        err_end(c);
    }
}

fn e_dup_variant(c: &mut Ctx, line: u32, col: u32, s: u32) {
    if err_open(c, line, col) {
        put_str(c, "duplicate variant ");
        put_q_name(c, s);
        err_end(c);
    }
}

fn field_named(c: &Ctx, head: u32, s: u32) -> u32 {
    let mut p: u32 = head;
    for p != 0 {
        let ns: u32 = c.^.fields[p].name;
        if ns == s { return p; }
        p = c.^.fields[p].next;
    }
    return 0;
}

fn new_field(c: &mut Ctx, name: u32, t: u32, off: u32) -> u32 {
    let n: u32 = c.^.nfield;
    c.^.fields[n] = FieldI{ name: name, ty: t, off: off, next: 0 };
    c.^.nfield = n + 1;
    return n;
}

fn declare_struct(c: &mut Ctx, d: u32) {
    let ns: u32 = c.^.nodes[d].a;
    let nl: u32 = c.^.nodes[d].b;
    let si: u32 = c.^.nstruct;
    c.^.structs[si] = StructI{ name: ns, fields: 0, bytes: 0, align: 1, next: 0 };
    c.^.nstruct = si + 1;
    let mut head: u32 = 0;
    let mut tail: u32 = 0;
    let mut off: u32 = 0;
    let mut align: u32 = 1;
    let mut f: u32 = c.^.nodes[d].c;
    for f != 0 && !failed(c) {
        let fs: u32 = c.^.nodes[f].a;
        let fl: u32 = c.^.nodes[f].b;
        let fline: u32 = c.^.nodes[f].line;
        let fcol: u32 = c.^.nodes[f].col;
        if field_named(c, head, fs) != 0 {
            e_dup_field(c, fline, fcol, fs);
            return;
        }
        let tn: u32 = c.^.nodes[f].c;
        let t: u32 = resolve_ty(c, tn);
        check_field_ty(c, t, fline, fcol, 0);
        if failed(c) { return; }
        let a: u32 = align_of(c, t);
        off = align_up(off, a);
        let fi: u32 = new_field(c, fs, t, off);
        if head == 0 { head = fi; } else { c.^.fields[tail].next = fi; }
        tail = fi;
        off = off + size_of(c, t);
        if a > align { align = a; }
        f = c.^.nodes[f].next;
    }
    c.^.structs[si].fields = head;
    c.^.structs[si].bytes = align_up(off, align);
    c.^.structs[si].align = align;
    c.^.nodes[d].aux = si;
}

fn variant_named(c: &Ctx, head: u32, s: u32) -> u32 {
    let mut p: u32 = head;
    for p != 0 {
        let ns: u32 = c.^.variants[p].name;
        if ns == s { return p; }
        p = c.^.variants[p].next;
    }
    return 0;
}

fn declare_enum(c: &mut Ctx, d: u32) {
    let ns: u32 = c.^.nodes[d].a;
    let nl: u32 = c.^.nodes[d].b;
    let ei: u32 = c.^.nenum;
    let is_scalar: u32 = if_scalar(c, d);
    c.^.enums[ei] = EnumI{
        name: ns, variants: 0, bytes: 0, align: 4, nvar: 0,
        scalar: is_scalar, next: 0,
    };
    c.^.nenum = ei + 1;
    let mut head: u32 = 0;
    let mut tail: u32 = 0;
    let mut slot: u32 = 0;
    let mut tag: u32 = 0;
    let mut v: u32 = c.^.nodes[d].c;
    for v != 0 && !failed(c) {
        let vs: u32 = c.^.nodes[v].a;
        let vl: u32 = c.^.nodes[v].b;
        let vline: u32 = c.^.nodes[v].line;
        let vcol: u32 = c.^.nodes[v].col;
        if variant_named(c, head, vs) != 0 {
            e_dup_variant(c, vline, vcol, vs);
            return;
        }
        let vi: u32 = c.^.nvariant;
        c.^.variants[vi] = VariantI{
            name: vs, tag: tag, payload: 0, nargs: 0, next: 0,
        };
        c.^.nvariant = vi + 1;
        // the payload lays out like a struct, then sits at offset 4 (language.md S4)
        let mut phead: u32 = 0;
        let mut ptail: u32 = 0;
        let mut off: u32 = 0;
        let mut palign: u32 = 1;
        let mut nargs: u32 = 0;
        let mut tn: u32 = c.^.nodes[v].c;
        for tn != 0 && !failed(c) {
            let tline: u32 = c.^.nodes[tn].line;
            let tcol: u32 = c.^.nodes[tn].col;
            let t: u32 = resolve_ty(c, tn);
            check_field_ty(c, t, tline, tcol, 1);
            if failed(c) { return; }
            let a: u32 = align_of(c, t);
            off = align_up(off, a);
            let fi: u32 = new_field(c, 0, t, off + 4);
            if phead == 0 { phead = fi; } else { c.^.fields[ptail].next = fi; }
            ptail = fi;
            off = off + size_of(c, t);
            if a > palign { palign = a; }
            nargs += 1;
            tn = c.^.nodes[tn].next;
        }
        let psize: u32 = align_up(off, palign);
        if psize > slot { slot = psize; }
        c.^.variants[vi].payload = phead;
        c.^.variants[vi].nargs = nargs;
        if head == 0 { head = vi; } else { c.^.variants[tail].next = vi; }
        tail = vi;
        tag += 1;
        v = c.^.nodes[v].next;
    }
    c.^.enums[ei].variants = head;
    c.^.enums[ei].bytes = align_up(4 + slot, 4);
    c.^.enums[ei].nvar = tag;
    c.^.nodes[d].aux = ei;
}

fn e_const_ty(c: &mut Ctx, line: u32, col: u32, t: u32) {
    if err_open(c, line, col) {
        put_str(c, "const must have type i32, u32 or bool, found ");
        put_q_ty(c, t);
        err_end(c);
    }
}

fn declare_const(c: &mut Ctx, d: u32) {
    let tn: u32 = c.^.nodes[d].c;
    let t: u32 = resolve_ty(c, tn);
    if failed(c) { return; }
    let k: u32 = ty_kind(c, t);
    let line: u32 = c.^.nodes[d].line;
    let col: u32 = c.^.nodes[d].col;
    if k != TYK_I32 && k != TYK_U32 && k != TYK_BOOL {
        e_const_ty(c, line, col, t);
        return;
    }
    let ns: u32 = c.^.nodes[d].a;
    let nl: u32 = c.^.nodes[d].b;
    let ci: u32 = c.^.nconst;
    c.^.consts[ci] = ConstI{
        name: ns, ty: t, value: 0, state: 0, decl: d, next: 0,
    };
    c.^.nconst = ci + 1;
    c.^.nodes[d].aux = ci;
}

fn e_const_cycle(c: &mut Ctx, line: u32, col: u32, s: u32) {
    if err_open(c, line, col) {
        put_str(c, "const ");
        put_q_name(c, s);
        put_str(c, " depends on itself");
        err_end(c);
    }
}

fn force_const(c: &mut Ctx, ci: u32, line: u32, col: u32) -> u32 {
    if c.^.consts[ci].state == 2 { return ci; }
    if c.^.consts[ci].state == 1 {
        let ns: u32 = c.^.consts[ci].name;
        e_const_cycle(c, line, col, ns);
        return ci;
    }
    c.^.consts[ci].state = 1;
    let d: u32 = c.^.consts[ci].decl;
    let vn: u32 = c.^.nodes[d].d;
    let t: u32 = c.^.consts[ci].ty;
    let v: u32 = eval_const(c, vn, t);
    c.^.consts[ci].value = v;
    c.^.consts[ci].state = 2;
    return ci;
}

// ===========================================================================
// Constant expressions (language.md S4)
// ===========================================================================

fn e_expected_ty(c: &mut Ctx, line: u32, col: u32, want: u32, got: u32) {
    if err_open(c, line, col) {
        put_str(c, "expected ");
        put_q_ty(c, want);
        put_str(c, ", found ");
        put_q_ty(c, got);
        err_end(c);
    }
}

fn eval_const(c: &mut Ctx, e: u32, want: u32) -> u32 {
    let v: u32 = const_expr(c, e, want);
    if failed(c) { return 0; }
    let mut t: u32 = c.^.cety;
    if ty_kind(c, t) == TYK_INTLIT {
        if is_int_ty(c, want) { t = want; } else { t = TY_I32; }
    }
    if t != want {
        let line: u32 = c.^.nodes[e].line;
        let col: u32 = c.^.nodes[e].col;
        e_expected_ty(c, line, col, want, t);
        return 0;
    }
    return v;
}

fn e_not_const(c: &mut Ctx, line: u32, col: u32, s: u32) {
    if err_open(c, line, col) {
        put_q_name(c, s);
        put_str(c, " is not a constant");
        err_end(c);
    }
}

fn e_cast_from(c: &mut Ctx, line: u32, col: u32, t: u32) {
    if err_open(c, line, col) { put_str(c, "cannot cast from "); put_q_ty(c, t); err_end(c); }
}

fn e_cast_to(c: &mut Ctx, line: u32, col: u32, t: u32) {
    if err_open(c, line, col) { put_str(c, "cannot cast to "); put_q_ty(c, t); err_end(c); }
}

fn e_negate(c: &mut Ctx, line: u32, col: u32, t: u32) {
    if err_open(c, line, col) { put_str(c, "cannot negate "); put_q_ty(c, t); err_end(c); }
}

fn e_not_bool(c: &mut Ctx, line: u32, col: u32, t: u32) {
    if err_open(c, line, col) {
        put_str(c, "cannot apply ");
        put_ch(c, 96);
        put_str(c, "!");
        put_ch(c, 96);
        put_str(c, " to ");
        put_q_ty(c, t);
        err_end(c);
    }
}

fn put_q_punct(c: &mut Ctx, p: Punct) { put_ch(c, 96); put_punct(c, p); put_ch(c, 96); }

fn e_op_bool(c: &mut Ctx, line: u32, col: u32, op: Punct) {
    if err_open(c, line, col) {
        put_q_punct(c, op);
        put_str(c, " requires bool operands");
        err_end(c);
    }
}

fn e_op_int(c: &mut Ctx, line: u32, col: u32, op: Punct) {
    if err_open(c, line, col) {
        put_q_punct(c, op);
        put_str(c, " requires integer operands");
        err_end(c);
    }
}

fn e_const_divzero(c: &mut Ctx, line: u32, col: u32) {
    err_msg(c, line, col, "division by zero in constant expression");
}

fn e_op_not_const(c: &mut Ctx, line: u32, col: u32, op: Punct) {
    if err_open(c, line, col) {
        put_q_punct(c, op);
        put_str(c, " is not allowed in a constant expression");
        err_end(c);
    }
}

fn e_not_const_expr(c: &mut Ctx, line: u32, col: u32) {
    err_msg(c, line, col, "not a constant expression");
}

fn to_signed_lt(a: u32, b: u32) -> bool {
    let x: i32 = a as i32;
    let y: i32 = b as i32;
    return x < y;
}

fn to_signed_gt(a: u32, b: u32) -> bool {
    let x: i32 = a as i32;
    let y: i32 = b as i32;
    return x > y;
}

fn sdiv(a: u32, b: u32) -> u32 {
    // wasm traps on INT_MIN / -1; cool0.py computes it in bignum and wraps
    if a == 0x8000_0000 && b == 0xFFFF_FFFF { return 0x8000_0000; }
    let x: i32 = a as i32;
    let y: i32 = b as i32;
    return (x / y) as u32;
}

fn srem(a: u32, b: u32) -> u32 {
    if a == 0x8000_0000 && b == 0xFFFF_FFFF { return 0; }
    let x: i32 = a as i32;
    let y: i32 = b as i32;
    return (x % y) as u32;
}

fn sshr(a: u32, sh: u32) -> u32 { let x: i32 = a as i32; return (x >> sh) as u32; }

// Returns the value; the type comes back in c.cety.
fn const_expr(c: &mut Ctx, e: u32, want: u32) -> u32 {
    if failed(c) { c.^.cety = TY_I32; return 0; }
    let mut iwant: u32 = 0;
    if want != 0 && is_int_ty(c, want) && ty_kind(c, want) != TYK_INTLIT { iwant = want; }
    let k: NodeKind = c.^.nodes[e].kind;
    let line: u32 = c.^.nodes[e].line;
    let col: u32 = c.^.nodes[e].col;
    let ea: u32 = c.^.nodes[e].a;
    let eb: u32 = c.^.nodes[e].b;

    if k == NodeKind.E_INT { c.^.cety = TY_INTLIT; return ea; }
    if k == NodeKind.E_CHAR { c.^.cety = TY_U32; return ea; }
    if k == NodeKind.E_BOOL { c.^.cety = TY_BOOL; return ea; }
    if k == NodeKind.E_IDENT {
        let ci: u32 = find_const(c, ea);
        if ci != 0 {
            force_const(c, ci, line, col);
            c.^.cety = c.^.consts[ci].ty;
            return c.^.consts[ci].value;
        }
        e_not_const(c, line, col, ea);
        c.^.cety = TY_I32;
        return 0;
    }
    if k == NodeKind.E_CAST {
        let v: u32 = const_expr(c, ea, 0);
        let t: u32 = c.^.cety;
        let dst: u32 = resolve_ty(c, eb);
        if failed(c) { c.^.cety = TY_I32; return 0; }
        if !is_int_ty(c, t) && ty_kind(c, t) != TYK_PTR {
            e_cast_from(c, line, col, t);
            c.^.cety = TY_I32;
            return 0;
        }
        let dk: u32 = ty_kind(c, dst);
        if dk != TYK_I32 && dk != TYK_U32 && dk != TYK_PTR {
            e_cast_to(c, line, col, dst);
            c.^.cety = TY_I32;
            return 0;
        }
        c.^.cety = dst;
        return v;
    }
    if k == NodeKind.E_UNARY {
        let op: Punct = c.^.nodes[e].op;
        let mut sub_want: u32 = TY_BOOL;
        if op == Punct.Sub { sub_want = want; }
        let v: u32 = const_expr(c, eb, sub_want);
        let t: u32 = c.^.cety;
        if failed(c) { c.^.cety = TY_I32; return 0; }
        if op == Punct.Sub {
            if !is_int_ty(c, t) {
                e_negate(c, line, col, t);
                c.^.cety = TY_I32;
                return 0;
            }
            c.^.cety = t;
            return 0 - v;
        }
        if ty_kind(c, t) != TYK_BOOL {
            e_not_bool(c, line, col, t);
            c.^.cety = TY_I32;
            return 0;
        }
        c.^.cety = TY_BOOL;
        return 1 - v;
    }
    if k == NodeKind.E_BINARY {
        let op: Punct = c.^.nodes[e].op;
        let ec: u32 = c.^.nodes[e].c;
        let cmp: bool = is_cmp(op) || op == Punct.AndAnd || op == Punct.OrOr;
        let mut lwant: u32 = want;
        if cmp { lwant = 0; }
        let lv: u32 = const_expr(c, eb, lwant);
        let lt: u32 = c.^.cety;
        let mut rwant: u32 = 0;
        if op == Punct.Shl || op == Punct.Shr {
            rwant = TY_U32;
        } else if cmp {
            rwant = 0;
        } else if ty_kind(c, lt) != TYK_INTLIT {
            rwant = lt;
        } else {
            rwant = want;
        }
        let rv: u32 = const_expr(c, ec, rwant);
        let rt: u32 = c.^.cety;
        if failed(c) { c.^.cety = TY_I32; return 0; }

        if op == Punct.AndAnd || op == Punct.OrOr {
            if ty_kind(c, lt) != TYK_BOOL || ty_kind(c, rt) != TYK_BOOL {
                e_op_bool(c, line, col, op);
                c.^.cety = TY_I32;
                return 0;
            }
            c.^.cety = TY_BOOL;
            if op == Punct.AndAnd {
                if lv != 0 && rv != 0 { return 1; }
                return 0;
            }
            if lv != 0 || rv != 0 { return 1; }
            return 0;
        }
        if op == Punct.Shl || op == Punct.Shr {
            if !is_int_ty(c, lt) || !is_int_ty(c, rt) {
                e_op_int(c, line, col, op);
                c.^.cety = TY_I32;
                return 0;
            }
            // the shift amount is `u32` here for the same reason it is everywhere
            // else (language.md S5) -- a constant is not a weaker position
            if ty_kind(c, rt) != TYK_INTLIT && ty_kind(c, rt) != TYK_U32 {
                let rl: u32 = c.^.nodes[ec].line;
                let rc: u32 = c.^.nodes[ec].col;
                e_expected_ty(c, rl, rc, TY_U32, rt);
                c.^.cety = TY_I32;
                return 0;
            }
            let mut t: u32 = lt;
            if ty_kind(c, lt) == TYK_INTLIT {
                if iwant != 0 { t = iwant; } else { t = TY_I32; }
            }
            let sh: u32 = rv & 31;
            c.^.cety = t;
            if op == Punct.Shl { return lv << sh; }
            if ty_kind(c, t) == TYK_I32 { return sshr(lv, sh); }
            return lv >> sh;
        }
        if !is_int_ty(c, lt) || !is_int_ty(c, rt) {
            if (op == Punct.EqEq || op == Punct.Ne) && ty_kind(c, lt) == TYK_BOOL
                && ty_kind(c, rt) == TYK_BOOL {
                c.^.cety = TY_BOOL;
                if op == Punct.EqEq {
                    if lv == rv { return 1; }
                    return 0;
                }
                if lv != rv { return 1; }
                return 0;
            }
            e_op_int(c, line, col, op);
            c.^.cety = TY_I32;
            return 0;
        }
        // cool0 has no implicit i32/u32 conversion, in a constant either
        // (language.md S3). An unsettled literal takes the other side's type;
        // two settled ones have to already agree.
        if ty_kind(c, lt) != TYK_INTLIT && ty_kind(c, rt) != TYK_INTLIT && lt != rt {
            e_type_mismatch2(c, line, col, op, lt, rt);
            c.^.cety = TY_I32;
            return 0;
        }
        let mut t: u32 = lt;
        if ty_kind(c, lt) == TYK_INTLIT { t = rt; }
        if ty_kind(c, t) == TYK_INTLIT {
            if !cmp && iwant != 0 { t = iwant; } else { t = TY_I32; }
        }
        let signed: bool = ty_kind(c, t) == TYK_I32;
        if is_cmp(op) {
            c.^.cety = TY_BOOL;
            if op == Punct.EqEq { if lv == rv { return 1; } return 0; }
            if op == Punct.Ne { if lv != rv { return 1; } return 0; }
            if signed {
                if op == Punct.Lt { if to_signed_lt(lv, rv) { return 1; } return 0; }
                if op == Punct.Gt { if to_signed_gt(lv, rv) { return 1; } return 0; }
                if op == Punct.Le { if !to_signed_gt(lv, rv) { return 1; } return 0; }
                if !to_signed_lt(lv, rv) { return 1; }
                return 0;
            }
            if op == Punct.Lt { if lv < rv { return 1; } return 0; }
            if op == Punct.Gt { if lv > rv { return 1; } return 0; }
            if op == Punct.Le { if lv <= rv { return 1; } return 0; }
            if lv >= rv { return 1; }
            return 0;
        }
        if (op == Punct.Div || op == Punct.Mod) && rv == 0 {
            e_const_divzero(c, line, col);
            c.^.cety = TY_I32;
            return 0;
        }
        c.^.cety = t;
        if op == Punct.Add { return lv + rv; }
        if op == Punct.Sub { return lv - rv; }
        if op == Punct.Mul { return lv * rv; }
        if op == Punct.Div {
            if signed { return sdiv(lv, rv); }
            return lv / rv;
        }
        if op == Punct.Mod {
            if signed { return srem(lv, rv); }
            return lv % rv;
        }
        if op == Punct.And { return lv & rv; }
        if op == Punct.Or { return lv | rv; }
        if op == Punct.Xor { return lv ^ rv; }
        e_op_not_const(c, line, col, op);
        c.^.cety = TY_I32;
        return 0;
    }
    e_not_const_expr(c, line, col);
    c.^.cety = TY_I32;
    return 0;
}

// ===========================================================================
// Function declarations (language.md S4)
// ===========================================================================

fn e_dup_param(c: &mut Ctx, line: u32, col: u32, s: u32) {
    if err_open(c, line, col) {
        put_str(c, "duplicate parameter ");
        put_q_name(c, s);
        err_end(c);
    }
}

fn e_agg_by_value(c: &mut Ctx, line: u32, col: u32, t: u32) {
    if err_open(c, line, col) {
        put_str(c, "cannot pass aggregate ");
        put_q_ty(c, t);
        put_str(c, " by value");
        err_end(c);
    }
}

fn e_u8_storage(c: &mut Ctx, line: u32, col: u32) {
    if err_open(c, line, col) {
        put_ch(c, 96);
        put_str(c, "u8");
        put_ch(c, 96);
        put_str(c, " is storage-only; use ");
        put_ch(c, 96);
        put_str(c, "u32");
        put_ch(c, 96);
        err_end(c);
    }
}

fn e_ret_agg(c: &mut Ctx, line: u32, col: u32, t: u32) {
    if err_open(c, line, col) {
        put_str(c, "cannot return aggregate ");
        put_q_ty(c, t);
        put_str(c, " by value");
        err_end(c);
    }
}

fn param_named(c: &Ctx, head: u32, s: u32) -> u32 {
    let mut p: u32 = head;
    for p != 0 {
        let ns: u32 = c.^.params[p].name;
        if ns == s { return p; }
        p = c.^.params[p].next;
    }
    return 0;
}

fn declare_fn(c: &mut Ctx, d: u32, index: u32) {
    let ns: u32 = c.^.nodes[d].a;
    let nl: u32 = c.^.nodes[d].b;
    let fi: u32 = c.^.nfn;
    c.^.fns[fi] = FnI{
        name: ns, params: 0, nparams: 0, ret: 0, index: index, decl: d,
        locals: 0, ltail: 0, frame: 0, npslot: 0, nlslot: 0, next: 0,
    };
    c.^.nfn = fi + 1;
    let mut head: u32 = 0;
    let mut tail: u32 = 0;
    let mut n: u32 = 0;
    let mut p: u32 = c.^.nodes[d].c;
    for p != 0 && !failed(c) {
        let ps: u32 = c.^.nodes[p].a;
        let pl: u32 = c.^.nodes[p].b;
        let pline: u32 = c.^.nodes[p].line;
        let pcol: u32 = c.^.nodes[p].col;
        if param_named(c, head, ps) != 0 {
            e_dup_param(c, pline, pcol, ps);
            return;
        }
        let ptn: u32 = c.^.nodes[p].c;
        let t: u32 = resolve_ty(c, ptn);
        if failed(c) { return; }
        if is_aggregate(c, t) {
            e_agg_by_value(c, pline, pcol, t);
            return;
        }
        if ty_kind(c, t) == TYK_U8 {
            e_u8_storage(c, pline, pcol);
            return;
        }
        let pi: u32 = c.^.nparam;
        c.^.params[pi] = ParamI{ name: ps, ty: t, next: 0 };
        c.^.nparam = pi + 1;
        if head == 0 { head = pi; } else { c.^.params[tail].next = pi; }
        tail = pi;
        n += 1;
        p = c.^.nodes[p].next;
    }
    c.^.fns[fi].params = head;
    c.^.fns[fi].nparams = n;
    let rn: u32 = c.^.nodes[d].d;
    let ret: u32 = resolve_ty(c, rn);
    if failed(c) { return; }
    if rn != 0 {
        let rl: u32 = c.^.nodes[rn].line;
        let rc: u32 = c.^.nodes[rn].col;
        if is_aggregate(c, ret) { e_ret_agg(c, rl, rc, ret); return; }
        let rk: u32 = ty_kind(c, ret);
        if rk == TYK_SLICE {
            err_msg(c, rl, rc, "cannot return a slice (wasm 1.0 has a single result)");
            return;
        }
        if rk == TYK_REF { err_msg(c, rl, rc, "cannot return a borrow"); return; }
        if rk == TYK_U8 { e_u8_storage(c, rl, rc); return; }
    }
    c.^.fns[fi].ret = ret;
    c.^.nodes[d].aux = fi;
}

// --- scopes ----------------------------------------------------------------

fn push_scope(c: &mut Ctx) {
    let m: u32 = c.^.marks_n;
    c.^.marks[m] = c.^.scope_n;
    c.^.marks_n = m + 1;
}

fn pop_scope(c: &mut Ctx) {
    let m: u32 = c.^.marks_n - 1;
    c.^.marks_n = m;
    c.^.scope_n = c.^.marks[m];
}

fn lookup(c: &Ctx, s: u32) -> u32 {
    let mut i: u32 = c.^.scope_n;
    for i > 0 {
        i -= 1;
        let loc: u32 = c.^.scope[i];
        let ns: u32 = c.^.locals[loc].name;
        if ns == s { return loc; }
    }
    return 0;
}

fn lookup_in_scope(c: &Ctx, s: u32) -> u32 {
    let base: u32 = c.^.marks[c.^.marks_n - 1];
    let mut i: u32 = c.^.scope_n;
    for i > base {
        i -= 1;
        let loc: u32 = c.^.scope[i];
        let ns: u32 = c.^.locals[loc].name;
        if ns == s { return loc; }
    }
    return 0;
}

fn e_dup_local(c: &mut Ctx, line: u32, col: u32, s: u32) {
    if err_open(c, line, col) {
        put_q_name(c, s);
        put_str(c, " is already declared in this scope");
        err_end(c);
    }
}

fn e_shadow(c: &mut Ctx, line: u32, col: u32, s: u32) {
    if err_open(c, line, col) {
        put_q_name(c, s);
        put_str(c, " shadows a top-level name");
        err_end(c);
    }
}

fn declare_local(c: &mut Ctx, s: u32, t: u32, mutable: u32, is_param: u32, line: u32, col: u32) -> u32 {
    if lookup_in_scope(c, s) != 0 {
        e_dup_local(c, line, col, s);
        return 0;
    }
    if find_taken(c, s) {
        e_shadow(c, line, col, s);
        return 0;
    }
    let loc: u32 = c.^.nlocal;
    c.^.locals[loc] = LocalI{
        name: s, ty: t, is_mut: mutable, is_param: is_param,
        addr: 0, slot: NONE, foff: NONE, next: 0,
    };
    c.^.nlocal = loc + 1;
    let sn: u32 = c.^.scope_n;
    c.^.scope[sn] = loc;
    c.^.scope_n = sn + 1;
    let fi: u32 = c.^.curfn;
    if c.^.fns[fi].locals == 0 {
        c.^.fns[fi].locals = loc;
    } else {
        let lt: u32 = c.^.fns[fi].ltail;
        c.^.locals[lt].next = loc;
    }
    c.^.fns[fi].ltail = loc;
    return loc;
}

// --- flow analysis (language.md S9) ----------------------------------------

fn has_break(c: &Ctx, head: u32) -> bool {
    let mut s: u32 = head;
    for s != 0 {
        let k: NodeKind = c.^.nodes[s].kind;
        if k == NodeKind.S_BREAK { return true; }
        if k == NodeKind.S_IF {
            if has_break(c, c.^.nodes[s].b) { return true; }
            if c.^.nodes[s].d != 0 && has_break(c, c.^.nodes[s].c) { return true; }
        }
        if k == NodeKind.S_MATCH {
            let mut a: u32 = c.^.nodes[s].b;
            for a != 0 {
                if has_break(c, c.^.nodes[a].d) { return true; }
                a = c.^.nodes[a].next;
            }
        }
        if k == NodeKind.S_UNSAFE {
            if has_break(c, c.^.nodes[s].a) { return true; }
        }
        s = c.^.nodes[s].next;
    }
    return false;
}

fn arms_all_diverge(c: &Ctx, head: u32) -> bool {
    let mut a: u32 = head;
    for a != 0 {
        if !diverges(c, c.^.nodes[a].d) { return false; }
        a = c.^.nodes[a].next;
    }
    return true;
}

// How many variants the arms name in total -- `A | B` covers two.
fn covered_count(c: &Ctx, head: u32) -> u32 {
    let mut n: u32 = 0;
    let mut a: u32 = head;
    for a != 0 {
        if c.^.nodes[a].e == 0 {
            n += 1;
            let mut alt: u32 = c.^.nodes[a].aux2;
            for alt != 0 {
                n += 1;
                alt = c.^.nodes[alt].next;
            }
        }
        a = c.^.nodes[a].next;
    }
    return n;
}

fn arm_count(c: &Ctx, head: u32) -> u32 {
    let mut n: u32 = 0;
    let mut a: u32 = head;
    for a != 0 {
        n += 1;
        a = c.^.nodes[a].next;
    }
    return n;
}

fn diverges(c: &Ctx, head: u32) -> bool {
    let mut s: u32 = head;
    for s != 0 {
        let k: NodeKind = c.^.nodes[s].kind;
        if k == NodeKind.S_RETURN || k == NodeKind.S_BREAK || k == NodeKind.S_CONTINUE { return true; }
        if k == NodeKind.S_IF {
            if c.^.nodes[s].d != 0 && diverges(c, c.^.nodes[s].b)
                && diverges(c, c.^.nodes[s].c) {
                return true;
            }
        }
        if k == NodeKind.S_FOR {
            if c.^.nodes[s].b == 0 && !has_break(c, c.^.nodes[s].d) { return true; }
        }
        if k == NodeKind.S_MATCH {
            let ei: u32 = c.^.nodes[s].c;
            let arms: u32 = c.^.nodes[s].b;
            let mut full: bool = c.^.nodes[s].d != 0;
            if !full && ei != 0 {
                full = covered_count(c, arms) == c.^.enums[ei].nvar;
            }
            if full && arms_all_diverge(c, arms) { return true; }
        }
        if k == NodeKind.S_UNSAFE {
            if diverges(c, c.^.nodes[s].a) { return true; }
        }
        s = c.^.nodes[s].next;
    }
    return false;
}

// ===========================================================================
// Checking a function body
// ===========================================================================

fn e_missing_return(c: &mut Ctx, line: u32, col: u32, s: u32) {
    if err_open(c, line, col) {
        put_str(c, "function ");
        put_q_name(c, s);
        put_str(c, " must return a value on every path");
        err_end(c);
    }
}

fn check_fn(c: &mut Ctx, fi: u32) {
    let d: u32 = c.^.fns[fi].decl;
    c.^.curfn = fi;
    c.^.scope_n = 0;
    c.^.marks_n = 0;
    c.^.loopd = 0;
    c.^.unsafed = 0;
    push_scope(c);
    let mut p: u32 = c.^.nodes[d].c;
    let mut pi: u32 = c.^.fns[fi].params;
    for p != 0 && pi != 0 && !failed(c) {
        let ps: u32 = c.^.nodes[p].a;
        let pl: u32 = c.^.nodes[p].b;
        let pline: u32 = c.^.nodes[p].line;
        let pcol: u32 = c.^.nodes[p].col;
        let pt: u32 = c.^.params[pi].ty;
        let loc: u32 = declare_local(c, ps, pt, 0, 1, pline, pcol);
        c.^.nodes[p].aux = loc;
        p = c.^.nodes[p].next;
        pi = c.^.params[pi].next;
    }
    let body: u32 = c.^.nodes[d].e;
    check_block(c, body);
    if failed(c) { return; }
    let ret: u32 = c.^.fns[fi].ret;
    if ty_kind(c, ret) != TYK_VOID && !diverges(c, body) {
        let dl: u32 = c.^.nodes[d].line;
        let dc: u32 = c.^.nodes[d].col;
        let ns: u32 = c.^.nodes[d].a;
        let nl: u32 = c.^.nodes[d].b;
        e_missing_return(c, dl, dc, ns);
        return;
    }
    pop_scope(c);
}

fn check_block(c: &mut Ctx, head: u32) {
    push_scope(c);
    let mut s: u32 = head;
    for s != 0 && !failed(c) {
        check_stmt(c, s);
        s = c.^.nodes[s].next;
    }
    pop_scope(c);
}

fn e_immutable_place(c: &mut Ctx, line: u32, col: u32) {
    err_msg(c, line, col, "cannot assign to an immutable place");
}

fn e_op_needs_int(c: &mut Ctx, line: u32, col: u32, op: Punct, t: u32) {
    if err_open(c, line, col) {
        put_q_punct(c, op);
        put_str(c, " requires an integer, found ");
        put_q_ty(c, t);
        err_end(c);
    }
}

fn e_no_value(c: &mut Ctx, line: u32, col: u32, t: u32) {
    if err_open(c, line, col) {
        put_str(c, "expected ");
        put_q_ty(c, t);
        put_str(c, ", found no value");
        err_end(c);
    }
}

fn e_u8_local(c: &mut Ctx, line: u32, col: u32) {
    if err_open(c, line, col) {
        put_ch(c, 96);
        put_str(c, "u8");
        put_ch(c, 96);
        put_str(c, " is storage-only; there are no u8 locals");
        err_end(c);
    }
}

fn check_local_ty(c: &mut Ctx, t: u32, line: u32, col: u32) {
    let k: u32 = ty_kind(c, t);
    if k == TYK_U8 { e_u8_local(c, line, col); return; }
    if k == TYK_REF {
        err_msg(c, line, col, "a borrow cannot be bound to a local");
        return;
    }
    if k == TYK_VOID {
        if err_open(c, line, col) {
            put_str(c, "local cannot have type ");
            put_ch(c, 96);
            put_str(c, "void");
            put_ch(c, 96);
            err_end(c);
        }
    }
}

// the base operator behind a compound assignment
fn assign_base_op(p: Punct) -> Punct {
    return match p {
        AddEq => Punct.Add,
        SubEq => Punct.Sub,
        MulEq => Punct.Mul,
        DivEq => Punct.Div,
        ModEq => Punct.Mod,
        AndEq => Punct.And,
        OrEq => Punct.Or,
        XorEq => Punct.Xor,
        ShlEq => Punct.Shl,
        _ => Punct.Shr,
    };
}

fn check_stmt(c: &mut Ctx, s: u32) {
    if failed(c) { return; }
    let k: NodeKind = c.^.nodes[s].kind;
    let line: u32 = c.^.nodes[s].line;
    let col: u32 = c.^.nodes[s].col;
    let sa: u32 = c.^.nodes[s].a;
    let sb: u32 = c.^.nodes[s].b;
    let sc: u32 = c.^.nodes[s].c;
    let sd: u32 = c.^.nodes[s].d;

    if k == NodeKind.S_LET {
        let tn: u32 = sc;
        let mut declared: u32 = 0;
        if tn != 0 {
            declared = resolve_ty(c, tn);
            if failed(c) { return; }
            check_local_ty(c, declared, line, col);
            if failed(c) { return; }
        }
        let mut t: u32 = check_init(c, sd, declared);
        if failed(c) { return; }
        if declared == 0 {
            if ty_kind(c, t) == TYK_INTLIT {
                t = TY_I32;
                retype(c, sd, t);
            }
            check_local_ty(c, t, line, col);
            if failed(c) { return; }
        } else {
            t = declared;
        }
        let se: u32 = c.^.nodes[s].e;
        let loc: u32 = declare_local(c, sa, t, se, 0, line, col);
        c.^.nodes[s].aux = loc;
        return;
    }

    if k == NodeKind.S_ASSIGN {
        let ty: u32 = check_place(c, sa);
        if failed(c) { return; }
        if c.^.place_mut == 0 { e_immutable_place(c, line, col); return; }
        let want: u32 = read_ty(c, ty);
        let op: Punct = c.^.nodes[s].op;
        if op == Punct.Eq {
            check_init(c, sc, want);
            return;
        }
        let base: Punct = assign_base_op(op);
        if base == Punct.Shl || base == Punct.Shr {
            if !is_int_ty(c, want) { e_op_needs_int(c, line, col, base, want); return; }
            coerce(c, sc, TY_U32);
            return;
        }
        coerce(c, sc, want);
        if failed(c) { return; }
        check_binop_types(c, line, col, base, want, want);
        return;
    }

    if k == NodeKind.S_EXPR {
        let t: u32 = check_expr(c, sa, 0);
        if failed(c) { return; }
        if ty_kind(c, t) != TYK_VOID { c.^.nodes[s].aux = 1; }
        return;
    }

    if k == NodeKind.S_IF {
        coerce(c, sa, TY_BOOL);
        if failed(c) { return; }
        check_block(c, sb);
        if sd != 0 { check_block(c, sc); }
        return;
    }

    if k == NodeKind.S_FOR {
        push_scope(c);
        if sa != 0 { check_stmt(c, sa); }
        if sb != 0 { coerce(c, sb, TY_BOOL); }
        c.^.loopd = c.^.loopd + 1;
        check_block(c, sd);
        if sc != 0 { check_stmt(c, sc); }
        c.^.loopd = c.^.loopd - 1;
        pop_scope(c);
        return;
    }

    if k == NodeKind.S_BREAK || k == NodeKind.S_CONTINUE {
        if c.^.loopd == 0 {
            if err_open(c, line, col) {
                put_ch(c, 96);
                if k == NodeKind.S_BREAK { put_str(c, "break"); } else { put_str(c, "continue"); }
                put_ch(c, 96);
                put_str(c, " outside of a loop");
                err_end(c);
            }
        }
        return;
    }

    if k == NodeKind.S_RETURN {
        let fi: u32 = c.^.curfn;
        let ret: u32 = c.^.fns[fi].ret;
        if sa == 0 {
            if ty_kind(c, ret) != TYK_VOID { e_no_value(c, line, col, ret); }
            return;
        }
        if ty_kind(c, ret) == TYK_VOID {
            err_msg(c, line, col, "function has no return type");
            return;
        }
        coerce(c, sa, ret);
        return;
    }

    if k == NodeKind.S_MATCH { check_match(c, s); return; }

    if k == NodeKind.S_UNSAFE {
        c.^.unsafed = c.^.unsafed + 1;
        check_block(c, sa);
        c.^.unsafed = c.^.unsafed - 1;
        return;
    }
}

// ===========================================================================
// match (language.md S6)
// ===========================================================================

fn e_match_needs_enum(c: &mut Ctx, line: u32, col: u32, t: u32) {
    if err_open(c, line, col) {
        put_ch(c, 96);
        put_str(c, "match");
        put_ch(c, 96);
        put_str(c, " requires an enum, found ");
        put_q_ty(c, t);
        err_end(c);
    }
}

fn e_no_variant(c: &mut Ctx, line: u32, col: u32, ens: u32, vs: u32) {
    if err_open(c, line, col) {
        put_q_name(c, ens);
        put_str(c, " has no variant ");
        put_q_name(c, vs);
        err_end(c);
    }
}

fn e_dup_arm(c: &mut Ctx, line: u32, col: u32, s: u32) {
    if err_open(c, line, col) {
        put_str(c, "duplicate arm for ");
        put_q_name(c, s);
        err_end(c);
    }
}

fn e_bind_arity(c: &mut Ctx, line: u32, col: u32, s: u32, want: u32, got: u32) {
    if err_open(c, line, col) {
        put_str(c, "variant ");
        put_q_name(c, s);
        put_str(c, " takes ");
        put_num(c, want);
        put_str(c, " binding(s), found ");
        put_num(c, got);
        err_end(c);
    }
}

fn e_nonexhaustive(c: &mut Ctx, line: u32, col: u32, s: u32) {
    if err_open(c, line, col) {
        put_str(c, "non-exhaustive match: missing ");
        put_q_name(c, s);
        err_end(c);
    }
}

fn find_variant(c: &Ctx, ei: u32, s: u32) -> u32 {
    let mut v: u32 = c.^.enums[ei].variants;
    for v != 0 {
        let ns: u32 = c.^.variants[v].name;
        if ns == s { return v; }
        v = c.^.variants[v].next;
    }
    return 0;
}

fn arm_for_variant(c: &Ctx, head: u32, s: u32) -> u32 {
    return arm_covers(c, head, s);
}

// Which arm names this variant, counting the tail of `A | B` too.
fn arm_covers(c: &Ctx, head: u32, s: u32) -> u32 {
    let mut a: u32 = head;
    for a != 0 {
        if c.^.nodes[a].e == 0 {
            let ns: u32 = c.^.nodes[a].a;
            if ns == s { return a; }
            let mut alt: u32 = c.^.nodes[a].aux2;
            for alt != 0 {
                let als: u32 = c.^.nodes[alt].a;
                if als == s { return a; }
                alt = c.^.nodes[alt].next;
            }
        }
        a = c.^.nodes[a].next;
    }
    return 0;
}

fn list_len(c: &Ctx, head: u32) -> u32 {
    let mut n: u32 = 0;
    let mut p: u32 = head;
    for p != 0 {
        n += 1;
        p = c.^.nodes[p].next;
    }
    return n;
}

// Checks the scrutinee and the shape of every arm (variants, `|`, binding
// arity, exhaustiveness) but not the arm bodies -- a statement match and an
// expression match check those differently (language.md S5, S6, S9), and
// completeness is required of both, with no exception.
fn check_match_common(c: &mut Ctx, s: u32) {
    let scr: u32 = c.^.nodes[s].a;
    // One look. An aggregate enum cannot be returned (language.md S3), so an
    // expression of that type is always a place and check_expr fills in
    // everything emit_addr needs.
    let ty: u32 = check_expr(c, scr, 0);
    if failed(c) { return; }
    let line: u32 = c.^.nodes[s].line;
    let col: u32 = c.^.nodes[s].col;
    if ty_kind(c, ty) != TYK_NAMED {
        e_match_needs_enum(c, line, col, ty);
        return;
    }
    let ei: u32 = agg_enum(c, ty);
    if ei == 0 {
        e_match_needs_enum(c, line, col, ty);
        return;
    }
    c.^.nodes[s].c = ei;
    c.^.nodes[s].aux2 = c.^.enums[ei].scalar;
    let head: u32 = c.^.nodes[s].b;
    let mut wild: u32 = 0;
    let mut seen: u32 = 0;
    let mut a: u32 = head;
    for a != 0 && !failed(c) {
        let al: u32 = c.^.nodes[a].line;
        let ac: u32 = c.^.nodes[a].col;
        let ans: u32 = c.^.nodes[a].a;
        let anl: u32 = c.^.nodes[a].b;
        if c.^.nodes[a].e != 0 {
            if c.^.nodes[a].next != 0 {
                if err_open(c, al, ac) {
                    put_ch(c, 96);
                    put_str(c, "_");
                    put_ch(c, 96);
                    put_str(c, " must be the last arm");
                    err_end(c);
                }
                return;
            }
            wild = 1;
            a = c.^.nodes[a].next;
            continue;
        }
        let v: u32 = find_variant(c, ei, ans);
        if v == 0 {
            let ens: u32 = c.^.enums[ei].name;
            e_no_variant(c, al, ac, ens, ans);
            return;
        }
        if arm_for_variant(c, head, ans) != a {
            e_dup_arm(c, al, ac, ans);
            return;
        }
        c.^.nodes[a].aux = v;
        let mut alt: u32 = c.^.nodes[a].aux2;
        for alt != 0 && !failed(c) {
            let als: u32 = c.^.nodes[alt].a;
            let all: u32 = c.^.nodes[alt].b;
            let av: u32 = find_variant(c, ei, als);
            if av == 0 {
                let ens2: u32 = c.^.enums[ei].name;
                e_no_variant(c, al, ac, ens2, als);
                return;
            }
            if arm_covers(c, head, als) != a {
                e_dup_arm(c, al, ac, als);
                return;
            }
            if c.^.variants[av].nargs != 0 {
                if err_open(c, al, ac) {
                    put_ch(c, 96);
                    put_str(c, "|");
                    put_ch(c, 96);
                    put_str(c, " cannot join ");
                    put_q_name(c, als);
                    put_str(c, ", which carries a payload");
                    err_end(c);
                }
                return;
            }
            c.^.nodes[alt].aux = av;
            seen += 1;
            alt = c.^.nodes[alt].next;
        }
        if c.^.nodes[a].aux2 != 0 && c.^.variants[v].nargs != 0 {
            if err_open(c, al, ac) {
                put_ch(c, 96);
                put_str(c, "|");
                put_ch(c, 96);
                put_str(c, " cannot join ");
                put_q_name(c, ans);
                put_str(c, ", which carries a payload");
                err_end(c);
            }
            return;
        }
        let binds: u32 = c.^.nodes[a].c;
        let nb: u32 = list_len(c, binds);
        let nargs: u32 = c.^.variants[v].nargs;
        if nb != nargs {
            e_bind_arity(c, al, ac, ans, nargs, nb);
            return;
        }
        seen += 1;
        a = c.^.nodes[a].next;
    }
    if failed(c) { return; }
    if wild == 0 && seen != c.^.enums[ei].nvar {
        let mut v: u32 = c.^.enums[ei].variants;
        for v != 0 {
            let vs: u32 = c.^.variants[v].name;
            if arm_for_variant(c, head, vs) == 0 {
                e_nonexhaustive(c, line, col, vs);
                return;
            }
            v = c.^.variants[v].next;
        }
    }
    c.^.nodes[s].d = wild;
}

// Declares this arm's bindings as locals in the scope the caller just pushed.
fn bind_arm(c: &mut Ctx, a: u32) {
    let v: u32 = c.^.nodes[a].aux;
    if v == 0 { return; }
    let mut b: u32 = c.^.nodes[a].c;
    let mut f: u32 = c.^.variants[v].payload;
    for b != 0 {
        let bs: u32 = c.^.nodes[b].a;
        let bl: u32 = c.^.nodes[b].b;
        let bline: u32 = c.^.nodes[b].line;
        let bcol: u32 = c.^.nodes[b].col;
        let ft: u32 = c.^.fields[f].ty;
        let bt: u32 = read_ty(c, ft);
        let loc: u32 = declare_local(c, bs, bt, 0, 0, bline, bcol);
        c.^.nodes[b].aux = loc;
        b = c.^.nodes[b].next;
        f = c.^.fields[f].next;
    }
}

fn check_match(c: &mut Ctx, s: u32) {
    check_match_common(c, s);
    if failed(c) { return; }
    let mut a: u32 = c.^.nodes[s].b;
    for a != 0 && !failed(c) {
        push_scope(c);
        bind_arm(c, a);
        let ad: u32 = c.^.nodes[a].d;
        check_block(c, ad);
        pop_scope(c);
        a = c.^.nodes[a].next;
    }
}

fn e_match_slice(c: &mut Ctx, line: u32, col: u32) {
    err_msg(c, line, col,
        "match expression cannot produce a slice (wasm 1.0 has a single result)");
}

fn e_match_agg(c: &mut Ctx, line: u32, col: u32, t: u32) {
    if err_open(c, line, col) {
        put_str(c, "match expression cannot produce aggregate ");
        put_q_ty(c, t);
        err_end(c);
    }
}

// The expression form (language.md S5). Every arm must yield the same type,
// with an unsettled integer literal taking whatever the other arms (or the
// caller's `want`) settle on -- the same rule `coerce` uses everywhere else.
fn check_match_expr(c: &mut Ctx, s: u32, want: u32) -> u32 {
    check_match_common(c, s);
    if failed(c) { return TY_I32; }
    let mut result: u32 = want;
    let mut a: u32 = c.^.nodes[s].b;
    for a != 0 && !failed(c) {
        push_scope(c);
        bind_arm(c, a);
        let value: u32 = c.^.nodes[a].d;
        let vt: u32 = check_expr(c, value, result);
        pop_scope(c);
        c.^.nodes[a].ty = vt;
        if result == 0 && ty_kind(c, vt) != TYK_INTLIT { result = vt; }
        a = c.^.nodes[a].next;
    }
    if failed(c) { return TY_I32; }
    if result == 0 { return TY_INTLIT; }
    let line: u32 = c.^.nodes[s].line;
    let col: u32 = c.^.nodes[s].col;
    if ty_kind(c, result) == TYK_SLICE { e_match_slice(c, line, col); return TY_I32; }
    if is_aggregate(c, result) { e_match_agg(c, line, col, result); return TY_I32; }
    a = c.^.nodes[s].b;
    for a != 0 && !failed(c) {
        let value: u32 = c.^.nodes[a].d;
        let vt: u32 = c.^.nodes[a].ty;
        if ty_kind(c, vt) == TYK_INTLIT && is_int_ty(c, result) {
            retype(c, value, result);
        } else if ty_kind(c, vt) != TYK_INTLIT && compatible(c, vt, result) {
            // already the right type
        } else {
            let vline: u32 = c.^.nodes[value].line;
            let vcol: u32 = c.^.nodes[value].col;
            e_expected_ty(c, vline, vcol, result, vt);
        }
        a = c.^.nodes[a].next;
    }
    if failed(c) { return TY_I32; }
    return result;
}

// ===========================================================================
// Initializers
// ===========================================================================

// `E.A` where E is a scalar enum. Returns the variant, or 0. A scalar enum's
// literal is one tag, so it is a value and belongs anywhere a value does.
fn scalar_enum_lit(c: &Ctx, e: u32) -> u32 {
    if c.^.nodes[e].kind != NodeKind.E_FIELD { return 0; }
    let base: u32 = c.^.nodes[e].a;
    if c.^.nodes[base].kind != NodeKind.E_IDENT { return 0; }
    let bs: u32 = c.^.nodes[base].a;
    let bl: u32 = c.^.nodes[base].b;
    let ei: u32 = find_enum(c, bs);
    if ei == 0 { return 0; }
    if c.^.enums[ei].scalar == 0 { return 0; }
    let vs: u32 = c.^.nodes[e].b;
    let vl: u32 = c.^.nodes[e].c;
    return find_variant(c, ei, vs);
}

fn scalar_enum_lit_enum(c: &Ctx, e: u32) -> u32 {
    let base: u32 = c.^.nodes[e].a;
    let bs: u32 = c.^.nodes[base].a;
    let bl: u32 = c.^.nodes[base].b;
    return find_enum(c, bs);
}

fn is_enum_lit(c: &Ctx, e: u32) -> bool {
    let mut b: u32 = e;
    if c.^.nodes[e].kind == NodeKind.E_CALL { b = c.^.nodes[e].a; }
    if c.^.nodes[b].kind != NodeKind.E_FIELD { return false; }
    let base: u32 = c.^.nodes[b].a;
    if c.^.nodes[base].kind != NodeKind.E_IDENT { return false; }
    let s: u32 = c.^.nodes[base].a;
    let l: u32 = c.^.nodes[base].b;
    return find_enum(c, s) != 0;
}

fn e_copy_agg(c: &mut Ctx, line: u32, col: u32, t: u32) {
    if err_open(c, line, col) {
        put_str(c, "cannot copy aggregate ");
        put_q_ty(c, t);
        err_end(c);
    }
}

fn check_init(c: &mut Ctx, e: u32, want: u32) -> u32 {
    if failed(c) { return TY_I32; }
    if scalar_enum_lit(c, e) != 0 {
        if want != 0 { return coerce(c, e, want); }
        return check_expr(c, e, 0);
    }
    if c.^.nodes[e].kind == NodeKind.E_STRUCTLIT { return check_struct_lit(c, e, want); }
    if is_enum_lit(c, e) { return check_enum_lit(c, e, want); }
    if want != 0 && !is_aggregate(c, want) { return coerce(c, e, want); }
    let t: u32 = check_expr(c, e, want);
    if failed(c) { return TY_I32; }
    let line: u32 = c.^.nodes[e].line;
    let col: u32 = c.^.nodes[e].col;
    if is_aggregate(c, t) {
        e_copy_agg(c, line, col, t);
        return TY_I32;
    }
    if want != 0 && t != want {
        e_expected_ty(c, line, col, want, t);
        return TY_I32;
    }
    return t;
}

fn e_unknown_struct(c: &mut Ctx, line: u32, col: u32, s: u32) {
    if err_open(c, line, col) {
        put_str(c, "unknown struct ");
        put_q_name(c, s);
        err_end(c);
    }
}

fn e_field_count(c: &mut Ctx, line: u32, col: u32, s: u32, n: u32) {
    if err_open(c, line, col) {
        put_q_name(c, s);
        put_str(c, " has ");
        put_num(c, n);
        put_str(c, " field(s)");
        err_end(c);
    }
}

fn e_field_order(c: &mut Ctx, line: u32, col: u32, ws: u32, gs: u32) {
    if err_open(c, line, col) {
        put_str(c, "expected field ");
        put_q_name(c, ws);
        put_str(c, ", found ");
        put_q_name(c, gs);
        err_end(c);
    }
}

fn fi_count(c: &Ctx, head: u32) -> u32 {
    let mut n: u32 = 0;
    let mut p: u32 = head;
    for p != 0 {
        n += 1;
        p = c.^.fields[p].next;
    }
    return n;
}

fn check_struct_lit(c: &mut Ctx, e: u32, want: u32) -> u32 {
    let line: u32 = c.^.nodes[e].line;
    let col: u32 = c.^.nodes[e].col;
    let ns: u32 = c.^.nodes[e].a;
    let nl: u32 = c.^.nodes[e].b;
    let si: u32 = find_struct(c, ns);
    if si == 0 {
        e_unknown_struct(c, line, col, ns);
        return TY_I32;
    }
    let self_ty: u32 = ty_named(c, ns);
    if want != 0 && want != self_ty {
        if err_open(c, line, col) {
            put_str(c, "expected ");
            put_q_ty(c, want);
            put_str(c, ", found ");
            put_q_name(c, ns);
            err_end(c);
        }
        return TY_I32;
    }
    let fhead: u32 = c.^.structs[si].fields;
    let nf: u32 = fi_count(c, fhead);
    let lits: u32 = c.^.nodes[e].c;
    if list_len(c, lits) != nf {
        e_field_count(c, line, col, ns, nf);
        return TY_I32;
    }
    let mut lf: u32 = lits;
    let mut f: u32 = fhead;
    for lf != 0 && !failed(c) {
        let ls: u32 = c.^.nodes[lf].a;
        let fs: u32 = c.^.fields[f].name;
        if ls != fs {
            let lline: u32 = c.^.nodes[lf].line;
            let lcol: u32 = c.^.nodes[lf].col;
            e_field_order(c, lline, lcol, fs, ls);
            return TY_I32;
        }
        let ft: u32 = c.^.fields[f].ty;
        let v: u32 = c.^.nodes[lf].c;
        let rt: u32 = read_ty(c, ft);
        coerce(c, v, rt);
        lf = c.^.nodes[lf].next;
        f = c.^.fields[f].next;
    }
    c.^.nodes[e].d = si;
    c.^.nodes[e].ty = self_ty;
    return self_ty;
}

fn e_variant_arity(c: &mut Ctx, line: u32, col: u32, s: u32, n: u32) {
    if err_open(c, line, col) {
        put_str(c, "variant ");
        put_q_name(c, s);
        put_str(c, " takes ");
        put_num(c, n);
        put_str(c, " value(s)");
        err_end(c);
    }
}

fn check_enum_lit(c: &mut Ctx, e: u32, want: u32) -> u32 {
    let line: u32 = c.^.nodes[e].line;
    let col: u32 = c.^.nodes[e].col;
    let mut fld: u32 = e;
    let mut args: u32 = 0;
    if c.^.nodes[e].kind == NodeKind.E_CALL {
        fld = c.^.nodes[e].a;
        args = c.^.nodes[e].b;
    }
    let base: u32 = c.^.nodes[fld].a;
    let bs: u32 = c.^.nodes[base].a;
    let bl: u32 = c.^.nodes[base].b;
    let ei: u32 = find_enum(c, bs);
    let vs: u32 = c.^.nodes[fld].b;
    let vl: u32 = c.^.nodes[fld].c;
    let v: u32 = find_variant(c, ei, vs);
    let ens: u32 = c.^.enums[ei].name;
    if v == 0 {
        let fline: u32 = c.^.nodes[fld].line;
        let fcol: u32 = c.^.nodes[fld].col;
        e_no_variant(c, fline, fcol, ens, vs);
        return TY_I32;
    }
    let nargs: u32 = c.^.variants[v].nargs;
    if list_len(c, args) != nargs {
        let vns: u32 = c.^.variants[v].name;
        e_variant_arity(c, line, col, vns, nargs);
        return TY_I32;
    }
    let self_ty: u32 = ty_named(c, ens);
    if want != 0 && want != self_ty {
        if err_open(c, line, col) {
            put_str(c, "expected ");
            put_q_ty(c, want);
            put_str(c, ", found ");
            put_q_name(c, ens);
            err_end(c);
        }
        return TY_I32;
    }
    let mut a: u32 = args;
    let mut f: u32 = c.^.variants[v].payload;
    for a != 0 && !failed(c) {
        let ft: u32 = c.^.fields[f].ty;
        let rt: u32 = read_ty(c, ft);
        coerce(c, a, rt);
        a = c.^.nodes[a].next;
        f = c.^.fields[f].next;
    }
    c.^.nodes[e].aux = v;
    c.^.nodes[e].aux2 = 1;
    c.^.nodes[e].ty = self_ty;
    return self_ty;
}

// --- integer literals that have not settled (language.md S2) ---------------

fn retype(c: &mut Ctx, e: u32, t: u32) {
    if ty_kind(c, c.^.nodes[e].ty) != TYK_INTLIT { return; }
    c.^.nodes[e].ty = t;
    let k: NodeKind = c.^.nodes[e].kind;
    if k == NodeKind.E_UNARY {
        let b: u32 = c.^.nodes[e].b;
        retype(c, b, t);
        return;
    }
    if k == NodeKind.E_BINARY {
        let b: u32 = c.^.nodes[e].b;
        retype(c, b, t);
        let op: Punct = c.^.nodes[e].op;
        if op != Punct.Shl && op != Punct.Shr {
            let rc: u32 = c.^.nodes[e].c;
            retype(c, rc, t);
        }
        return;
    }
    if k == NodeKind.S_MATCH {
        let mut a: u32 = c.^.nodes[e].b;
        for a != 0 {
            let value: u32 = c.^.nodes[a].d;
            retype(c, value, t);
            a = c.^.nodes[a].next;
        }
    }
}

// `&mut T` in a `&T` position, and `[]mut T` in a `[]T` position, drop the
// write permission and nothing else (language.md S3). No value changes, so
// this costs no instructions.
fn weakens_to(c: &Ctx, got: u32, want: u32) -> bool {
    let gk: u32 = ty_kind(c, got);
    if gk != ty_kind(c, want) { return false; }
    if gk != TYK_REF && gk != TYK_SLICE { return false; }
    if ty_flag(c, got) == 0 || ty_flag(c, want) != 0 { return false; }
    return ty_arg(c, got) == ty_arg(c, want);
}

// Can `got` be used where `want` is expected, as-is (equal, or a mutability
// weakening)? This is `coerce` without the integer-literal settling, so
// callers that already have both types in hand (match arms) can reuse it.
fn compatible(c: &Ctx, got: u32, want: u32) -> bool {
    if got == want { return true; }
    return weakens_to(c, got, want);
}

fn coerce(c: &mut Ctx, e: u32, want: u32) -> u32 {
    let got: u32 = check_expr(c, e, want);
    if failed(c) { return want; }
    if ty_kind(c, got) == TYK_INTLIT && is_int_ty(c, want)
        && ty_kind(c, want) != TYK_INTLIT {
        retype(c, e, want);
        return want;
    }
    if compatible(c, got, want) { return want; }
    let line: u32 = c.^.nodes[e].line;
    let col: u32 = c.^.nodes[e].col;
    e_expected_ty(c, line, col, want, got);
    return want;
}

// ===========================================================================
// Expressions (language.md S5)
// ===========================================================================

fn int_want(c: &Ctx, want: u32) -> u32 {
    if want == 0 { return 0; }
    let k: u32 = ty_kind(c, want);
    if k == TYK_I32 || k == TYK_U32 { return want; }
    return 0;
}

fn e_unknown_name(c: &mut Ctx, line: u32, col: u32, s: u32) {
    if err_open(c, line, col) {
        put_str(c, "unknown name ");
        put_q_name(c, s);
        err_end(c);
    }
}

fn e_type_mismatch2(c: &mut Ctx, line: u32, col: u32, op: Punct, lt: u32, rt: u32) {
    if err_open(c, line, col) {
        put_q_punct(c, op);
        put_str(c, ": ");
        put_q_ty(c, lt);
        put_str(c, " and ");
        put_q_ty(c, rt);
        put_str(c, " do not match");
        err_end(c);
    }
}

fn check_binop_types(c: &mut Ctx, line: u32, col: u32, op: Punct, lt: u32, rt: u32) {
    if failed(c) { return; }
    if op == Punct.Shl || op == Punct.Shr {
        if !is_int_ty(c, lt) { e_op_needs_int(c, line, col, op, lt); return; }
        if ty_kind(c, rt) != TYK_U32 {
            if err_open(c, line, col) {
                put_str(c, "shift amount must be ");
                put_ch(c, 96);
                put_str(c, "u32");
                put_ch(c, 96);
                put_str(c, ", found ");
                put_q_ty(c, rt);
                err_end(c);
            }
        }
        return;
    }
    if lt != rt { e_type_mismatch2(c, line, col, op, lt, rt); return; }
    let k: u32 = ty_kind(c, lt);
    if op == Punct.EqEq || op == Punct.Ne {
        if is_scalar_enum(c, lt) { return; }
        if k != TYK_I32 && k != TYK_U32 && k != TYK_BOOL && k != TYK_PTR {
            if err_open(c, line, col) {
                put_str(c, "cannot compare ");
                put_q_ty(c, lt);
                err_end(c);
            }
        }
        return;
    }
    if is_cmp(op) {
        if k != TYK_I32 && k != TYK_U32 && k != TYK_PTR {
            if err_open(c, line, col) {
                put_str(c, "cannot order ");
                put_q_ty(c, lt);
                err_end(c);
            }
        }
        return;
    }
    if k != TYK_I32 && k != TYK_U32 {
        if err_open(c, line, col) {
            put_q_punct(c, op);
            put_str(c, " requires ");
            put_ch(c, 96);
            put_str(c, "i32");
            put_ch(c, 96);
            put_str(c, " or ");
            put_ch(c, 96);
            put_str(c, "u32");
            put_ch(c, 96);
            put_str(c, ", found ");
            put_q_ty(c, lt);
            err_end(c);
        }
    }
}

fn check_binary(c: &mut Ctx, e: u32, want: u32) -> u32 {
    let op: Punct = c.^.nodes[e].op;
    let line: u32 = c.^.nodes[e].line;
    let col: u32 = c.^.nodes[e].col;
    let eb: u32 = c.^.nodes[e].b;
    let ec: u32 = c.^.nodes[e].c;
    if op == Punct.AndAnd || op == Punct.OrOr {
        coerce(c, eb, TY_BOOL);
        coerce(c, ec, TY_BOOL);
        return TY_BOOL;
    }
    let iw: u32 = int_want(c, want);
    let cmp: bool = is_cmp(op);

    if op == Punct.Shl || op == Punct.Shr {
        let mut lt: u32 = check_expr(c, eb, iw);
        coerce(c, ec, TY_U32);
        if failed(c) { return TY_I32; }
        if ty_kind(c, lt) == TYK_INTLIT {
            if iw == 0 {
                c.^.nodes[e].d = TY_INTLIT;
                return TY_INTLIT;
            }
            retype(c, eb, iw);
            lt = iw;
        }
        if !is_int_ty(c, lt) { e_op_needs_int(c, line, col, op, lt); return TY_I32; }
        c.^.nodes[e].d = lt;
        return lt;
    }

    let mut lwant: u32 = iw;
    if cmp { lwant = 0; }
    let mut lt: u32 = check_expr(c, eb, lwant);
    let mut rwant: u32 = lt;
    if ty_kind(c, lt) == TYK_INTLIT { rwant = lwant; }
    let mut rt: u32 = check_expr(c, ec, rwant);
    if failed(c) { return TY_I32; }
    let li: bool = ty_kind(c, lt) == TYK_INTLIT;
    let ri: bool = ty_kind(c, rt) == TYK_INTLIT;
    if li && !ri {
        retype(c, eb, rt);
        lt = rt;
    } else if ri && !li {
        retype(c, ec, lt);
        rt = lt;
    } else if li && ri {
        if !cmp {
            c.^.nodes[e].d = TY_INTLIT;
            return TY_INTLIT;
        }
        retype(c, eb, TY_I32);
        retype(c, ec, TY_I32);
        lt = TY_I32;
        rt = TY_I32;
    }
    check_binop_types(c, line, col, op, lt, rt);
    c.^.nodes[e].d = lt;
    if cmp { return TY_BOOL; }
    return lt;
}

fn e_arg_count(c: &mut Ctx, line: u32, col: u32, s: u32, want: u32, got: u32) {
    if err_open(c, line, col) {
        put_q_name(c, s);
        put_str(c, " takes ");
        put_num(c, want);
        put_str(c, " argument(s), found ");
        put_num(c, got);
        err_end(c);
    }
}

fn count_mentions(c: &Ctx, e: u32, loc: u32) -> u32 {
    if e == 0 { return 0; }
    let k: NodeKind = c.^.nodes[e].kind;
    let ea: u32 = c.^.nodes[e].a;
    let eb: u32 = c.^.nodes[e].b;
    if k == NodeKind.E_IDENT {
        if c.^.nodes[e].aux2 == 0 && c.^.nodes[e].aux == loc && loc != 0 { return 1; }
        return 0;
    }
    if k == NodeKind.E_UNARY || k == NodeKind.E_BORROW { return count_mentions(c, eb, loc); }
    if k == NodeKind.E_CAST || k == NodeKind.E_FIELD || k == NodeKind.E_DEREF { return count_mentions(c, ea, loc); }
    if k == NodeKind.E_BINARY {
        let ec: u32 = c.^.nodes[e].c;
        return count_mentions(c, eb, loc) + count_mentions(c, ec, loc);
    }
    if k == NodeKind.E_INDEX {
        return count_mentions(c, ea, loc) + count_mentions(c, eb, loc);
    }
    if k == NodeKind.E_SLICE {
        let ec: u32 = c.^.nodes[e].c;
        return count_mentions(c, eb, loc) + count_mentions(c, ec, loc);
    }
    if k == NodeKind.E_OFFSET {
        return count_mentions(c, ea, loc) + count_mentions(c, eb, loc);
    }
    if k == NodeKind.E_CALL {
        let mut n: u32 = count_mentions(c, ea, loc);
        let mut a: u32 = eb;
        for a != 0 {
            n += count_mentions(c, a, loc);
            a = c.^.nodes[a].next;
        }
        return n;
    }
    if k == NodeKind.E_STRUCTLIT {
        let mut n: u32 = 0;
        let mut f: u32 = c.^.nodes[e].c;
        for f != 0 {
            let fv: u32 = c.^.nodes[f].c;
            n += count_mentions(c, fv, loc);
            f = c.^.nodes[f].next;
        }
        return n;
    }
    return 0;
}

fn e_alias(c: &mut Ctx, line: u32, col: u32, s: u32, twice: u32) {
    if err_open(c, line, col) {
        put_q_name(c, s);
        if twice == 0 {
            put_str(c, " is borrowed mutably and also used in the same argument list");
        } else {
            put_str(c, " is borrowed mutably more than once");
        }
        err_end(c);
    }
}

// language.md S7 -- one rule.
fn check_aliasing(c: &mut Ctx, e: u32) {
    let line: u32 = c.^.nodes[e].line;
    let col: u32 = c.^.nodes[e].col;
    let head: u32 = c.^.nodes[e].b;
    let mut a: u32 = head;
    for a != 0 && !failed(c) {
        let root: u32 = c.^.nodes[a].d;
        if c.^.nodes[a].kind == NodeKind.E_BORROW && c.^.nodes[a].a != 0 && root != 0 {
            let rns: u32 = c.^.locals[root].name;
            let mut b: u32 = head;
            for b != 0 {
                if b != a && count_mentions(c, b, root) > 0 {
                    e_alias(c, line, col, rns, 0);
                    return;
                }
                b = c.^.nodes[b].next;
            }
            let opnd: u32 = c.^.nodes[a].b;
            if count_mentions(c, opnd, root) > 1 {
                e_alias(c, line, col, rns, 1);
                return;
            }
        }
        a = c.^.nodes[a].next;
    }
}

fn check_borrow(c: &mut Ctx, b: u32, want: u32) {
    let line: u32 = c.^.nodes[b].line;
    let col: u32 = c.^.nodes[b].col;
    let opnd: u32 = c.^.nodes[b].b;
    let oline: u32 = c.^.nodes[opnd].line;
    let ocol: u32 = c.^.nodes[opnd].col;
    if c.^.nodes[opnd].kind == NodeKind.E_STRUCTLIT {
        err_msg(c, oline, ocol, "struct literal is only allowed as an initializer");
        return;
    }
    if is_enum_lit(c, opnd) {
        err_msg(c, oline, ocol, "enum literal is only allowed as an initializer");
        return;
    }
    let ty: u32 = check_place(c, opnd);
    if failed(c) { return; }
    let mutable: u32 = c.^.place_mut;
    let root: u32 = c.^.place_root;
    let is_mut: u32 = c.^.nodes[b].a;
    if ty_kind(c, want) != TYK_REF {
        if err_open(c, line, col) {
            put_str(c, "expected ");
            put_q_ty(c, want);
            put_str(c, ", found a borrow");
            err_end(c);
        }
        return;
    }
    if is_mut != 0 && mutable == 0 {
        err_msg(c, line, col, "cannot borrow an immutable place as `&mut`");
        return;
    }
    let got: u32 = ty_intern(c, TYK_REF, ty, is_mut);
    if want != got {
        e_expected_ty(c, line, col, want, got);
        return;
    }
    if root != 0 { c.^.locals[root].addr = 1; }
    c.^.nodes[b].d = root;
    c.^.nodes[b].ty = got;
}

fn check_call(c: &mut Ctx, e: u32) -> u32 {
    let line: u32 = c.^.nodes[e].line;
    let col: u32 = c.^.nodes[e].col;
    let callee: u32 = c.^.nodes[e].a;
    if c.^.nodes[callee].kind != NodeKind.E_IDENT {
        err_msg(c, line, col, "callee must be a function name");
        return TY_I32;
    }
    let cs: u32 = c.^.nodes[callee].a;
    let cl: u32 = c.^.nodes[callee].b;
    let fi: u32 = find_fn(c, cs);
    if fi == 0 {
        if err_open(c, line, col) {
            put_str(c, "unknown function ");
            put_q_name(c, cs);
            err_end(c);
        }
        return TY_I32;
    }
    let args: u32 = c.^.nodes[e].b;
    let nargs: u32 = list_len(c, args);
    let nparams: u32 = c.^.fns[fi].nparams;
    if nargs != nparams {
        let fns: u32 = c.^.fns[fi].name;
        e_arg_count(c, line, col, fns, nparams, nargs);
        return TY_I32;
    }
    let mut a: u32 = args;
    let mut p: u32 = c.^.fns[fi].params;
    for a != 0 && !failed(c) {
        let pt: u32 = c.^.params[p].ty;
        if c.^.nodes[a].kind == NodeKind.E_BORROW {
            check_borrow(c, a, pt);
        } else {
            coerce(c, a, pt);
        }
        a = c.^.nodes[a].next;
        p = c.^.params[p].next;
    }
    if failed(c) { return TY_I32; }
    check_aliasing(c, e);
    if failed(c) { return TY_I32; }
    c.^.nodes[e].d = fi;
    return c.^.fns[fi].ret;
}

// ===========================================================================
// Places
// ===========================================================================

fn root_local(c: &Ctx, e: u32) -> u32 {
    let mut p: u32 = e;
    for p != 0 {
        let k: NodeKind = c.^.nodes[p].kind;
        if k == NodeKind.E_IDENT {
            if c.^.nodes[p].aux2 != 0 { return 0; }
            return c.^.nodes[p].aux;
        }
        if k == NodeKind.E_FIELD || k == NodeKind.E_INDEX || k == NodeKind.E_DEREF {
            p = c.^.nodes[p].a;
            continue;
        }
        return 0;
    }
    return 0;
}

fn e_no_field_ty(c: &mut Ctx, line: u32, col: u32, t: u32, s: u32) {
    if err_open(c, line, col) {
        put_q_ty(c, t);
        put_str(c, " has no field ");
        put_q_name(c, s);
        err_end(c);
    }
}

fn e_no_field_name(c: &mut Ctx, line: u32, col: u32, bs: u32, bl: u32, s: u32) {
    if err_open(c, line, col) {
        put_q_name(c, bs);
        put_str(c, " has no field ");
        put_q_name(c, s);
        err_end(c);
    }
}

// Returns the place type; mutability and root local come back in c.place_*.
fn check_place(c: &mut Ctx, e: u32) -> u32 {
    if failed(c) { return TY_I32; }
    let k: NodeKind = c.^.nodes[e].kind;
    let line: u32 = c.^.nodes[e].line;
    let col: u32 = c.^.nodes[e].col;
    let ea: u32 = c.^.nodes[e].a;
    let eb: u32 = c.^.nodes[e].b;

    if k == NodeKind.E_IDENT {
        let loc: u32 = lookup(c, ea);
        if loc == 0 {
            if find_const(c, ea) != 0 {
                if err_open(c, line, col) {
                    put_q_name(c, ea);
                    put_str(c, " is a constant, not a place");
                    err_end(c);
                }
                return TY_I32;
            }
            if find_type_name(c, ea) {
                if err_open(c, line, col) {
                    put_q_name(c, ea);
                    put_str(c, " is a type, not a place");
                    err_end(c);
                }
                return TY_I32;
            }
            e_unknown_name(c, line, col, ea);
            return TY_I32;
        }
        let lt: u32 = c.^.locals[loc].ty;
        c.^.nodes[e].aux = loc;
        c.^.nodes[e].aux2 = 0;
        c.^.nodes[e].ty = read_ty(c, lt);
        c.^.place_mut = c.^.locals[loc].is_mut;
        c.^.place_root = loc;
        return lt;
    }

    if k == NodeKind.E_FIELD {
        let ec: u32 = c.^.nodes[e].c;
        let bt: u32 = check_place(c, ea);
        if failed(c) { return TY_I32; }
        let bmut: u32 = c.^.place_mut;
        let broot: u32 = c.^.place_root;
        if ty_kind(c, bt) != TYK_NAMED {
            e_no_field_ty(c, line, col, bt, eb);
            return TY_I32;
        }
        let si: u32 = agg_struct(c, bt);
        if si == 0 {
            e_no_field_ty(c, line, col, bt, eb);
            return TY_I32;
        }
        let fhead: u32 = c.^.structs[si].fields;
        let f: u32 = field_named(c, fhead, eb);
        if f == 0 {
            let sns: u32 = c.^.structs[si].name;
            e_no_field_name(c, line, col, sns, eb, ec);
            return TY_I32;
        }
        let ft: u32 = c.^.fields[f].ty;
        c.^.nodes[e].d = f;
        c.^.nodes[e].ty = read_ty(c, ft);
        c.^.place_mut = bmut;
        c.^.place_root = broot;
        return ft;
    }

    if k == NodeKind.E_INDEX {
        let bt: u32 = check_expr(c, ea, 0);
        if failed(c) { return TY_I32; }
        if ty_kind(c, bt) != TYK_SLICE {
            if err_open(c, line, col) {
                put_str(c, "cannot index ");
                put_q_ty(c, bt);
                err_end(c);
            }
            return TY_I32;
        }
        coerce(c, eb, TY_U32);
        if failed(c) { return TY_I32; }
        let elem: u32 = ty_arg(c, bt);
        let flag: u32 = ty_flag(c, bt);
        let rt: u32 = root_local(c, ea);
        c.^.nodes[e].d = size_of(c, elem);
        c.^.nodes[e].ty = read_ty(c, elem);
        c.^.place_mut = flag;
        c.^.place_root = rt;
        return elem;
    }

    if k == NodeKind.E_DEREF {
        let bt: u32 = check_expr(c, ea, 0);
        if failed(c) { return TY_I32; }
        let bk: u32 = ty_kind(c, bt);
        let inner: u32 = ty_arg(c, bt);
        if bk == TYK_REF {
            let rt: u32 = root_local(c, ea);
            c.^.nodes[e].ty = read_ty(c, inner);
            c.^.place_mut = ty_flag(c, bt);
            c.^.place_root = rt;
            return inner;
        }
        if bk == TYK_PTR {
            if c.^.unsafed == 0 {
                err_msg(c, line, col, "raw pointer dereference requires `unsafe`");
                return TY_I32;
            }
            let rt: u32 = root_local(c, ea);
            c.^.nodes[e].ty = read_ty(c, inner);
            c.^.place_mut = 1;
            c.^.place_root = rt;
            return inner;
        }
        if err_open(c, line, col) {
            put_str(c, "cannot dereference ");
            put_q_ty(c, bt);
            err_end(c);
        }
        return TY_I32;
    }

    err_msg(c, line, col, "expected a place expression");
    return TY_I32;
}

// A slice has exactly two built-in fields, `len` and `ptr` (language.md S3).
// Returns 0 for neither, 1 for len, 2 for ptr.
fn slice_field(c: &mut Ctx, e: u32) -> u32 {
    let ns: u32 = c.^.nodes[e].b;
    let mut which: u32 = 0;
    if ns == c.^.id_len { which = 1; }
    else if ns == c.^.id_ptr { which = 2; }
    else { return 0; }
    let base: u32 = c.^.nodes[e].a;
    if c.^.nodes[base].kind == NodeKind.E_IDENT {
        let bs: u32 = c.^.nodes[base].a;
        let bl: u32 = c.^.nodes[base].b;
        if find_enum(c, bs) != 0 { return 0; }
    }
    // probe without committing: a failure here is not the program's diagnostic
    let saved_err: u32 = c.^.err;
    let saved_out: u32 = c.^.out;
    let saved_ty: u32 = c.^.nodes[base].ty;
    let t: u32 = check_expr(c, base, 0);
    let bad: bool = failed(c);
    c.^.err = saved_err;
    c.^.out = saved_out;
    if saved_ty != 0 { c.^.nodes[base].ty = saved_ty; }
    if bad { return 0; }
    if ty_kind(c, t) != TYK_SLICE { return 0; }
    return which;
}

fn check_expr(c: &mut Ctx, e: u32, want: u32) -> u32 {
    let t: u32 = check_expr_inner(c, e, want);
    c.^.nodes[e].ty = t;
    return t;
}

fn check_expr_inner(c: &mut Ctx, e: u32, want: u32) -> u32 {
    if failed(c) { return TY_I32; }
    let k: NodeKind = c.^.nodes[e].kind;
    let line: u32 = c.^.nodes[e].line;
    let col: u32 = c.^.nodes[e].col;
    let ea: u32 = c.^.nodes[e].a;
    let eb: u32 = c.^.nodes[e].b;

    if k == NodeKind.E_INT { return TY_INTLIT; }
    if k == NodeKind.E_CHAR { return TY_U32; }
    if k == NodeKind.E_BOOL { return TY_BOOL; }
    if k == NodeKind.E_STR {
        let addr: u32 = intern_string(c, ea, eb, line, col);
        c.^.nodes[e].aux = addr;
        return ty_intern(c, TYK_SLICE, TY_U8, 0);
    }
    if k == NodeKind.E_STRUCTLIT {
        err_msg(c, line, col, "struct literal is only allowed as an initializer");
        return TY_I32;
    }
    if k == NodeKind.S_MATCH { return check_match_expr(c, e, want); }
    if k == NodeKind.E_SLICE {
        let ec: u32 = c.^.nodes[e].c;
        if c.^.unsafed == 0 {
            if err_open(c, line, col) {
                put_ch(c, 96);
                if ea != 0 { put_str(c, "slice_mut"); } else { put_str(c, "slice"); }
                put_ch(c, 96);
                put_str(c, " requires ");
                put_ch(c, 96);
                put_str(c, "unsafe");
                put_ch(c, 96);
                err_end(c);
            }
            return TY_I32;
        }
        let pt: u32 = check_expr(c, eb, 0);
        if failed(c) { return TY_I32; }
        if ty_kind(c, pt) != TYK_PTR {
            let pl: u32 = c.^.nodes[eb].line;
            let pc: u32 = c.^.nodes[eb].col;
            if err_open(c, pl, pc) {
                put_str(c, "expected a raw pointer, found ");
                put_q_ty(c, pt);
                err_end(c);
            }
            return TY_I32;
        }
        coerce(c, ec, TY_U32);
        if failed(c) { return TY_I32; }
        let elem: u32 = ty_arg(c, pt);
        return ty_intern(c, TYK_SLICE, elem, ea);
    }
    if k == NodeKind.E_OFFSET {
        let pt: u32 = check_expr(c, ea, 0);
        if failed(c) { return TY_I32; }
        if ty_kind(c, pt) != TYK_PTR {
            let pl: u32 = c.^.nodes[ea].line;
            let pc: u32 = c.^.nodes[ea].col;
            if err_open(c, pl, pc) {
                put_str(c, "expected a raw pointer, found ");
                put_q_ty(c, pt);
                err_end(c);
            }
            return TY_I32;
        }
        coerce(c, eb, TY_U32);
        if failed(c) { return TY_I32; }
        let inner: u32 = ty_arg(c, pt);
        c.^.nodes[e].d = size_of(c, inner);
        return pt;
    }
    if k == NodeKind.E_IDENT {
        let loc: u32 = lookup(c, ea);
        if loc != 0 {
            let lt: u32 = c.^.locals[loc].ty;
            c.^.nodes[e].aux = loc;
            c.^.nodes[e].aux2 = 0;
            return read_ty(c, lt);
        }
        let ci: u32 = find_const(c, ea);
        if ci != 0 {
            force_const(c, ci, line, col);
            if failed(c) { return TY_I32; }
            c.^.nodes[e].aux = c.^.consts[ci].value;
            c.^.nodes[e].aux2 = 1;
            return c.^.consts[ci].ty;
        }
        if find_fn(c, ea) != 0 {
            err_msg(c, line, col, "functions are not values");
            return TY_I32;
        }
        e_unknown_name(c, line, col, ea);
        return TY_I32;
    }
    if k == NodeKind.E_UNARY {
        if c.^.nodes[e].op == Punct.Not {
            coerce(c, eb, TY_BOOL);
            return TY_BOOL;
        }
        let iw: u32 = int_want(c, want);
        let t: u32 = check_expr(c, eb, iw);
        if failed(c) { return TY_I32; }
        if !is_int_ty(c, t) { e_negate(c, line, col, t); return TY_I32; }
        return t;
    }
    if k == NodeKind.E_BORROW {
        err_msg(c, line, col, "a borrow may only appear as a call argument");
        return TY_I32;
    }
    if k == NodeKind.E_CAST {
        let mut src: u32 = check_expr(c, ea, 0);
        if failed(c) { return TY_I32; }
        if ty_kind(c, src) == TYK_INTLIT {
            retype(c, ea, TY_I32);
            src = TY_I32;
        }
        let dst: u32 = resolve_ty(c, eb);
        if failed(c) { return TY_I32; }
        let sk: u32 = ty_kind(c, src);
        let dk: u32 = ty_kind(c, dst);
        if sk != TYK_I32 && sk != TYK_U32 && sk != TYK_PTR {
            e_cast_from(c, line, col, src);
            return TY_I32;
        }
        if dk != TYK_I32 && dk != TYK_U32 && dk != TYK_PTR {
            e_cast_to(c, line, col, dst);
            return TY_I32;
        }
        return dst;
    }
    if k == NodeKind.E_BINARY { return check_binary(c, e, want); }
    if k == NodeKind.E_CALL {
        if is_enum_lit(c, e) {
            err_msg(c, line, col, "enum literal is only allowed as an initializer");
            return TY_I32;
        }
        return check_call(c, e);
    }
    if k == NodeKind.E_FIELD {
        let sv: u32 = scalar_enum_lit(c, e);
        if sv != 0 {
            let sei: u32 = scalar_enum_lit_enum(c, e);
            let ens3: u32 = c.^.enums[sei].name;
            c.^.nodes[e].aux = c.^.variants[sv].tag;
            c.^.nodes[e].aux2 = 2;   // 2 marks a scalar tag constant
            return ty_named(c, ens3);
        }
        if is_enum_lit(c, e) {
            err_msg(c, line, col, "enum literal is only allowed as an initializer");
            return TY_I32;
        }
        let which: u32 = slice_field(c, e);
        if which != 0 {
            let bt: u32 = check_expr(c, ea, 0);
            if failed(c) { return TY_I32; }
            c.^.nodes[e].aux = which;
            if which == 1 { return TY_U32; }
            let elem: u32 = ty_arg(c, bt);
            return ty_intern(c, TYK_PTR, elem, 0);
        }
    }
    if k == NodeKind.E_FIELD || k == NodeKind.E_INDEX || k == NodeKind.E_DEREF {
        let ty: u32 = check_place(c, e);
        if failed(c) { return TY_I32; }
        if is_aggregate(c, ty) { return ty; }
        return read_ty(c, ty);
    }
    err_msg(c, line, col, "expected expression");
    return TY_I32;
}

// ===========================================================================
// The whole check (language.md S4)
// ===========================================================================

fn check_program(c: &mut Ctx) {
    // pass one: gather declarations. Top level is order-independent (language.md S4)
    let mut d: u32 = c.^.decls;
    for d != 0 && !failed(c) {
        claim(c, d);
        d = c.^.nodes[d].next;
    }
    if failed(c) { return; }
    d = c.^.decls;
    for d != 0 {
        let k: NodeKind = c.^.nodes[d].kind;
        if k == NodeKind.D_STRUCT || k == NodeKind.D_ENUM { add_type_name(c, d); }
        if k == NodeKind.D_ENUM { add_scalar_name(c, d); }
        d = c.^.nodes[d].next;
    }
    d = c.^.decls;
    for d != 0 && !failed(c) {
        if c.^.nodes[d].kind == NodeKind.D_STRUCT { declare_struct(c, d); }
        d = c.^.nodes[d].next;
    }
    if failed(c) { return; }
    d = c.^.decls;
    for d != 0 && !failed(c) {
        if c.^.nodes[d].kind == NodeKind.D_ENUM { declare_enum(c, d); }
        d = c.^.nodes[d].next;
    }
    if failed(c) { return; }
    // consts may reference each other, so register them all before folding
    d = c.^.decls;
    for d != 0 && !failed(c) {
        if c.^.nodes[d].kind == NodeKind.D_CONST { declare_const(c, d); }
        d = c.^.nodes[d].next;
    }
    if failed(c) { return; }
    d = c.^.decls;
    for d != 0 && !failed(c) {
        if c.^.nodes[d].kind == NodeKind.D_CONST {
            let ci: u32 = c.^.nodes[d].aux;
            let line: u32 = c.^.nodes[d].line;
            let col: u32 = c.^.nodes[d].col;
            force_const(c, ci, line, col);
        }
        d = c.^.nodes[d].next;
    }
    if failed(c) { return; }
    let mut index: u32 = 0;
    d = c.^.decls;
    for d != 0 && !failed(c) {
        if c.^.nodes[d].kind == NodeKind.D_FN {
            declare_fn(c, d, index);
            index += 1;
        }
        d = c.^.nodes[d].next;
    }
    c.^.nfns = index;
    if failed(c) { return; }

    // Bodies are not checked here any more. Each one is parsed, checked,
    // emitted and dropped inside emit_module's code loop (gh #5 C) -- the
    // order is the same, so the first diagnostic is the same.
}

// ===========================================================================
// wasm encoding (implementation.md S5)
// ===========================================================================

const SEC_TYPE: u32 = 1;
const SEC_FUNC: u32 = 3;
const SEC_MEM: u32 = 5;
const SEC_GLOBAL: u32 = 6;
const SEC_EXPORT: u32 = 7;
const SEC_CODE: u32 = 10;
const SEC_DATA: u32 = 11;

const OP_UNREACHABLE: u32 = 0x00;
const OP_BLOCK: u32 = 0x02;
const OP_LOOP: u32 = 0x03;
const OP_IF: u32 = 0x04;
const OP_ELSE: u32 = 0x05;
const OP_END: u32 = 0x0B;
const OP_BR: u32 = 0x0C;
const OP_BR_IF: u32 = 0x0D;
const OP_RETURN: u32 = 0x0F;
const OP_CALL: u32 = 0x10;
const OP_DROP: u32 = 0x1A;
const OP_LOCAL_GET: u32 = 0x20;
const OP_LOCAL_SET: u32 = 0x21;
const OP_GLOBAL_GET: u32 = 0x23;
const OP_GLOBAL_SET: u32 = 0x24;
const OP_I32_LOAD: u32 = 0x28;
const OP_I32_LOAD8_U: u32 = 0x2D;
const OP_I32_STORE: u32 = 0x36;
const OP_I32_STORE8: u32 = 0x3A;
const OP_I32_CONST: u32 = 0x41;
const OP_I32_EQZ: u32 = 0x45;
const OP_I32_LT_U: u32 = 0x49;
const OP_I32_GE_U: u32 = 0x4F;
const OP_I32_ADD: u32 = 0x6A;
const OP_I32_SUB: u32 = 0x6B;
const OP_I32_MUL: u32 = 0x6C;
const OP_I32_OR: u32 = 0x72;
const TYPE_I32: u32 = 0x7F;
const BLOCK_VOID: u32 = 0x40;

const MEM_PAGES: u32 = 8192;
const SHADOW_FLOOR: u32 = 0x1800_0000;
const SHADOW_TOP: u32 = 0x2000_0000;

const CTRL_BRK: u32 = 1;
const CTRL_LOOP: u32 = 2;
const CTRL_CNT: u32 = 3;
const CTRL_MATCH: u32 = 4;
const CTRL_IF: u32 = 5;

// Two output cursors: one for a function body, one for a section payload.
const W_BODY: u32 = 0;
const W_SEC: u32 = 1;
const W_OUT: u32 = 2;

// --- byte writers ----------------------------------------------------------

fn w_ch(c: &mut Ctx, sel: u32, ch: u32) {
    if sel == W_BODY {
        stb(c.^.wb, ch);
        c.^.wb = c.^.wb + 1;
        return;
    }
    if sel == W_SEC {
        stb(c.^.ws, ch);
        c.^.ws = c.^.ws + 1;
        return;
    }
    stb(c.^.out, ch);
    c.^.out = c.^.out + 1;
}

fn w_u(c: &mut Ctx, sel: u32, n: u32) {
    let mut x: u32 = n;
    for {
        let byte: u32 = x & 0x7F;
        x = x >> 7;
        if x == 0 {
            w_ch(c, sel, byte);
            break;
        }
        w_ch(c, sel, byte | 0x80);
    }
}

// signed LEB128 of the 32-bit pattern v
fn w_s(c: &mut Ctx, sel: u32, v: u32) {
    let mut x: i32 = v as i32;
    for {
        let byte: u32 = (x as u32) & 0x7F;
        x = x >> 7;
        let sign: u32 = byte & 0x40;
        if (x == 0 && sign == 0) || (x == -1 && sign != 0) {
            w_ch(c, sel, byte);
            break;
        }
        w_ch(c, sel, byte | 0x80);
    }
}

// An interned name, straight into a section payload. The bytes are the same
// bytes the source had -- interning copies, it does not canonicalise -- so the
// emitted module is unchanged by gh #5 A.
fn name_len(c: &Ctx, id: u32) -> u32 { return c.^.ntab[id].len; }

fn w_name(c: &mut Ctx, sel: u32, id: u32) {
    let off: u32 = c.^.ntab[id].off;
    let ln: u32 = c.^.ntab[id].len;
    let base: u32 = c.^.nmem.ptr as u32;
    w_copy(c, sel, base + off, ln);
}

fn w_copy(c: &mut Ctx, sel: u32, src: u32, n: u32) {
    for let mut i: u32 = 0; i < n; i += 1 {
        let b: u32 = ldb(src + i);
        w_ch(c, sel, b);
    }
}

fn leb_u_len(n: u32) -> u32 {
    let mut x: u32 = n;
    let mut k: u32 = 1;
    for x >= 128 {
        x = x >> 7;
        k += 1;
    }
    return k;
}

// body writers
fn b_ch(c: &mut Ctx, ch: u32) { w_ch(c, W_BODY, ch); }

fn b_u(c: &mut Ctx, n: u32) { w_u(c, W_BODY, n); }

fn b_op(c: &mut Ctx, op: u32) { w_ch(c, W_BODY, op); }

fn b_i32const(c: &mut Ctx, v: u32) {
    w_ch(c, W_BODY, OP_I32_CONST);
    w_s(c, W_BODY, v);
}

fn b_idx(c: &mut Ctx, op: u32, i: u32) {
    w_ch(c, W_BODY, op);
    w_u(c, W_BODY, i);
}

// memarg: alignment, then an offset that is always 0 (implementation.md S5)
fn b_mem(c: &mut Ctx, op: u32, align: u32) {
    w_ch(c, W_BODY, op);
    w_u(c, W_BODY, align);
    w_u(c, W_BODY, 0);
}

fn b_blocked(c: &mut Ctx, op: u32, bt: u32) {
    w_ch(c, W_BODY, op);
    w_ch(c, W_BODY, bt);
}

// section writers
fn s_ch(c: &mut Ctx, ch: u32) { w_ch(c, W_SEC, ch); }

fn s_u(c: &mut Ctx, n: u32) { w_u(c, W_SEC, n); }

// --- temporaries (implementation.md S6) ------------------------------------

fn temp(c: &mut Ctx) -> u32 {
    if c.^.free_n != 0 {
        let n: u32 = c.^.free_n - 1;
        c.^.free_n = n;
        return c.^.free[n];
    }
    let fi: u32 = c.^.efn;
    let i: u32 = c.^.fns[fi].npslot + c.^.fns[fi].nlslot + c.^.ntemp;
    c.^.ntemp = c.^.ntemp + 1;
    return i;
}

fn free_push(c: &mut Ctx, t: u32) {
    let n: u32 = c.^.free_n;
    c.^.free[n] = t;
    c.^.free_n = n + 1;
}

fn release1(c: &mut Ctx, a: u32) { free_push(c, a); }

// released highest first, exactly as cool0.py sorts them
fn release2(c: &mut Ctx, a: u32, b: u32) {
    if a > b { free_push(c, a); free_push(c, b); return; }
    free_push(c, b);
    free_push(c, a);
}

fn release3(c: &mut Ctx, a: u32, b: u32, d: u32) {
    let mut hi: u32 = a;
    let mut mid: u32 = b;
    let mut lo: u32 = d;
    if mid > hi { let t: u32 = hi; hi = mid; mid = t; }
    if lo > hi { let t: u32 = hi; hi = lo; lo = t; }
    if lo > mid { let t: u32 = mid; mid = lo; lo = t; }
    free_push(c, hi);
    free_push(c, mid);
    free_push(c, lo);
}

// --- control stack ---------------------------------------------------------

fn ctrl_push(c: &mut Ctx, k: u32) {
    let n: u32 = c.^.ctrl_n;
    c.^.ctrl[n] = k;
    c.^.ctrl_n = n + 1;
}

fn ctrl_pop(c: &mut Ctx) { c.^.ctrl_n = c.^.ctrl_n - 1; }

fn depth_to(c: &Ctx, k: u32) -> u32 {
    let n: u32 = c.^.ctrl_n;
    let mut i: u32 = n;
    for i > 0 {
        i -= 1;
        if c.^.ctrl[i] == k { return n - 1 - i; }
    }
    return 0;
}

// --- storage assignment (implementation.md S6) -----------------------------

fn loc_in_memory(c: &Ctx, loc: u32) -> bool {
    let t: u32 = c.^.locals[loc].ty;
    return is_aggregate(c, t) || c.^.locals[loc].addr != 0;
}

fn assign_storage(c: &mut Ctx, fi: u32) {
    let mut slot: u32 = 0;
    let mut loc: u32 = c.^.fns[fi].locals;
    for loc != 0 {
        if c.^.locals[loc].is_param != 0 {
            let t: u32 = c.^.locals[loc].ty;
            c.^.locals[loc].slot = slot;
            slot += slot_count(c, t);
        }
        loc = c.^.locals[loc].next;
    }
    c.^.fns[fi].npslot = slot;
    loc = c.^.fns[fi].locals;
    for loc != 0 {
        if c.^.locals[loc].is_param == 0 && !loc_in_memory(c, loc) {
            let t: u32 = c.^.locals[loc].ty;
            c.^.locals[loc].slot = slot;
            slot += slot_count(c, t);
        }
        loc = c.^.locals[loc].next;
    }
    c.^.fns[fi].nlslot = slot - c.^.fns[fi].npslot;

    let mut off: u32 = 0;
    let mut align: u32 = 4;
    loc = c.^.fns[fi].locals;
    for loc != 0 {
        if loc_in_memory(c, loc) {
            let t: u32 = c.^.locals[loc].ty;
            let a: u32 = align_of(c, t);
            off = align_up(off, a);
            c.^.locals[loc].foff = off;
            off += size_of(c, t);
            if a > align { align = a; }
        }
        loc = c.^.locals[loc].next;
    }
    if off != 0 { c.^.fns[fi].frame = align_up(off, align); }
    else { c.^.fns[fi].frame = 0; }
}

// --- memory access ---------------------------------------------------------

fn load_op(c: &mut Ctx, t: u32) {
    let k: u32 = ty_kind(c, t);
    if k == TYK_BOOL || k == TYK_U8 { b_mem(c, OP_I32_LOAD8_U, 0); return; }
    b_mem(c, OP_I32_LOAD, 2);
}

fn store_op(c: &mut Ctx, t: u32) {
    let k: u32 = ty_kind(c, t);
    if k == TYK_BOOL || k == TYK_U8 { b_mem(c, OP_I32_STORE8, 0); return; }
    b_mem(c, OP_I32_STORE, 2);
}

fn frame_addr(c: &mut Ctx, loc: u32) {
    let off: u32 = c.^.locals[loc].foff;
    b_idx(c, OP_GLOBAL_GET, 0);
    b_i32const(c, off);
    b_op(c, OP_I32_ADD);
}

fn ident_local(c: &Ctx, e: u32) -> u32 {
    if c.^.nodes[e].aux2 != 0 { return 0; }
    return c.^.nodes[e].aux;
}

fn in_wasm_local(c: &Ctx, e: u32) -> bool {
    if c.^.nodes[e].kind != NodeKind.E_IDENT { return false; }
    let loc: u32 = ident_local(c, e);
    if loc == 0 { return false; }
    return !loc_in_memory(c, loc);
}

fn place_ty(c: &Ctx, e: u32) -> u32 {
    let k: NodeKind = c.^.nodes[e].kind;
    if k == NodeKind.E_IDENT {
        let loc: u32 = ident_local(c, e);
        return c.^.locals[loc].ty;
    }
    if k == NodeKind.E_FIELD {
        let f: u32 = c.^.nodes[e].d;
        return c.^.fields[f].ty;
    }
    let base: u32 = c.^.nodes[e].a;
    let bt: u32 = c.^.nodes[base].ty;
    return ty_arg(c, bt);
}

fn emit_addr(c: &mut Ctx, e: u32) {
    let k: NodeKind = c.^.nodes[e].kind;
    let ea: u32 = c.^.nodes[e].a;
    if k == NodeKind.E_IDENT {
        let loc: u32 = ident_local(c, e);
        frame_addr(c, loc);
        return;
    }
    if k == NodeKind.E_FIELD {
        let f: u32 = c.^.nodes[e].d;
        let off: u32 = c.^.fields[f].off;
        emit_addr(c, ea);
        b_i32const(c, off);
        b_op(c, OP_I32_ADD);
        return;
    }
    if k == NodeKind.E_DEREF { emit_expr(c, ea); return; }
    // NodeKind.E_INDEX -- bounds checked (language.md S5)
    let tp: u32 = temp(c);
    let tl: u32 = temp(c);
    let tix: u32 = temp(c);
    let stride: u32 = c.^.nodes[e].d;
    let eb: u32 = c.^.nodes[e].b;
    emit_expr(c, ea);
    b_idx(c, OP_LOCAL_SET, tl);
    b_idx(c, OP_LOCAL_SET, tp);
    emit_expr(c, eb);
    b_idx(c, OP_LOCAL_SET, tix);
    b_idx(c, OP_LOCAL_GET, tix);
    b_idx(c, OP_LOCAL_GET, tl);
    b_op(c, OP_I32_GE_U);
    b_blocked(c, OP_IF, BLOCK_VOID);
    b_op(c, OP_UNREACHABLE);
    b_op(c, OP_END);
    b_idx(c, OP_LOCAL_GET, tp);
    b_idx(c, OP_LOCAL_GET, tix);
    b_i32const(c, stride);
    b_op(c, OP_I32_MUL);
    b_op(c, OP_I32_ADD);
    release3(c, tp, tl, tix);
}

fn emit_place_load(c: &mut Ctx, e: u32, pt: u32) {
    if in_wasm_local(c, e) {
        let loc: u32 = ident_local(c, e);
        let slot: u32 = c.^.locals[loc].slot;
        let lt: u32 = c.^.locals[loc].ty;
        b_idx(c, OP_LOCAL_GET, slot);
        if ty_kind(c, lt) == TYK_SLICE {
            b_idx(c, OP_LOCAL_GET, slot + 1);
        }
        return;
    }
    if ty_kind(c, pt) == TYK_SLICE {
        let ta: u32 = temp(c);
        emit_addr(c, e);
        b_idx(c, OP_LOCAL_SET, ta);
        b_idx(c, OP_LOCAL_GET, ta);
        b_mem(c, OP_I32_LOAD, 2);
        b_idx(c, OP_LOCAL_GET, ta);
        b_i32const(c, 4);
        b_op(c, OP_I32_ADD);
        b_mem(c, OP_I32_LOAD, 2);
        release1(c, ta);
        return;
    }
    emit_addr(c, e);
    load_op(c, pt);
}

fn emit_load_at(c: &mut Ctx, ta: u32, off: u32, t: u32) {
    if ty_kind(c, t) == TYK_SLICE {
        b_idx(c, OP_LOCAL_GET, ta);
        b_i32const(c, off);
        b_op(c, OP_I32_ADD);
        b_mem(c, OP_I32_LOAD, 2);
        b_idx(c, OP_LOCAL_GET, ta);
        b_i32const(c, off + 4);
        b_op(c, OP_I32_ADD);
        b_mem(c, OP_I32_LOAD, 2);
        return;
    }
    b_idx(c, OP_LOCAL_GET, ta);
    b_i32const(c, off);
    b_op(c, OP_I32_ADD);
    load_op(c, t);
}

// vk 0: the value is expression a1.  vk 1: load a3 from a1 + a2.
fn emit_value(c: &mut Ctx, vk: u32, a1: u32, a2: u32, a3: u32) {
    if vk == 0 { emit_expr(c, a1); return; }
    emit_load_at(c, a1, a2, a3);
}

// --- expressions -----------------------------------------------------------

// A match arm is a value, not a block, so the `if signed { s } else { u }`
// that used to live in six of these arms becomes one call each.
fn signed_of(signed: bool, s: u32, u: u32) -> u32 { if signed { return s; } return u; }

fn arith_op(op: Punct, signed: bool) -> u32 {
    return match op {
        Add => 0x6A,
        Sub => 0x6B,
        Mul => 0x6C,
        Div => signed_of(signed, 0x6D, 0x6E),
        Mod => signed_of(signed, 0x6F, 0x70),
        And => 0x71,
        Or => 0x72,
        Xor => 0x73,
        Shl => 0x74,
        _ => signed_of(signed, 0x75, 0x76),
    };
}

fn cmp_opcode(op: Punct, signed: bool) -> u32 {
    return match op {
        EqEq => 0x46,
        Ne => 0x47,
        Lt => signed_of(signed, 0x48, 0x49),
        Gt => signed_of(signed, 0x4A, 0x4B),
        Le => signed_of(signed, 0x4C, 0x4D),
        _ => signed_of(signed, 0x4E, 0x4F),
    };
}

fn emit_binary(c: &mut Ctx, e: u32) {
    let op: Punct = c.^.nodes[e].op;
    let eb: u32 = c.^.nodes[e].b;
    let ec: u32 = c.^.nodes[e].c;
    if op == Punct.AndAnd || op == Punct.OrOr {
        emit_expr(c, eb);
        b_blocked(c, OP_IF, TYPE_I32);
        ctrl_push(c, CTRL_IF);
        if op == Punct.AndAnd {
            emit_expr(c, ec);
            b_op(c, OP_ELSE);
            b_i32const(c, 0);
        } else {
            b_i32const(c, 1);
            b_op(c, OP_ELSE);
            emit_expr(c, ec);
        }
        ctrl_pop(c);
        b_op(c, OP_END);
        return;
    }
    emit_expr(c, eb);
    emit_expr(c, ec);
    if is_cmp(op) {
        let ot: u32 = c.^.nodes[e].d;
        let sg: bool = ty_kind(c, ot) == TYK_I32;
        b_op(c, cmp_opcode(op, sg));
        return;
    }
    let rt: u32 = c.^.nodes[e].ty;
    let sg: bool = ty_kind(c, rt) == TYK_I32;
    b_op(c, arith_op(op, sg));
}

fn emit_expr(c: &mut Ctx, e: u32) {
    let k: NodeKind = c.^.nodes[e].kind;
    if k == NodeKind.E_FIELD && c.^.nodes[e].aux2 == 2 {
        let tag: u32 = c.^.nodes[e].aux;
        b_i32const(c, tag);
        return;
    }
    let ea: u32 = c.^.nodes[e].a;
    let eb: u32 = c.^.nodes[e].b;
    if k == NodeKind.E_INT || k == NodeKind.E_CHAR || k == NodeKind.E_BOOL { b_i32const(c, ea); return; }
    if k == NodeKind.E_STR {
        let addr: u32 = c.^.nodes[e].aux;
        b_i32const(c, addr);
        b_i32const(c, eb);
        return;
    }
    if k == NodeKind.E_IDENT {
        let loc: u32 = ident_local(c, e);
        if loc != 0 {
            let lt: u32 = c.^.locals[loc].ty;
            emit_place_load(c, e, lt);
            return;
        }
        let v: u32 = c.^.nodes[e].aux;
        b_i32const(c, v);
        return;
    }
    if k == NodeKind.E_CAST { emit_expr(c, ea); return; }
    if k == NodeKind.E_UNARY {
        if c.^.nodes[e].op == Punct.Not {
            emit_expr(c, eb);
            b_op(c, OP_I32_EQZ);
            return;
        }
        b_i32const(c, 0);
        emit_expr(c, eb);
        b_op(c, OP_I32_SUB);
        return;
    }
    if k == NodeKind.E_SLICE {
        // the two operands already are the (ptr, len) pair (implementation.md S5)
        let ec: u32 = c.^.nodes[e].c;
        emit_expr(c, eb);
        emit_expr(c, ec);
        return;
    }
    if k == NodeKind.E_OFFSET {
        let stride: u32 = c.^.nodes[e].d;
        emit_expr(c, ea);
        emit_expr(c, eb);
        b_i32const(c, stride);
        b_op(c, OP_I32_MUL);
        b_op(c, OP_I32_ADD);
        return;
    }
    if k == NodeKind.E_BINARY { emit_binary(c, e); return; }
    if k == NodeKind.E_CALL {
        let mut a: u32 = eb;
        for a != 0 {
            if c.^.nodes[a].kind == NodeKind.E_BORROW {
                let opnd: u32 = c.^.nodes[a].b;
                emit_addr(c, opnd);
            } else {
                emit_expr(c, a);
            }
            a = c.^.nodes[a].next;
        }
        let fi: u32 = c.^.nodes[e].d;
        let idx: u32 = c.^.fns[fi].index;
        b_idx(c, OP_CALL, idx);
        return;
    }
    if k == NodeKind.E_FIELD && c.^.nodes[e].d == 0 {
        // a slice's built-in field: 1 is `len`, 2 is `ptr`
        let which: u32 = c.^.nodes[e].aux;
        emit_expr(c, ea);
        if which == 2 {
            // (ptr, len) is on the stack; drop the len
            b_op(c, OP_DROP);
            return;
        }
        let t: u32 = temp(c);
        b_idx(c, OP_LOCAL_SET, t);
        b_op(c, OP_DROP);
        b_idx(c, OP_LOCAL_GET, t);
        release1(c, t);
        return;
    }
    if k == NodeKind.S_MATCH { emit_match_expr(c, e); return; }
    let pt: u32 = place_ty(c, e);
    emit_place_load(c, e, pt);
}

// --- stores ----------------------------------------------------------------

fn emit_store_common(c: &mut Ctx, ak: u32, arg: u32, ty: u32,
                     vk: u32, a1: u32, a2: u32, a3: u32) {
    let ta: u32 = temp(c);
    if ak == 0 { emit_addr(c, arg); } else { frame_addr(c, arg); }
    b_idx(c, OP_LOCAL_SET, ta);
    if ty_kind(c, ty) == TYK_SLICE {
        let tp: u32 = temp(c);
        let tl: u32 = temp(c);
        emit_value(c, vk, a1, a2, a3);
        b_idx(c, OP_LOCAL_SET, tl);
        b_idx(c, OP_LOCAL_SET, tp);
        b_idx(c, OP_LOCAL_GET, ta);
        b_idx(c, OP_LOCAL_GET, tp);
        b_mem(c, OP_I32_STORE, 2);
        b_idx(c, OP_LOCAL_GET, ta);
        b_i32const(c, 4);
        b_op(c, OP_I32_ADD);
        b_idx(c, OP_LOCAL_GET, tl);
        b_mem(c, OP_I32_STORE, 2);
        release2(c, tp, tl);
    } else {
        b_idx(c, OP_LOCAL_GET, ta);
        emit_value(c, vk, a1, a2, a3);
        store_op(c, ty);
    }
    release1(c, ta);
}

fn emit_store_slots(c: &mut Ctx, loc: u32, vk: u32, a1: u32, a2: u32, a3: u32) {
    let slot: u32 = c.^.locals[loc].slot;
    let lt: u32 = c.^.locals[loc].ty;
    emit_value(c, vk, a1, a2, a3);
    if ty_kind(c, lt) == TYK_SLICE {
        b_idx(c, OP_LOCAL_SET, slot + 1);
        b_idx(c, OP_LOCAL_SET, slot);
        return;
    }
    b_idx(c, OP_LOCAL_SET, slot);
}

fn emit_store_to(c: &mut Ctx, place: u32, vk: u32, a1: u32, a2: u32, a3: u32) {
    if in_wasm_local(c, place) {
        let loc: u32 = ident_local(c, place);
        emit_store_slots(c, loc, vk, a1, a2, a3);
        return;
    }
    let pt: u32 = place_ty(c, place);
    emit_store_common(c, 0, place, pt, vk, a1, a2, a3);
}

fn emit_store_local(c: &mut Ctx, loc: u32, vk: u32, a1: u32, a2: u32, a3: u32) {
    if !loc_in_memory(c, loc) {
        emit_store_slots(c, loc, vk, a1, a2, a3);
        return;
    }
    let lt: u32 = c.^.locals[loc].ty;
    emit_store_common(c, 1, loc, lt, vk, a1, a2, a3);
}

fn emit_field_store(c: &mut Ctx, ta: u32, off: u32, ty: u32, value: u32) {
    if ty_kind(c, ty) == TYK_SLICE {
        let tp: u32 = temp(c);
        let tl: u32 = temp(c);
        emit_expr(c, value);
        b_idx(c, OP_LOCAL_SET, tl);
        b_idx(c, OP_LOCAL_SET, tp);
        b_idx(c, OP_LOCAL_GET, ta);
        b_i32const(c, off);
        b_op(c, OP_I32_ADD);
        b_idx(c, OP_LOCAL_GET, tp);
        b_mem(c, OP_I32_STORE, 2);
        b_idx(c, OP_LOCAL_GET, ta);
        b_i32const(c, off + 4);
        b_op(c, OP_I32_ADD);
        b_idx(c, OP_LOCAL_GET, tl);
        b_mem(c, OP_I32_STORE, 2);
        release2(c, tp, tl);
        return;
    }
    b_idx(c, OP_LOCAL_GET, ta);
    b_i32const(c, off);
    b_op(c, OP_I32_ADD);
    emit_expr(c, value);
    store_op(c, ty);
}

fn is_agg_lit(c: &Ctx, e: u32) -> bool {
    let k: NodeKind = c.^.nodes[e].kind;
    if k == NodeKind.E_STRUCTLIT { return true; }
    if k == NodeKind.E_FIELD || k == NodeKind.E_CALL { return c.^.nodes[e].aux2 == 1; }
    return false;
}

// The literal is written straight into the destination -- no copy (language.md S5).
fn emit_agg_init(c: &mut Ctx, ta: u32, init: u32) {
    if c.^.nodes[init].kind == NodeKind.E_STRUCTLIT {
        let si: u32 = c.^.nodes[init].d;
        let mut lf: u32 = c.^.nodes[init].c;
        let mut f: u32 = c.^.structs[si].fields;
        for lf != 0 {
            let off: u32 = c.^.fields[f].off;
            let ft: u32 = c.^.fields[f].ty;
            let v: u32 = c.^.nodes[lf].c;
            emit_field_store(c, ta, off, ft, v);
            lf = c.^.nodes[lf].next;
            f = c.^.fields[f].next;
        }
        return;
    }
    let v: u32 = c.^.nodes[init].aux;
    let tag: u32 = c.^.variants[v].tag;
    b_idx(c, OP_LOCAL_GET, ta);
    b_i32const(c, 0);
    b_op(c, OP_I32_ADD);
    b_i32const(c, tag);
    b_mem(c, OP_I32_STORE, 2);
    let mut a: u32 = 0;
    if c.^.nodes[init].kind == NodeKind.E_CALL { a = c.^.nodes[init].b; }
    let mut f: u32 = c.^.variants[v].payload;
    for a != 0 {
        let off: u32 = c.^.fields[f].off;
        let ft: u32 = c.^.fields[f].ty;
        emit_field_store(c, ta, off, ft, a);
        a = c.^.nodes[a].next;
        f = c.^.fields[f].next;
    }
}

// --- statements ------------------------------------------------------------

fn emit_epilogue(c: &mut Ctx) {
    let fi: u32 = c.^.efn;
    let frame: u32 = c.^.fns[fi].frame;
    if frame != 0 {
        b_idx(c, OP_GLOBAL_GET, 0);
        b_i32const(c, frame);
        b_op(c, OP_I32_ADD);
        b_idx(c, OP_GLOBAL_SET, 0);
    }
}

fn emit_block(c: &mut Ctx, head: u32) {
    let mut s: u32 = head;
    for s != 0 {
        emit_stmt(c, s);
        s = c.^.nodes[s].next;
    }
}

// A statement match makes no value (a block per arm); an expression match
// makes one (a value per arm). Everything else about the two is identical, so
// one core does both (implementation.md S5).
fn emit_arm_body(c: &mut Ctx, arm: u32, is_expr: bool) {
    let body: u32 = c.^.nodes[arm].d;
    if is_expr { emit_expr(c, body); } else { emit_block(c, body); }
}

fn emit_match_core(c: &mut Ctx, s: u32, is_expr: bool) {
    let ta: u32 = temp(c);
    let scr: u32 = c.^.nodes[s].a;
    let scalar: u32 = c.^.nodes[s].aux2;
    // the tag is the value: no address, no load
    if scalar != 0 { emit_expr(c, scr); } else { emit_addr(c, scr); }
    b_idx(c, OP_LOCAL_SET, ta);
    if is_expr { b_blocked(c, OP_BLOCK, TYPE_I32); } else { b_blocked(c, OP_BLOCK, BLOCK_VOID); }
    ctrl_push(c, CTRL_MATCH);
    let mut arm: u32 = c.^.nodes[s].b;
    for arm != 0 {
        if c.^.nodes[arm].e != 0 {
            emit_arm_body(c, arm, is_expr);
        } else {
            let v: u32 = c.^.nodes[arm].aux;
            let tag: u32 = c.^.variants[v].tag;
            b_idx(c, OP_LOCAL_GET, ta);
            if scalar == 0 {
                b_i32const(c, 0);
                b_op(c, OP_I32_ADD);
                b_mem(c, OP_I32_LOAD, 2);
            }
            b_i32const(c, tag);
            b_op(c, cmp_opcode(Punct.EqEq, false));
            let mut alt: u32 = c.^.nodes[arm].aux2;
            for alt != 0 {
                let av: u32 = c.^.nodes[alt].aux;
                let atag: u32 = c.^.variants[av].tag;
                b_idx(c, OP_LOCAL_GET, ta);
                if scalar == 0 {
                    b_i32const(c, 0);
                    b_op(c, OP_I32_ADD);
                    b_mem(c, OP_I32_LOAD, 2);
                }
                b_i32const(c, atag);
                b_op(c, cmp_opcode(Punct.EqEq, false));
                b_op(c, OP_I32_OR);
                alt = c.^.nodes[alt].next;
            }
            b_blocked(c, OP_IF, BLOCK_VOID);
            ctrl_push(c, CTRL_IF);
            let mut b: u32 = c.^.nodes[arm].c;
            let mut f: u32 = c.^.variants[v].payload;
            for b != 0 {
                let loc: u32 = c.^.nodes[b].aux;
                let off: u32 = c.^.fields[f].off;
                let ft: u32 = c.^.fields[f].ty;
                emit_store_local(c, loc, 1, ta, off, ft);
                b = c.^.nodes[b].next;
                f = c.^.fields[f].next;
            }
            emit_arm_body(c, arm, is_expr);
            let d: u32 = depth_to(c, CTRL_MATCH);
            b_idx(c, OP_BR, d);
            ctrl_pop(c);
            b_op(c, OP_END);
        }
        arm = c.^.nodes[arm].next;
    }
    if c.^.nodes[s].d == 0 { b_op(c, OP_UNREACHABLE); }
    ctrl_pop(c);
    b_op(c, OP_END);
    release1(c, ta);
}

fn emit_match(c: &mut Ctx, s: u32) { emit_match_core(c, s, false); }

fn emit_match_expr(c: &mut Ctx, e: u32) { emit_match_core(c, e, true); }

fn emit_stmt(c: &mut Ctx, s: u32) {
    let k: NodeKind = c.^.nodes[s].kind;
    let sa: u32 = c.^.nodes[s].a;
    let sb: u32 = c.^.nodes[s].b;
    let sc: u32 = c.^.nodes[s].c;
    let sd: u32 = c.^.nodes[s].d;

    if k == NodeKind.S_LET {
        let loc: u32 = c.^.nodes[s].aux;
        if is_agg_lit(c, sd) {
            let ta: u32 = temp(c);
            frame_addr(c, loc);
            b_idx(c, OP_LOCAL_SET, ta);
            emit_agg_init(c, ta, sd);
            release1(c, ta);
            return;
        }
        emit_store_local(c, loc, 0, sd, 0, 0);
        return;
    }

    if k == NodeKind.S_ASSIGN {
        let op: Punct = c.^.nodes[s].op;
        if op == Punct.Eq {
            if is_agg_lit(c, sc) {
                let ta: u32 = temp(c);
                emit_addr(c, sa);
                b_idx(c, OP_LOCAL_SET, ta);
                emit_agg_init(c, ta, sc);
                release1(c, ta);
                return;
            }
            emit_store_to(c, sa, 0, sc, 0, 0);
            return;
        }
        let base: Punct = assign_base_op(op);
        let ty: u32 = place_ty(c, sa);
        let rt: u32 = read_ty(c, ty);
        let signed: bool = ty_kind(c, rt) == TYK_I32;
        if in_wasm_local(c, sa) {
            let loc: u32 = ident_local(c, sa);
            let slot: u32 = c.^.locals[loc].slot;
            b_idx(c, OP_LOCAL_GET, slot);
            emit_expr(c, sc);
            b_op(c, arith_op(base, signed));
            b_idx(c, OP_LOCAL_SET, slot);
            return;
        }
        let ta: u32 = temp(c);
        emit_addr(c, sa);
        b_idx(c, OP_LOCAL_SET, ta);
        b_idx(c, OP_LOCAL_GET, ta);
        b_idx(c, OP_LOCAL_GET, ta);
        load_op(c, ty);
        emit_expr(c, sc);
        b_op(c, arith_op(base, signed));
        store_op(c, ty);
        release1(c, ta);
        return;
    }

    if k == NodeKind.S_EXPR {
        emit_expr(c, sa);
        if c.^.nodes[s].aux != 0 {
            let et: u32 = c.^.nodes[sa].ty;
            let n: u32 = slot_count(c, et);
            for let mut i: u32 = 0; i < n; i += 1 { b_op(c, OP_DROP); }
        }
        return;
    }

    if k == NodeKind.S_IF {
        emit_expr(c, sa);
        b_blocked(c, OP_IF, BLOCK_VOID);
        ctrl_push(c, CTRL_IF);
        emit_block(c, sb);
        if sd != 0 {
            b_op(c, OP_ELSE);
            emit_block(c, sc);
        }
        ctrl_pop(c);
        b_op(c, OP_END);
        return;
    }

    if k == NodeKind.S_FOR {
        if sa != 0 { emit_stmt(c, sa); }
        b_blocked(c, OP_BLOCK, BLOCK_VOID);
        ctrl_push(c, CTRL_BRK);
        b_blocked(c, OP_LOOP, BLOCK_VOID);
        ctrl_push(c, CTRL_LOOP);
        if sb != 0 {
            emit_expr(c, sb);
            b_op(c, OP_I32_EQZ);
            let d: u32 = depth_to(c, CTRL_BRK);
            b_idx(c, OP_BR_IF, d);
        }
        b_blocked(c, OP_BLOCK, BLOCK_VOID);
        ctrl_push(c, CTRL_CNT);
        emit_block(c, sd);
        ctrl_pop(c);
        b_op(c, OP_END);
        if sc != 0 { emit_stmt(c, sc); }
        let dl: u32 = depth_to(c, CTRL_LOOP);
        b_idx(c, OP_BR, dl);
        ctrl_pop(c);
        b_op(c, OP_END);
        ctrl_pop(c);
        b_op(c, OP_END);
        return;
    }

    if k == NodeKind.S_BREAK {
        let d: u32 = depth_to(c, CTRL_BRK);
        b_idx(c, OP_BR, d);
        return;
    }
    if k == NodeKind.S_CONTINUE {
        let d: u32 = depth_to(c, CTRL_CNT);
        b_idx(c, OP_BR, d);
        return;
    }

    if k == NodeKind.S_RETURN {
        if sa != 0 { emit_expr(c, sa); }
        emit_epilogue(c);
        b_op(c, OP_RETURN);
        return;
    }

    if k == NodeKind.S_MATCH { emit_match(c, s); return; }
    if k == NodeKind.S_UNSAFE { emit_block(c, sa); return; }
}

// --- functions -------------------------------------------------------------

fn emit_fn(c: &mut Ctx, fi: u32) {
    assign_storage(c, fi);
    c.^.wb = S1;
    c.^.ntemp = 0;
    c.^.free_n = 0;
    c.^.ctrl_n = 0;
    c.^.efn = fi;

    let frame: u32 = c.^.fns[fi].frame;
    if frame != 0 {
        b_idx(c, OP_GLOBAL_GET, 0);
        b_i32const(c, frame);
        b_op(c, OP_I32_SUB);
        b_idx(c, OP_GLOBAL_SET, 0);
        b_idx(c, OP_GLOBAL_GET, 0);
        b_i32const(c, SHADOW_FLOOR);
        b_op(c, OP_I32_LT_U);
        b_blocked(c, OP_IF, BLOCK_VOID);
        b_op(c, OP_UNREACHABLE);
        b_op(c, OP_END);
    }
    // a parameter whose address is taken is copied into the frame (implementation.md S6)
    let mut loc: u32 = c.^.fns[fi].locals;
    for loc != 0 {
        if c.^.locals[loc].is_param != 0 && c.^.locals[loc].foff != NONE {
            let slot: u32 = c.^.locals[loc].slot;
            let lt: u32 = c.^.locals[loc].ty;
            frame_addr(c, loc);
            if ty_kind(c, lt) == TYK_SLICE {
                let ta: u32 = temp(c);
                b_idx(c, OP_LOCAL_SET, ta);
                b_idx(c, OP_LOCAL_GET, ta);
                b_idx(c, OP_LOCAL_GET, slot);
                b_mem(c, OP_I32_STORE, 2);
                b_idx(c, OP_LOCAL_GET, ta);
                b_i32const(c, 4);
                b_op(c, OP_I32_ADD);
                b_idx(c, OP_LOCAL_GET, slot + 1);
                b_mem(c, OP_I32_STORE, 2);
                release1(c, ta);
            } else {
                b_idx(c, OP_LOCAL_GET, slot);
                store_op(c, lt);
            }
        }
        loc = c.^.locals[loc].next;
    }

    let d: u32 = c.^.fns[fi].decl;
    let body: u32 = c.^.nodes[d].e;
    emit_block(c, body);
    emit_epilogue(c);
    let ret: u32 = c.^.fns[fi].ret;
    if ty_kind(c, ret) != TYK_VOID { b_op(c, OP_UNREACHABLE); }
    b_op(c, OP_END);

    let nlocals: u32 = c.^.fns[fi].nlslot + c.^.ntemp;
    let mut declsize: u32 = 1;
    if nlocals != 0 { declsize = 1 + leb_u_len(nlocals) + 1; }
    let codelen: u32 = c.^.wb - S1;
    s_u(c, declsize + codelen);
    if nlocals == 0 {
        s_u(c, 0);
    } else {
        s_u(c, 1);
        s_u(c, nlocals);
        s_ch(c, TYPE_I32);
    }
    w_copy(c, W_SEC, S1, codelen);
}

// --- the module (implementation.md S4) -------------------------------------

fn sig_of(c: &Ctx, fi: u32) -> u32 {
    let mut n: u32 = 0;
    let mut p: u32 = c.^.fns[fi].params;
    for p != 0 {
        let pt: u32 = c.^.params[p].ty;
        n += slot_count(c, pt);
        p = c.^.params[p].next;
    }
    // every wasm type here is i32, so the shape is (count, has-result)
    let ret: u32 = c.^.fns[fi].ret;
    if ty_kind(c, ret) == TYK_VOID { return n * 2; }
    return n * 2 + 1;
}

fn type_idx(c: &mut Ctx, sig: u32) -> u32 {
    let n: u32 = c.^.nsigs;
    for let mut i: u32 = 0; i < n; i += 1 {
        if c.^.sigs[i] == sig { return i; }
    }
    c.^.sigs[n] = sig;
    c.^.nsigs = n + 1;
    return n;
}

fn begin_section(c: &mut Ctx) { c.^.ws = S2; }

fn end_section(c: &mut Ctx, id: u32) {
    let n: u32 = c.^.ws - S2;
    w_ch(c, W_OUT, id);
    w_u(c, W_OUT, n);
    w_copy(c, W_OUT, S2, n);
}

fn emit_module(c: &mut Ctx) {
    for let mut fi: u32 = 1; fi < c.^.nfn; fi += 1 {
        let sig: u32 = sig_of(c, fi);
        type_idx(c, sig);
    }

    out_reset(c);
    put_ch(c, 0);
    put_ch(c, 'a');
    put_ch(c, 's');
    put_ch(c, 'm');
    put_ch(c, 1);
    put_ch(c, 0);
    put_ch(c, 0);
    put_ch(c, 0);

    let nfns: u32 = c.^.nfns;
    let nsigs: u32 = c.^.nsigs;

    if nsigs != 0 {
        begin_section(c);
        s_u(c, nsigs);
        for let mut i: u32 = 0; i < nsigs; i += 1 {
            let sig: u32 = c.^.sigs[i];
            let np: u32 = sig / 2;
            s_ch(c, 0x60);
            s_u(c, np);
            for let mut j: u32 = 0; j < np; j += 1 { s_ch(c, TYPE_I32); }
            if sig % 2 == 0 {
                s_u(c, 0);
            } else {
                s_u(c, 1);
                s_ch(c, TYPE_I32);
            }
        }
        end_section(c, SEC_TYPE);
    }

    if nfns != 0 {
        begin_section(c);
        s_u(c, nfns);
        for let mut fi: u32 = 1; fi < c.^.nfn; fi += 1 {
            let sig: u32 = sig_of(c, fi);
            let ti: u32 = type_idx(c, sig);
            s_u(c, ti);
        }
        end_section(c, SEC_FUNC);
    }

    begin_section(c);
    s_u(c, 1);
    s_ch(c, 0x01);
    s_u(c, MEM_PAGES);
    s_u(c, MEM_PAGES);
    end_section(c, SEC_MEM);

    begin_section(c);
    s_u(c, 1);
    s_ch(c, TYPE_I32);
    s_ch(c, 0x01);
    s_ch(c, OP_I32_CONST);
    w_s(c, W_SEC, SHADOW_TOP);
    s_ch(c, OP_END);
    end_section(c, SEC_GLOBAL);

    begin_section(c);
    s_u(c, nfns + 1);
    for let mut fi: u32 = 1; fi < c.^.nfn; fi += 1 {
        let ns: u32 = c.^.fns[fi].name;
        let idx: u32 = c.^.fns[fi].index;
        let ln: u32 = name_len(c, ns);
        s_u(c, ln);
        w_name(c, W_SEC, ns);
        s_ch(c, 0x00);
        s_u(c, idx);
    }
    s_u(c, 6);
    s_ch(c, 'm');
    s_ch(c, 'e');
    s_ch(c, 'm');
    s_ch(c, 'o');
    s_ch(c, 'r');
    s_ch(c, 'y');
    s_ch(c, 0x02);
    s_u(c, 0);
    end_section(c, SEC_EXPORT);

    if nfns != 0 {
        begin_section(c);
        s_u(c, nfns);
        // One body at a time: parse it above the declarations, check it,
        // emit it, then hand the space back (gh #5 C). `nnode` is the
        // watermark the declarations ended at.
        let mark: u32 = c.^.nnode;
        for let mut fi: u32 = 1; fi < c.^.nfn && !failed(c); fi += 1 {
            c.^.nnode = mark;
            parse_fn_body(c, fi);
            if !failed(c) { check_fn(c, fi); }
            if !failed(c) { emit_fn(c, fi); }
        }
        // A body is checked while the module is already half written, so a
        // diagnostic has to stop the writing too. err_open has reset `out`
        // to the start; anything appended after it would trail the message.
        if failed(c) { return; }
        end_section(c, SEC_CODE);
    }

    if c.^.nstr > 1 {
        let nstr: u32 = c.^.nstr - 1;
        begin_section(c);
        s_u(c, nstr);
        for let mut sp: u32 = 1; sp < c.^.nstr; sp += 1 {
            let addr: u32 = c.^.strs[sp].addr;
            let ptr: u32 = c.^.strs[sp].ptr;
            let len: u32 = c.^.strs[sp].len;
            s_ch(c, 0x00);
            s_ch(c, OP_I32_CONST);
            w_s(c, W_SEC, addr);
            s_ch(c, OP_END);
            s_u(c, len);
            w_copy(c, W_SEC, ptr, len);
        }
        end_section(c, SEC_DATA);
    }
}

// ===========================================================================
// Arena sizing
// ===========================================================================
//
// Every table is bounded by a count of AST nodes of one kind, so one linear
// pass over the node arena sizes all of them exactly. Guessing from the source
// length instead would reserve megabytes that are never touched.

struct Counts {
    tys: u32,
    fields: u32,
    structs: u32,
    variants: u32,
    enums: u32,
    consts: u32,
    params: u32,
    fns: u32,
    lets: u32,
    binds: u32,
    strs: u32,
}

// Counts nodes [lo, hi). A body is counted just before its nodes are dropped,
// so the tables it feeds are sized as if the whole AST had been kept.
fn count_range(c: &mut Ctx, lo: u32, hi: u32) {
    for let mut i: u32 = lo; i < hi; i += 1 {
        match c.^.nodes[i].kind {
            // this used to read `k >= T_PRIM && k <= T_PTR`, which quietly
            // depended on the five type kinds being numbered next to each
            // other. An enum has no ordering, so the group has to be spelled.
            T_PRIM | T_NAMED | T_SLICE | T_REF | T_PTR => { c.^.ck_tys += 1; }
            D_FIELD => { c.^.ck_fields += 1; }
            D_STRUCT => { c.^.ck_structs += 1; }
            D_VARIANT => { c.^.ck_variants += 1; }
            D_ENUM => { c.^.ck_enums += 1; }
            D_CONST => { c.^.ck_consts += 1; }
            D_PARAM => { c.^.ck_params += 1; }
            D_FN => { c.^.ck_fns += 1; }
            S_LET => { c.^.ck_lets += 1; }
            S_BIND => { c.^.ck_binds += 1; }
            E_STR => { c.^.ck_strs += 1; }
            _ => { }
        }
    }
}

fn init_types(c: &mut Ctx) {
    c.^.types[TY_I32] = Ty.I32;
    c.^.types[TY_U32] = Ty.U32;
    c.^.types[TY_BOOL] = Ty.Bool;
    c.^.types[TY_U8] = Ty.U8;
    c.^.types[TY_VOID] = Ty.Void;
    c.^.types[TY_INTLIT] = Ty.IntLit;
    c.^.nty = TY_FIRST;
}

// The arenas grow up from the source and S1 is fixed. If the heap ever reaches
// it, two compiler-owned regions alias. The limit belongs to the target, not to
// the language, but cool0.py enforces the same one so the two never diverge
// (implementation.md S7).
fn e_too_large(c: &mut Ctx) {
    err_msg(c, 1, 1, "program is too large for the compiler's memory");
}

fn heap_fits(c: &Ctx) -> bool { return c.^.heap <= S1; }

// How many nodes can be alive at once (gh #5 C): every declaration, plus the
// largest single function body -- bodies are parsed one at a time and dropped.
// There is at most one node per token, so counting tokens bounds it.
//
// A body is what sits between the braces that follow a top-level `fn`. Braces
// belonging to a struct or enum declaration are at depth 0 with no `fn` in
// front, so they count as declarations, which is right -- they stay.
//
// Unbalanced braces can only make `body_total` smaller and the answer larger,
// so a malformed source is never under-reserved; it is rejected later by the
// parser anyway.
fn arena_bound(c: &Ctx) -> u32 {
    let mut depth: u32 = 0;
    let mut isfn: bool = false;
    let mut bstart: u32 = 0;
    let mut body_total: u32 = 0;
    let mut body_max: u32 = 0;
    for let mut i: u32 = 0; i < c.^.ntok; i += 1 {
        let k: TokKind = c.^.toks[i].kind;
        if depth == 0 && k == TokKind.TK_KW && c.^.toks[i].kw == Kw.K_FN { isfn = true; }
        if k == TokKind.TK_PUNCT {
            let p: Punct = c.^.toks[i].punct;
            if p == Punct.LBrace {
                if depth == 0 && isfn { bstart = i; }
                depth += 1;
            } else if p == Punct.RBrace {
                if depth > 0 { depth -= 1; }
                if depth == 0 && isfn {
                    let n: u32 = i - bstart + 1;
                    body_total = body_total + n;
                    if n > body_max { body_max = n; }
                    isfn = false;
                }
            }
        }
    }
    return c.^.ntok - body_total + body_max + 2;
}

fn pow2_at_least(v: u32) -> u32 {
    let mut p: u32 = 8;
    for p < v { p = p * 2; }
    return p;
}

// ===========================================================================
// Entry point (implementation.md S7)
// ===========================================================================

// The one-buffer entry point of implementation.md S7, kept exactly as it was:
// the host writes the source at SRC and calls this. It builds a one-entry
// descriptor table and hands over to compile_n, so there is a single code path.
fn compile(src_len_in: u32) -> i32 {
    stw(SRCTAB, SRC);
    stw(SRCTAB + 4, src_len_in);
    return compile_n(1);
}

// gh #5 B. `nsrc` (ptr, len) pairs live at SRCTAB. Buffers are compiled as if
// concatenated: line numbers continue across them.
fn compile_n(nsrc: u32) -> i32 {
    unsafe {
        // The heap starts past the last byte of the last buffer. Everything the
        // compiler builds is bump-allocated from here and never freed -- one
        // run, then the host reclaims the memory (language.md S1).
        let mut top: u32 = SRC;
        let mut total: u32 = 0;
        for let mut i: u32 = 0; i < nsrc; i += 1 {
            let p: u32 = ldw(SRCTAB + i * 8);
            let n: u32 = ldw(SRCTAB + i * 8 + 4);
            if p + n > top { top = p + n; }
            total = total + n;
        }
        let srctok_at: u32 = align4(top) + 4;
        let heap0: u32 = srctok_at + (nsrc + 1) * 4;

        // There can be no more tokens than source bytes, plus one for eof.
        let ntok_max: u32 = total + 1;
        // sizeof(Token). cool0 has no sizeof, so the number lives next to the
        // struct it measures -- getting it wrong overlaps the next arena
        let tok_bytes: u32 = ntok_max * SIZEOF_TOKEN;

        // This is the boundary. Below it every access is bounds-checked.
        let mut c: Ctx = Ctx{
            src: slice(SRC as *u8, 0),
            pos: 0,
            line: 1,
            col: 1,
            ck_tys: 0,
            ck_fields: 0,
            ck_structs: 0,
            ck_variants: 0,
            ck_enums: 0,
            ck_consts: 0,
            ck_params: 0,
            ck_fns: 0,
            ck_lets: 0,
            ck_binds: 0,
            ck_strs: 0,
            nsrc: nsrc,
            srctok: slice_mut(srctok_at as *u32, nsrc + 1),
            toks: slice_mut(heap0 as *Token, ntok_max),
            ntok: 0,
            nmem: slice_mut(heap0 as *u8, 0),
            nmem_n: 0,
            ntab: slice_mut(heap0 as *NameEnt, 0),
            ntab_n: 1,
            nhash: slice_mut(heap0 as *u32, 0),
            id_i32: 0,
            id_u32: 0,
            id_bool: 0,
            id_u8: 0,
            id_under: 0,
            id_len: 0,
            id_ptr: 0,
            nodes: slice_mut(heap0 as *Node, 0),
            nnode: 1,
            ti: 0,
            edepth: 0,
            bdepth: 0,
            decls: 0,
            types: slice_mut(heap0 as *Ty, 0),
            nty: TY_FIRST,
            fields: slice_mut(heap0 as *FieldI, 0),
            nfield: 1,
            structs: slice_mut(heap0 as *StructI, 0),
            nstruct: 1,
            variants: slice_mut(heap0 as *VariantI, 0),
            nvariant: 1,
            enums: slice_mut(heap0 as *EnumI, 0),
            nenum: 1,
            consts: slice_mut(heap0 as *ConstI, 0),
            nconst: 1,
            params: slice_mut(heap0 as *ParamI, 0),
            nparam: 1,
            fns: slice_mut(heap0 as *FnI, 0),
            nfn: 1,
            locals: slice_mut(heap0 as *LocalI, 0),
            nlocal: 1,
            strs: slice_mut(heap0 as *StrI, 0),
            nstr: 1,
            taken: slice_mut(heap0 as *NameI, 0),
            ntaken: 1,
            tynames: slice_mut(heap0 as *NameI, 0),
            ntyname: 1,
            scalars: slice_mut(heap0 as *NameI, 0),
            nscalar: 1,
            rodata: RODATA,
            cety: 0,
            scope: slice_mut(heap0 as *u32, 0),
            scope_n: 0,
            marks: slice_mut(heap0 as *u32, 0),
            marks_n: 0,
            curfn: 0,
            loopd: 0,
            unsafed: 0,
            place_mut: 0,
            place_root: 0,
            nfns: 0,
            wb: S1,
            ws: S2,
            sigs: slice_mut(heap0 as *u32, 0),
            nsigs: 0,
            ntemp: 0,
            free: slice_mut(heap0 as *u32, 0),
            free_n: 0,
            ctrl: slice_mut(heap0 as *u32, 0),
            ctrl_n: 0,
            efn: 0,
            heap: heap0 + tok_bytes,
            err: 0,
            out: OUT,
        };

        // before lexing: the token arena alone can reach S1
        if !heap_fits(&c) { e_too_large(&mut c); }

        if c.err == 0 { lex_all(&mut c); }

        // Names, sized exactly off the tokens (gh #5 A). Doing this here rather
        // than during lexing is what makes "exactly" possible: the byte count
        // and the identifier count are both readable from the token array.
        if c.err == 0 {
            let mut nb: u32 = 0;
            let mut nid: u32 = 0;
            for let mut i: u32 = 0; i < c.ntok; i += 1 {
                if c.toks[i].kind == TokKind.TK_IDENT {
                    nb = nb + c.toks[i].len;
                    nid = nid + 1;
                }
            }
            // the well-known names above need not appear in the source
            nb = nb + WELLKNOWN_BYTES;
            nid = nid + WELLKNOWN_COUNT;
            c.nmem = slice_mut(c.heap as *u8, nb);
            c.heap = align4(c.heap + nb);
            let ntab_max: u32 = nid + 1;
            c.ntab = slice_mut(c.heap as *NameEnt, ntab_max);
            c.heap = c.heap + ntab_max * 8;
            let nh: u32 = pow2_at_least(ntab_max + ntab_max);
            c.nhash = slice_mut(c.heap as *u32, nh);
            c.heap = c.heap + nh * 4;
            if !heap_fits(&c) { e_too_large(&mut c); }
            if c.err == 0 {
                // wasm hands out zeroed memory, but an empty table is a
                // correctness precondition here, not a happy accident.
                for let mut i: u32 = 0; i < nh; i += 1 { c.nhash[i] = 0; }
                let w1: u32 = intern(&mut c, "i32");
                c.id_i32 = w1;
                let w2: u32 = intern(&mut c, "u32");
                c.id_u32 = w2;
                let w3: u32 = intern(&mut c, "bool");
                c.id_bool = w3;
                let w4: u32 = intern(&mut c, "u8");
                c.id_u8 = w4;
                let w5: u32 = intern(&mut c, "_");
                c.id_under = w5;
                let w6: u32 = intern(&mut c, "len");
                c.id_len = w6;
                let w7: u32 = intern(&mut c, "ptr");
                c.id_ptr = w7;
                intern_idents(&mut c);
            }
        }

        // The node arena is sized from the token count, not the source length --
        // there is at most one node per token and tokens are far fewer than
        // bytes. Sizing it before lexing would reserve megabytes for nothing.
        //
        // And not from *all* the tokens either: the declarations plus the
        // largest single body is what is alive at once (gh #5 C).
        if c.err == 0 {
            let nmax: u32 = arena_bound(&c);
            c.nodes = slice_mut(c.heap as *Node, nmax);
            let nodes_at: u32 = c.heap;
            c.heap = c.heap + nmax * SIZEOF_NODE;
            if !heap_fits(&c) { e_too_large(&mut c); }
            if c.err == 0 { parse_program(&mut c); }
            stw(G_NODES, nodes_at);
            stw(G_DECLS, c.decls);
        }

        if c.err == 0 {
            // The declarations are still in the arena; every body was counted
            // into c.ck_* as it was parsed and dropped (gh #5 C).
            let ndecl: u32 = c.nnode;
            count_range(&mut c, 1, ndecl);
            let mut k: Counts = Counts{
                tys: c.ck_tys,
                fields: c.ck_fields,
                structs: c.ck_structs,
                variants: c.ck_variants,
                enums: c.ck_enums,
                consts: c.ck_consts,
                params: c.ck_params,
                fns: c.ck_fns,
                lets: c.ck_lets,
                binds: c.ck_binds,
                strs: c.ck_strs,
            };

            let n_ty: u32 = k.tys + TY_FIRST + 8;
            c.types = slice_mut(c.heap as *Ty, n_ty);
            c.heap = c.heap + n_ty * 12;

            let n_field: u32 = k.fields + k.tys + 2;
            c.fields = slice_mut(c.heap as *FieldI, n_field);
            c.heap = c.heap + n_field * 20;

            let n_struct: u32 = k.structs + 2;
            c.structs = slice_mut(c.heap as *StructI, n_struct);
            c.heap = c.heap + n_struct * 24;

            let n_variant: u32 = k.variants + 2;
            c.variants = slice_mut(c.heap as *VariantI, n_variant);
            c.heap = c.heap + n_variant * 24;

            let n_enum: u32 = k.enums + 2;
            c.enums = slice_mut(c.heap as *EnumI, n_enum);
            c.heap = c.heap + n_enum * 28;

            let n_const: u32 = k.consts + 2;
            c.consts = slice_mut(c.heap as *ConstI, n_const);
            c.heap = c.heap + n_const * 28;

            let n_param: u32 = k.params + 2;
            c.params = slice_mut(c.heap as *ParamI, n_param);
            c.heap = c.heap + n_param * 16;

            let n_fn: u32 = k.fns + 2;
            c.fns = slice_mut(c.heap as *FnI, n_fn);
            c.heap = c.heap + n_fn * 52;

            let n_local: u32 = k.params + k.lets + k.binds + 2;
            c.locals = slice_mut(c.heap as *LocalI, n_local);
            c.heap = c.heap + n_local * 36;

            let n_str: u32 = k.strs + 2;
            c.strs = slice_mut(c.heap as *StrI, n_str);
            c.heap = c.heap + n_str * 16;

            let n_name: u32 = k.structs + k.enums + k.consts + k.fns + 2;
            c.taken = slice_mut(c.heap as *NameI, n_name);
            c.heap = c.heap + n_name * 12;
            c.tynames = slice_mut(c.heap as *NameI, n_name);
            c.heap = c.heap + n_name * 12;
            c.scalars = slice_mut(c.heap as *NameI, n_name);
            c.heap = c.heap + n_name * 12;

            let n_scope: u32 = n_local + 2;
            c.scope = slice_mut(c.heap as *u32, n_scope);
            c.heap = c.heap + n_scope * 4;
            let n_mark: u32 = MAX_DEPTH + MAX_DEPTH + 8;
            c.marks = slice_mut(c.heap as *u32, n_mark);
            c.heap = c.heap + n_mark * 4;

            let n_stack: u32 = 512;
            c.free = slice_mut(c.heap as *u32, n_stack);
            c.heap = c.heap + n_stack * 4;
            c.ctrl = slice_mut(c.heap as *u32, n_stack);
            c.heap = c.heap + n_stack * 4;
            let n_sig: u32 = (k.fns + 2) * 3;
            c.sigs = slice_mut(c.heap as *u32, n_sig);
            c.heap = c.heap + n_sig * 4;

            if !heap_fits(&c) { e_too_large(&mut c); }
            init_types(&mut c);
            if c.err == 0 { check_program(&mut c); }
            if c.err == 0 { emit_module(&mut c); }
        }

        // debug window for the workbench
        let toks_at: u32 = heap0;
        let nmem_at: u32 = c.nmem.ptr as u32;
        let ntab_at: u32 = c.ntab.ptr as u32;
        stw(G_NMEM, nmem_at);
        stw(G_NTAB, ntab_at);
        stw(G_TOKS, toks_at);
        stw(G_NTOK, c.ntok);
        stw(G_ERR, c.err);

        stw(OUT_PTR_ADDR, OUT);
        stw(OUT_LEN_ADDR, c.out - OUT);
        if c.err != 0 { return 1; }
        return 0;
    }
}

fn stw(a: u32, v: u32) { unsafe { let p: *u32 = a as *u32; p.^ = v; } }
