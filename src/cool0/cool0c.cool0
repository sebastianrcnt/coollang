// ===========================================================================
// cool0c -- the cool0 compiler, written in cool0
//
// It implements spec/ and must emit byte-identical output to cool0.py
// (implementation.md S8).
//
// This file uses cool0 the way cool0 is meant to be used. That is the point of
// it existing at all -- a compiler is the program cool0 was designed for, so
// the compiler is the proof:
//
//     struct        records with named fields, not u32 arrays and offsets
//     enum + match  every sum type is a real sum type, dispatched by match
//     []T / []mut T arenas are slices, so every index is bounds-checked
//     &T / &mut T   the compiler context is borrowed, not global
//     slice_mut     the one place raw memory becomes a checked arena
//
// `unsafe` appears in exactly two kinds of place: the raw byte accessors used
// to write the output buffer, and the arena constructors in `compile`. Nothing
// in the lexer, parser, checker, or emitter dereferences a raw pointer.
//
// cool0 has no mutable globals, so state lives in one `Ctx` that is threaded
// through as `&mut Ctx`. That is not a workaround -- it is what makes the data
// flow visible.
// ===========================================================================

// --- memory map (implementation.md S7) -------------------------------------

const OUT_PTR_ADDR: u32 = 0x0000;
const OUT_LEN_ADDR: u32 = 0x0004;
const SRC: u32 = 0x1000;

// Debug window. The workbench (tests/test_cool0c.py) reads these to compare
// stages against the oracle. They are written once per stage and never read
// by the compiler itself.
const G_ERR: u32 = 0x0014;
const G_NTOK: u32 = 0x002C;
const G_TOKS: u32 = 0x0030;
const G_DECLS: u32 = 0x0040;
const G_NODES: u32 = 0x0044;

// regions
const S1: u32 = 0x0080_0000;   // scratch for one function body
const S2: u32 = 0x00A0_0000;   // scratch for one section payload
const OUT: u32 = 0x0101_0000;  // final output; 0x0100_0000 is this module's rodata

const NONE: u32 = 0xFFFF_FFFF;

// --- raw memory ------------------------------------------------------------
//
// The only raw pointers in the compiler. Everything above this line is a
// slice, and every slice index is checked.

fn ldb(a: u32) -> u32 { unsafe { let p: *u8 = a as *u8; return p.^; } }

fn stb(a: u32, v: u32) { unsafe { let p: *u8 = a as *u8; p.^ = v; } }

fn align4(v: u32) -> u32 { return (v + 3) / 4 * 4; }

// ===========================================================================
// The compiler context
// ===========================================================================

struct Ctx {
    // source and lexer cursor
    src: []u8,
    pos: u32,
    line: u32,
    col: u32,

    // tokens
    toks: []mut Token,
    ntok: u32,

    // AST arena and parser cursor. Node index 0 means "none".
    nodes: []mut Node,
    nnode: u32,
    ti: u32,
    edepth: u32,
    bdepth: u32,
    decls: u32,

    // checker tables. Each is an arena whose index 0 means "none".
    types: []mut Ty,
    nty: u32,
    fields: []mut FieldI,
    nfield: u32,
    structs: []mut StructI,
    nstruct: u32,
    variants: []mut VariantI,
    nvariant: u32,
    enums: []mut EnumI,
    nenum: u32,
    consts: []mut ConstI,
    nconst: u32,
    params: []mut ParamI,
    nparam: u32,
    fns: []mut FnI,
    nfn: u32,
    locals: []mut LocalI,
    nlocal: u32,
    strs: []mut StrI,
    nstr: u32,
    taken: []mut NameI,
    ntaken: u32,
    tynames: []mut NameI,
    ntyname: u32,
    rodata: u32,

    // bump heap for string literal bodies. Nothing is ever freed -- the
    // compiler runs once and the host reclaims the memory.
    heap: u32,

    // diagnostics. Only the first error writes; the rest are dropped.
    err: u32,
    out: u32,
}

// --- output buffer ---------------------------------------------------------

fn out_reset(c: &mut Ctx) { c.^.out = OUT; }

fn put_ch(c: &mut Ctx, ch: u32) {
    stb(c.^.out, ch);
    c.^.out = c.^.out + 1;
}

fn put_str(c: &mut Ctx, s: []u8) {
    for let mut i: u32 = 0; i < s.len; i += 1 { put_ch(c, s[i]); }
}

fn put_src(c: &mut Ctx, start: u32, len: u32) {
    for let mut i: u32 = 0; i < len; i += 1 {
        let b: u32 = c.^.src[start + i];
        put_ch(c, b);
    }
}

fn put_num(c: &mut Ctx, v: u32) {
    if v >= 10 { put_num(c, v / 10); }
    put_ch(c, '0' + v % 10);
}

// --- diagnostics (implementation.md S9) ------------------------------------

fn failed(c: &Ctx) -> bool { return c.^.err != 0; }

// Stop at the first error. Only the winner writes its message.
fn err_open(c: &mut Ctx, line: u32, col: u32) -> bool {
    if failed(c) { return false; }
    c.^.err = 1;
    out_reset(c);
    put_num(c, line);
    put_ch(c, ':');
    put_num(c, col);
    put_ch(c, ':');
    put_ch(c, ' ');
    return true;
}

fn err_end(c: &mut Ctx) { put_ch(c, '\n'); }

// A diagnostic that is just one fixed phrase
fn err_msg(c: &mut Ctx, line: u32, col: u32, s: []u8) {
    if err_open(c, line, col) {
        put_str(c, s);
        err_end(c);
    }
}

// ===========================================================================
// Tokens (language.md S2)
// ===========================================================================

const TK_EOF: u32 = 0;
const TK_IDENT: u32 = 1;
const TK_INT: u32 = 2;
const TK_CHAR: u32 = 3;
const TK_STR: u32 = 4;
const TK_KW: u32 = 5;
const TK_PUNCT: u32 = 6;

struct Token {
    kind: u32,
    start: u32,
    len: u32,
    value: u32,   // int/char value, punct/keyword id, or string body address
    line: u32,
    col: u32,
    aux: u32,     // decoded length of a string literal
}

// keyword ids -- the order language.md S2 lists them in
const K_FN: u32 = 0;
const K_STRUCT: u32 = 1;
const K_ENUM: u32 = 2;
const K_CONST: u32 = 3;
const K_LET: u32 = 4;
const K_MUT: u32 = 5;
const K_IF: u32 = 6;
const K_ELSE: u32 = 7;
const K_FOR: u32 = 8;
const K_BREAK: u32 = 9;
const K_CONTINUE: u32 = 10;
const K_RETURN: u32 = 11;
const K_MATCH: u32 = 12;
const K_UNSAFE: u32 = 13;
const K_AS: u32 = 14;
const K_TRUE: u32 = 15;
const K_FALSE: u32 = 16;
const K_SLICE: u32 = 17;
const K_SLICE_MUT: u32 = 18;
const K_OFFSET: u32 = 19;

// punctuation ids -- longest match order
const P_SHLEQ: u32 = 0;
const P_SHREQ: u32 = 1;
const P_ARROW: u32 = 2;
const P_FATARROW: u32 = 3;
const P_EQEQ: u32 = 4;
const P_NE: u32 = 5;
const P_LE: u32 = 6;
const P_GE: u32 = 7;
const P_ANDAND: u32 = 8;
const P_OROR: u32 = 9;
const P_SHL: u32 = 10;
const P_SHR: u32 = 11;
const P_ADDEQ: u32 = 12;
const P_SUBEQ: u32 = 13;
const P_MULEQ: u32 = 14;
const P_DIVEQ: u32 = 15;
const P_MODEQ: u32 = 16;
const P_ANDEQ: u32 = 17;
const P_OREQ: u32 = 18;
const P_XOREQ: u32 = 19;
const P_LPAREN: u32 = 20;
const P_RPAREN: u32 = 21;
const P_LBRACE: u32 = 22;
const P_RBRACE: u32 = 23;
const P_LBRACK: u32 = 24;
const P_RBRACK: u32 = 25;
const P_COMMA: u32 = 26;
const P_SEMI: u32 = 27;
const P_COLON: u32 = 28;
const P_DOT: u32 = 29;
const P_EQ: u32 = 30;
const P_LT: u32 = 31;
const P_GT: u32 = 32;
const P_ADD: u32 = 33;
const P_SUB: u32 = 34;
const P_MUL: u32 = 35;
const P_DIV: u32 = 36;
const P_MOD: u32 = 37;
const P_AND: u32 = 38;
const P_OR: u32 = 39;
const P_XOR: u32 = 40;
const P_NOT: u32 = 41;

// ===========================================================================
// Lexer (language.md S2)
// ===========================================================================

// Byte predicates. Source is ASCII only.
fn is_alpha(b: u32) -> bool {
    return b >= 'A' && b <= 'Z' || b >= 'a' && b <= 'z';
}

fn is_digit(b: u32) -> bool { return b >= '0' && b <= '9'; }

fn is_ident_start(b: u32) -> bool { return is_alpha(b) || b == '_'; }

fn is_ident_cont(b: u32) -> bool { return is_alpha(b) || is_digit(b) || b == '_'; }

fn at(c: &Ctx, i: u32) -> u32 { return c.^.src[i]; }

fn adv(c: &mut Ctx, k: u32) {
    for let mut t: u32 = 0; t < k; t += 1 {
        let p: u32 = c.^.pos;
        if c.^.src[p] == '\n' {
            c.^.line = c.^.line + 1;
            c.^.col = 1;
        } else {
            c.^.col = c.^.col + 1;
        }
        c.^.pos = p + 1;
    }
}

// does source [start, start+len) equal s
fn src_eq(c: &Ctx, start: u32, len: u32, s: []u8) -> bool {
    if len != s.len { return false; }
    for let mut i: u32 = 0; i < len; i += 1 {
        if c.^.src[start + i] != s[i] { return false; }
    }
    return true;
}

// does source at i start with s
fn src_has(c: &Ctx, i: u32, s: []u8) -> bool {
    if i + s.len > c.^.src.len { return false; }
    for let mut k: u32 = 0; k < s.len; k += 1 {
        if c.^.src[i + k] != s[k] { return false; }
    }
    return true;
}

fn kw_id(c: &Ctx, start: u32, len: u32) -> u32 {
    if src_eq(c, start, len, "fn") { return K_FN; }
    if src_eq(c, start, len, "struct") { return K_STRUCT; }
    if src_eq(c, start, len, "enum") { return K_ENUM; }
    if src_eq(c, start, len, "const") { return K_CONST; }
    if src_eq(c, start, len, "let") { return K_LET; }
    if src_eq(c, start, len, "mut") { return K_MUT; }
    if src_eq(c, start, len, "if") { return K_IF; }
    if src_eq(c, start, len, "else") { return K_ELSE; }
    if src_eq(c, start, len, "for") { return K_FOR; }
    if src_eq(c, start, len, "break") { return K_BREAK; }
    if src_eq(c, start, len, "continue") { return K_CONTINUE; }
    if src_eq(c, start, len, "return") { return K_RETURN; }
    if src_eq(c, start, len, "match") { return K_MATCH; }
    if src_eq(c, start, len, "unsafe") { return K_UNSAFE; }
    if src_eq(c, start, len, "as") { return K_AS; }
    if src_eq(c, start, len, "true") { return K_TRUE; }
    if src_eq(c, start, len, "false") { return K_FALSE; }
    if src_eq(c, start, len, "slice") { return K_SLICE; }
    if src_eq(c, start, len, "slice_mut") { return K_SLICE_MUT; }
    if src_eq(c, start, len, "offset") { return K_OFFSET; }
    return NONE;
}

// longest match (language.md S2)
fn punct_id(c: &Ctx, i: u32) -> u32 {
    if src_has(c, i, "<<=") { return P_SHLEQ; }
    if src_has(c, i, ">>=") { return P_SHREQ; }
    if src_has(c, i, "->") { return P_ARROW; }
    if src_has(c, i, "=>") { return P_FATARROW; }
    if src_has(c, i, "==") { return P_EQEQ; }
    if src_has(c, i, "!=") { return P_NE; }
    if src_has(c, i, "<=") { return P_LE; }
    if src_has(c, i, ">=") { return P_GE; }
    if src_has(c, i, "&&") { return P_ANDAND; }
    if src_has(c, i, "||") { return P_OROR; }
    if src_has(c, i, "<<") { return P_SHL; }
    if src_has(c, i, ">>") { return P_SHR; }
    if src_has(c, i, "+=") { return P_ADDEQ; }
    if src_has(c, i, "-=") { return P_SUBEQ; }
    if src_has(c, i, "*=") { return P_MULEQ; }
    if src_has(c, i, "/=") { return P_DIVEQ; }
    if src_has(c, i, "%=") { return P_MODEQ; }
    if src_has(c, i, "&=") { return P_ANDEQ; }
    if src_has(c, i, "|=") { return P_OREQ; }
    if src_has(c, i, "^=") { return P_XOREQ; }
    if src_has(c, i, "(") { return P_LPAREN; }
    if src_has(c, i, ")") { return P_RPAREN; }
    if src_has(c, i, "{") { return P_LBRACE; }
    if src_has(c, i, "}") { return P_RBRACE; }
    if src_has(c, i, "[") { return P_LBRACK; }
    if src_has(c, i, "]") { return P_RBRACK; }
    if src_has(c, i, ",") { return P_COMMA; }
    if src_has(c, i, ";") { return P_SEMI; }
    if src_has(c, i, ":") { return P_COLON; }
    if src_has(c, i, ".") { return P_DOT; }
    if src_has(c, i, "=") { return P_EQ; }
    if src_has(c, i, "<") { return P_LT; }
    if src_has(c, i, ">") { return P_GT; }
    if src_has(c, i, "+") { return P_ADD; }
    if src_has(c, i, "-") { return P_SUB; }
    if src_has(c, i, "*") { return P_MUL; }
    if src_has(c, i, "/") { return P_DIV; }
    if src_has(c, i, "%") { return P_MOD; }
    if src_has(c, i, "&") { return P_AND; }
    if src_has(c, i, "|") { return P_OR; }
    if src_has(c, i, "^") { return P_XOR; }
    if src_has(c, i, "!") { return P_NOT; }
    return NONE;
}

fn punct_len(id: u32) -> u32 {
    if id <= P_SHREQ { return 3; }
    if id <= P_XOREQ { return 2; }
    return 1;
}

fn push_tok(c: &mut Ctx, kind: u32, start: u32, len: u32, value: u32,
            line: u32, col: u32, aux: u32) {
    let n: u32 = c.^.ntok;
    c.^.toks[n] = Token{
        kind: kind, start: start, len: len, value: value,
        line: line, col: col, aux: aux,
    };
    c.^.ntok = n + 1;
}

// One escape. Strings allow one more than chars do (language.md S2).
fn escape_of(e: u32, in_string: bool) -> u32 {
    if e == 'n' { return 10; }
    if e == 't' { return 9; }
    if e == 'r' { return 13; }
    if e == '0' { return 0; }
    if e == '\\' { return 92; }
    if e == '\'' { return 39; }
    if in_string && e == '"' { return 34; }
    return NONE;
}

fn lex_ident(c: &mut Ctx) {
    let sl: u32 = c.^.line;
    let sc: u32 = c.^.col;
    let i: u32 = c.^.pos;
    let n: u32 = c.^.src.len;
    let mut j: u32 = i;
    for j < n && is_ident_cont(c.^.src[j]) { j += 1; }
    let id: u32 = kw_id(c, i, j - i);
    adv(c, j - i);
    if id == NONE {
        push_tok(c, TK_IDENT, i, j - i, 0, sl, sc, 0);
    } else {
        push_tok(c, TK_KW, i, j - i, id, sl, sc, 0);
    }
}

fn digit_val(ch: u32, base: u32) -> u32 {
    if is_digit(ch) {
        if ch - '0' < base { return ch - '0'; }
        return NONE;
    }
    if base == 16 {
        if ch >= 'a' && ch <= 'f' { return ch - 'a' + 10; }
        if ch >= 'A' && ch <= 'F' { return ch - 'A' + 10; }
    }
    return NONE;
}

fn lex_number(c: &mut Ctx) {
    let sl: u32 = c.^.line;
    let sc: u32 = c.^.col;
    let i: u32 = c.^.pos;
    let n: u32 = c.^.src.len;
    let mut base: u32 = 10;
    let mut j: u32 = i;
    if c.^.src[i] == '0' && i + 1 < n {
        let b: u32 = c.^.src[i + 1];
        if b == 'x' || b == 'X' { base = 16; j = i + 2; }
        if b == 'b' || b == 'B' { base = 2; j = i + 2; }
    }
    let mut ndigits: u32 = 0;
    let mut value: u32 = 0;
    let mut over: bool = false;
    for j < n {
        let b: u32 = c.^.src[j];
        if b == '_' {
            j += 1;
        } else {
            let d: u32 = digit_val(b, base);
            if d == NONE { break; }
            // detect overflow past 32 bits; the value itself is then meaningless
            if value > (0xFFFF_FFFF - d) / base { over = true; }
            value = value * base + d;
            ndigits += 1;
            j += 1;
        }
    }
    if ndigits == 0 {
        err_msg(c, sl, sc, "integer literal has no digits");
        return;
    }
    if j < n && is_ident_cont(c.^.src[j]) {
        err_msg(c, sl, sc, "invalid digit in integer literal");
        return;
    }
    if over {
        err_msg(c, sl, sc, "integer literal out of range");
        return;
    }
    adv(c, j - i);
    push_tok(c, TK_INT, i, j - i, value, sl, sc, 0);
}

fn lex_char(c: &mut Ctx) {
    let sl: u32 = c.^.line;
    let sc: u32 = c.^.col;
    let start: u32 = c.^.pos;
    let n: u32 = c.^.src.len;
    adv(c, 1);
    if c.^.pos >= n {
        err_msg(c, sl, sc, "unterminated character literal");
        return;
    }
    if c.^.src[c.^.pos] == '\'' {
        err_msg(c, sl, sc, "empty character literal");
        return;
    }
    let mut value: u32 = 0;
    if c.^.src[c.^.pos] == '\\' {
        adv(c, 1);
        if c.^.pos >= n {
            err_msg(c, sl, sc, "unterminated character literal");
            return;
        }
        let e: u32 = escape_of(c.^.src[c.^.pos], false);
        if e == NONE {
            let el: u32 = c.^.line;
            let ec: u32 = c.^.col;
            err_msg(c, el, ec, "unknown escape sequence");
            return;
        }
        value = e;
        adv(c, 1);
    } else {
        value = c.^.src[c.^.pos];
        if value < 0x20 || value > 0x7E {
            let el: u32 = c.^.line;
            let ec: u32 = c.^.col;
            err_msg(c, el, ec, "invalid character in character literal");
            return;
        }
        adv(c, 1);
    }
    if c.^.pos >= n {
        err_msg(c, sl, sc, "unterminated character literal");
        return;
    }
    if c.^.src[c.^.pos] != '\'' {
        err_msg(c, sl, sc, "unterminated character literal");
        return;
    }
    adv(c, 1);
    let end: u32 = c.^.pos;
    push_tok(c, TK_CHAR, start, end - start, value, sl, sc, 0);
}

fn lex_string(c: &mut Ctx) {
    let sl: u32 = c.^.line;
    let sc: u32 = c.^.col;
    let start: u32 = c.^.pos;
    let n: u32 = c.^.src.len;
    adv(c, 1);
    let buf: u32 = c.^.heap;
    let mut k: u32 = 0;
    for {
        if c.^.pos >= n {
            err_msg(c, sl, sc, "unterminated string literal");
            return;
        }
        let b: u32 = c.^.src[c.^.pos];
        if b == '\n' {
            err_msg(c, sl, sc, "unterminated string literal");
            return;
        }
        if b == '"' {
            adv(c, 1);
            break;
        }
        if b == '\\' {
            adv(c, 1);
            if c.^.pos >= n {
                err_msg(c, sl, sc, "unterminated string literal");
                return;
            }
            let e: u32 = escape_of(c.^.src[c.^.pos], true);
            if e == NONE {
                let el: u32 = c.^.line;
                let ec: u32 = c.^.col;
                err_msg(c, el, ec, "unknown escape sequence");
                return;
            }
            stb(buf + k, e);
            k += 1;
            adv(c, 1);
        } else {
            if b < 0x20 || b > 0x7E {
                let el: u32 = c.^.line;
                let ec: u32 = c.^.col;
                err_msg(c, el, ec, "invalid character in string literal");
                return;
            }
            stb(buf + k, b);
            k += 1;
            adv(c, 1);
        }
    }
    c.^.heap = align4(buf + k);
    let end: u32 = c.^.pos;
    push_tok(c, TK_STR, start, end - start, buf, sl, sc, k);
}

fn lex_comment(c: &mut Ctx) {
    let n: u32 = c.^.src.len;
    for c.^.pos < n && c.^.src[c.^.pos] != '\n' {
        let b: u32 = c.^.src[c.^.pos];
        if b != 9 && b != 13 && (b < 0x20 || b > 0x7E) {
            let el: u32 = c.^.line;
            let ec: u32 = c.^.col;
            err_msg(c, el, ec, "non-ascii byte in source");
            return;
        }
        adv(c, 1);
    }
}

fn lex(c: &mut Ctx) {
    let n: u32 = c.^.src.len;
    c.^.pos = 0;
    c.^.line = 1;
    c.^.col = 1;
    c.^.ntok = 0;

    for c.^.pos < n && !failed(c) {
        let i: u32 = c.^.pos;
        let b: u32 = c.^.src[i];

        if b != 9 && b != 10 && b != 13 && (b < 0x20 || b > 0x7E) {
            let el: u32 = c.^.line;
            let ec: u32 = c.^.col;
            err_msg(c, el, ec, "non-ascii byte in source");
            return;
        }
        if b == 9 || b == 10 || b == 13 || b == 32 {
            adv(c, 1);
            continue;
        }
        if b == '/' && i + 1 < n && c.^.src[i + 1] == '/' {
            lex_comment(c);
            continue;
        }
        if is_ident_start(b) { lex_ident(c); continue; }
        if is_digit(b) { lex_number(c); continue; }
        if b == '\'' { lex_char(c); continue; }
        if b == '"' { lex_string(c); continue; }

        let p: u32 = punct_id(c, i);
        if p == NONE {
            let el: u32 = c.^.line;
            let ec: u32 = c.^.col;
            err_msg(c, el, ec, "unexpected character");
            return;
        }
        let sl: u32 = c.^.line;
        let sc: u32 = c.^.col;
        adv(c, punct_len(p));
        push_tok(c, TK_PUNCT, i, punct_len(p), p, sl, sc, 0);
    }
    if failed(c) { return; }
    let ep: u32 = c.^.pos;
    let el: u32 = c.^.line;
    let ec: u32 = c.^.col;
    push_tok(c, TK_EOF, ep, 0, 0, el, ec, 0);
}

// ===========================================================================
// AST (language.md S4, S5, S6)
// ===========================================================================
//
// One arena of one record shape, indexed by u32. Index 0 means "none" -- the
// arena starts filling at 1 so a real node can never be 0.
//
// This is a struct and not an enum, and the reason is worth writing down: the
// checker annotates nodes in place (ty, aux, aux2) and language.md S4 forbids
// a struct field from holding an aggregate, so an enum's payload cannot carry
// mutable annotations. The sum type that *is* an enum here is Ty -- see below.

struct Node {
    kind: u32,
    line: u32,
    col: u32,
    a: u32,
    b: u32,
    c: u32,
    d: u32,
    e: u32,
    next: u32,   // sibling in a list
    ty: u32,     // checker: type id
    aux: u32,    // checker: local, field, fn, ...
    aux2: u32,
    depth: u32,  // expression tree depth (language.md S9)
}

// expressions
const E_INT: u32 = 1;        // A value
const E_CHAR: u32 = 2;       // A value
const E_STR: u32 = 3;        // A bytes, B len; AUX rodata address
const E_BOOL: u32 = 4;       // A 0/1
const E_IDENT: u32 = 5;      // A name start, B name len; AUX local or const value
const E_UNARY: u32 = 6;      // A op(punct), B operand
const E_BINARY: u32 = 7;     // A op(punct), B lhs, C rhs, D operand type
const E_BORROW: u32 = 8;     // A mut, B operand, D root local
const E_CAST: u32 = 9;       // A operand, B type node
const E_CALL: u32 = 10;      // A callee, B args, D fn info
const E_INDEX: u32 = 11;     // A base, B index, D element size
const E_FIELD: u32 = 12;     // A base, B name start, C name len, D field info
const E_DEREF: u32 = 13;     // A base
const E_STRUCTLIT: u32 = 14; // A name start, B name len, C fields, D struct info
const E_LITFIELD: u32 = 15;  // A name start, B name len, C value
const E_SLICE: u32 = 16;     // A mut, B ptr, C len          (language.md S5)
const E_OFFSET: u32 = 17;    // A ptr, B index, D stride     (language.md S5)

// type syntax (language.md S3)
const T_PRIM: u32 = 20;      // A 0=i32 1=u32 2=bool 3=u8
const T_NAMED: u32 = 21;     // A name start, B name len
const T_SLICE: u32 = 22;     // A inner, B mut
const T_REF: u32 = 23;       // A inner, B mut
const T_PTR: u32 = 24;       // A inner

// statements
const S_LET: u32 = 30;       // A name start, B name len, C type, D init, E mut
const S_ASSIGN: u32 = 31;    // A target, B op(punct), C value
const S_EXPR: u32 = 32;      // A call; AUX discard
const S_IF: u32 = 33;        // A cond, B then, C else, D has-else
const S_FOR: u32 = 34;       // A init, B cond, C post, D body
const S_BREAK: u32 = 35;
const S_CONTINUE: u32 = 36;
const S_RETURN: u32 = 37;    // A value
const S_MATCH: u32 = 38;     // A scrutinee, B arms, C enum info, D has-wild
const S_UNSAFE: u32 = 39;    // A body
const S_ARM: u32 = 40;       // A name start, B name len, C binds, D body, E wild
const S_BIND: u32 = 41;      // A name start, B name len; AUX local

// declarations
const D_FN: u32 = 50;        // A name start, B name len, C params, D ret, E body
const D_STRUCT: u32 = 51;    // A name start, B name len, C fields; AUX struct info
const D_ENUM: u32 = 52;      // A name start, B name len, C variants; AUX enum info
const D_CONST: u32 = 53;     // A name start, B name len, C type, D value
const D_PARAM: u32 = 54;     // A name start, B name len, C type; AUX local
const D_FIELD: u32 = 55;     // A name start, B name len, C type
const D_VARIANT: u32 = 56;   // A name start, B name len, C payload types

const MAX_DEPTH: u32 = 64;

fn node(c: &mut Ctx, kind: u32, line: u32, col: u32) -> u32 {
    let n: u32 = c.^.nnode;
    c.^.nodes[n] = Node{
        kind: kind, line: line, col: col,
        a: 0, b: 0, c: 0, d: 0, e: 0,
        next: 0, ty: 0, aux: 0, aux2: 0, depth: 1,
    };
    c.^.nnode = n + 1;
    return n;
}

// --- token cursor ----------------------------------------------------------

fn cur_kind(c: &Ctx) -> u32 { return c.^.toks[c.^.ti].kind; }

fn cur_val(c: &Ctx) -> u32 { return c.^.toks[c.^.ti].value; }

fn cur_line(c: &Ctx) -> u32 { return c.^.toks[c.^.ti].line; }

fn cur_col(c: &Ctx) -> u32 { return c.^.toks[c.^.ti].col; }

fn bump(c: &mut Ctx) { c.^.ti = c.^.ti + 1; }

fn at_p(c: &Ctx, p: u32) -> bool {
    return cur_kind(c) == TK_PUNCT && cur_val(c) == p;
}

fn at_kw(c: &Ctx, k: u32) -> bool {
    return cur_kind(c) == TK_KW && cur_val(c) == k;
}

fn eat_p(c: &mut Ctx, p: u32) -> bool {
    if at_p(c, p) { bump(c); return true; }
    return false;
}

fn eat_kw(c: &mut Ctx, k: u32) -> bool {
    if at_kw(c, k) { bump(c); return true; }
    return false;
}

// --- rendering tokens into diagnostics -------------------------------------

fn put_punct(c: &mut Ctx, p: u32) {
    if p == P_SHLEQ { put_str(c, "<<="); return; }
    if p == P_SHREQ { put_str(c, ">>="); return; }
    if p == P_ARROW { put_str(c, "->"); return; }
    if p == P_FATARROW { put_str(c, "=>"); return; }
    if p == P_EQEQ { put_str(c, "=="); return; }
    if p == P_NE { put_str(c, "!="); return; }
    if p == P_LE { put_str(c, "<="); return; }
    if p == P_GE { put_str(c, ">="); return; }
    if p == P_ANDAND { put_str(c, "&&"); return; }
    if p == P_OROR { put_str(c, "||"); return; }
    if p == P_SHL { put_str(c, "<<"); return; }
    if p == P_SHR { put_str(c, ">>"); return; }
    if p == P_ADDEQ { put_str(c, "+="); return; }
    if p == P_SUBEQ { put_str(c, "-="); return; }
    if p == P_MULEQ { put_str(c, "*="); return; }
    if p == P_DIVEQ { put_str(c, "/="); return; }
    if p == P_MODEQ { put_str(c, "%="); return; }
    if p == P_ANDEQ { put_str(c, "&="); return; }
    if p == P_OREQ { put_str(c, "|="); return; }
    if p == P_XOREQ { put_str(c, "^="); return; }
    if p == P_LPAREN { put_str(c, "("); return; }
    if p == P_RPAREN { put_str(c, ")"); return; }
    if p == P_LBRACE { put_str(c, "{"); return; }
    if p == P_RBRACE { put_str(c, "}"); return; }
    if p == P_LBRACK { put_str(c, "["); return; }
    if p == P_RBRACK { put_str(c, "]"); return; }
    if p == P_COMMA { put_str(c, ","); return; }
    if p == P_SEMI { put_str(c, ";"); return; }
    if p == P_COLON { put_str(c, ":"); return; }
    if p == P_DOT { put_str(c, "."); return; }
    if p == P_EQ { put_str(c, "="); return; }
    if p == P_LT { put_str(c, "<"); return; }
    if p == P_GT { put_str(c, ">"); return; }
    if p == P_ADD { put_str(c, "+"); return; }
    if p == P_SUB { put_str(c, "-"); return; }
    if p == P_MUL { put_str(c, "*"); return; }
    if p == P_DIV { put_str(c, "/"); return; }
    if p == P_MOD { put_str(c, "%"); return; }
    if p == P_AND { put_str(c, "&"); return; }
    if p == P_OR { put_str(c, "|"); return; }
    if p == P_XOR { put_str(c, "^"); return; }
    put_str(c, "!");
}

fn put_kw(c: &mut Ctx, k: u32) {
    if k == K_FN { put_str(c, "fn"); return; }
    if k == K_STRUCT { put_str(c, "struct"); return; }
    if k == K_ENUM { put_str(c, "enum"); return; }
    if k == K_CONST { put_str(c, "const"); return; }
    if k == K_LET { put_str(c, "let"); return; }
    if k == K_MUT { put_str(c, "mut"); return; }
    if k == K_IF { put_str(c, "if"); return; }
    if k == K_ELSE { put_str(c, "else"); return; }
    if k == K_FOR { put_str(c, "for"); return; }
    if k == K_BREAK { put_str(c, "break"); return; }
    if k == K_CONTINUE { put_str(c, "continue"); return; }
    if k == K_RETURN { put_str(c, "return"); return; }
    if k == K_MATCH { put_str(c, "match"); return; }
    if k == K_UNSAFE { put_str(c, "unsafe"); return; }
    if k == K_AS { put_str(c, "as"); return; }
    if k == K_TRUE { put_str(c, "true"); return; }
    if k == K_FALSE { put_str(c, "false"); return; }
    if k == K_SLICE { put_str(c, "slice"); return; }
    if k == K_SLICE_MUT { put_str(c, "slice_mut"); return; }
    put_str(c, "offset");
}

// Token.describe() in cool0.py
fn put_describe(c: &mut Ctx, i: u32) {
    let k: u32 = c.^.toks[i].kind;
    if k == TK_EOF { put_str(c, "end of file"); return; }
    if k == TK_INT { put_str(c, "integer literal"); return; }
    if k == TK_CHAR { put_str(c, "character literal"); return; }
    if k == TK_STR { put_str(c, "string literal"); return; }
    let s: u32 = c.^.toks[i].start;
    let l: u32 = c.^.toks[i].len;
    put_ch(c, 96);
    put_src(c, s, l);
    put_ch(c, 96);
}

fn e_expected_p(c: &mut Ctx, p: u32) {
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    let i: u32 = c.^.ti;
    if err_open(c, line, col) {
        put_str(c, "expected ");
        put_ch(c, 96);
        put_punct(c, p);
        put_ch(c, 96);
        put_str(c, ", found ");
        put_describe(c, i);
        err_end(c);
    }
}

fn e_expected_kw(c: &mut Ctx, k: u32) {
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    let i: u32 = c.^.ti;
    if err_open(c, line, col) {
        put_str(c, "expected ");
        put_ch(c, 96);
        put_kw(c, k);
        put_ch(c, 96);
        put_str(c, ", found ");
        put_describe(c, i);
        err_end(c);
    }
}

fn e_expected_str(c: &mut Ctx, s: []u8) {
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    let i: u32 = c.^.ti;
    if err_open(c, line, col) {
        put_str(c, s);
        put_str(c, ", found ");
        put_describe(c, i);
        err_end(c);
    }
}

fn expect_p(c: &mut Ctx, p: u32) {
    if failed(c) { return; }
    if at_p(c, p) { bump(c); return; }
    e_expected_p(c, p);
}

fn expect_kw(c: &mut Ctx, k: u32) {
    if failed(c) { return; }
    if at_kw(c, k) { bump(c); return; }
    e_expected_kw(c, k);
}

// Returns the token index of the identifier, or NONE.
fn expect_ident(c: &mut Ctx) -> u32 {
    if failed(c) { return NONE; }
    if cur_kind(c) != TK_IDENT {
        e_expected_str(c, "expected identifier");
        return NONE;
    }
    let i: u32 = c.^.ti;
    bump(c);
    return i;
}

// --- depth guards (language.md S9) -----------------------------------------

fn e_deep_expr(c: &mut Ctx, line: u32, col: u32) {
    err_msg(c, line, col, "expression nests too deeply");
}

// Set a composite node's tree depth, guarding the limit.
fn deep(c: &mut Ctx, n: u32, maxd: u32) -> u32 {
    if maxd + 1 > MAX_DEPTH {
        let line: u32 = c.^.nodes[n].line;
        let col: u32 = c.^.nodes[n].col;
        e_deep_expr(c, line, col);
        return n;
    }
    c.^.nodes[n].depth = maxd + 1;
    return n;
}

fn depth_of(c: &Ctx, n: u32) -> u32 {
    if n == 0 { return 0; }
    return c.^.nodes[n].depth;
}

fn max2(a: u32, b: u32) -> u32 { if a > b { return a; } return b; }

fn depth_list(c: &Ctx, head: u32) -> u32 {
    let mut d: u32 = 0;
    let mut p: u32 = head;
    for p != 0 {
        d = max2(d, depth_of(c, p));
        p = c.^.nodes[p].next;
    }
    return d;
}

// --- types (language.md S3) ------------------------------------------------

fn parse_ty(c: &mut Ctx) -> u32 {
    if failed(c) { return 0; }
    if c.^.edepth >= MAX_DEPTH {
        let line: u32 = cur_line(c);
        let col: u32 = cur_col(c);
        err_msg(c, line, col, "type nests too deeply");
        return 0;
    }
    c.^.edepth = c.^.edepth + 1;
    let t: u32 = parse_ty_inner(c);
    c.^.edepth = c.^.edepth - 1;
    return t;
}

fn parse_ty_inner(c: &mut Ctx) -> u32 {
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    if eat_p(c, P_LBRACK) {
        expect_p(c, P_RBRACK);
        let n: u32 = node(c, T_SLICE, line, col);
        if eat_kw(c, K_MUT) { c.^.nodes[n].b = 1; }
        let inner: u32 = parse_ty(c);
        c.^.nodes[n].a = inner;
        return n;
    }
    if eat_p(c, P_AND) {
        let n: u32 = node(c, T_REF, line, col);
        if eat_kw(c, K_MUT) { c.^.nodes[n].b = 1; }
        let inner: u32 = parse_ty(c);
        c.^.nodes[n].a = inner;
        return n;
    }
    if eat_p(c, P_MUL) {
        let n: u32 = node(c, T_PTR, line, col);
        let inner: u32 = parse_ty(c);
        c.^.nodes[n].a = inner;
        return n;
    }
    if cur_kind(c) == TK_IDENT {
        let s: u32 = c.^.toks[c.^.ti].start;
        let l: u32 = c.^.toks[c.^.ti].len;
        bump(c);
        if src_eq(c, s, l, "i32") {
            let n: u32 = node(c, T_PRIM, line, col);
            c.^.nodes[n].a = 0;
            return n;
        }
        if src_eq(c, s, l, "u32") {
            let n: u32 = node(c, T_PRIM, line, col);
            c.^.nodes[n].a = 1;
            return n;
        }
        if src_eq(c, s, l, "bool") {
            let n: u32 = node(c, T_PRIM, line, col);
            c.^.nodes[n].a = 2;
            return n;
        }
        if src_eq(c, s, l, "u8") {
            let n: u32 = node(c, T_PRIM, line, col);
            c.^.nodes[n].a = 3;
            return n;
        }
        let n: u32 = node(c, T_NAMED, line, col);
        c.^.nodes[n].a = s;
        c.^.nodes[n].b = l;
        return n;
    }
    e_expected_str(c, "expected type");
    return 0;
}

// --- expressions (language.md S5) ------------------------------------------

const CMP_LEVEL: u32 = 2;
const NLEVELS: u32 = 9;

fn is_cmp(p: u32) -> bool {
    return p == P_EQEQ || p == P_NE || p == P_LT || p == P_GT || p == P_LE || p == P_GE;
}

fn op_at_level(p: u32, level: u32) -> bool {
    if level == 0 { return p == P_OROR; }
    if level == 1 { return p == P_ANDAND; }
    if level == 3 { return p == P_OR; }
    if level == 4 { return p == P_XOR; }
    if level == 5 { return p == P_AND; }
    if level == 6 { return p == P_SHL || p == P_SHR; }
    if level == 7 { return p == P_ADD || p == P_SUB; }
    if level == 8 { return p == P_MUL || p == P_DIV || p == P_MOD; }
    return false;
}

fn parse_expr(c: &mut Ctx, asl: bool) -> u32 { return parse_bin(c, 0, asl); }

fn parse_bin(c: &mut Ctx, level: u32, asl: bool) -> u32 {
    if failed(c) { return 0; }
    if level == CMP_LEVEL { return parse_cmp(c, asl); }
    if level >= NLEVELS { return parse_unary(c, asl); }
    let mut lhs: u32 = parse_bin(c, level + 1, asl);
    for !failed(c) && cur_kind(c) == TK_PUNCT && op_at_level(cur_val(c), level) {
        let line: u32 = cur_line(c);
        let col: u32 = cur_col(c);
        let op: u32 = cur_val(c);
        bump(c);
        let rhs: u32 = parse_bin(c, level + 1, asl);
        let n: u32 = node(c, E_BINARY, line, col);
        c.^.nodes[n].a = op;
        c.^.nodes[n].b = lhs;
        c.^.nodes[n].c = rhs;
        let dl: u32 = depth_of(c, lhs);
        let dr: u32 = depth_of(c, rhs);
        lhs = deep(c, n, max2(dl, dr));
    }
    return lhs;
}

fn parse_cmp(c: &mut Ctx, asl: bool) -> u32 {
    let lhs: u32 = parse_bin(c, CMP_LEVEL + 1, asl);
    if failed(c) { return 0; }
    if cur_kind(c) == TK_PUNCT && is_cmp(cur_val(c)) {
        let line: u32 = cur_line(c);
        let col: u32 = cur_col(c);
        let op: u32 = cur_val(c);
        bump(c);
        let rhs: u32 = parse_bin(c, CMP_LEVEL + 1, asl);
        if failed(c) { return 0; }
        if cur_kind(c) == TK_PUNCT && is_cmp(cur_val(c)) {
            let el: u32 = cur_line(c);
            let ec: u32 = cur_col(c);
            err_msg(c, el, ec, "comparison operators cannot be chained");
            return 0;
        }
        let n: u32 = node(c, E_BINARY, line, col);
        c.^.nodes[n].a = op;
        c.^.nodes[n].b = lhs;
        c.^.nodes[n].c = rhs;
        let dl: u32 = depth_of(c, lhs);
        let dr: u32 = depth_of(c, rhs);
        return deep(c, n, max2(dl, dr));
    }
    return lhs;
}

// The `as` level. Unary binds tighter than `as` (language.md S5).
fn parse_unary(c: &mut Ctx, asl: bool) -> u32 {
    let mut e: u32 = parse_prefix(c, asl);
    for !failed(c) && at_kw(c, K_AS) {
        let line: u32 = cur_line(c);
        let col: u32 = cur_col(c);
        bump(c);
        let t: u32 = parse_ty(c);
        let n: u32 = node(c, E_CAST, line, col);
        c.^.nodes[n].a = e;
        c.^.nodes[n].b = t;
        let d: u32 = depth_of(c, e);
        e = deep(c, n, d);
    }
    return e;
}

fn parse_prefix(c: &mut Ctx, asl: bool) -> u32 {
    if failed(c) { return 0; }
    if c.^.edepth >= MAX_DEPTH {
        let line: u32 = cur_line(c);
        let col: u32 = cur_col(c);
        e_deep_expr(c, line, col);
        return 0;
    }
    c.^.edepth = c.^.edepth + 1;
    let e: u32 = parse_prefix_inner(c, asl);
    c.^.edepth = c.^.edepth - 1;
    return e;
}

fn parse_prefix_inner(c: &mut Ctx, asl: bool) -> u32 {
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    if at_p(c, P_SUB) {
        bump(c);
        let k: u32 = parse_prefix(c, asl);
        let n: u32 = node(c, E_UNARY, line, col);
        c.^.nodes[n].a = P_SUB;
        c.^.nodes[n].b = k;
        let d: u32 = depth_of(c, k);
        return deep(c, n, d);
    }
    if at_p(c, P_NOT) {
        bump(c);
        let k: u32 = parse_prefix(c, asl);
        let n: u32 = node(c, E_UNARY, line, col);
        c.^.nodes[n].a = P_NOT;
        c.^.nodes[n].b = k;
        let d: u32 = depth_of(c, k);
        return deep(c, n, d);
    }
    if at_p(c, P_AND) {
        bump(c);
        let n: u32 = node(c, E_BORROW, line, col);
        if eat_kw(c, K_MUT) { c.^.nodes[n].a = 1; }
        let k: u32 = parse_prefix(c, asl);
        c.^.nodes[n].b = k;
        let d: u32 = depth_of(c, k);
        return deep(c, n, d);
    }
    return parse_postfix(c, asl);
}

fn parse_postfix(c: &mut Ctx, asl: bool) -> u32 {
    let mut e: u32 = parse_primary(c, asl);
    for !failed(c) {
        let line: u32 = cur_line(c);
        let col: u32 = cur_col(c);
        if at_p(c, P_LPAREN) {
            // inside brackets the struct-literal restriction lifts (language.md S5)
            bump(c);
            let mut head: u32 = 0;
            let mut tail: u32 = 0;
            for !failed(c) && !at_p(c, P_RPAREN) {
                let a: u32 = parse_expr(c, true);
                if head == 0 { head = a; } else { c.^.nodes[tail].next = a; }
                tail = a;
                if !eat_p(c, P_COMMA) { break; }
            }
            expect_p(c, P_RPAREN);
            let n: u32 = node(c, E_CALL, line, col);
            c.^.nodes[n].a = e;
            c.^.nodes[n].b = head;
            let de: u32 = depth_of(c, e);
            let dh: u32 = depth_list(c, head);
            e = deep(c, n, max2(de, dh));
        } else if at_p(c, P_LBRACK) {
            bump(c);
            let idx: u32 = parse_expr(c, true);
            expect_p(c, P_RBRACK);
            let n: u32 = node(c, E_INDEX, line, col);
            c.^.nodes[n].a = e;
            c.^.nodes[n].b = idx;
            let de: u32 = depth_of(c, e);
            let di: u32 = depth_of(c, idx);
            e = deep(c, n, max2(de, di));
        } else if at_p(c, P_DOT) {
            bump(c);
            if eat_p(c, P_XOR) {
                let n: u32 = node(c, E_DEREF, line, col);
                c.^.nodes[n].a = e;
                let d: u32 = depth_of(c, e);
                e = deep(c, n, d);
            } else {
                let it: u32 = expect_ident(c);
                if it == NONE { return e; }
                let n: u32 = node(c, E_FIELD, line, col);
                c.^.nodes[n].a = e;
                let s: u32 = c.^.toks[it].start;
                let l: u32 = c.^.toks[it].len;
                c.^.nodes[n].b = s;
                c.^.nodes[n].c = l;
                let d: u32 = depth_of(c, e);
                e = deep(c, n, d);
            }
        } else {
            return e;
        }
    }
    return e;
}

fn parse_primary(c: &mut Ctx, asl: bool) -> u32 {
    if failed(c) { return 0; }
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    let k: u32 = cur_kind(c);
    if k == TK_INT {
        let n: u32 = node(c, E_INT, line, col);
        let v: u32 = cur_val(c);
        c.^.nodes[n].a = v;
        bump(c);
        return n;
    }
    if k == TK_CHAR {
        let n: u32 = node(c, E_CHAR, line, col);
        let v: u32 = cur_val(c);
        c.^.nodes[n].a = v;
        bump(c);
        return n;
    }
    if k == TK_STR {
        let n: u32 = node(c, E_STR, line, col);
        let v: u32 = cur_val(c);
        let aux: u32 = c.^.toks[c.^.ti].aux;
        c.^.nodes[n].a = v;
        c.^.nodes[n].b = aux;
        bump(c);
        return n;
    }
    if at_kw(c, K_TRUE) {
        let n: u32 = node(c, E_BOOL, line, col);
        c.^.nodes[n].a = 1;
        bump(c);
        return n;
    }
    if at_kw(c, K_FALSE) {
        let n: u32 = node(c, E_BOOL, line, col);
        c.^.nodes[n].a = 0;
        bump(c);
        return n;
    }
    if at_kw(c, K_SLICE) || at_kw(c, K_SLICE_MUT) {
        let is_mut: bool = at_kw(c, K_SLICE_MUT);
        bump(c);
        expect_p(c, P_LPAREN);
        let p: u32 = parse_expr(c, true);
        expect_p(c, P_COMMA);
        let ln: u32 = parse_expr(c, true);
        expect_p(c, P_RPAREN);
        let n: u32 = node(c, E_SLICE, line, col);
        if is_mut { c.^.nodes[n].a = 1; }
        c.^.nodes[n].b = p;
        c.^.nodes[n].c = ln;
        let dp: u32 = depth_of(c, p);
        let dl: u32 = depth_of(c, ln);
        return deep(c, n, max2(dp, dl));
    }
    if at_kw(c, K_OFFSET) {
        bump(c);
        expect_p(c, P_LPAREN);
        let p: u32 = parse_expr(c, true);
        expect_p(c, P_COMMA);
        let ix: u32 = parse_expr(c, true);
        expect_p(c, P_RPAREN);
        let n: u32 = node(c, E_OFFSET, line, col);
        c.^.nodes[n].a = p;
        c.^.nodes[n].b = ix;
        let dp: u32 = depth_of(c, p);
        let di: u32 = depth_of(c, ix);
        return deep(c, n, max2(dp, di));
    }
    if at_p(c, P_LPAREN) {
        bump(c);
        let e: u32 = parse_expr(c, true);
        expect_p(c, P_RPAREN);
        return e;
    }
    if k == TK_IDENT {
        let s: u32 = c.^.toks[c.^.ti].start;
        let l: u32 = c.^.toks[c.^.ti].len;
        bump(c);
        if asl && at_p(c, P_LBRACE) { return parse_struct_lit(c, line, col, s, l); }
        let n: u32 = node(c, E_IDENT, line, col);
        c.^.nodes[n].a = s;
        c.^.nodes[n].b = l;
        return n;
    }
    e_expected_str(c, "expected expression");
    return 0;
}

fn parse_struct_lit(c: &mut Ctx, line: u32, col: u32, s: u32, l: u32) -> u32 {
    expect_p(c, P_LBRACE);
    let mut head: u32 = 0;
    let mut tail: u32 = 0;
    for !failed(c) && !at_p(c, P_RBRACE) {
        let fline: u32 = cur_line(c);
        let fcol: u32 = cur_col(c);
        let it: u32 = expect_ident(c);
        if it == NONE { break; }
        expect_p(c, P_COLON);
        let v: u32 = parse_expr(c, true);
        let f: u32 = node(c, E_LITFIELD, fline, fcol);
        let fs: u32 = c.^.toks[it].start;
        let fl: u32 = c.^.toks[it].len;
        c.^.nodes[f].a = fs;
        c.^.nodes[f].b = fl;
        c.^.nodes[f].c = v;
        let dv: u32 = depth_of(c, v);
        c.^.nodes[f].depth = dv;
        if head == 0 { head = f; } else { c.^.nodes[tail].next = f; }
        tail = f;
        if !eat_p(c, P_COMMA) { break; }
    }
    expect_p(c, P_RBRACE);
    let n: u32 = node(c, E_STRUCTLIT, line, col);
    c.^.nodes[n].a = s;
    c.^.nodes[n].b = l;
    c.^.nodes[n].c = head;
    let dh: u32 = depth_list(c, head);
    return deep(c, n, dh);
}

// --- statements (language.md S6) -------------------------------------------

fn parse_block(c: &mut Ctx) -> u32 {
    if failed(c) { return 0; }
    if c.^.bdepth >= MAX_DEPTH {
        let line: u32 = cur_line(c);
        let col: u32 = cur_col(c);
        err_msg(c, line, col, "block nests too deeply");
        return 0;
    }
    c.^.bdepth = c.^.bdepth + 1;
    expect_p(c, P_LBRACE);
    let mut head: u32 = 0;
    let mut tail: u32 = 0;
    for !failed(c) && !at_p(c, P_RBRACE) {
        if cur_kind(c) == TK_EOF {
            e_expected_p(c, P_RBRACE);
            return 0;
        }
        let s: u32 = parse_stmt(c);
        if failed(c) { return 0; }
        if head == 0 { head = s; } else { c.^.nodes[tail].next = s; }
        tail = s;
    }
    expect_p(c, P_RBRACE);
    c.^.bdepth = c.^.bdepth - 1;
    return head;
}

fn is_assign_op(p: u32) -> bool {
    return p == P_EQ || p == P_ADDEQ || p == P_SUBEQ || p == P_MULEQ || p == P_DIVEQ
        || p == P_MODEQ || p == P_ANDEQ || p == P_OREQ || p == P_XOREQ
        || p == P_SHLEQ || p == P_SHREQ;
}

fn parse_stmt(c: &mut Ctx) -> u32 {
    if failed(c) { return 0; }
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    if at_kw(c, K_LET) {
        let s: u32 = parse_let(c);
        expect_p(c, P_SEMI);
        return s;
    }
    if at_kw(c, K_IF) { return parse_if(c); }
    if at_kw(c, K_FOR) { return parse_for(c); }
    if at_kw(c, K_MATCH) { return parse_match(c); }
    if at_kw(c, K_UNSAFE) {
        bump(c);
        let n: u32 = node(c, S_UNSAFE, line, col);
        let b: u32 = parse_block(c);
        c.^.nodes[n].a = b;
        return n;
    }
    if eat_kw(c, K_BREAK) {
        expect_p(c, P_SEMI);
        return node(c, S_BREAK, line, col);
    }
    if eat_kw(c, K_CONTINUE) {
        expect_p(c, P_SEMI);
        return node(c, S_CONTINUE, line, col);
    }
    if eat_kw(c, K_RETURN) {
        let n: u32 = node(c, S_RETURN, line, col);
        if eat_p(c, P_SEMI) { return n; }
        let v: u32 = parse_expr(c, false);
        c.^.nodes[n].a = v;
        expect_p(c, P_SEMI);
        return n;
    }
    let s: u32 = parse_simple_stmt(c);
    expect_p(c, P_SEMI);
    return s;
}

// Assignment or a call statement. The caller eats the `;` -- the for header
// needs the same production without one.
fn parse_simple_stmt(c: &mut Ctx) -> u32 {
    if failed(c) { return 0; }
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    let e: u32 = parse_expr(c, false);
    if failed(c) { return 0; }
    if cur_kind(c) == TK_PUNCT && is_assign_op(cur_val(c)) {
        let op: u32 = cur_val(c);
        bump(c);
        let v: u32 = parse_expr(c, true);
        let n: u32 = node(c, S_ASSIGN, line, col);
        c.^.nodes[n].a = e;
        c.^.nodes[n].b = op;
        c.^.nodes[n].c = v;
        return n;
    }
    if c.^.nodes[e].kind != E_CALL {
        err_msg(c, line, col, "expression statement must be a call");
        return 0;
    }
    let n: u32 = node(c, S_EXPR, line, col);
    c.^.nodes[n].a = e;
    return n;
}

fn parse_let(c: &mut Ctx) -> u32 {
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    expect_kw(c, K_LET);
    let n: u32 = node(c, S_LET, line, col);
    if eat_kw(c, K_MUT) { c.^.nodes[n].e = 1; }
    let it: u32 = expect_ident(c);
    if it == NONE { return n; }
    let s: u32 = c.^.toks[it].start;
    let l: u32 = c.^.toks[it].len;
    c.^.nodes[n].a = s;
    c.^.nodes[n].b = l;
    if eat_p(c, P_COLON) {
        let t: u32 = parse_ty(c);
        c.^.nodes[n].c = t;
    }
    expect_p(c, P_EQ);
    let init: u32 = parse_expr(c, true);
    c.^.nodes[n].d = init;
    return n;
}

fn parse_if(c: &mut Ctx) -> u32 {
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    expect_kw(c, K_IF);
    let n: u32 = node(c, S_IF, line, col);
    let cond: u32 = parse_expr(c, false);
    c.^.nodes[n].a = cond;
    let then: u32 = parse_block(c);
    c.^.nodes[n].b = then;
    if eat_kw(c, K_ELSE) {
        c.^.nodes[n].d = 1;
        if at_kw(c, K_IF) {
            // an else-if chain is recursion too; it counts as block nesting
            if c.^.bdepth >= MAX_DEPTH {
                let el: u32 = cur_line(c);
                let ec: u32 = cur_col(c);
                err_msg(c, el, ec, "block nests too deeply");
                return n;
            }
            c.^.bdepth = c.^.bdepth + 1;
            let els: u32 = parse_if(c);
            c.^.nodes[n].c = els;
            c.^.bdepth = c.^.bdepth - 1;
        } else {
            let els: u32 = parse_block(c);
            c.^.nodes[n].c = els;
        }
    }
    return n;
}

fn parse_for(c: &mut Ctx) -> u32 {
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    expect_kw(c, K_FOR);
    let n: u32 = node(c, S_FOR, line, col);
    if at_p(c, P_LBRACE) {
        let body: u32 = parse_block(c);
        c.^.nodes[n].d = body;
        return n;
    }
    if at_kw(c, K_LET) {
        let init: u32 = parse_let(c);
        c.^.nodes[n].a = init;
        expect_p(c, P_SEMI);
        let cond: u32 = parse_expr(c, false);
        c.^.nodes[n].b = cond;
        expect_p(c, P_SEMI);
        let post: u32 = parse_simple_stmt(c);
        c.^.nodes[n].c = post;
        let body: u32 = parse_block(c);
        c.^.nodes[n].d = body;
        return n;
    }
    let cond: u32 = parse_expr(c, false);
    c.^.nodes[n].b = cond;
    let body: u32 = parse_block(c);
    c.^.nodes[n].d = body;
    return n;
}

fn parse_match(c: &mut Ctx) -> u32 {
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    expect_kw(c, K_MATCH);
    let n: u32 = node(c, S_MATCH, line, col);
    let scr: u32 = parse_expr(c, false);
    c.^.nodes[n].a = scr;
    expect_p(c, P_LBRACE);
    let mut head: u32 = 0;
    let mut tail: u32 = 0;
    for !failed(c) && !at_p(c, P_RBRACE) {
        let aline: u32 = cur_line(c);
        let acol: u32 = cur_col(c);
        let arm: u32 = node(c, S_ARM, aline, acol);
        let ts: u32 = c.^.toks[c.^.ti].start;
        let tl: u32 = c.^.toks[c.^.ti].len;
        if cur_kind(c) == TK_IDENT && src_eq(c, ts, tl, "_") {
            bump(c);
            c.^.nodes[arm].e = 1;
        } else {
            let it: u32 = expect_ident(c);
            if it == NONE { break; }
            let s: u32 = c.^.toks[it].start;
            let l: u32 = c.^.toks[it].len;
            c.^.nodes[arm].a = s;
            c.^.nodes[arm].b = l;
            if eat_p(c, P_LPAREN) {
                let mut bh: u32 = 0;
                let mut bt: u32 = 0;
                for !failed(c) && !at_p(c, P_RPAREN) {
                    let bline: u32 = cur_line(c);
                    let bcol: u32 = cur_col(c);
                    let bi: u32 = expect_ident(c);
                    if bi == NONE { break; }
                    let b: u32 = node(c, S_BIND, bline, bcol);
                    let bs: u32 = c.^.toks[bi].start;
                    let bl: u32 = c.^.toks[bi].len;
                    c.^.nodes[b].a = bs;
                    c.^.nodes[b].b = bl;
                    if bh == 0 { bh = b; } else { c.^.nodes[bt].next = b; }
                    bt = b;
                    if !eat_p(c, P_COMMA) { break; }
                }
                expect_p(c, P_RPAREN);
                c.^.nodes[arm].c = bh;
            }
        }
        expect_p(c, P_FATARROW);
        let body: u32 = parse_block(c);
        c.^.nodes[arm].d = body;
        if head == 0 { head = arm; } else { c.^.nodes[tail].next = arm; }
        tail = arm;
    }
    expect_p(c, P_RBRACE);
    c.^.nodes[n].b = head;
    return n;
}

// --- declarations (language.md S4) -----------------------------------------

fn parse_fn(c: &mut Ctx) -> u32 {
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    expect_kw(c, K_FN);
    let n: u32 = node(c, D_FN, line, col);
    let it: u32 = expect_ident(c);
    if it == NONE { return n; }
    let s: u32 = c.^.toks[it].start;
    let l: u32 = c.^.toks[it].len;
    c.^.nodes[n].a = s;
    c.^.nodes[n].b = l;
    expect_p(c, P_LPAREN);
    let mut head: u32 = 0;
    let mut tail: u32 = 0;
    for !failed(c) && !at_p(c, P_RPAREN) {
        let pline: u32 = cur_line(c);
        let pcol: u32 = cur_col(c);
        let pi: u32 = expect_ident(c);
        if pi == NONE { break; }
        expect_p(c, P_COLON);
        let p: u32 = node(c, D_PARAM, pline, pcol);
        let ps: u32 = c.^.toks[pi].start;
        let pl: u32 = c.^.toks[pi].len;
        c.^.nodes[p].a = ps;
        c.^.nodes[p].b = pl;
        let pt: u32 = parse_ty(c);
        c.^.nodes[p].c = pt;
        if head == 0 { head = p; } else { c.^.nodes[tail].next = p; }
        tail = p;
        if !eat_p(c, P_COMMA) { break; }
    }
    expect_p(c, P_RPAREN);
    c.^.nodes[n].c = head;
    if eat_p(c, P_ARROW) {
        let r: u32 = parse_ty(c);
        c.^.nodes[n].d = r;
    }
    let body: u32 = parse_block(c);
    c.^.nodes[n].e = body;
    return n;
}

fn parse_struct(c: &mut Ctx) -> u32 {
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    expect_kw(c, K_STRUCT);
    let n: u32 = node(c, D_STRUCT, line, col);
    let it: u32 = expect_ident(c);
    if it == NONE { return n; }
    let s: u32 = c.^.toks[it].start;
    let l: u32 = c.^.toks[it].len;
    c.^.nodes[n].a = s;
    c.^.nodes[n].b = l;
    expect_p(c, P_LBRACE);
    let mut head: u32 = 0;
    let mut tail: u32 = 0;
    for !failed(c) && !at_p(c, P_RBRACE) {
        let fline: u32 = cur_line(c);
        let fcol: u32 = cur_col(c);
        let fi: u32 = expect_ident(c);
        if fi == NONE { break; }
        expect_p(c, P_COLON);
        let f: u32 = node(c, D_FIELD, fline, fcol);
        let fs: u32 = c.^.toks[fi].start;
        let fl: u32 = c.^.toks[fi].len;
        c.^.nodes[f].a = fs;
        c.^.nodes[f].b = fl;
        let ft: u32 = parse_ty(c);
        c.^.nodes[f].c = ft;
        if head == 0 { head = f; } else { c.^.nodes[tail].next = f; }
        tail = f;
        if !eat_p(c, P_COMMA) { break; }
    }
    expect_p(c, P_RBRACE);
    c.^.nodes[n].c = head;
    return n;
}

fn parse_enum(c: &mut Ctx) -> u32 {
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    expect_kw(c, K_ENUM);
    let n: u32 = node(c, D_ENUM, line, col);
    let it: u32 = expect_ident(c);
    if it == NONE { return n; }
    let s: u32 = c.^.toks[it].start;
    let l: u32 = c.^.toks[it].len;
    c.^.nodes[n].a = s;
    c.^.nodes[n].b = l;
    expect_p(c, P_LBRACE);
    let mut head: u32 = 0;
    let mut tail: u32 = 0;
    for !failed(c) && !at_p(c, P_RBRACE) {
        let vline: u32 = cur_line(c);
        let vcol: u32 = cur_col(c);
        let vi: u32 = expect_ident(c);
        if vi == NONE { break; }
        let v: u32 = node(c, D_VARIANT, vline, vcol);
        let vs: u32 = c.^.toks[vi].start;
        let vl: u32 = c.^.toks[vi].len;
        c.^.nodes[v].a = vs;
        c.^.nodes[v].b = vl;
        if eat_p(c, P_LPAREN) {
            let mut ph: u32 = 0;
            let mut pt: u32 = 0;
            for !failed(c) && !at_p(c, P_RPAREN) {
                let t: u32 = parse_ty(c);
                if t == 0 { break; }
                if ph == 0 { ph = t; } else { c.^.nodes[pt].next = t; }
                pt = t;
                if !eat_p(c, P_COMMA) { break; }
            }
            expect_p(c, P_RPAREN);
            c.^.nodes[v].c = ph;
        }
        if head == 0 { head = v; } else { c.^.nodes[tail].next = v; }
        tail = v;
        if !eat_p(c, P_COMMA) { break; }
    }
    expect_p(c, P_RBRACE);
    c.^.nodes[n].c = head;
    return n;
}

fn parse_const(c: &mut Ctx) -> u32 {
    let line: u32 = cur_line(c);
    let col: u32 = cur_col(c);
    expect_kw(c, K_CONST);
    let n: u32 = node(c, D_CONST, line, col);
    let it: u32 = expect_ident(c);
    if it == NONE { return n; }
    let s: u32 = c.^.toks[it].start;
    let l: u32 = c.^.toks[it].len;
    c.^.nodes[n].a = s;
    c.^.nodes[n].b = l;
    expect_p(c, P_COLON);
    let t: u32 = parse_ty(c);
    c.^.nodes[n].c = t;
    expect_p(c, P_EQ);
    let v: u32 = parse_expr(c, false);
    c.^.nodes[n].d = v;
    expect_p(c, P_SEMI);
    return n;
}

fn parse_program(c: &mut Ctx) {
    c.^.ti = 0;
    c.^.edepth = 0;
    c.^.bdepth = 0;
    let mut head: u32 = 0;
    let mut tail: u32 = 0;
    for !failed(c) && cur_kind(c) != TK_EOF {
        let mut d: u32 = 0;
        if at_kw(c, K_FN) {
            d = parse_fn(c);
        } else if at_kw(c, K_STRUCT) {
            d = parse_struct(c);
        } else if at_kw(c, K_ENUM) {
            d = parse_enum(c);
        } else if at_kw(c, K_CONST) {
            d = parse_const(c);
        } else {
            e_expected_str(c, "expected `fn`, `struct`, `enum` or `const`");
            return;
        }
        if failed(c) { return; }
        if head == 0 { head = d; } else { c.^.nodes[tail].next = d; }
        tail = d;
    }
    c.^.decls = head;
}

// ===========================================================================
// Types, interned (language.md S3)
// ===========================================================================
//
// This is the sum type the compiler leans on hardest, so this is where cool0's
// enum earns its keep. Structural types are hash-consed: equality is index
// equality, and `match` reads the shape off directly instead of switching on a
// tag word and then trusting that the other words mean what you think.

enum Ty {
    I32,
    U32,
    Bool,
    U8,
    Void,
    IntLit,           // an integer literal that has not settled yet
    Slice(u32, u32),  // element type, mut
    Ref(u32, u32),    // inner type, mut
    Ptr(u32),         // inner type
    Named(u32, u32),  // name start, name len
}

// The primitives get fixed indices so they need no lookup.
const TY_I32: u32 = 1;
const TY_U32: u32 = 2;
const TY_BOOL: u32 = 3;
const TY_U8: u32 = 4;
const TY_VOID: u32 = 5;
const TY_INTLIT: u32 = 6;
const TY_FIRST: u32 = 7;   // interned types start here

// Kind tags, used only where a type has to be compared or built from parts.
const TYK_I32: u32 = 0;
const TYK_U32: u32 = 1;
const TYK_BOOL: u32 = 2;
const TYK_U8: u32 = 3;
const TYK_VOID: u32 = 4;
const TYK_INTLIT: u32 = 5;
const TYK_SLICE: u32 = 6;
const TYK_REF: u32 = 7;
const TYK_PTR: u32 = 8;
const TYK_NAMED: u32 = 9;

fn ty_kind(c: &Ctx, t: u32) -> u32 {
    match c.^.types[t] {
        I32 => { return TYK_I32; }
        U32 => { return TYK_U32; }
        Bool => { return TYK_BOOL; }
        U8 => { return TYK_U8; }
        Void => { return TYK_VOID; }
        IntLit => { return TYK_INTLIT; }
        Slice(e, m) => { return TYK_SLICE; }
        Ref(i, m) => { return TYK_REF; }
        Ptr(i) => { return TYK_PTR; }
        Named(s, l) => { return TYK_NAMED; }
    }
}

fn ty_arg(c: &Ctx, t: u32) -> u32 {
    match c.^.types[t] {
        Slice(e, m) => { return e; }
        Ref(i, m) => { return i; }
        Ptr(i) => { return i; }
        Named(s, l) => { return s; }
        _ => { return 0; }
    }
}

fn ty_flag(c: &Ctx, t: u32) -> u32 {
    match c.^.types[t] {
        Slice(e, m) => { return m; }
        Ref(i, m) => { return m; }
        Named(s, l) => { return l; }
        _ => { return 0; }
    }
}

fn ty_put(c: &mut Ctx, kind: u32, arg: u32, flag: u32) -> u32 {
    let n: u32 = c.^.nty;
    if kind == TYK_SLICE { c.^.types[n] = Ty.Slice(arg, flag); }
    else if kind == TYK_REF { c.^.types[n] = Ty.Ref(arg, flag); }
    else if kind == TYK_PTR { c.^.types[n] = Ty.Ptr(arg); }
    else { c.^.types[n] = Ty.Named(arg, flag); }
    c.^.nty = n + 1;
    return n;
}

fn ty_intern(c: &mut Ctx, kind: u32, arg: u32, flag: u32) -> u32 {
    let n: u32 = c.^.nty;
    for let mut p: u32 = TY_FIRST; p < n; p += 1 {
        if ty_kind(c, p) == kind && ty_arg(c, p) == arg && ty_flag(c, p) == flag {
            return p;
        }
    }
    return ty_put(c, kind, arg, flag);
}

// two source slices, same bytes
fn src_eq2(c: &Ctx, s1: u32, l1: u32, s2: u32, l2: u32) -> bool {
    if l1 != l2 { return false; }
    for let mut i: u32 = 0; i < l1; i += 1 {
        if c.^.src[s1 + i] != c.^.src[s2 + i] { return false; }
    }
    return true;
}

// Named types compare by text, not by where the name was written.
fn ty_named(c: &mut Ctx, start: u32, len: u32) -> u32 {
    let n: u32 = c.^.nty;
    for let mut p: u32 = TY_FIRST; p < n; p += 1 {
        if ty_kind(c, p) == TYK_NAMED {
            let s: u32 = ty_arg(c, p);
            let l: u32 = ty_flag(c, p);
            if src_eq2(c, s, l, start, len) { return p; }
        }
    }
    return ty_put(c, TYK_NAMED, start, len);
}

fn is_int_ty(c: &Ctx, t: u32) -> bool {
    match c.^.types[t] {
        I32 => { return true; }
        U32 => { return true; }
        IntLit => { return true; }
        _ => { return false; }
    }
}

fn is_aggregate(c: &Ctx, t: u32) -> bool {
    match c.^.types[t] {
        Named(s, l) => { return true; }
        _ => { return false; }
    }
}

// The type a place yields when read: u8 reads as u32 (language.md S3).
fn read_ty(c: &Ctx, t: u32) -> u32 {
    match c.^.types[t] {
        U8 => { return TY_U32; }
        _ => { return t; }
    }
}

fn slot_count(c: &Ctx, t: u32) -> u32 {
    match c.^.types[t] {
        Slice(e, m) => { return 2; }
        _ => { return 1; }
    }
}

// ty_str() in cool0.py
fn put_ty(c: &mut Ctx, t: u32) {
    let k: u32 = ty_kind(c, t);
    let arg: u32 = ty_arg(c, t);
    let flag: u32 = ty_flag(c, t);
    if k == TYK_I32 { put_str(c, "i32"); return; }
    if k == TYK_U32 { put_str(c, "u32"); return; }
    if k == TYK_BOOL { put_str(c, "bool"); return; }
    if k == TYK_U8 { put_str(c, "u8"); return; }
    if k == TYK_VOID { put_str(c, "void"); return; }
    if k == TYK_INTLIT { put_str(c, "integer literal"); return; }
    if k == TYK_SLICE {
        if flag != 0 { put_str(c, "[]mut "); } else { put_str(c, "[]"); }
        put_ty(c, arg);
        return;
    }
    if k == TYK_REF {
        if flag != 0 { put_str(c, "&mut "); } else { put_str(c, "&"); }
        put_ty(c, arg);
        return;
    }
    if k == TYK_PTR {
        put_str(c, "*");
        put_ty(c, arg);
        return;
    }
    put_src(c, arg, flag);
}

fn put_q_ty(c: &mut Ctx, t: u32) { put_ch(c, 96); put_ty(c, t); put_ch(c, 96); }

fn put_q_src(c: &mut Ctx, s: u32, l: u32) { put_ch(c, 96); put_src(c, s, l); put_ch(c, 96); }

// ===========================================================================
// Declaration tables
// ===========================================================================
//
// Every table is a slice arena of records with named fields. Index 0 is "none"
// in each, so every arena starts filling at 1.

struct FieldI {   // a struct field, or one payload slot of an enum variant
    ns: u32,
    nl: u32,
    ty: u32,
    off: u32,
    next: u32,
}

struct StructI {
    ns: u32,
    nl: u32,
    fields: u32,
    bytes: u32,
    align: u32,
    next: u32,
}

struct VariantI {
    ns: u32,
    nl: u32,
    tag: u32,
    payload: u32,
    nargs: u32,
    next: u32,
}

struct EnumI {
    ns: u32,
    nl: u32,
    variants: u32,
    bytes: u32,
    align: u32,
    nvar: u32,
    next: u32,
}

struct ConstI {
    ns: u32,
    nl: u32,
    ty: u32,
    value: u32,
    state: u32,   // 0 pending, 1 busy, 2 done
    decl: u32,
    next: u32,
}

struct ParamI {
    ns: u32,
    nl: u32,
    ty: u32,
    next: u32,
}

struct FnI {
    ns: u32,
    nl: u32,
    params: u32,
    nparams: u32,
    ret: u32,
    index: u32,
    decl: u32,
    locals: u32,
    ltail: u32,
    frame: u32,
    npslot: u32,
    nlslot: u32,
    next: u32,
}

struct LocalI {
    ns: u32,
    nl: u32,
    ty: u32,
    is_mut: u32,
    is_param: u32,
    addr: u32,    // address-taken (implementation.md S6)
    slot: u32,
    foff: u32,
    next: u32,
}

struct StrI {
    ptr: u32,
    len: u32,
    addr: u32,
    next: u32,
}

struct NameI {   // a claimed top-level name, or a type name
    ns: u32,
    nl: u32,
    next: u32,
}

const RODATA: u32 = 0x0100_0000;

// --- lookups ---------------------------------------------------------------

fn find_struct(c: &Ctx, s: u32, l: u32) -> u32 {
    for let mut p: u32 = 1; p < c.^.nstruct; p += 1 {
        let ns: u32 = c.^.structs[p].ns;
        let nl: u32 = c.^.structs[p].nl;
        if src_eq2(c, ns, nl, s, l) { return p; }
    }
    return 0;
}

fn find_enum(c: &Ctx, s: u32, l: u32) -> u32 {
    for let mut p: u32 = 1; p < c.^.nenum; p += 1 {
        let ns: u32 = c.^.enums[p].ns;
        let nl: u32 = c.^.enums[p].nl;
        if src_eq2(c, ns, nl, s, l) { return p; }
    }
    return 0;
}

fn find_const(c: &Ctx, s: u32, l: u32) -> u32 {
    for let mut p: u32 = 1; p < c.^.nconst; p += 1 {
        let ns: u32 = c.^.consts[p].ns;
        let nl: u32 = c.^.consts[p].nl;
        if src_eq2(c, ns, nl, s, l) { return p; }
    }
    return 0;
}

fn find_fn(c: &Ctx, s: u32, l: u32) -> u32 {
    for let mut p: u32 = 1; p < c.^.nfn; p += 1 {
        let ns: u32 = c.^.fns[p].ns;
        let nl: u32 = c.^.fns[p].nl;
        if src_eq2(c, ns, nl, s, l) { return p; }
    }
    return 0;
}

fn find_type_name(c: &Ctx, s: u32, l: u32) -> bool {
    for let mut p: u32 = 1; p < c.^.ntyname; p += 1 {
        let ns: u32 = c.^.tynames[p].ns;
        let nl: u32 = c.^.tynames[p].nl;
        if src_eq2(c, ns, nl, s, l) { return true; }
    }
    return false;
}

fn find_taken(c: &Ctx, s: u32, l: u32) -> bool {
    for let mut p: u32 = 1; p < c.^.ntaken; p += 1 {
        let ns: u32 = c.^.taken[p].ns;
        let nl: u32 = c.^.taken[p].nl;
        if src_eq2(c, ns, nl, s, l) { return true; }
    }
    return false;
}

// The aggregate info behind a named type
fn agg_struct(c: &Ctx, t: u32) -> u32 {
    let s: u32 = ty_arg(c, t);
    let l: u32 = ty_flag(c, t);
    return find_struct(c, s, l);
}

fn agg_enum(c: &Ctx, t: u32) -> u32 {
    let s: u32 = ty_arg(c, t);
    let l: u32 = ty_flag(c, t);
    return find_enum(c, s, l);
}

fn size_of(c: &Ctx, t: u32) -> u32 {
    match c.^.types[t] {
        Bool => { return 1; }
        U8 => { return 1; }
        Slice(e, m) => { return 8; }
        Named(ns, nl) => {
            let s: u32 = find_struct(c, ns, nl);
            if s != 0 { return c.^.structs[s].bytes; }
            let e2: u32 = find_enum(c, ns, nl);
            if e2 != 0 { return c.^.enums[e2].bytes; }
            return 0;
        }
        _ => { return 4; }
    }
}

fn align_of(c: &Ctx, t: u32) -> u32 {
    match c.^.types[t] {
        Bool => { return 1; }
        U8 => { return 1; }
        Named(ns, nl) => {
            let s: u32 = find_struct(c, ns, nl);
            if s != 0 { return c.^.structs[s].align; }
            let e2: u32 = find_enum(c, ns, nl);
            if e2 != 0 { return c.^.enums[e2].align; }
            return 1;
        }
        _ => { return 4; }
    }
}

fn align_up(x: u32, a: u32) -> u32 { return (x + a - 1) / a * a; }

// --- resolving type syntax to types ----------------------------------------

fn e_unknown_type(c: &mut Ctx, line: u32, col: u32, s: u32, l: u32) {
    if err_open(c, line, col) {
        put_str(c, "unknown type ");
        put_q_src(c, s, l);
        err_end(c);
    }
}

fn resolve_ty(c: &mut Ctx, t: u32) -> u32 {
    if t == 0 { return TY_VOID; }
    let k: u32 = c.^.nodes[t].kind;
    let a: u32 = c.^.nodes[t].a;
    let b: u32 = c.^.nodes[t].b;
    if k == T_PRIM {
        if a == 0 { return TY_I32; }
        if a == 1 { return TY_U32; }
        if a == 2 { return TY_BOOL; }
        return TY_U8;
    }
    if k == T_NAMED {
        if find_type_name(c, a, b) { return ty_named(c, a, b); }
        let line: u32 = c.^.nodes[t].line;
        let col: u32 = c.^.nodes[t].col;
        e_unknown_type(c, line, col, a, b);
        return TY_I32;
    }
    if k == T_SLICE {
        let inner: u32 = resolve_ty(c, a);
        return ty_intern(c, TYK_SLICE, inner, b);
    }
    if k == T_REF {
        let inner: u32 = resolve_ty(c, a);
        return ty_intern(c, TYK_REF, inner, b);
    }
    let inner: u32 = resolve_ty(c, a);
    return ty_intern(c, TYK_PTR, inner, 0);
}

// --- string interning (implementation.md S4) -------------------------------

fn bytes_eq(p1: u32, l1: u32, p2: u32, l2: u32) -> bool {
    if l1 != l2 { return false; }
    for let mut i: u32 = 0; i < l1; i += 1 {
        if ldb(p1 + i) != ldb(p2 + i) { return false; }
    }
    return true;
}

fn intern_string(c: &mut Ctx, ptr: u32, len: u32) -> u32 {
    for let mut p: u32 = 1; p < c.^.nstr; p += 1 {
        let sp: u32 = c.^.strs[p].ptr;
        let sl: u32 = c.^.strs[p].len;
        if bytes_eq(sp, sl, ptr, len) { return c.^.strs[p].addr; }
    }
    let n: u32 = c.^.nstr;
    let addr: u32 = c.^.rodata;
    c.^.strs[n] = StrI{ ptr: ptr, len: len, addr: addr, next: 0 };
    c.^.nstr = n + 1;
    c.^.rodata = addr + len;
    return addr;
}

// ===========================================================================
// Arena sizing
// ===========================================================================
//
// Every table is bounded by a count of AST nodes of one kind, so one linear
// pass over the node arena sizes all of them exactly. Guessing from the source
// length instead would reserve megabytes that are never touched.

struct Counts {
    tys: u32,
    fields: u32,
    structs: u32,
    variants: u32,
    enums: u32,
    consts: u32,
    params: u32,
    fns: u32,
    lets: u32,
    binds: u32,
    strs: u32,
}

fn count_nodes(c: &Ctx, n: &mut Counts) {
    for let mut i: u32 = 1; i < c.^.nnode; i += 1 {
        let k: u32 = c.^.nodes[i].kind;
        if k >= T_PRIM && k <= T_PTR { n.^.tys += 1; }
        else if k == D_FIELD { n.^.fields += 1; }
        else if k == D_STRUCT { n.^.structs += 1; }
        else if k == D_VARIANT { n.^.variants += 1; }
        else if k == D_ENUM { n.^.enums += 1; }
        else if k == D_CONST { n.^.consts += 1; }
        else if k == D_PARAM { n.^.params += 1; }
        else if k == D_FN { n.^.fns += 1; }
        else if k == S_LET { n.^.lets += 1; }
        else if k == S_BIND { n.^.binds += 1; }
        else if k == E_STR { n.^.strs += 1; }
    }
}

fn init_types(c: &mut Ctx) {
    c.^.types[TY_I32] = Ty.I32;
    c.^.types[TY_U32] = Ty.U32;
    c.^.types[TY_BOOL] = Ty.Bool;
    c.^.types[TY_U8] = Ty.U8;
    c.^.types[TY_VOID] = Ty.Void;
    c.^.types[TY_INTLIT] = Ty.IntLit;
    c.^.nty = TY_FIRST;
}

// ===========================================================================
// Entry point (implementation.md S7)
// ===========================================================================

fn compile(src_len_in: u32) -> i32 {
    unsafe {
        // The heap starts just past the source. Everything the compiler builds
        // is bump-allocated from here and never freed -- one run, then the host
        // reclaims the memory (language.md S1).
        let heap0: u32 = align4(SRC + src_len_in) + 4;

        // There can be no more tokens than source bytes, plus one for eof.
        let ntok_max: u32 = src_len_in + 1;
        let tok_bytes: u32 = ntok_max * 28;

        // This is the boundary. Below it every access is bounds-checked.
        let mut c: Ctx = Ctx{
            src: slice(SRC as *u8, src_len_in),
            pos: 0,
            line: 1,
            col: 1,
            toks: slice_mut(heap0 as *Token, ntok_max),
            ntok: 0,
            nodes: slice_mut(heap0 as *Node, 0),
            nnode: 1,
            ti: 0,
            edepth: 0,
            bdepth: 0,
            decls: 0,
            types: slice_mut(heap0 as *Ty, 0),
            nty: TY_FIRST,
            fields: slice_mut(heap0 as *FieldI, 0),
            nfield: 1,
            structs: slice_mut(heap0 as *StructI, 0),
            nstruct: 1,
            variants: slice_mut(heap0 as *VariantI, 0),
            nvariant: 1,
            enums: slice_mut(heap0 as *EnumI, 0),
            nenum: 1,
            consts: slice_mut(heap0 as *ConstI, 0),
            nconst: 1,
            params: slice_mut(heap0 as *ParamI, 0),
            nparam: 1,
            fns: slice_mut(heap0 as *FnI, 0),
            nfn: 1,
            locals: slice_mut(heap0 as *LocalI, 0),
            nlocal: 1,
            strs: slice_mut(heap0 as *StrI, 0),
            nstr: 1,
            taken: slice_mut(heap0 as *NameI, 0),
            ntaken: 1,
            tynames: slice_mut(heap0 as *NameI, 0),
            ntyname: 1,
            rodata: RODATA,
            heap: heap0 + tok_bytes,
            err: 0,
            out: OUT,
        };

        lex(&mut c);

        // The node arena is sized from the token count, not the source length --
        // there is at most one node per token and tokens are far fewer than
        // bytes. Sizing it before lexing would reserve megabytes for nothing.
        if c.err == 0 {
            let nmax: u32 = c.ntok + 2;
            c.nodes = slice_mut(c.heap as *Node, nmax);
            let nodes_at: u32 = c.heap;
            c.heap = c.heap + nmax * 52;
            parse_program(&mut c);
            stw(G_NODES, nodes_at);
            stw(G_DECLS, c.decls);
        }

        if c.err == 0 {
            let mut k: Counts = Counts{
                tys: 0, fields: 0, structs: 0, variants: 0, enums: 0,
                consts: 0, params: 0, fns: 0, lets: 0, binds: 0, strs: 0,
            };
            count_nodes(&c, &mut k);

            let n_ty: u32 = k.tys + TY_FIRST + 8;
            c.types = slice_mut(c.heap as *Ty, n_ty);
            c.heap = c.heap + n_ty * 12;

            let n_field: u32 = k.fields + k.tys + 2;
            c.fields = slice_mut(c.heap as *FieldI, n_field);
            c.heap = c.heap + n_field * 20;

            let n_struct: u32 = k.structs + 2;
            c.structs = slice_mut(c.heap as *StructI, n_struct);
            c.heap = c.heap + n_struct * 24;

            let n_variant: u32 = k.variants + 2;
            c.variants = slice_mut(c.heap as *VariantI, n_variant);
            c.heap = c.heap + n_variant * 24;

            let n_enum: u32 = k.enums + 2;
            c.enums = slice_mut(c.heap as *EnumI, n_enum);
            c.heap = c.heap + n_enum * 28;

            let n_const: u32 = k.consts + 2;
            c.consts = slice_mut(c.heap as *ConstI, n_const);
            c.heap = c.heap + n_const * 28;

            let n_param: u32 = k.params + 2;
            c.params = slice_mut(c.heap as *ParamI, n_param);
            c.heap = c.heap + n_param * 16;

            let n_fn: u32 = k.fns + 2;
            c.fns = slice_mut(c.heap as *FnI, n_fn);
            c.heap = c.heap + n_fn * 52;

            let n_local: u32 = k.params + k.lets + k.binds + 2;
            c.locals = slice_mut(c.heap as *LocalI, n_local);
            c.heap = c.heap + n_local * 36;

            let n_str: u32 = k.strs + 2;
            c.strs = slice_mut(c.heap as *StrI, n_str);
            c.heap = c.heap + n_str * 16;

            let n_name: u32 = k.structs + k.enums + k.consts + k.fns + 2;
            c.taken = slice_mut(c.heap as *NameI, n_name);
            c.heap = c.heap + n_name * 12;
            c.tynames = slice_mut(c.heap as *NameI, n_name);
            c.heap = c.heap + n_name * 12;

            init_types(&mut c);
        }

        // debug window for the workbench
        let toks_at: u32 = heap0;
        stw(G_TOKS, toks_at);
        stw(G_NTOK, c.ntok);
        stw(G_ERR, c.err);

        stw(OUT_PTR_ADDR, OUT);
        stw(OUT_LEN_ADDR, c.out - OUT);
        if c.err != 0 { return 1; }
        return 0;
    }
}

fn stw(a: u32, v: u32) { unsafe { let p: *u32 = a as *u32; p.^ = v; } }
