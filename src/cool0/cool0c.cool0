// ===========================================================================
// cool0c -- the cool0 compiler, written in cool0
//
// It implements SPEC.md and must emit byte-identical output to cool0.py (S9).
//
// This file uses only a narrow subset of cool0:
//
//     u32 i32 bool, functions, const, []u8 literals, unsafe pointers, if, for
//
// No struct, no enum, no match, no borrows, no aggregates. Therefore
//
//   - not one function needs a shadow frame (no prologue, no epilogue)
//   - every local sits in a wasm local
//   - one function transcribes to exactly one WAT function.
//
// What it compiles is still all of cool0. Only what it is written in is narrow.
//
// Every data structure is hand-rolled: a bump heap, records as u32 arrays,
// field access through ld/st.
// ===========================================================================

// --- memory map (SPEC.md S8) ----------------------------------------------

const OUT_PTR_ADDR: u32 = 0x0000;
const OUT_LEN_ADDR: u32 = 0x0004;
const SRC: u32 = 0x1000;

// Globals live in the shadow stack region -- this compiler builds no frames
const G_SRCLEN: u32 = 0x0010;
const G_ERR: u32 = 0x0014;
const G_POS: u32 = 0x0018;
const G_LINE: u32 = 0x001C;
const G_COL: u32 = 0x0020;
const G_HEAP: u32 = 0x0024;
const G_OUT: u32 = 0x0028;
const G_NTOK: u32 = 0x002C;
const G_TOKS: u32 = 0x0030;

// regions
const S1: u32 = 0x0080_0000;   // scratch for one function body
const S2: u32 = 0x00A0_0000;   // scratch for one section payload
const OUT: u32 = 0x0101_0000;  // final output; 0x0100_0000 is this module's rodata

// --- raw memory ------------------------------------------------------------

fn ld(a: u32) -> u32 { unsafe { let p: *u32 = a as *u32; return p.^; } }

fn st(a: u32, v: u32) { unsafe { let p: *u32 = a as *u32; p.^ = v; } }

fn ldb(a: u32) -> u32 { unsafe { let p: *u8 = a as *u8; return p.^; } }

fn stb(a: u32, v: u32) { unsafe { let p: *u8 = a as *u8; p.^ = v; } }

fn align4(v: u32) -> u32 { return (v + 3) / 4 * 4; }

// Bump allocation. Nothing is ever freed -- the compiler runs once.
fn alloc(bytes: u32) -> u32 {
    let a: u32 = ld(G_HEAP);
    st(G_HEAP, a + align4(bytes));
    return a;
}

fn zero(addr: u32, bytes: u32) {
    for let mut i: u32 = 0; i < bytes; i += 4 { st(addr + i, 0); }
}

// --- output buffer ---------------------------------------------------------

fn out_reset() { st(G_OUT, OUT); }

fn put_ch(c: u32) {
    stb(ld(G_OUT), c);
    st(G_OUT, ld(G_OUT) + 1);
}

fn put_str(s: []u8) {
    for let mut i: u32 = 0; i < s.len; i += 1 { put_ch(s[i]); }
}

fn put_src(start: u32, len: u32) {
    for let mut i: u32 = 0; i < len; i += 1 { put_ch(ldb(SRC + start + i)); }
}

fn put_num(v: u32) {
    if v >= 10 { put_num(v / 10); }
    put_ch('0' + v % 10);
}

// --- diagnostics (SPEC.md S12) ---------------------------------------------

fn failed() -> bool { return ld(G_ERR) != 0; }

// Stop at the first error. Only the winner writes its message.
fn err_open(line: u32, col: u32) -> bool {
    if failed() { return false; }
    st(G_ERR, 1);
    out_reset();
    put_num(line);
    put_ch(':');
    put_num(col);
    put_ch(':');
    put_ch(' ');
    return true;
}

fn err_end() { put_ch('\n'); }

// A diagnostic that is just one fixed phrase
fn err_msg(line: u32, col: u32, s: []u8) {
    if err_open(line, col) { put_str(s); err_end(); }
}

// --- tokens (SPEC.md S2) ---------------------------------------------------

const TK_EOF: u32 = 0;
const TK_IDENT: u32 = 1;
const TK_INT: u32 = 2;
const TK_CHAR: u32 = 3;
const TK_STR: u32 = 4;
const TK_KW: u32 = 5;
const TK_PUNCT: u32 = 6;

// token record: 8 words
const TOK_SIZE: u32 = 32;
const T_KIND: u32 = 0;
const T_START: u32 = 4;
const T_LEN: u32 = 8;
const T_VALUE: u32 = 12;   // int/char value, punct/keyword id, or string bytes
const T_LINE: u32 = 16;
const T_COL: u32 = 20;
const T_AUX: u32 = 24;     // decoded length of a string literal

fn tok(i: u32) -> u32 { return ld(G_TOKS) + i * TOK_SIZE; }

fn tk(i: u32, f: u32) -> u32 { return ld(tok(i) + f); }

// keyword ids -- the order SPEC.md S2 lists them in
const K_FN: u32 = 0;
const K_STRUCT: u32 = 1;
const K_ENUM: u32 = 2;
const K_CONST: u32 = 3;
const K_LET: u32 = 4;
const K_MUT: u32 = 5;
const K_IF: u32 = 6;
const K_ELSE: u32 = 7;
const K_FOR: u32 = 8;
const K_BREAK: u32 = 9;
const K_CONTINUE: u32 = 10;
const K_RETURN: u32 = 11;
const K_MATCH: u32 = 12;
const K_UNSAFE: u32 = 13;
const K_AS: u32 = 14;
const K_TRUE: u32 = 15;
const K_FALSE: u32 = 16;

// punctuation ids -- longest match order
const P_SHLEQ: u32 = 0;
const P_SHREQ: u32 = 1;
const P_ARROW: u32 = 2;
const P_FATARROW: u32 = 3;
const P_EQEQ: u32 = 4;
const P_NE: u32 = 5;
const P_LE: u32 = 6;
const P_GE: u32 = 7;
const P_ANDAND: u32 = 8;
const P_OROR: u32 = 9;
const P_SHL: u32 = 10;
const P_SHR: u32 = 11;
const P_ADDEQ: u32 = 12;
const P_SUBEQ: u32 = 13;
const P_MULEQ: u32 = 14;
const P_DIVEQ: u32 = 15;
const P_MODEQ: u32 = 16;
const P_ANDEQ: u32 = 17;
const P_OREQ: u32 = 18;
const P_XOREQ: u32 = 19;
const P_LPAREN: u32 = 20;
const P_RPAREN: u32 = 21;
const P_LBRACE: u32 = 22;
const P_RBRACE: u32 = 23;
const P_LBRACK: u32 = 24;
const P_RBRACK: u32 = 25;
const P_COMMA: u32 = 26;
const P_SEMI: u32 = 27;
const P_COLON: u32 = 28;
const P_DOT: u32 = 29;
const P_EQ: u32 = 30;
const P_LT: u32 = 31;
const P_GT: u32 = 32;
const P_ADD: u32 = 33;
const P_SUB: u32 = 34;
const P_MUL: u32 = 35;
const P_DIV: u32 = 36;
const P_MOD: u32 = 37;
const P_AND: u32 = 38;
const P_OR: u32 = 39;
const P_XOR: u32 = 40;
const P_NOT: u32 = 41;

const NONE: u32 = 0xFFFF_FFFF;

// --- lexer (SPEC.md S2) ----------------------------------------------------

// Byte predicates. Source is ASCII only.
fn is_alpha(b: u32) -> bool {
    return b >= 'A' && b <= 'Z' || b >= 'a' && b <= 'z';
}

fn is_digit(b: u32) -> bool { return b >= '0' && b <= '9'; }

fn is_ident_start(b: u32) -> bool { return is_alpha(b) || b == '_'; }

fn is_ident_cont(b: u32) -> bool { return is_alpha(b) || is_digit(b) || b == '_'; }

fn src_len() -> u32 { return ld(G_SRCLEN); }

fn at(i: u32) -> u32 { return ldb(SRC + i); }

fn adv(k: u32) {
    for let mut t: u32 = 0; t < k; t += 1 {
        if at(ld(G_POS)) == '\n' {
            st(G_LINE, ld(G_LINE) + 1);
            st(G_COL, 1);
        } else {
            st(G_COL, ld(G_COL) + 1);
        }
        st(G_POS, ld(G_POS) + 1);
    }
}

// does source [start, start+len) equal s
fn src_eq(start: u32, len: u32, s: []u8) -> bool {
    if len != s.len { return false; }
    for let mut i: u32 = 0; i < len; i += 1 {
        if at(start + i) != s[i] { return false; }
    }
    return true;
}

// does source at i start with s
fn src_has(i: u32, s: []u8) -> bool {
    if i + s.len > src_len() { return false; }
    for let mut k: u32 = 0; k < s.len; k += 1 {
        if at(i + k) != s[k] { return false; }
    }
    return true;
}

fn kw_id(start: u32, len: u32) -> u32 {
    if src_eq(start, len, "fn") { return K_FN; }
    if src_eq(start, len, "struct") { return K_STRUCT; }
    if src_eq(start, len, "enum") { return K_ENUM; }
    if src_eq(start, len, "const") { return K_CONST; }
    if src_eq(start, len, "let") { return K_LET; }
    if src_eq(start, len, "mut") { return K_MUT; }
    if src_eq(start, len, "if") { return K_IF; }
    if src_eq(start, len, "else") { return K_ELSE; }
    if src_eq(start, len, "for") { return K_FOR; }
    if src_eq(start, len, "break") { return K_BREAK; }
    if src_eq(start, len, "continue") { return K_CONTINUE; }
    if src_eq(start, len, "return") { return K_RETURN; }
    if src_eq(start, len, "match") { return K_MATCH; }
    if src_eq(start, len, "unsafe") { return K_UNSAFE; }
    if src_eq(start, len, "as") { return K_AS; }
    if src_eq(start, len, "true") { return K_TRUE; }
    if src_eq(start, len, "false") { return K_FALSE; }
    return NONE;
}

// longest match (S2)
fn punct_id(i: u32) -> u32 {
    if src_has(i, "<<=") { return P_SHLEQ; }
    if src_has(i, ">>=") { return P_SHREQ; }
    if src_has(i, "->") { return P_ARROW; }
    if src_has(i, "=>") { return P_FATARROW; }
    if src_has(i, "==") { return P_EQEQ; }
    if src_has(i, "!=") { return P_NE; }
    if src_has(i, "<=") { return P_LE; }
    if src_has(i, ">=") { return P_GE; }
    if src_has(i, "&&") { return P_ANDAND; }
    if src_has(i, "||") { return P_OROR; }
    if src_has(i, "<<") { return P_SHL; }
    if src_has(i, ">>") { return P_SHR; }
    if src_has(i, "+=") { return P_ADDEQ; }
    if src_has(i, "-=") { return P_SUBEQ; }
    if src_has(i, "*=") { return P_MULEQ; }
    if src_has(i, "/=") { return P_DIVEQ; }
    if src_has(i, "%=") { return P_MODEQ; }
    if src_has(i, "&=") { return P_ANDEQ; }
    if src_has(i, "|=") { return P_OREQ; }
    if src_has(i, "^=") { return P_XOREQ; }
    if src_has(i, "(") { return P_LPAREN; }
    if src_has(i, ")") { return P_RPAREN; }
    if src_has(i, "{") { return P_LBRACE; }
    if src_has(i, "}") { return P_RBRACE; }
    if src_has(i, "[") { return P_LBRACK; }
    if src_has(i, "]") { return P_RBRACK; }
    if src_has(i, ",") { return P_COMMA; }
    if src_has(i, ";") { return P_SEMI; }
    if src_has(i, ":") { return P_COLON; }
    if src_has(i, ".") { return P_DOT; }
    if src_has(i, "=") { return P_EQ; }
    if src_has(i, "<") { return P_LT; }
    if src_has(i, ">") { return P_GT; }
    if src_has(i, "+") { return P_ADD; }
    if src_has(i, "-") { return P_SUB; }
    if src_has(i, "*") { return P_MUL; }
    if src_has(i, "/") { return P_DIV; }
    if src_has(i, "%") { return P_MOD; }
    if src_has(i, "&") { return P_AND; }
    if src_has(i, "|") { return P_OR; }
    if src_has(i, "^") { return P_XOR; }
    if src_has(i, "!") { return P_NOT; }
    return NONE;
}

fn punct_len(id: u32) -> u32 {
    if id <= P_SHREQ { return 3; }
    if id <= P_XOREQ { return 2; }
    return 1;
}

fn push_tok(kind: u32, start: u32, len: u32, value: u32, line: u32, col: u32, aux: u32) {
    let t: u32 = tok(ld(G_NTOK));
    st(t + T_KIND, kind);
    st(t + T_START, start);
    st(t + T_LEN, len);
    st(t + T_VALUE, value);
    st(t + T_LINE, line);
    st(t + T_COL, col);
    st(t + T_AUX, aux);
    st(G_NTOK, ld(G_NTOK) + 1);
}

// One escape. Strings allow one more than chars do (S2).
fn escape_of(e: u32, in_string: bool) -> u32 {
    if e == 'n' { return 10; }
    if e == 't' { return 9; }
    if e == 'r' { return 13; }
    if e == '0' { return 0; }
    if e == '\\' { return 92; }
    if e == '\'' { return 39; }
    if in_string && e == '"' { return 34; }
    return NONE;
}

fn lex_ident() {
    let sl: u32 = ld(G_LINE);
    let sc: u32 = ld(G_COL);
    let i: u32 = ld(G_POS);
    let mut j: u32 = i;
    for j < src_len() && is_ident_cont(at(j)) { j += 1; }
    let id: u32 = kw_id(i, j - i);
    adv(j - i);
    if id == NONE {
        push_tok(TK_IDENT, i, j - i, 0, sl, sc, 0);
    } else {
        push_tok(TK_KW, i, j - i, id, sl, sc, 0);
    }
}

fn digit_val(c: u32, base: u32) -> u32 {
    if is_digit(c) {
        if c - '0' < base { return c - '0'; }
        return NONE;
    }
    if base == 16 {
        if c >= 'a' && c <= 'f' { return c - 'a' + 10; }
        if c >= 'A' && c <= 'F' { return c - 'A' + 10; }
    }
    return NONE;
}

fn lex_number() {
    let sl: u32 = ld(G_LINE);
    let sc: u32 = ld(G_COL);
    let i: u32 = ld(G_POS);
    let mut base: u32 = 10;
    let mut j: u32 = i;
    if at(i) == '0' && i + 1 < src_len() {
        let c: u32 = at(i + 1);
        if c == 'x' || c == 'X' { base = 16; j = i + 2; }
        if c == 'b' || c == 'B' { base = 2; j = i + 2; }
    }
    let mut ndigits: u32 = 0;
    let mut value: u32 = 0;
    let mut over: bool = false;
    for j < src_len() {
        let c: u32 = at(j);
        if c == '_' {
            j += 1;
        } else {
            let d: u32 = digit_val(c, base);
            if d == NONE { break; }
            // detect overflow past 32 bits; the value itself is then meaningless
            if value > (0xFFFF_FFFF - d) / base { over = true; }
            value = value * base + d;
            ndigits += 1;
            j += 1;
        }
    }
    if ndigits == 0 {
        err_msg(sl, sc, "integer literal has no digits");
        return;
    }
    if j < src_len() && is_ident_cont(at(j)) {
        err_msg(sl, sc, "invalid digit in integer literal");
        return;
    }
    if over {
        err_msg(sl, sc, "integer literal out of range");
        return;
    }
    adv(j - i);
    push_tok(TK_INT, i, j - i, value, sl, sc, 0);
}

fn lex_char() {
    let sl: u32 = ld(G_LINE);
    let sc: u32 = ld(G_COL);
    let start: u32 = ld(G_POS);
    adv(1);
    if ld(G_POS) >= src_len() {
        err_msg(sl, sc, "unterminated character literal");
        return;
    }
    if at(ld(G_POS)) == '\'' {
        err_msg(sl, sc, "empty character literal");
        return;
    }
    let mut value: u32 = 0;
    if at(ld(G_POS)) == '\\' {
        adv(1);
        if ld(G_POS) >= src_len() {
            err_msg(sl, sc, "unterminated character literal");
            return;
        }
        let e: u32 = escape_of(at(ld(G_POS)), false);
        if e == NONE {
            err_msg(ld(G_LINE), ld(G_COL), "unknown escape sequence");
            return;
        }
        value = e;
        adv(1);
    } else {
        value = at(ld(G_POS));
        if value < 0x20 || value > 0x7E {
            err_msg(ld(G_LINE), ld(G_COL), "invalid character in character literal");
            return;
        }
        adv(1);
    }
    if ld(G_POS) >= src_len() {
        err_msg(sl, sc, "unterminated character literal");
        return;
    }
    if at(ld(G_POS)) != '\'' {
        err_msg(sl, sc, "unterminated character literal");
        return;
    }
    adv(1);
    push_tok(TK_CHAR, start, ld(G_POS) - start, value, sl, sc, 0);
}

fn lex_string() {
    let sl: u32 = ld(G_LINE);
    let sc: u32 = ld(G_COL);
    let start: u32 = ld(G_POS);
    adv(1);
    let buf: u32 = ld(G_HEAP);
    let mut n: u32 = 0;
    for {
        if ld(G_POS) >= src_len() {
            err_msg(sl, sc, "unterminated string literal");
            return;
        }
        let c: u32 = at(ld(G_POS));
        if c == '\n' {
            err_msg(sl, sc, "unterminated string literal");
            return;
        }
        if c == '"' {
            adv(1);
            break;
        }
        if c == '\\' {
            adv(1);
            if ld(G_POS) >= src_len() {
                err_msg(sl, sc, "unterminated string literal");
                return;
            }
            let e: u32 = escape_of(at(ld(G_POS)), true);
            if e == NONE {
                err_msg(ld(G_LINE), ld(G_COL), "unknown escape sequence");
                return;
            }
            stb(buf + n, e);
            n += 1;
            adv(1);
        } else {
            if c < 0x20 || c > 0x7E {
                err_msg(ld(G_LINE), ld(G_COL), "invalid character in string literal");
                return;
            }
            stb(buf + n, c);
            n += 1;
            adv(1);
        }
    }
    st(G_HEAP, align4(buf + n));
    push_tok(TK_STR, start, ld(G_POS) - start, buf, sl, sc, n);
}

fn lex_comment() {
    for ld(G_POS) < src_len() && at(ld(G_POS)) != '\n' {
        let c: u32 = at(ld(G_POS));
        if c != 9 && c != 13 && (c < 0x20 || c > 0x7E) {
            err_msg(ld(G_LINE), ld(G_COL), "non-ascii byte in source");
            return;
        }
        adv(1);
    }
}

fn lex() {
    st(G_TOKS, ld(G_HEAP));
    // there can be no more tokens than source bytes, plus one for eof
    st(G_HEAP, ld(G_HEAP) + (src_len() + 1) * TOK_SIZE);
    st(G_NTOK, 0);
    st(G_POS, 0);
    st(G_LINE, 1);
    st(G_COL, 1);

    for ld(G_POS) < src_len() && !failed() {
        let i: u32 = ld(G_POS);
        let b: u32 = at(i);

        if b != 9 && b != 10 && b != 13 && (b < 0x20 || b > 0x7E) {
            err_msg(ld(G_LINE), ld(G_COL), "non-ascii byte in source");
            return;
        }
        if b == 9 || b == 10 || b == 13 || b == 32 {
            adv(1);
            continue;
        }
        if b == '/' && i + 1 < src_len() && at(i + 1) == '/' {
            lex_comment();
            continue;
        }
        if is_ident_start(b) { lex_ident(); continue; }
        if is_digit(b) { lex_number(); continue; }
        if b == '\'' { lex_char(); continue; }
        if b == '"' { lex_string(); continue; }

        let p: u32 = punct_id(i);
        if p == NONE {
            err_msg(ld(G_LINE), ld(G_COL), "unexpected character");
            return;
        }
        let sl: u32 = ld(G_LINE);
        let sc: u32 = ld(G_COL);
        adv(punct_len(p));
        push_tok(TK_PUNCT, i, punct_len(p), p, sl, sc, 0);
    }
    if failed() { return; }
    push_tok(TK_EOF, ld(G_POS), 0, 0, ld(G_LINE), ld(G_COL), 0);
}

// --- AST nodes -------------------------------------------------------------
//
// One arena, one record shape. Address 0 means "none" -- the heap starts well
// above zero so a real node can never sit at 0.

const NODE_SIZE: u32 = 52;
const N_KIND: u32 = 0;
const N_LINE: u32 = 4;
const N_COL: u32 = 8;
const N_A: u32 = 12;
const N_B: u32 = 16;
const N_C: u32 = 20;
const N_D: u32 = 24;
const N_E: u32 = 28;
const N_NEXT: u32 = 32;    // sibling in a list
const N_TY: u32 = 36;      // checker: type id
const N_AUX: u32 = 40;     // checker: local, field, fn, ...
const N_AUX2: u32 = 44;
const N_DEPTH: u32 = 48;   // expression tree depth (S6)

// expressions
const E_INT: u32 = 1;        // A value
const E_CHAR: u32 = 2;       // A value
const E_STR: u32 = 3;        // A bytes, B len; AUX rodata address
const E_BOOL: u32 = 4;       // A 0/1
const E_IDENT: u32 = 5;      // A name start, B name len; AUX local or const value
const E_UNARY: u32 = 6;      // A op(punct), B operand
const E_BINARY: u32 = 7;     // A op(punct), B lhs, C rhs, D operand type
const E_BORROW: u32 = 8;     // A mut, B operand, D root local
const E_CAST: u32 = 9;       // A operand, B type node
const E_CALL: u32 = 10;      // A callee, B args, D fn info
const E_INDEX: u32 = 11;     // A base, B index, D element size
const E_FIELD: u32 = 12;     // A base, B name start, C name len, D field info
const E_DEREF: u32 = 13;     // A base
const E_STRUCTLIT: u32 = 14; // A name start, B name len, C fields, D struct info
const E_LITFIELD: u32 = 15;  // A name start, B name len, C value

// type syntax (SPEC.md S3)
const T_PRIM: u32 = 20;      // A 0=i32 1=u32 2=bool 3=u8
const T_NAMED: u32 = 21;     // A name start, B name len
const T_SLICE: u32 = 22;     // A inner, B mut
const T_REF: u32 = 23;       // A inner, B mut
const T_PTR: u32 = 24;       // A inner

// statements
const S_LET: u32 = 30;       // A name start, B name len, C type, D init, E mut
const S_ASSIGN: u32 = 31;    // A target, B op(punct), C value
const S_EXPR: u32 = 32;      // A call; AUX discard
const S_IF: u32 = 33;        // A cond, B then, C else, D has-else
const S_FOR: u32 = 34;       // A init, B cond, C post, D body
const S_BREAK: u32 = 35;
const S_CONTINUE: u32 = 36;
const S_RETURN: u32 = 37;    // A value
const S_MATCH: u32 = 38;     // A scrutinee, B arms, C enum info, D has-wild
const S_UNSAFE: u32 = 39;    // A body
const S_ARM: u32 = 40;       // A name start, B name len, C binds, D body, E wild
const S_BIND: u32 = 41;      // A name start, B name len; AUX local

// declarations
const D_FN: u32 = 50;        // A name start, B name len, C params, D ret, E body
const D_STRUCT: u32 = 51;    // A name start, B name len, C fields; AUX struct info
const D_ENUM: u32 = 52;      // A name start, B name len, C variants; AUX enum info
const D_CONST: u32 = 53;     // A name start, B name len, C type, D value
const D_PARAM: u32 = 54;     // A name start, B name len, C type; AUX local
const D_FIELD: u32 = 55;     // A name start, B name len, C type
const D_VARIANT: u32 = 56;   // A name start, B name len, C payload types

const MAX_DEPTH: u32 = 64;

const G_TI: u32 = 0x0034;      // parser token index
const G_EDEPTH: u32 = 0x0038;  // grammar nesting depth
const G_BDEPTH: u32 = 0x003C;  // block nesting depth
const G_DECLS: u32 = 0x0040;   // head of the top-level declaration list

fn node(kind: u32, line: u32, col: u32) -> u32 {
    let n: u32 = alloc(NODE_SIZE);
    zero(n, NODE_SIZE);
    st(n + N_KIND, kind);
    st(n + N_LINE, line);
    st(n + N_COL, col);
    st(n + N_DEPTH, 1);
    return n;
}

fn nd(n: u32, f: u32) -> u32 { return ld(n + f); }

fn nset(n: u32, f: u32, v: u32) { st(n + f, v); }

// --- token cursor ----------------------------------------------------------

fn ti() -> u32 { return ld(G_TI); }

fn bump() { st(G_TI, ti() + 1); }

fn cur_kind() -> u32 { return tk(ti(), T_KIND); }

fn cur_val() -> u32 { return tk(ti(), T_VALUE); }

fn cur_line() -> u32 { return tk(ti(), T_LINE); }

fn cur_col() -> u32 { return tk(ti(), T_COL); }

fn at_p(p: u32) -> bool { return cur_kind() == TK_PUNCT && cur_val() == p; }

fn at_kw(k: u32) -> bool { return cur_kind() == TK_KW && cur_val() == k; }

fn eat_p(p: u32) -> bool { if at_p(p) { bump(); return true; } return false; }

fn eat_kw(k: u32) -> bool { if at_kw(k) { bump(); return true; } return false; }

// --- rendering tokens into diagnostics -------------------------------------

fn put_punct(p: u32) {
    if p == P_SHLEQ { put_str("<<="); return; }
    if p == P_SHREQ { put_str(">>="); return; }
    if p == P_ARROW { put_str("->"); return; }
    if p == P_FATARROW { put_str("=>"); return; }
    if p == P_EQEQ { put_str("=="); return; }
    if p == P_NE { put_str("!="); return; }
    if p == P_LE { put_str("<="); return; }
    if p == P_GE { put_str(">="); return; }
    if p == P_ANDAND { put_str("&&"); return; }
    if p == P_OROR { put_str("||"); return; }
    if p == P_SHL { put_str("<<"); return; }
    if p == P_SHR { put_str(">>"); return; }
    if p == P_ADDEQ { put_str("+="); return; }
    if p == P_SUBEQ { put_str("-="); return; }
    if p == P_MULEQ { put_str("*="); return; }
    if p == P_DIVEQ { put_str("/="); return; }
    if p == P_MODEQ { put_str("%="); return; }
    if p == P_ANDEQ { put_str("&="); return; }
    if p == P_OREQ { put_str("|="); return; }
    if p == P_XOREQ { put_str("^="); return; }
    if p == P_LPAREN { put_str("("); return; }
    if p == P_RPAREN { put_str(")"); return; }
    if p == P_LBRACE { put_str("{"); return; }
    if p == P_RBRACE { put_str("}"); return; }
    if p == P_LBRACK { put_str("["); return; }
    if p == P_RBRACK { put_str("]"); return; }
    if p == P_COMMA { put_str(","); return; }
    if p == P_SEMI { put_str(";"); return; }
    if p == P_COLON { put_str(":"); return; }
    if p == P_DOT { put_str("."); return; }
    if p == P_EQ { put_str("="); return; }
    if p == P_LT { put_str("<"); return; }
    if p == P_GT { put_str(">"); return; }
    if p == P_ADD { put_str("+"); return; }
    if p == P_SUB { put_str("-"); return; }
    if p == P_MUL { put_str("*"); return; }
    if p == P_DIV { put_str("/"); return; }
    if p == P_MOD { put_str("%"); return; }
    if p == P_AND { put_str("&"); return; }
    if p == P_OR { put_str("|"); return; }
    if p == P_XOR { put_str("^"); return; }
    put_str("!");
}

fn put_kw(k: u32) {
    if k == K_FN { put_str("fn"); return; }
    if k == K_STRUCT { put_str("struct"); return; }
    if k == K_ENUM { put_str("enum"); return; }
    if k == K_CONST { put_str("const"); return; }
    if k == K_LET { put_str("let"); return; }
    if k == K_MUT { put_str("mut"); return; }
    if k == K_IF { put_str("if"); return; }
    if k == K_ELSE { put_str("else"); return; }
    if k == K_FOR { put_str("for"); return; }
    if k == K_BREAK { put_str("break"); return; }
    if k == K_CONTINUE { put_str("continue"); return; }
    if k == K_RETURN { put_str("return"); return; }
    if k == K_MATCH { put_str("match"); return; }
    if k == K_UNSAFE { put_str("unsafe"); return; }
    if k == K_AS { put_str("as"); return; }
    if k == K_TRUE { put_str("true"); return; }
    put_str("false");
}

// Token.describe() in cool0.py
fn put_describe(i: u32) {
    let k: u32 = tk(i, T_KIND);
    if k == TK_EOF { put_str("end of file"); return; }
    if k == TK_INT { put_str("integer literal"); return; }
    if k == TK_CHAR { put_str("character literal"); return; }
    if k == TK_STR { put_str("string literal"); return; }
    put_ch(96);
    put_src(tk(i, T_START), tk(i, T_LEN));
    put_ch(96);
}

fn e_expected_p(p: u32) {
    if err_open(cur_line(), cur_col()) {
        put_str("expected ");
        put_ch(96);
        put_punct(p);
        put_ch(96);
        put_str(", found ");
        put_describe(ti());
        err_end();
    }
}

fn e_expected_kw(k: u32) {
    if err_open(cur_line(), cur_col()) {
        put_str("expected ");
        put_ch(96);
        put_kw(k);
        put_ch(96);
        put_str(", found ");
        put_describe(ti());
        err_end();
    }
}

fn e_expected_str(s: []u8) {
    if err_open(cur_line(), cur_col()) {
        put_str(s);
        put_str(", found ");
        put_describe(ti());
        err_end();
    }
}

fn expect_p(p: u32) {
    if failed() { return; }
    if at_p(p) { bump(); return; }
    e_expected_p(p);
}

fn expect_kw(k: u32) {
    if failed() { return; }
    if at_kw(k) { bump(); return; }
    e_expected_kw(k);
}

// Returns the token index of the identifier, or NONE.
fn expect_ident() -> u32 {
    if failed() { return NONE; }
    if cur_kind() != TK_IDENT {
        e_expected_str("expected identifier");
        return NONE;
    }
    let i: u32 = ti();
    bump();
    return i;
}

// --- depth guards (SPEC.md S6) ---------------------------------------------

fn e_deep_expr(line: u32, col: u32) { err_msg(line, col, "expression nests too deeply"); }

// Set a composite node's tree depth, guarding the limit.
fn deep(n: u32, maxd: u32) -> u32 {
    if maxd + 1 > MAX_DEPTH {
        e_deep_expr(nd(n, N_LINE), nd(n, N_COL));
        return n;
    }
    nset(n, N_DEPTH, maxd + 1);
    return n;
}

fn depth_of(n: u32) -> u32 { if n == 0 { return 0; } return nd(n, N_DEPTH); }

fn max2(a: u32, b: u32) -> u32 { if a > b { return a; } return b; }

fn depth_list(head: u32) -> u32 {
    let mut d: u32 = 0;
    let mut p: u32 = head;
    for p != 0 {
        d = max2(d, depth_of(p));
        p = nd(p, N_NEXT);
    }
    return d;
}

// --- types (SPEC.md S3) ----------------------------------------------------

fn parse_ty() -> u32 {
    if failed() { return 0; }
    if ld(G_EDEPTH) >= MAX_DEPTH {
        err_msg(cur_line(), cur_col(), "type nests too deeply");
        return 0;
    }
    st(G_EDEPTH, ld(G_EDEPTH) + 1);
    let t: u32 = parse_ty_inner();
    st(G_EDEPTH, ld(G_EDEPTH) - 1);
    return t;
}

fn parse_ty_inner() -> u32 {
    let line: u32 = cur_line();
    let col: u32 = cur_col();
    if eat_p(P_LBRACK) {
        expect_p(P_RBRACK);
        let n: u32 = node(T_SLICE, line, col);
        if eat_kw(K_MUT) { nset(n, N_B, 1); }
        nset(n, N_A, parse_ty());
        return n;
    }
    if eat_p(P_AND) {
        let n: u32 = node(T_REF, line, col);
        if eat_kw(K_MUT) { nset(n, N_B, 1); }
        nset(n, N_A, parse_ty());
        return n;
    }
    if eat_p(P_MUL) {
        let n: u32 = node(T_PTR, line, col);
        nset(n, N_A, parse_ty());
        return n;
    }
    if cur_kind() == TK_IDENT {
        let s: u32 = tk(ti(), T_START);
        let l: u32 = tk(ti(), T_LEN);
        bump();
        if src_eq(s, l, "i32") { let n: u32 = node(T_PRIM, line, col); nset(n, N_A, 0); return n; }
        if src_eq(s, l, "u32") { let n: u32 = node(T_PRIM, line, col); nset(n, N_A, 1); return n; }
        if src_eq(s, l, "bool") { let n: u32 = node(T_PRIM, line, col); nset(n, N_A, 2); return n; }
        if src_eq(s, l, "u8") { let n: u32 = node(T_PRIM, line, col); nset(n, N_A, 3); return n; }
        let n: u32 = node(T_NAMED, line, col);
        nset(n, N_A, s);
        nset(n, N_B, l);
        return n;
    }
    e_expected_str("expected type");
    return 0;
}

// --- expressions (SPEC.md S5) ----------------------------------------------

const CMP_LEVEL: u32 = 2;
const NLEVELS: u32 = 9;

fn is_cmp(p: u32) -> bool {
    return p == P_EQEQ || p == P_NE || p == P_LT || p == P_GT || p == P_LE || p == P_GE;
}

fn op_at_level(p: u32, level: u32) -> bool {
    if level == 0 { return p == P_OROR; }
    if level == 1 { return p == P_ANDAND; }
    if level == 3 { return p == P_OR; }
    if level == 4 { return p == P_XOR; }
    if level == 5 { return p == P_AND; }
    if level == 6 { return p == P_SHL || p == P_SHR; }
    if level == 7 { return p == P_ADD || p == P_SUB; }
    if level == 8 { return p == P_MUL || p == P_DIV || p == P_MOD; }
    return false;
}

fn parse_expr(asl: bool) -> u32 { return parse_bin(0, asl); }

fn parse_bin(level: u32, asl: bool) -> u32 {
    if failed() { return 0; }
    if level == CMP_LEVEL { return parse_cmp(asl); }
    if level >= NLEVELS { return parse_unary(asl); }
    let mut lhs: u32 = parse_bin(level + 1, asl);
    for !failed() && cur_kind() == TK_PUNCT && op_at_level(cur_val(), level) {
        let line: u32 = cur_line();
        let col: u32 = cur_col();
        let op: u32 = cur_val();
        bump();
        let rhs: u32 = parse_bin(level + 1, asl);
        let n: u32 = node(E_BINARY, line, col);
        nset(n, N_A, op);
        nset(n, N_B, lhs);
        nset(n, N_C, rhs);
        lhs = deep(n, max2(depth_of(lhs), depth_of(rhs)));
    }
    return lhs;
}

fn parse_cmp(asl: bool) -> u32 {
    let lhs: u32 = parse_bin(CMP_LEVEL + 1, asl);
    if failed() { return 0; }
    if cur_kind() == TK_PUNCT && is_cmp(cur_val()) {
        let line: u32 = cur_line();
        let col: u32 = cur_col();
        let op: u32 = cur_val();
        bump();
        let rhs: u32 = parse_bin(CMP_LEVEL + 1, asl);
        if failed() { return 0; }
        if cur_kind() == TK_PUNCT && is_cmp(cur_val()) {
            err_msg(cur_line(), cur_col(), "comparison operators cannot be chained");
            return 0;
        }
        let n: u32 = node(E_BINARY, line, col);
        nset(n, N_A, op);
        nset(n, N_B, lhs);
        nset(n, N_C, rhs);
        return deep(n, max2(depth_of(lhs), depth_of(rhs)));
    }
    return lhs;
}

// The `as` level. Unary binds tighter than `as` (S5).
fn parse_unary(asl: bool) -> u32 {
    let mut e: u32 = parse_prefix(asl);
    for !failed() && at_kw(K_AS) {
        let line: u32 = cur_line();
        let col: u32 = cur_col();
        bump();
        let t: u32 = parse_ty();
        let n: u32 = node(E_CAST, line, col);
        nset(n, N_A, e);
        nset(n, N_B, t);
        e = deep(n, depth_of(e));
    }
    return e;
}

fn parse_prefix(asl: bool) -> u32 {
    if failed() { return 0; }
    if ld(G_EDEPTH) >= MAX_DEPTH {
        e_deep_expr(cur_line(), cur_col());
        return 0;
    }
    st(G_EDEPTH, ld(G_EDEPTH) + 1);
    let e: u32 = parse_prefix_inner(asl);
    st(G_EDEPTH, ld(G_EDEPTH) - 1);
    return e;
}

fn parse_prefix_inner(asl: bool) -> u32 {
    let line: u32 = cur_line();
    let col: u32 = cur_col();
    if at_p(P_SUB) {
        bump();
        let k: u32 = parse_prefix(asl);
        let n: u32 = node(E_UNARY, line, col);
        nset(n, N_A, P_SUB);
        nset(n, N_B, k);
        return deep(n, depth_of(k));
    }
    if at_p(P_NOT) {
        bump();
        let k: u32 = parse_prefix(asl);
        let n: u32 = node(E_UNARY, line, col);
        nset(n, N_A, P_NOT);
        nset(n, N_B, k);
        return deep(n, depth_of(k));
    }
    if at_p(P_AND) {
        bump();
        let n: u32 = node(E_BORROW, line, col);
        if eat_kw(K_MUT) { nset(n, N_A, 1); }
        let k: u32 = parse_prefix(asl);
        nset(n, N_B, k);
        return deep(n, depth_of(k));
    }
    return parse_postfix(asl);
}

fn parse_postfix(asl: bool) -> u32 {
    let mut e: u32 = parse_primary(asl);
    for !failed() {
        let line: u32 = cur_line();
        let col: u32 = cur_col();
        if at_p(P_LPAREN) {
            // inside brackets the struct-literal restriction lifts (S5)
            bump();
            let mut head: u32 = 0;
            let mut tail: u32 = 0;
            for !failed() && !at_p(P_RPAREN) {
                let a: u32 = parse_expr(true);
                if head == 0 { head = a; } else { nset(tail, N_NEXT, a); }
                tail = a;
                if !eat_p(P_COMMA) { break; }
            }
            expect_p(P_RPAREN);
            let n: u32 = node(E_CALL, line, col);
            nset(n, N_A, e);
            nset(n, N_B, head);
            e = deep(n, max2(depth_of(e), depth_list(head)));
        } else if at_p(P_LBRACK) {
            bump();
            let idx: u32 = parse_expr(true);
            expect_p(P_RBRACK);
            let n: u32 = node(E_INDEX, line, col);
            nset(n, N_A, e);
            nset(n, N_B, idx);
            e = deep(n, max2(depth_of(e), depth_of(idx)));
        } else if at_p(P_DOT) {
            bump();
            if eat_p(P_XOR) {
                let n: u32 = node(E_DEREF, line, col);
                nset(n, N_A, e);
                e = deep(n, depth_of(e));
            } else {
                let it: u32 = expect_ident();
                if it == NONE { return e; }
                let n: u32 = node(E_FIELD, line, col);
                nset(n, N_A, e);
                nset(n, N_B, tk(it, T_START));
                nset(n, N_C, tk(it, T_LEN));
                e = deep(n, depth_of(e));
            }
        } else {
            return e;
        }
    }
    return e;
}

fn parse_primary(asl: bool) -> u32 {
    if failed() { return 0; }
    let line: u32 = cur_line();
    let col: u32 = cur_col();
    let k: u32 = cur_kind();
    if k == TK_INT {
        let n: u32 = node(E_INT, line, col);
        nset(n, N_A, cur_val());
        bump();
        return n;
    }
    if k == TK_CHAR {
        let n: u32 = node(E_CHAR, line, col);
        nset(n, N_A, cur_val());
        bump();
        return n;
    }
    if k == TK_STR {
        let n: u32 = node(E_STR, line, col);
        nset(n, N_A, cur_val());
        nset(n, N_B, tk(ti(), T_AUX));
        bump();
        return n;
    }
    if at_kw(K_TRUE) {
        let n: u32 = node(E_BOOL, line, col);
        nset(n, N_A, 1);
        bump();
        return n;
    }
    if at_kw(K_FALSE) {
        let n: u32 = node(E_BOOL, line, col);
        nset(n, N_A, 0);
        bump();
        return n;
    }
    if at_p(P_LPAREN) {
        bump();
        let e: u32 = parse_expr(true);
        expect_p(P_RPAREN);
        return e;
    }
    if k == TK_IDENT {
        let s: u32 = tk(ti(), T_START);
        let l: u32 = tk(ti(), T_LEN);
        bump();
        if asl && at_p(P_LBRACE) { return parse_struct_lit(line, col, s, l); }
        let n: u32 = node(E_IDENT, line, col);
        nset(n, N_A, s);
        nset(n, N_B, l);
        return n;
    }
    e_expected_str("expected expression");
    return 0;
}

fn parse_struct_lit(line: u32, col: u32, s: u32, l: u32) -> u32 {
    expect_p(P_LBRACE);
    let mut head: u32 = 0;
    let mut tail: u32 = 0;
    for !failed() && !at_p(P_RBRACE) {
        let fline: u32 = cur_line();
        let fcol: u32 = cur_col();
        let it: u32 = expect_ident();
        if it == NONE { break; }
        expect_p(P_COLON);
        let v: u32 = parse_expr(true);
        let f: u32 = node(E_LITFIELD, fline, fcol);
        nset(f, N_A, tk(it, T_START));
        nset(f, N_B, tk(it, T_LEN));
        nset(f, N_C, v);
        nset(f, N_DEPTH, depth_of(v));
        if head == 0 { head = f; } else { nset(tail, N_NEXT, f); }
        tail = f;
        if !eat_p(P_COMMA) { break; }
    }
    expect_p(P_RBRACE);
    let n: u32 = node(E_STRUCTLIT, line, col);
    nset(n, N_A, s);
    nset(n, N_B, l);
    nset(n, N_C, head);
    return deep(n, depth_list(head));
}

// --- statements (SPEC.md S6) -----------------------------------------------

fn parse_block() -> u32 {
    if failed() { return 0; }
    if ld(G_BDEPTH) >= MAX_DEPTH {
        err_msg(cur_line(), cur_col(), "block nests too deeply");
        return 0;
    }
    st(G_BDEPTH, ld(G_BDEPTH) + 1);
    expect_p(P_LBRACE);
    let mut head: u32 = 0;
    let mut tail: u32 = 0;
    for !failed() && !at_p(P_RBRACE) {
        if cur_kind() == TK_EOF {
            e_expected_p(P_RBRACE);
            return 0;
        }
        let s: u32 = parse_stmt();
        if failed() { return 0; }
        if head == 0 { head = s; } else { nset(tail, N_NEXT, s); }
        tail = s;
    }
    expect_p(P_RBRACE);
    st(G_BDEPTH, ld(G_BDEPTH) - 1);
    return head;
}

fn is_assign_op(p: u32) -> bool {
    return p == P_EQ || p == P_ADDEQ || p == P_SUBEQ || p == P_MULEQ || p == P_DIVEQ
        || p == P_MODEQ || p == P_ANDEQ || p == P_OREQ || p == P_XOREQ
        || p == P_SHLEQ || p == P_SHREQ;
}

fn parse_stmt() -> u32 {
    if failed() { return 0; }
    let line: u32 = cur_line();
    let col: u32 = cur_col();
    if at_kw(K_LET) {
        let s: u32 = parse_let();
        expect_p(P_SEMI);
        return s;
    }
    if at_kw(K_IF) { return parse_if(); }
    if at_kw(K_FOR) { return parse_for(); }
    if at_kw(K_MATCH) { return parse_match(); }
    if at_kw(K_UNSAFE) {
        bump();
        let n: u32 = node(S_UNSAFE, line, col);
        nset(n, N_A, parse_block());
        return n;
    }
    if eat_kw(K_BREAK) {
        expect_p(P_SEMI);
        return node(S_BREAK, line, col);
    }
    if eat_kw(K_CONTINUE) {
        expect_p(P_SEMI);
        return node(S_CONTINUE, line, col);
    }
    if eat_kw(K_RETURN) {
        let n: u32 = node(S_RETURN, line, col);
        if eat_p(P_SEMI) { return n; }
        nset(n, N_A, parse_expr(false));
        expect_p(P_SEMI);
        return n;
    }
    let s: u32 = parse_simple_stmt();
    expect_p(P_SEMI);
    return s;
}

// Assignment or a call statement. The caller eats the `;` -- the for header
// needs the same production without one.
fn parse_simple_stmt() -> u32 {
    if failed() { return 0; }
    let line: u32 = cur_line();
    let col: u32 = cur_col();
    let e: u32 = parse_expr(false);
    if failed() { return 0; }
    if cur_kind() == TK_PUNCT && is_assign_op(cur_val()) {
        let op: u32 = cur_val();
        bump();
        let v: u32 = parse_expr(true);
        let n: u32 = node(S_ASSIGN, line, col);
        nset(n, N_A, e);
        nset(n, N_B, op);
        nset(n, N_C, v);
        return n;
    }
    if nd(e, N_KIND) != E_CALL {
        err_msg(line, col, "expression statement must be a call");
        return 0;
    }
    let n: u32 = node(S_EXPR, line, col);
    nset(n, N_A, e);
    return n;
}

fn parse_let() -> u32 {
    let line: u32 = cur_line();
    let col: u32 = cur_col();
    expect_kw(K_LET);
    let n: u32 = node(S_LET, line, col);
    if eat_kw(K_MUT) { nset(n, N_E, 1); }
    let it: u32 = expect_ident();
    if it == NONE { return n; }
    nset(n, N_A, tk(it, T_START));
    nset(n, N_B, tk(it, T_LEN));
    if eat_p(P_COLON) { nset(n, N_C, parse_ty()); }
    expect_p(P_EQ);
    nset(n, N_D, parse_expr(true));
    return n;
}

fn parse_if() -> u32 {
    let line: u32 = cur_line();
    let col: u32 = cur_col();
    expect_kw(K_IF);
    let n: u32 = node(S_IF, line, col);
    nset(n, N_A, parse_expr(false));
    nset(n, N_B, parse_block());
    if eat_kw(K_ELSE) {
        nset(n, N_D, 1);
        if at_kw(K_IF) {
            // an else-if chain is recursion too; it counts as block nesting
            if ld(G_BDEPTH) >= MAX_DEPTH {
                err_msg(cur_line(), cur_col(), "block nests too deeply");
                return n;
            }
            st(G_BDEPTH, ld(G_BDEPTH) + 1);
            nset(n, N_C, parse_if());
            st(G_BDEPTH, ld(G_BDEPTH) - 1);
        } else {
            nset(n, N_C, parse_block());
        }
    }
    return n;
}

fn parse_for() -> u32 {
    let line: u32 = cur_line();
    let col: u32 = cur_col();
    expect_kw(K_FOR);
    let n: u32 = node(S_FOR, line, col);
    if at_p(P_LBRACE) {
        nset(n, N_D, parse_block());
        return n;
    }
    if at_kw(K_LET) {
        nset(n, N_A, parse_let());
        expect_p(P_SEMI);
        nset(n, N_B, parse_expr(false));
        expect_p(P_SEMI);
        nset(n, N_C, parse_simple_stmt());
        nset(n, N_D, parse_block());
        return n;
    }
    nset(n, N_B, parse_expr(false));
    nset(n, N_D, parse_block());
    return n;
}

fn parse_match() -> u32 {
    let line: u32 = cur_line();
    let col: u32 = cur_col();
    expect_kw(K_MATCH);
    let n: u32 = node(S_MATCH, line, col);
    nset(n, N_A, parse_expr(false));
    expect_p(P_LBRACE);
    let mut head: u32 = 0;
    let mut tail: u32 = 0;
    for !failed() && !at_p(P_RBRACE) {
        let aline: u32 = cur_line();
        let acol: u32 = cur_col();
        let arm: u32 = node(S_ARM, aline, acol);
        if cur_kind() == TK_IDENT && src_eq(tk(ti(), T_START), tk(ti(), T_LEN), "_") {
            bump();
            nset(arm, N_E, 1);
        } else {
            let it: u32 = expect_ident();
            if it == NONE { break; }
            nset(arm, N_A, tk(it, T_START));
            nset(arm, N_B, tk(it, T_LEN));
            if eat_p(P_LPAREN) {
                let mut bh: u32 = 0;
                let mut bt: u32 = 0;
                for !failed() && !at_p(P_RPAREN) {
                    let bline: u32 = cur_line();
                    let bcol: u32 = cur_col();
                    let bi: u32 = expect_ident();
                    if bi == NONE { break; }
                    let b: u32 = node(S_BIND, bline, bcol);
                    nset(b, N_A, tk(bi, T_START));
                    nset(b, N_B, tk(bi, T_LEN));
                    if bh == 0 { bh = b; } else { nset(bt, N_NEXT, b); }
                    bt = b;
                    if !eat_p(P_COMMA) { break; }
                }
                expect_p(P_RPAREN);
                nset(arm, N_C, bh);
            }
        }
        expect_p(P_FATARROW);
        nset(arm, N_D, parse_block());
        if head == 0 { head = arm; } else { nset(tail, N_NEXT, arm); }
        tail = arm;
    }
    expect_p(P_RBRACE);
    nset(n, N_B, head);
    return n;
}

// --- declarations (SPEC.md S4) ---------------------------------------------

fn parse_fn() -> u32 {
    let line: u32 = cur_line();
    let col: u32 = cur_col();
    expect_kw(K_FN);
    let n: u32 = node(D_FN, line, col);
    let it: u32 = expect_ident();
    if it == NONE { return n; }
    nset(n, N_A, tk(it, T_START));
    nset(n, N_B, tk(it, T_LEN));
    expect_p(P_LPAREN);
    let mut head: u32 = 0;
    let mut tail: u32 = 0;
    for !failed() && !at_p(P_RPAREN) {
        let pline: u32 = cur_line();
        let pcol: u32 = cur_col();
        let pi: u32 = expect_ident();
        if pi == NONE { break; }
        expect_p(P_COLON);
        let p: u32 = node(D_PARAM, pline, pcol);
        nset(p, N_A, tk(pi, T_START));
        nset(p, N_B, tk(pi, T_LEN));
        nset(p, N_C, parse_ty());
        if head == 0 { head = p; } else { nset(tail, N_NEXT, p); }
        tail = p;
        if !eat_p(P_COMMA) { break; }
    }
    expect_p(P_RPAREN);
    nset(n, N_C, head);
    if eat_p(P_ARROW) { nset(n, N_D, parse_ty()); }
    nset(n, N_E, parse_block());
    return n;
}

fn parse_struct() -> u32 {
    let line: u32 = cur_line();
    let col: u32 = cur_col();
    expect_kw(K_STRUCT);
    let n: u32 = node(D_STRUCT, line, col);
    let it: u32 = expect_ident();
    if it == NONE { return n; }
    nset(n, N_A, tk(it, T_START));
    nset(n, N_B, tk(it, T_LEN));
    expect_p(P_LBRACE);
    let mut head: u32 = 0;
    let mut tail: u32 = 0;
    for !failed() && !at_p(P_RBRACE) {
        let fline: u32 = cur_line();
        let fcol: u32 = cur_col();
        let fi: u32 = expect_ident();
        if fi == NONE { break; }
        expect_p(P_COLON);
        let f: u32 = node(D_FIELD, fline, fcol);
        nset(f, N_A, tk(fi, T_START));
        nset(f, N_B, tk(fi, T_LEN));
        nset(f, N_C, parse_ty());
        if head == 0 { head = f; } else { nset(tail, N_NEXT, f); }
        tail = f;
        if !eat_p(P_COMMA) { break; }
    }
    expect_p(P_RBRACE);
    nset(n, N_C, head);
    return n;
}

fn parse_enum() -> u32 {
    let line: u32 = cur_line();
    let col: u32 = cur_col();
    expect_kw(K_ENUM);
    let n: u32 = node(D_ENUM, line, col);
    let it: u32 = expect_ident();
    if it == NONE { return n; }
    nset(n, N_A, tk(it, T_START));
    nset(n, N_B, tk(it, T_LEN));
    expect_p(P_LBRACE);
    let mut head: u32 = 0;
    let mut tail: u32 = 0;
    for !failed() && !at_p(P_RBRACE) {
        let vline: u32 = cur_line();
        let vcol: u32 = cur_col();
        let vi: u32 = expect_ident();
        if vi == NONE { break; }
        let v: u32 = node(D_VARIANT, vline, vcol);
        nset(v, N_A, tk(vi, T_START));
        nset(v, N_B, tk(vi, T_LEN));
        if eat_p(P_LPAREN) {
            let mut ph: u32 = 0;
            let mut pt: u32 = 0;
            for !failed() && !at_p(P_RPAREN) {
                let t: u32 = parse_ty();
                if t == 0 { break; }
                if ph == 0 { ph = t; } else { nset(pt, N_NEXT, t); }
                pt = t;
                if !eat_p(P_COMMA) { break; }
            }
            expect_p(P_RPAREN);
            nset(v, N_C, ph);
        }
        if head == 0 { head = v; } else { nset(tail, N_NEXT, v); }
        tail = v;
        if !eat_p(P_COMMA) { break; }
    }
    expect_p(P_RBRACE);
    nset(n, N_C, head);
    return n;
}

fn parse_const() -> u32 {
    let line: u32 = cur_line();
    let col: u32 = cur_col();
    expect_kw(K_CONST);
    let n: u32 = node(D_CONST, line, col);
    let it: u32 = expect_ident();
    if it == NONE { return n; }
    nset(n, N_A, tk(it, T_START));
    nset(n, N_B, tk(it, T_LEN));
    expect_p(P_COLON);
    nset(n, N_C, parse_ty());
    expect_p(P_EQ);
    nset(n, N_D, parse_expr(false));
    expect_p(P_SEMI);
    return n;
}

fn parse_program() {
    st(G_TI, 0);
    st(G_EDEPTH, 0);
    st(G_BDEPTH, 0);
    let mut head: u32 = 0;
    let mut tail: u32 = 0;
    for !failed() && cur_kind() != TK_EOF {
        let mut d: u32 = 0;
        if at_kw(K_FN) {
            d = parse_fn();
        } else if at_kw(K_STRUCT) {
            d = parse_struct();
        } else if at_kw(K_ENUM) {
            d = parse_enum();
        } else if at_kw(K_CONST) {
            d = parse_const();
        } else {
            e_expected_str("expected `fn`, `struct`, `enum` or `const`");
            return;
        }
        if failed() { return; }
        if head == 0 { head = d; } else { nset(tail, N_NEXT, d); }
        tail = d;
    }
    st(G_DECLS, head);
}

// --- types, interned (SPEC.md S3) ------------------------------------------
//
// Structural types are hash-consed so that equality is address equality.

const TYK_I32: u32 = 0;
const TYK_U32: u32 = 1;
const TYK_BOOL: u32 = 2;
const TYK_U8: u32 = 3;
const TYK_VOID: u32 = 4;
const TYK_INTLIT: u32 = 5;   // an integer literal that has not settled yet
const TYK_SLICE: u32 = 6;    // ARG element, FLAG mut
const TYK_REF: u32 = 7;      // ARG inner, FLAG mut
const TYK_PTR: u32 = 8;      // ARG inner
const TYK_NAMED: u32 = 9;    // ARG name start, FLAG name len

const TY_SIZE: u32 = 16;
const TY_KIND: u32 = 0;
const TY_ARG: u32 = 4;
const TY_FLAG: u32 = 8;
const TY_NEXT: u32 = 12;

// field of a struct, or one payload slot of an enum variant
const FI_SIZE: u32 = 20;
const FI_NS: u32 = 0;
const FI_NL: u32 = 4;
const FI_TY: u32 = 8;
const FI_OFF: u32 = 12;
const FI_NEXT: u32 = 16;

const SI_SIZE: u32 = 24;
const SI_NS: u32 = 0;
const SI_NL: u32 = 4;
const SI_FIELDS: u32 = 8;
const SI_BYTES: u32 = 12;
const SI_ALIGN: u32 = 16;
const SI_NEXT: u32 = 20;

const VI_SIZE: u32 = 24;
const VI_NS: u32 = 0;
const VI_NL: u32 = 4;
const VI_TAG: u32 = 8;
const VI_PAYLOAD: u32 = 12;
const VI_NARGS: u32 = 16;
const VI_NEXT: u32 = 20;

const EI_SIZE: u32 = 28;
const EI_NS: u32 = 0;
const EI_NL: u32 = 4;
const EI_VARIANTS: u32 = 8;
const EI_BYTES: u32 = 12;
const EI_ALIGN: u32 = 16;
const EI_NVAR: u32 = 20;
const EI_NEXT: u32 = 24;

const CI_SIZE: u32 = 28;
const CI_NS: u32 = 0;
const CI_NL: u32 = 4;
const CI_TY: u32 = 8;
const CI_VALUE: u32 = 12;
const CI_STATE: u32 = 16;    // 0 pending, 1 busy, 2 done
const CI_DECL: u32 = 20;
const CI_NEXT: u32 = 24;

const PI_SIZE: u32 = 16;
const PI_NS: u32 = 0;
const PI_NL: u32 = 4;
const PI_TY: u32 = 8;
const PI_NEXT: u32 = 12;

const FN_SIZE: u32 = 52;
const FN_NS: u32 = 0;
const FN_NL: u32 = 4;
const FN_PARAMS: u32 = 8;
const FN_NPARAMS: u32 = 12;
const FN_RET: u32 = 16;
const FN_INDEX: u32 = 20;
const FN_DECL: u32 = 24;
const FN_LOCALS: u32 = 28;
const FN_LTAIL: u32 = 32;
const FN_FRAME: u32 = 36;
const FN_NPSLOT: u32 = 40;
const FN_NLSLOT: u32 = 44;
const FN_NEXT: u32 = 48;

const LOC_SIZE: u32 = 36;
const LOC_NS: u32 = 0;
const LOC_NL: u32 = 4;
const LOC_TY: u32 = 8;
const LOC_MUT: u32 = 12;
const LOC_PARAM: u32 = 16;
const LOC_ADDR: u32 = 20;    // address-taken (S11)
const LOC_SLOT: u32 = 24;
const LOC_FOFF: u32 = 28;
const LOC_NEXT: u32 = 32;

const STR_SIZE: u32 = 20;
const STR_PTR: u32 = 0;
const STR_LEN: u32 = 4;
const STR_ADDR: u32 = 8;
const STR_NEXT: u32 = 12;

const TN_SIZE: u32 = 12;     // a claimed top-level name
const TN_NS: u32 = 0;
const TN_NL: u32 = 4;
const TN_NEXT: u32 = 8;

const RODATA: u32 = 0x0100_0000;

const G_TYPES: u32 = 0x0044;
const G_TY_I32: u32 = 0x0048;
const G_TY_U32: u32 = 0x004C;
const G_TY_BOOL: u32 = 0x0050;
const G_TY_U8: u32 = 0x0054;
const G_TY_VOID: u32 = 0x0058;
const G_TY_INTLIT: u32 = 0x005C;
const G_STRUCTS: u32 = 0x0060;
const G_STRUCTS_T: u32 = 0x0064;
const G_ENUMS: u32 = 0x0068;
const G_ENUMS_T: u32 = 0x006C;
const G_CONSTS: u32 = 0x0070;
const G_CONSTS_T: u32 = 0x0074;
const G_FNS: u32 = 0x0078;
const G_FNS_T: u32 = 0x007C;
const G_NFNS: u32 = 0x0080;
const G_TAKEN: u32 = 0x0084;
const G_TAKEN_T: u32 = 0x0088;
const G_STRINGS: u32 = 0x008C;
const G_STRINGS_T: u32 = 0x0090;
const G_RODATA: u32 = 0x0094;
const G_SCOPE: u32 = 0x0098;
const G_SCOPE_N: u32 = 0x009C;
const G_MARKS: u32 = 0x00A0;
const G_MARKS_N: u32 = 0x00A4;
const G_CURFN: u32 = 0x00A8;
const G_LOOPD: u32 = 0x00AC;
const G_UNSAFED: u32 = 0x00B0;
const G_CETY: u32 = 0x00B4;    // const_expr's second result
const G_TYNAMES: u32 = 0x00B8;
const G_TYNAMES_T: u32 = 0x00BC;

fn ty_kind(t: u32) -> u32 { return ld(t + TY_KIND); }

fn ty_arg(t: u32) -> u32 { return ld(t + TY_ARG); }

fn ty_flag(t: u32) -> u32 { return ld(t + TY_FLAG); }

fn ty_new(kind: u32, arg: u32, flag: u32) -> u32 {
    let n: u32 = alloc(TY_SIZE);
    st(n + TY_KIND, kind);
    st(n + TY_ARG, arg);
    st(n + TY_FLAG, flag);
    st(n + TY_NEXT, ld(G_TYPES));
    st(G_TYPES, n);
    return n;
}

fn ty_intern(kind: u32, arg: u32, flag: u32) -> u32 {
    let mut p: u32 = ld(G_TYPES);
    for p != 0 {
        if ld(p + TY_KIND) == kind && ld(p + TY_ARG) == arg && ld(p + TY_FLAG) == flag {
            return p;
        }
        p = ld(p + TY_NEXT);
    }
    return ty_new(kind, arg, flag);
}

// two source slices, same bytes
fn src_eq2(s1: u32, l1: u32, s2: u32, l2: u32) -> bool {
    if l1 != l2 { return false; }
    for let mut i: u32 = 0; i < l1; i += 1 {
        if at(s1 + i) != at(s2 + i) { return false; }
    }
    return true;
}

// Named types compare by text, not by where the name was written.
fn ty_named(start: u32, len: u32) -> u32 {
    let mut p: u32 = ld(G_TYPES);
    for p != 0 {
        if ld(p + TY_KIND) == TYK_NAMED
            && src_eq2(ld(p + TY_ARG), ld(p + TY_FLAG), start, len) {
            return p;
        }
        p = ld(p + TY_NEXT);
    }
    return ty_new(TYK_NAMED, start, len);
}

fn ty_i32() -> u32 { return ld(G_TY_I32); }

fn ty_u32() -> u32 { return ld(G_TY_U32); }

fn ty_bool() -> u32 { return ld(G_TY_BOOL); }

fn ty_u8() -> u32 { return ld(G_TY_U8); }

fn ty_void() -> u32 { return ld(G_TY_VOID); }

fn ty_intlit() -> u32 { return ld(G_TY_INTLIT); }

fn is_int_ty(t: u32) -> bool {
    let k: u32 = ty_kind(t);
    return k == TYK_I32 || k == TYK_U32 || k == TYK_INTLIT;
}

fn is_aggregate(t: u32) -> bool { return ty_kind(t) == TYK_NAMED; }

// The type a place yields when read: u8 reads as u32 (S3).
fn read_ty(t: u32) -> u32 {
    if ty_kind(t) == TYK_U8 { return ty_u32(); }
    return t;
}

fn slot_count(t: u32) -> u32 {
    if ty_kind(t) == TYK_SLICE { return 2; }
    return 1;
}

// ty_str() in cool0.py
fn put_ty(t: u32) {
    let k: u32 = ty_kind(t);
    if k == TYK_I32 { put_str("i32"); return; }
    if k == TYK_U32 { put_str("u32"); return; }
    if k == TYK_BOOL { put_str("bool"); return; }
    if k == TYK_U8 { put_str("u8"); return; }
    if k == TYK_VOID { put_str("void"); return; }
    if k == TYK_INTLIT { put_str("integer literal"); return; }
    if k == TYK_SLICE {
        if ty_flag(t) != 0 { put_str("[]mut "); } else { put_str("[]"); }
        put_ty(ty_arg(t));
        return;
    }
    if k == TYK_REF {
        if ty_flag(t) != 0 { put_str("&mut "); } else { put_str("&"); }
        put_ty(ty_arg(t));
        return;
    }
    if k == TYK_PTR {
        put_str("*");
        put_ty(ty_arg(t));
        return;
    }
    put_src(ty_arg(t), ty_flag(t));
}

fn put_q_ty(t: u32) { put_ch(96); put_ty(t); put_ch(96); }

fn put_q_src(s: u32, l: u32) { put_ch(96); put_src(s, l); put_ch(96); }

// --- tables ----------------------------------------------------------------

fn find_struct(s: u32, l: u32) -> u32 {
    let mut p: u32 = ld(G_STRUCTS);
    for p != 0 {
        if src_eq2(ld(p + SI_NS), ld(p + SI_NL), s, l) { return p; }
        p = ld(p + SI_NEXT);
    }
    return 0;
}

fn find_enum(s: u32, l: u32) -> u32 {
    let mut p: u32 = ld(G_ENUMS);
    for p != 0 {
        if src_eq2(ld(p + EI_NS), ld(p + EI_NL), s, l) { return p; }
        p = ld(p + EI_NEXT);
    }
    return 0;
}

fn find_const(s: u32, l: u32) -> u32 {
    let mut p: u32 = ld(G_CONSTS);
    for p != 0 {
        if src_eq2(ld(p + CI_NS), ld(p + CI_NL), s, l) { return p; }
        p = ld(p + CI_NEXT);
    }
    return 0;
}

fn find_fn(s: u32, l: u32) -> u32 {
    let mut p: u32 = ld(G_FNS);
    for p != 0 {
        if src_eq2(ld(p + FN_NS), ld(p + FN_NL), s, l) { return p; }
        p = ld(p + FN_NEXT);
    }
    return 0;
}

fn find_type_name(s: u32, l: u32) -> bool {
    let mut p: u32 = ld(G_TYNAMES);
    for p != 0 {
        if src_eq2(ld(p + TN_NS), ld(p + TN_NL), s, l) { return true; }
        p = ld(p + TN_NEXT);
    }
    return false;
}

fn find_taken(s: u32, l: u32) -> bool {
    let mut p: u32 = ld(G_TAKEN);
    for p != 0 {
        if src_eq2(ld(p + TN_NS), ld(p + TN_NL), s, l) { return true; }
        p = ld(p + TN_NEXT);
    }
    return false;
}

fn list_append(head_g: u32, tail_g: u32, item: u32, next_off: u32) {
    if ld(head_g) == 0 { st(head_g, item); } else { st(ld(tail_g) + next_off, item); }
    st(tail_g, item);
}

// The aggregate info behind a named type
fn agg_struct(t: u32) -> u32 { return find_struct(ty_arg(t), ty_flag(t)); }

fn agg_enum(t: u32) -> u32 { return find_enum(ty_arg(t), ty_flag(t)); }

fn size_of(t: u32) -> u32 {
    let k: u32 = ty_kind(t);
    if k == TYK_BOOL || k == TYK_U8 { return 1; }
    if k == TYK_SLICE { return 8; }
    if k == TYK_NAMED {
        let s: u32 = agg_struct(t);
        if s != 0 { return ld(s + SI_BYTES); }
        let e: u32 = agg_enum(t);
        if e != 0 { return ld(e + EI_BYTES); }
        return 0;
    }
    return 4;
}

fn align_of(t: u32) -> u32 {
    let k: u32 = ty_kind(t);
    if k == TYK_BOOL || k == TYK_U8 { return 1; }
    if k == TYK_NAMED {
        let s: u32 = agg_struct(t);
        if s != 0 { return ld(s + SI_ALIGN); }
        let e: u32 = agg_enum(t);
        if e != 0 { return ld(e + EI_ALIGN); }
        return 1;
    }
    return 4;
}

fn align_up(x: u32, a: u32) -> u32 { return (x + a - 1) / a * a; }

// --- resolving type syntax to types ----------------------------------------

fn e_unknown_type(line: u32, col: u32, s: u32, l: u32) {
    if err_open(line, col) {
        put_str("unknown type ");
        put_q_src(s, l);
        err_end();
    }
}

fn resolve_ty(t: u32) -> u32 {
    if t == 0 { return ty_void(); }
    let k: u32 = nd(t, N_KIND);
    if k == T_PRIM {
        let w: u32 = nd(t, N_A);
        if w == 0 { return ty_i32(); }
        if w == 1 { return ty_u32(); }
        if w == 2 { return ty_bool(); }
        return ty_u8();
    }
    if k == T_NAMED {
        if find_type_name(nd(t, N_A), nd(t, N_B)) {
            return ty_named(nd(t, N_A), nd(t, N_B));
        }
        e_unknown_type(nd(t, N_LINE), nd(t, N_COL), nd(t, N_A), nd(t, N_B));
        return ty_i32();
    }
    if k == T_SLICE { return ty_intern(TYK_SLICE, resolve_ty(nd(t, N_A)), nd(t, N_B)); }
    if k == T_REF { return ty_intern(TYK_REF, resolve_ty(nd(t, N_A)), nd(t, N_B)); }
    return ty_intern(TYK_PTR, resolve_ty(nd(t, N_A)), 0);
}

// --- string interning (S11) ------------------------------------------------

fn bytes_eq(p1: u32, l1: u32, p2: u32, l2: u32) -> bool {
    if l1 != l2 { return false; }
    for let mut i: u32 = 0; i < l1; i += 1 {
        if ldb(p1 + i) != ldb(p2 + i) { return false; }
    }
    return true;
}

fn intern_string(ptr: u32, len: u32) -> u32 {
    let mut p: u32 = ld(G_STRINGS);
    for p != 0 {
        if bytes_eq(ld(p + STR_PTR), ld(p + STR_LEN), ptr, len) { return ld(p + STR_ADDR); }
        p = ld(p + STR_NEXT);
    }
    let n: u32 = alloc(STR_SIZE);
    st(n + STR_PTR, ptr);
    st(n + STR_LEN, len);
    st(n + STR_ADDR, ld(G_RODATA));
    st(n + STR_NEXT, 0);
    st(G_RODATA, ld(G_RODATA) + len);
    list_append(G_STRINGS, G_STRINGS_T, n, STR_NEXT);
    return ld(n + STR_ADDR);
}

// --- declaration collection (SPEC.md S4) -----------------------------------

fn e_dup_toplevel(line: u32, col: u32, s: u32, l: u32) {
    if err_open(line, col) {
        put_str("duplicate top-level name ");
        put_q_src(s, l);
        err_end();
    }
}

fn e_builtin_name(line: u32, col: u32, s: u32, l: u32) {
    if err_open(line, col) {
        put_q_src(s, l);
        put_str(" is a built-in type name");
        err_end();
    }
}

fn claim(d: u32) {
    let s: u32 = nd(d, N_A);
    let l: u32 = nd(d, N_B);
    if find_taken(s, l) {
        e_dup_toplevel(nd(d, N_LINE), nd(d, N_COL), s, l);
        return;
    }
    if src_eq(s, l, "i32") || src_eq(s, l, "u32") || src_eq(s, l, "bool")
        || src_eq(s, l, "u8") {
        e_builtin_name(nd(d, N_LINE), nd(d, N_COL), s, l);
        return;
    }
    let n: u32 = alloc(TN_SIZE);
    st(n + TN_NS, s);
    st(n + TN_NL, l);
    st(n + TN_NEXT, 0);
    list_append(G_TAKEN, G_TAKEN_T, n, TN_NEXT);
}

fn add_type_name(d: u32) {
    let n: u32 = alloc(TN_SIZE);
    st(n + TN_NS, nd(d, N_A));
    st(n + TN_NL, nd(d, N_B));
    st(n + TN_NEXT, 0);
    list_append(G_TYNAMES, G_TYNAMES_T, n, TN_NEXT);
}

fn e_field_ty(line: u32, col: u32, what: u32, kind: u32, t: u32) {
    if err_open(line, col) {
        if what == 0 { put_str("struct field"); } else { put_str("enum payload"); }
        if kind == 0 { put_str(" cannot have aggregate type "); }
        else { put_str(" cannot have borrow type "); }
        put_q_ty(t);
        err_end();
    }
}

// Fields and payloads hold no aggregates and no borrows (S4).
fn check_field_ty(t: u32, line: u32, col: u32, what: u32) {
    if is_aggregate(t) { e_field_ty(line, col, what, 0, t); return; }
    if ty_kind(t) == TYK_REF { e_field_ty(line, col, what, 1, t); }
}

fn e_dup_field(line: u32, col: u32, s: u32, l: u32) {
    if err_open(line, col) {
        put_str("duplicate field ");
        put_q_src(s, l);
        err_end();
    }
}

fn e_dup_variant(line: u32, col: u32, s: u32, l: u32) {
    if err_open(line, col) {
        put_str("duplicate variant ");
        put_q_src(s, l);
        err_end();
    }
}

fn field_named(head: u32, s: u32, l: u32) -> u32 {
    let mut p: u32 = head;
    for p != 0 {
        if src_eq2(ld(p + FI_NS), ld(p + FI_NL), s, l) { return p; }
        p = ld(p + FI_NEXT);
    }
    return 0;
}

fn declare_struct(d: u32) {
    let si: u32 = alloc(SI_SIZE);
    zero(si, SI_SIZE);
    st(si + SI_NS, nd(d, N_A));
    st(si + SI_NL, nd(d, N_B));
    let mut head: u32 = 0;
    let mut tail: u32 = 0;
    let mut off: u32 = 0;
    let mut align: u32 = 1;
    let mut f: u32 = nd(d, N_C);
    for f != 0 && !failed() {
        if field_named(head, nd(f, N_A), nd(f, N_B)) != 0 {
            e_dup_field(nd(f, N_LINE), nd(f, N_COL), nd(f, N_A), nd(f, N_B));
            return;
        }
        let t: u32 = resolve_ty(nd(f, N_C));
        check_field_ty(t, nd(f, N_LINE), nd(f, N_COL), 0);
        if failed() { return; }
        let a: u32 = align_of(t);
        off = align_up(off, a);
        let fi: u32 = alloc(FI_SIZE);
        st(fi + FI_NS, nd(f, N_A));
        st(fi + FI_NL, nd(f, N_B));
        st(fi + FI_TY, t);
        st(fi + FI_OFF, off);
        st(fi + FI_NEXT, 0);
        if head == 0 { head = fi; } else { st(tail + FI_NEXT, fi); }
        tail = fi;
        off = off + size_of(t);
        if a > align { align = a; }
        f = nd(f, N_NEXT);
    }
    st(si + SI_FIELDS, head);
    st(si + SI_BYTES, align_up(off, align));
    st(si + SI_ALIGN, align);
    st(si + SI_NEXT, 0);
    nset(d, N_AUX, si);
    list_append(G_STRUCTS, G_STRUCTS_T, si, SI_NEXT);
}

fn variant_named(head: u32, s: u32, l: u32) -> u32 {
    let mut p: u32 = head;
    for p != 0 {
        if src_eq2(ld(p + VI_NS), ld(p + VI_NL), s, l) { return p; }
        p = ld(p + VI_NEXT);
    }
    return 0;
}

fn declare_enum(d: u32) {
    let ei: u32 = alloc(EI_SIZE);
    zero(ei, EI_SIZE);
    st(ei + EI_NS, nd(d, N_A));
    st(ei + EI_NL, nd(d, N_B));
    let mut head: u32 = 0;
    let mut tail: u32 = 0;
    let mut slot: u32 = 0;
    let mut tag: u32 = 0;
    let mut v: u32 = nd(d, N_C);
    for v != 0 && !failed() {
        if variant_named(head, nd(v, N_A), nd(v, N_B)) != 0 {
            e_dup_variant(nd(v, N_LINE), nd(v, N_COL), nd(v, N_A), nd(v, N_B));
            return;
        }
        let vi: u32 = alloc(VI_SIZE);
        zero(vi, VI_SIZE);
        st(vi + VI_NS, nd(v, N_A));
        st(vi + VI_NL, nd(v, N_B));
        st(vi + VI_TAG, tag);
        // the payload lays out like a struct, then sits at offset 4 (S4)
        let mut phead: u32 = 0;
        let mut ptail: u32 = 0;
        let mut off: u32 = 0;
        let mut palign: u32 = 1;
        let mut nargs: u32 = 0;
        let mut tn: u32 = nd(v, N_C);
        for tn != 0 && !failed() {
            let t: u32 = resolve_ty(tn);
            check_field_ty(t, nd(tn, N_LINE), nd(tn, N_COL), 1);
            if failed() { return; }
            let a: u32 = align_of(t);
            off = align_up(off, a);
            let fi: u32 = alloc(FI_SIZE);
            st(fi + FI_NS, 0);
            st(fi + FI_NL, 0);
            st(fi + FI_TY, t);
            st(fi + FI_OFF, off + 4);
            st(fi + FI_NEXT, 0);
            if phead == 0 { phead = fi; } else { st(ptail + FI_NEXT, fi); }
            ptail = fi;
            off = off + size_of(t);
            if a > palign { palign = a; }
            nargs += 1;
            tn = nd(tn, N_NEXT);
        }
        let psize: u32 = align_up(off, palign);
        if psize > slot { slot = psize; }
        st(vi + VI_PAYLOAD, phead);
        st(vi + VI_NARGS, nargs);
        st(vi + VI_NEXT, 0);
        if head == 0 { head = vi; } else { st(tail + VI_NEXT, vi); }
        tail = vi;
        tag += 1;
        v = nd(v, N_NEXT);
    }
    st(ei + EI_VARIANTS, head);
    st(ei + EI_BYTES, align_up(4 + slot, 4));
    st(ei + EI_ALIGN, 4);
    st(ei + EI_NVAR, tag);
    st(ei + EI_NEXT, 0);
    nset(d, N_AUX, ei);
    list_append(G_ENUMS, G_ENUMS_T, ei, EI_NEXT);
}

fn e_const_ty(line: u32, col: u32, t: u32) {
    if err_open(line, col) {
        put_str("const must have type i32, u32 or bool, found ");
        put_q_ty(t);
        err_end();
    }
}

fn declare_const(d: u32) {
    let t: u32 = resolve_ty(nd(d, N_C));
    if failed() { return; }
    let k: u32 = ty_kind(t);
    if k != TYK_I32 && k != TYK_U32 && k != TYK_BOOL {
        e_const_ty(nd(d, N_LINE), nd(d, N_COL), t);
        return;
    }
    let ci: u32 = alloc(CI_SIZE);
    st(ci + CI_NS, nd(d, N_A));
    st(ci + CI_NL, nd(d, N_B));
    st(ci + CI_TY, t);
    st(ci + CI_VALUE, 0);
    st(ci + CI_STATE, 0);
    st(ci + CI_DECL, d);
    st(ci + CI_NEXT, 0);
    nset(d, N_AUX, ci);
    list_append(G_CONSTS, G_CONSTS_T, ci, CI_NEXT);
}

fn e_const_cycle(line: u32, col: u32, s: u32, l: u32) {
    if err_open(line, col) {
        put_str("const ");
        put_q_src(s, l);
        put_str(" depends on itself");
        err_end();
    }
}

fn force_const(ci: u32, line: u32, col: u32) -> u32 {
    if ld(ci + CI_STATE) == 2 { return ci; }
    if ld(ci + CI_STATE) == 1 {
        e_const_cycle(line, col, ld(ci + CI_NS), ld(ci + CI_NL));
        return ci;
    }
    st(ci + CI_STATE, 1);
    let d: u32 = ld(ci + CI_DECL);
    st(ci + CI_VALUE, eval_const(nd(d, N_D), ld(ci + CI_TY)));
    st(ci + CI_STATE, 2);
    return ci;
}

// --- constant expressions (SPEC.md S4) -------------------------------------

fn e_expected_ty(line: u32, col: u32, want: u32, got: u32) {
    if err_open(line, col) {
        put_str("expected ");
        put_q_ty(want);
        put_str(", found ");
        put_q_ty(got);
        err_end();
    }
}

fn eval_const(e: u32, want: u32) -> u32 {
    let v: u32 = const_expr(e, want);
    if failed() { return 0; }
    let mut t: u32 = ld(G_CETY);
    if ty_kind(t) == TYK_INTLIT {
        if is_int_ty(want) { t = want; } else { t = ty_i32(); }
    }
    if t != want {
        e_expected_ty(nd(e, N_LINE), nd(e, N_COL), want, t);
        return 0;
    }
    return v;
}

fn e_not_const(line: u32, col: u32, s: u32, l: u32) {
    if err_open(line, col) {
        put_q_src(s, l);
        put_str(" is not a constant");
        err_end();
    }
}

fn e_cast_from(line: u32, col: u32, t: u32) {
    if err_open(line, col) { put_str("cannot cast from "); put_q_ty(t); err_end(); }
}

fn e_cast_to(line: u32, col: u32, t: u32) {
    if err_open(line, col) { put_str("cannot cast to "); put_q_ty(t); err_end(); }
}

fn e_negate(line: u32, col: u32, t: u32) {
    if err_open(line, col) { put_str("cannot negate "); put_q_ty(t); err_end(); }
}

fn e_not_bool(line: u32, col: u32, t: u32) {
    if err_open(line, col) {
        put_str("cannot apply ");
        put_ch(96);
        put_str("!");
        put_ch(96);
        put_str(" to ");
        put_q_ty(t);
        err_end();
    }
}

fn e_op_bool(line: u32, col: u32, op: u32) {
    if err_open(line, col) {
        put_q_punct(op);
        put_str(" requires bool operands");
        err_end();
    }
}

fn e_op_int(line: u32, col: u32, op: u32) {
    if err_open(line, col) {
        put_q_punct(op);
        put_str(" requires integer operands");
        err_end();
    }
}

fn put_q_punct(p: u32) { put_ch(96); put_punct(p); put_ch(96); }

fn e_const_divzero(line: u32, col: u32) {
    err_msg(line, col, "division by zero in constant expression");
}

fn e_op_not_const(line: u32, col: u32, op: u32) {
    if err_open(line, col) {
        put_q_punct(op);
        put_str(" is not allowed in a constant expression");
        err_end();
    }
}

fn e_not_const_expr(line: u32, col: u32) {
    err_msg(line, col, "not a constant expression");
}

fn to_signed_lt(a: u32, b: u32) -> bool { let x: i32 = a as i32; let y: i32 = b as i32; return x < y; }

fn to_signed_gt(a: u32, b: u32) -> bool { let x: i32 = a as i32; let y: i32 = b as i32; return x > y; }

fn sdiv(a: u32, b: u32) -> u32 {
    // wasm traps on INT_MIN / -1; cool0.py computes it in bignum and wraps
    if a == 0x8000_0000 && b == 0xFFFF_FFFF { return 0x8000_0000; }
    let x: i32 = a as i32;
    let y: i32 = b as i32;
    return (x / y) as u32;
}

fn srem(a: u32, b: u32) -> u32 {
    if a == 0x8000_0000 && b == 0xFFFF_FFFF { return 0; }
    let x: i32 = a as i32;
    let y: i32 = b as i32;
    return (x % y) as u32;
}

fn sshr(a: u32, sh: u32) -> u32 { let x: i32 = a as i32; return (x >> sh) as u32; }

// Returns the value; the type comes back in G_CETY.
fn const_expr(e: u32, want: u32) -> u32 {
    if failed() { st(G_CETY, ty_i32()); return 0; }
    let mut iwant: u32 = 0;
    if want != 0 && is_int_ty(want) && ty_kind(want) != TYK_INTLIT { iwant = want; }
    let k: u32 = nd(e, N_KIND);
    let line: u32 = nd(e, N_LINE);
    let col: u32 = nd(e, N_COL);

    if k == E_INT { st(G_CETY, ty_intlit()); return nd(e, N_A); }
    if k == E_CHAR { st(G_CETY, ty_u32()); return nd(e, N_A); }
    if k == E_BOOL { st(G_CETY, ty_bool()); return nd(e, N_A); }
    if k == E_IDENT {
        let ci: u32 = find_const(nd(e, N_A), nd(e, N_B));
        if ci != 0 {
            force_const(ci, line, col);
            st(G_CETY, ld(ci + CI_TY));
            return ld(ci + CI_VALUE);
        }
        e_not_const(line, col, nd(e, N_A), nd(e, N_B));
        st(G_CETY, ty_i32());
        return 0;
    }
    if k == E_CAST {
        let v: u32 = const_expr(nd(e, N_A), 0);
        let t: u32 = ld(G_CETY);
        let dst: u32 = resolve_ty(nd(e, N_B));
        if failed() { st(G_CETY, ty_i32()); return 0; }
        if !is_int_ty(t) && ty_kind(t) != TYK_PTR {
            e_cast_from(line, col, t);
            st(G_CETY, ty_i32());
            return 0;
        }
        let dk: u32 = ty_kind(dst);
        if dk != TYK_I32 && dk != TYK_U32 && dk != TYK_PTR {
            e_cast_to(line, col, dst);
            st(G_CETY, ty_i32());
            return 0;
        }
        st(G_CETY, dst);
        return v;
    }
    if k == E_UNARY {
        let op: u32 = nd(e, N_A);
        let mut sub_want: u32 = ty_bool();
        if op == P_SUB { sub_want = want; }
        let v: u32 = const_expr(nd(e, N_B), sub_want);
        let t: u32 = ld(G_CETY);
        if failed() { st(G_CETY, ty_i32()); return 0; }
        if op == P_SUB {
            if !is_int_ty(t) {
                e_negate(line, col, t);
                st(G_CETY, ty_i32());
                return 0;
            }
            st(G_CETY, t);
            return 0 - v;
        }
        if ty_kind(t) != TYK_BOOL {
            e_not_bool(line, col, t);
            st(G_CETY, ty_i32());
            return 0;
        }
        st(G_CETY, ty_bool());
        return 1 - v;
    }
    if k == E_BINARY {
        let op: u32 = nd(e, N_A);
        let cmp: bool = is_cmp(op) || op == P_ANDAND || op == P_OROR;
        let mut lwant: u32 = want;
        if cmp { lwant = 0; }
        let lv: u32 = const_expr(nd(e, N_B), lwant);
        let lt: u32 = ld(G_CETY);
        let mut rwant: u32 = 0;
        if op == P_SHL || op == P_SHR {
            rwant = ty_u32();
        } else if cmp {
            rwant = 0;
        } else if ty_kind(lt) != TYK_INTLIT {
            rwant = lt;
        } else {
            rwant = want;
        }
        let rv: u32 = const_expr(nd(e, N_C), rwant);
        let rt: u32 = ld(G_CETY);
        if failed() { st(G_CETY, ty_i32()); return 0; }

        if op == P_ANDAND || op == P_OROR {
            if ty_kind(lt) != TYK_BOOL || ty_kind(rt) != TYK_BOOL {
                e_op_bool(line, col, op);
                st(G_CETY, ty_i32());
                return 0;
            }
            st(G_CETY, ty_bool());
            if op == P_ANDAND {
                if lv != 0 && rv != 0 { return 1; }
                return 0;
            }
            if lv != 0 || rv != 0 { return 1; }
            return 0;
        }
        if op == P_SHL || op == P_SHR {
            if !is_int_ty(lt) || !is_int_ty(rt) {
                e_op_int(line, col, op);
                st(G_CETY, ty_i32());
                return 0;
            }
            let mut t: u32 = lt;
            if ty_kind(lt) == TYK_INTLIT {
                if iwant != 0 { t = iwant; } else { t = ty_i32(); }
            }
            let sh: u32 = rv & 31;
            st(G_CETY, t);
            if op == P_SHL { return lv << sh; }
            if ty_kind(t) == TYK_I32 { return sshr(lv, sh); }
            return lv >> sh;
        }
        if !is_int_ty(lt) || !is_int_ty(rt) {
            if (op == P_EQEQ || op == P_NE) && ty_kind(lt) == TYK_BOOL
                && ty_kind(rt) == TYK_BOOL {
                st(G_CETY, ty_bool());
                if op == P_EQEQ {
                    if lv == rv { return 1; }
                    return 0;
                }
                if lv != rv { return 1; }
                return 0;
            }
            e_op_int(line, col, op);
            st(G_CETY, ty_i32());
            return 0;
        }
        let mut t: u32 = lt;
        if ty_kind(lt) == TYK_INTLIT { t = rt; }
        if ty_kind(t) == TYK_INTLIT {
            if !cmp && iwant != 0 { t = iwant; } else { t = ty_i32(); }
        }
        let signed: bool = ty_kind(t) == TYK_I32;
        if is_cmp(op) {
            st(G_CETY, ty_bool());
            if op == P_EQEQ { if lv == rv { return 1; } return 0; }
            if op == P_NE { if lv != rv { return 1; } return 0; }
            if signed {
                if op == P_LT { if to_signed_lt(lv, rv) { return 1; } return 0; }
                if op == P_GT { if to_signed_gt(lv, rv) { return 1; } return 0; }
                if op == P_LE { if !to_signed_gt(lv, rv) { return 1; } return 0; }
                if !to_signed_lt(lv, rv) { return 1; }
                return 0;
            }
            if op == P_LT { if lv < rv { return 1; } return 0; }
            if op == P_GT { if lv > rv { return 1; } return 0; }
            if op == P_LE { if lv <= rv { return 1; } return 0; }
            if lv >= rv { return 1; }
            return 0;
        }
        if (op == P_DIV || op == P_MOD) && rv == 0 {
            e_const_divzero(line, col);
            st(G_CETY, ty_i32());
            return 0;
        }
        st(G_CETY, t);
        if op == P_ADD { return lv + rv; }
        if op == P_SUB { return lv - rv; }
        if op == P_MUL { return lv * rv; }
        if op == P_DIV {
            if signed { return sdiv(lv, rv); }
            return lv / rv;
        }
        if op == P_MOD {
            if signed { return srem(lv, rv); }
            return lv % rv;
        }
        if op == P_AND { return lv & rv; }
        if op == P_OR { return lv | rv; }
        if op == P_XOR { return lv ^ rv; }
        e_op_not_const(line, col, op);
        st(G_CETY, ty_i32());
        return 0;
    }
    e_not_const_expr(line, col);
    st(G_CETY, ty_i32());
    return 0;
}

// --- function declarations (SPEC.md S4) ------------------------------------

fn e_dup_param(line: u32, col: u32, s: u32, l: u32) {
    if err_open(line, col) {
        put_str("duplicate parameter ");
        put_q_src(s, l);
        err_end();
    }
}

fn e_agg_by_value(line: u32, col: u32, t: u32) {
    if err_open(line, col) {
        put_str("cannot pass aggregate ");
        put_q_ty(t);
        put_str(" by value");
        err_end();
    }
}

fn e_u8_storage(line: u32, col: u32) {
    if err_open(line, col) {
        put_ch(96);
        put_str("u8");
        put_ch(96);
        put_str(" is storage-only; use ");
        put_ch(96);
        put_str("u32");
        put_ch(96);
        err_end();
    }
}

fn e_ret_agg(line: u32, col: u32, t: u32) {
    if err_open(line, col) {
        put_str("cannot return aggregate ");
        put_q_ty(t);
        put_str(" by value");
        err_end();
    }
}

fn param_named(head: u32, s: u32, l: u32) -> u32 {
    let mut p: u32 = head;
    for p != 0 {
        if src_eq2(ld(p + PI_NS), ld(p + PI_NL), s, l) { return p; }
        p = ld(p + PI_NEXT);
    }
    return 0;
}

fn declare_fn(d: u32, index: u32) {
    let fi: u32 = alloc(FN_SIZE);
    zero(fi, FN_SIZE);
    st(fi + FN_NS, nd(d, N_A));
    st(fi + FN_NL, nd(d, N_B));
    st(fi + FN_INDEX, index);
    st(fi + FN_DECL, d);
    let mut head: u32 = 0;
    let mut tail: u32 = 0;
    let mut n: u32 = 0;
    let mut p: u32 = nd(d, N_C);
    for p != 0 && !failed() {
        if param_named(head, nd(p, N_A), nd(p, N_B)) != 0 {
            e_dup_param(nd(p, N_LINE), nd(p, N_COL), nd(p, N_A), nd(p, N_B));
            return;
        }
        let t: u32 = resolve_ty(nd(p, N_C));
        if failed() { return; }
        if is_aggregate(t) {
            e_agg_by_value(nd(p, N_LINE), nd(p, N_COL), t);
            return;
        }
        if ty_kind(t) == TYK_U8 {
            e_u8_storage(nd(p, N_LINE), nd(p, N_COL));
            return;
        }
        let pi: u32 = alloc(PI_SIZE);
        st(pi + PI_NS, nd(p, N_A));
        st(pi + PI_NL, nd(p, N_B));
        st(pi + PI_TY, t);
        st(pi + PI_NEXT, 0);
        if head == 0 { head = pi; } else { st(tail + PI_NEXT, pi); }
        tail = pi;
        n += 1;
        p = nd(p, N_NEXT);
    }
    st(fi + FN_PARAMS, head);
    st(fi + FN_NPARAMS, n);
    let rn: u32 = nd(d, N_D);
    let ret: u32 = resolve_ty(rn);
    if failed() { return; }
    if rn != 0 {
        let rl: u32 = nd(rn, N_LINE);
        let rc: u32 = nd(rn, N_COL);
        if is_aggregate(ret) { e_ret_agg(rl, rc, ret); return; }
        if ty_kind(ret) == TYK_SLICE {
            err_msg(rl, rc, "cannot return a slice (wasm 1.0 has a single result)");
            return;
        }
        if ty_kind(ret) == TYK_REF { err_msg(rl, rc, "cannot return a borrow"); return; }
        if ty_kind(ret) == TYK_U8 { e_u8_storage(rl, rc); return; }
    }
    st(fi + FN_RET, ret);
    st(fi + FN_NEXT, 0);
    nset(d, N_AUX, fi);
    list_append(G_FNS, G_FNS_T, fi, FN_NEXT);
}

// --- scopes ----------------------------------------------------------------

fn push_scope() {
    st(ld(G_MARKS) + ld(G_MARKS_N) * 4, ld(G_SCOPE_N));
    st(G_MARKS_N, ld(G_MARKS_N) + 1);
}

fn pop_scope() {
    st(G_MARKS_N, ld(G_MARKS_N) - 1);
    st(G_SCOPE_N, ld(ld(G_MARKS) + ld(G_MARKS_N) * 4));
}

fn scope_at(i: u32) -> u32 { return ld(ld(G_SCOPE) + i * 4); }

fn lookup(s: u32, l: u32) -> u32 {
    let mut i: u32 = ld(G_SCOPE_N);
    for i > 0 {
        i -= 1;
        let loc: u32 = scope_at(i);
        if src_eq2(ld(loc + LOC_NS), ld(loc + LOC_NL), s, l) { return loc; }
    }
    return 0;
}

fn lookup_in_scope(s: u32, l: u32) -> u32 {
    let base: u32 = ld(ld(G_MARKS) + (ld(G_MARKS_N) - 1) * 4);
    let mut i: u32 = ld(G_SCOPE_N);
    for i > base {
        i -= 1;
        let loc: u32 = scope_at(i);
        if src_eq2(ld(loc + LOC_NS), ld(loc + LOC_NL), s, l) { return loc; }
    }
    return 0;
}

fn e_dup_local(line: u32, col: u32, s: u32, l: u32) {
    if err_open(line, col) {
        put_q_src(s, l);
        put_str(" is already declared in this scope");
        err_end();
    }
}

fn e_shadow(line: u32, col: u32, s: u32, l: u32) {
    if err_open(line, col) {
        put_q_src(s, l);
        put_str(" shadows a top-level name");
        err_end();
    }
}

fn declare_local(s: u32, l: u32, t: u32, mutable: u32, is_param: u32,
                 line: u32, col: u32) -> u32 {
    if lookup_in_scope(s, l) != 0 {
        e_dup_local(line, col, s, l);
        return 0;
    }
    if find_taken(s, l) {
        e_shadow(line, col, s, l);
        return 0;
    }
    let loc: u32 = alloc(LOC_SIZE);
    st(loc + LOC_NS, s);
    st(loc + LOC_NL, l);
    st(loc + LOC_TY, t);
    st(loc + LOC_MUT, mutable);
    st(loc + LOC_PARAM, is_param);
    st(loc + LOC_ADDR, 0);
    st(loc + LOC_SLOT, NONE);
    st(loc + LOC_FOFF, NONE);
    st(loc + LOC_NEXT, 0);
    st(ld(G_SCOPE) + ld(G_SCOPE_N) * 4, loc);
    st(G_SCOPE_N, ld(G_SCOPE_N) + 1);
    let fi: u32 = ld(G_CURFN);
    if ld(fi + FN_LOCALS) == 0 {
        st(fi + FN_LOCALS, loc);
    } else {
        st(ld(fi + FN_LTAIL) + LOC_NEXT, loc);
    }
    st(fi + FN_LTAIL, loc);
    return loc;
}

// --- flow analysis (SPEC.md S6) --------------------------------------------

fn has_break(head: u32) -> bool {
    let mut s: u32 = head;
    for s != 0 {
        let k: u32 = nd(s, N_KIND);
        if k == S_BREAK { return true; }
        if k == S_IF {
            if has_break(nd(s, N_B)) { return true; }
            if nd(s, N_D) != 0 && has_break(nd(s, N_C)) { return true; }
        }
        if k == S_MATCH {
            let mut a: u32 = nd(s, N_B);
            for a != 0 {
                if has_break(nd(a, N_D)) { return true; }
                a = nd(a, N_NEXT);
            }
        }
        if k == S_UNSAFE {
            if has_break(nd(s, N_A)) { return true; }
        }
        s = nd(s, N_NEXT);
    }
    return false;
}

fn arms_all_diverge(head: u32) -> bool {
    let mut a: u32 = head;
    for a != 0 {
        if !diverges(nd(a, N_D)) { return false; }
        a = nd(a, N_NEXT);
    }
    return true;
}

fn arm_count(head: u32) -> u32 {
    let mut n: u32 = 0;
    let mut a: u32 = head;
    for a != 0 {
        n += 1;
        a = nd(a, N_NEXT);
    }
    return n;
}

fn diverges(head: u32) -> bool {
    let mut s: u32 = head;
    for s != 0 {
        let k: u32 = nd(s, N_KIND);
        if k == S_RETURN || k == S_BREAK || k == S_CONTINUE { return true; }
        if k == S_IF {
            if nd(s, N_D) != 0 && diverges(nd(s, N_B)) && diverges(nd(s, N_C)) {
                return true;
            }
        }
        if k == S_FOR {
            if nd(s, N_B) == 0 && !has_break(nd(s, N_D)) { return true; }
        }
        if k == S_MATCH {
            let ei: u32 = nd(s, N_C);
            let full: bool = nd(s, N_D) != 0
                || (ei != 0 && arm_count(nd(s, N_B)) == ld(ei + EI_NVAR));
            if full && arms_all_diverge(nd(s, N_B)) { return true; }
        }
        if k == S_UNSAFE {
            if diverges(nd(s, N_A)) { return true; }
        }
        s = nd(s, N_NEXT);
    }
    return false;
}

// --- checking a function body ----------------------------------------------

fn e_missing_return(line: u32, col: u32, s: u32, l: u32) {
    if err_open(line, col) {
        put_str("function ");
        put_q_src(s, l);
        put_str(" must return a value on every path");
        err_end();
    }
}

fn check_fn(fi: u32) {
    let d: u32 = ld(fi + FN_DECL);
    st(G_CURFN, fi);
    st(G_SCOPE_N, 0);
    st(G_MARKS_N, 0);
    st(G_LOOPD, 0);
    st(G_UNSAFED, 0);
    push_scope();
    let mut p: u32 = nd(d, N_C);
    let mut pi: u32 = ld(fi + FN_PARAMS);
    for p != 0 && pi != 0 && !failed() {
        let loc: u32 = declare_local(nd(p, N_A), nd(p, N_B), ld(pi + PI_TY), 0, 1,
                                     nd(p, N_LINE), nd(p, N_COL));
        nset(p, N_AUX, loc);
        p = nd(p, N_NEXT);
        pi = ld(pi + PI_NEXT);
    }
    check_block(nd(d, N_E));
    if failed() { return; }
    if ty_kind(ld(fi + FN_RET)) != TYK_VOID && !diverges(nd(d, N_E)) {
        e_missing_return(nd(d, N_LINE), nd(d, N_COL), nd(d, N_A), nd(d, N_B));
        return;
    }
    pop_scope();
}

fn check_block(head: u32) {
    push_scope();
    let mut s: u32 = head;
    for s != 0 && !failed() {
        check_stmt(s);
        s = nd(s, N_NEXT);
    }
    pop_scope();
}

fn e_immutable_place(line: u32, col: u32) {
    err_msg(line, col, "cannot assign to an immutable place");
}

fn e_op_needs_int(line: u32, col: u32, op: u32, t: u32) {
    if err_open(line, col) {
        put_q_punct(op);
        put_str(" requires an integer, found ");
        put_q_ty(t);
        err_end();
    }
}

fn e_no_value(line: u32, col: u32, t: u32) {
    if err_open(line, col) {
        put_str("expected ");
        put_q_ty(t);
        put_str(", found no value");
        err_end();
    }
}

fn e_u8_local(line: u32, col: u32) {
    if err_open(line, col) {
        put_ch(96);
        put_str("u8");
        put_ch(96);
        put_str(" is storage-only; there are no u8 locals");
        err_end();
    }
}

fn check_local_ty(t: u32, line: u32, col: u32) {
    let k: u32 = ty_kind(t);
    if k == TYK_U8 { e_u8_local(line, col); return; }
    if k == TYK_REF { err_msg(line, col, "a borrow cannot be bound to a local"); return; }
    if k == TYK_VOID {
        if err_open(line, col) {
            put_str("local cannot have type ");
            put_ch(96);
            put_str("void");
            put_ch(96);
            err_end();
        }
    }
}

// the base operator behind a compound assignment
fn assign_base_op(p: u32) -> u32 {
    if p == P_ADDEQ { return P_ADD; }
    if p == P_SUBEQ { return P_SUB; }
    if p == P_MULEQ { return P_MUL; }
    if p == P_DIVEQ { return P_DIV; }
    if p == P_MODEQ { return P_MOD; }
    if p == P_ANDEQ { return P_AND; }
    if p == P_OREQ { return P_OR; }
    if p == P_XOREQ { return P_XOR; }
    if p == P_SHLEQ { return P_SHL; }
    return P_SHR;
}

fn check_stmt(s: u32) {
    if failed() { return; }
    let k: u32 = nd(s, N_KIND);
    let line: u32 = nd(s, N_LINE);
    let col: u32 = nd(s, N_COL);

    if k == S_LET {
        let tn: u32 = nd(s, N_C);
        let mut declared: u32 = 0;
        if tn != 0 {
            declared = resolve_ty(tn);
            if failed() { return; }
            check_local_ty(declared, line, col);
            if failed() { return; }
        }
        let mut t: u32 = check_init(nd(s, N_D), declared);
        if failed() { return; }
        if declared == 0 {
            if ty_kind(t) == TYK_INTLIT {
                t = ty_i32();
                retype(nd(s, N_D), t);
            }
            check_local_ty(t, line, col);
            if failed() { return; }
        } else {
            t = declared;
        }
        nset(s, N_AUX, declare_local(nd(s, N_A), nd(s, N_B), t, nd(s, N_E), 0, line, col));
        return;
    }

    if k == S_ASSIGN {
        let ty: u32 = check_place(nd(s, N_A));
        if failed() { return; }
        if ld(G_PLACE_MUT) == 0 { e_immutable_place(line, col); return; }
        let want: u32 = read_ty(ty);
        let op: u32 = nd(s, N_B);
        if op == P_EQ {
            check_init(nd(s, N_C), want);
            return;
        }
        let base: u32 = assign_base_op(op);
        if base == P_SHL || base == P_SHR {
            if !is_int_ty(want) { e_op_needs_int(line, col, base, want); return; }
            coerce(nd(s, N_C), ty_u32());
            return;
        }
        coerce(nd(s, N_C), want);
        if failed() { return; }
        check_binop_types(line, col, base, want, want);
        return;
    }

    if k == S_EXPR {
        let t: u32 = check_expr(nd(s, N_A), 0);
        if failed() { return; }
        if ty_kind(t) != TYK_VOID { nset(s, N_AUX, 1); }
        return;
    }

    if k == S_IF {
        coerce(nd(s, N_A), ty_bool());
        if failed() { return; }
        check_block(nd(s, N_B));
        if nd(s, N_D) != 0 { check_block(nd(s, N_C)); }
        return;
    }

    if k == S_FOR {
        push_scope();
        if nd(s, N_A) != 0 { check_stmt(nd(s, N_A)); }
        if nd(s, N_B) != 0 { coerce(nd(s, N_B), ty_bool()); }
        st(G_LOOPD, ld(G_LOOPD) + 1);
        check_block(nd(s, N_D));
        if nd(s, N_C) != 0 { check_stmt(nd(s, N_C)); }
        st(G_LOOPD, ld(G_LOOPD) - 1);
        pop_scope();
        return;
    }

    if k == S_BREAK || k == S_CONTINUE {
        if ld(G_LOOPD) == 0 {
            if err_open(line, col) {
                put_ch(96);
                if k == S_BREAK { put_str("break"); } else { put_str("continue"); }
                put_ch(96);
                put_str(" outside of a loop");
                err_end();
            }
        }
        return;
    }

    if k == S_RETURN {
        let ret: u32 = ld(ld(G_CURFN) + FN_RET);
        if nd(s, N_A) == 0 {
            if ty_kind(ret) != TYK_VOID { e_no_value(line, col, ret); }
            return;
        }
        if ty_kind(ret) == TYK_VOID {
            err_msg(line, col, "function has no return type");
            return;
        }
        coerce(nd(s, N_A), ret);
        return;
    }

    if k == S_MATCH { check_match(s); return; }

    if k == S_UNSAFE {
        st(G_UNSAFED, ld(G_UNSAFED) + 1);
        check_block(nd(s, N_A));
        st(G_UNSAFED, ld(G_UNSAFED) - 1);
        return;
    }
}

// --- match (SPEC.md S6) ----------------------------------------------------

fn e_match_needs_enum(line: u32, col: u32, t: u32) {
    if err_open(line, col) {
        put_ch(96);
        put_str("match");
        put_ch(96);
        put_str(" requires an enum, found ");
        put_q_ty(t);
        err_end();
    }
}

fn e_no_variant(line: u32, col: u32, ens: u32, enl: u32, vs: u32, vl: u32) {
    if err_open(line, col) {
        put_q_src(ens, enl);
        put_str(" has no variant ");
        put_q_src(vs, vl);
        err_end();
    }
}

fn e_dup_arm(line: u32, col: u32, s: u32, l: u32) {
    if err_open(line, col) {
        put_str("duplicate arm for ");
        put_q_src(s, l);
        err_end();
    }
}

fn e_bind_arity(line: u32, col: u32, s: u32, l: u32, want: u32, got: u32) {
    if err_open(line, col) {
        put_str("variant ");
        put_q_src(s, l);
        put_str(" takes ");
        put_num(want);
        put_str(" binding(s), found ");
        put_num(got);
        err_end();
    }
}

fn e_nonexhaustive(line: u32, col: u32, s: u32, l: u32) {
    if err_open(line, col) {
        put_str("non-exhaustive match: missing ");
        put_q_src(s, l);
        err_end();
    }
}

fn find_variant(ei: u32, s: u32, l: u32) -> u32 {
    let mut v: u32 = ld(ei + EI_VARIANTS);
    for v != 0 {
        if src_eq2(ld(v + VI_NS), ld(v + VI_NL), s, l) { return v; }
        v = ld(v + VI_NEXT);
    }
    return 0;
}

fn arm_for_variant(head: u32, s: u32, l: u32) -> u32 {
    let mut a: u32 = head;
    for a != 0 {
        if nd(a, N_E) == 0 && src_eq2(nd(a, N_A), nd(a, N_B), s, l) { return a; }
        a = nd(a, N_NEXT);
    }
    return 0;
}

fn list_len(head: u32) -> u32 {
    let mut n: u32 = 0;
    let mut p: u32 = head;
    for p != 0 {
        n += 1;
        p = nd(p, N_NEXT);
    }
    return n;
}

fn check_match(s: u32) {
    let ty: u32 = check_place(nd(s, N_A));
    if failed() { return; }
    let line: u32 = nd(s, N_LINE);
    let col: u32 = nd(s, N_COL);
    if ty_kind(ty) != TYK_NAMED {
        e_match_needs_enum(line, col, ty);
        return;
    }
    let ei: u32 = agg_enum(ty);
    if ei == 0 {
        e_match_needs_enum(line, col, ty);
        return;
    }
    nset(s, N_C, ei);
    let head: u32 = nd(s, N_B);
    let mut wild: u32 = 0;
    let mut seen: u32 = 0;
    let mut a: u32 = head;
    for a != 0 && !failed() {
        let al: u32 = nd(a, N_LINE);
        let ac: u32 = nd(a, N_COL);
        if nd(a, N_E) != 0 {
            if nd(a, N_NEXT) != 0 {
                if err_open(al, ac) {
                    put_ch(96);
                    put_str("_");
                    put_ch(96);
                    put_str(" must be the last arm");
                    err_end();
                }
                return;
            }
            wild = 1;
            push_scope();
            check_block(nd(a, N_D));
            pop_scope();
            a = nd(a, N_NEXT);
            continue;
        }
        let v: u32 = find_variant(ei, nd(a, N_A), nd(a, N_B));
        if v == 0 {
            e_no_variant(al, ac, ld(ei + EI_NS), ld(ei + EI_NL), nd(a, N_A), nd(a, N_B));
            return;
        }
        if arm_for_variant(head, nd(a, N_A), nd(a, N_B)) != a {
            e_dup_arm(al, ac, nd(a, N_A), nd(a, N_B));
            return;
        }
        nset(a, N_AUX, v);
        let nb: u32 = list_len(nd(a, N_C));
        if nb != ld(v + VI_NARGS) {
            e_bind_arity(al, ac, nd(a, N_A), nd(a, N_B), ld(v + VI_NARGS), nb);
            return;
        }
        push_scope();
        let mut b: u32 = nd(a, N_C);
        let mut f: u32 = ld(v + VI_PAYLOAD);
        for b != 0 && !failed() {
            nset(b, N_AUX, declare_local(nd(b, N_A), nd(b, N_B), read_ty(ld(f + FI_TY)),
                                         0, 0, nd(b, N_LINE), nd(b, N_COL)));
            b = nd(b, N_NEXT);
            f = ld(f + FI_NEXT);
        }
        check_block(nd(a, N_D));
        pop_scope();
        seen += 1;
        a = nd(a, N_NEXT);
    }
    if failed() { return; }
    if wild == 0 && seen != ld(ei + EI_NVAR) {
        let mut v: u32 = ld(ei + EI_VARIANTS);
        for v != 0 {
            if arm_for_variant(head, ld(v + VI_NS), ld(v + VI_NL)) == 0 {
                e_nonexhaustive(line, col, ld(v + VI_NS), ld(v + VI_NL));
                return;
            }
            v = ld(v + VI_NEXT);
        }
    }
    nset(s, N_D, wild);
}

// --- initializers ----------------------------------------------------------

fn is_enum_lit(e: u32) -> bool {
    let mut b: u32 = e;
    if nd(e, N_KIND) == E_CALL { b = nd(e, N_A); }
    if nd(b, N_KIND) != E_FIELD { return false; }
    let base: u32 = nd(b, N_A);
    if nd(base, N_KIND) != E_IDENT { return false; }
    return find_enum(nd(base, N_A), nd(base, N_B)) != 0;
}

fn e_copy_agg(line: u32, col: u32, t: u32) {
    if err_open(line, col) {
        put_str("cannot copy aggregate ");
        put_q_ty(t);
        err_end();
    }
}

fn check_init(e: u32, want: u32) -> u32 {
    if failed() { return ty_i32(); }
    if nd(e, N_KIND) == E_STRUCTLIT { return check_struct_lit(e, want); }
    if is_enum_lit(e) { return check_enum_lit(e, want); }
    if want != 0 && !is_aggregate(want) { return coerce(e, want); }
    let t: u32 = check_expr(e, want);
    if failed() { return ty_i32(); }
    if is_aggregate(t) {
        e_copy_agg(nd(e, N_LINE), nd(e, N_COL), t);
        return ty_i32();
    }
    if want != 0 && t != want {
        e_expected_ty(nd(e, N_LINE), nd(e, N_COL), want, t);
        return ty_i32();
    }
    return t;
}

fn e_unknown_struct(line: u32, col: u32, s: u32, l: u32) {
    if err_open(line, col) {
        put_str("unknown struct ");
        put_q_src(s, l);
        err_end();
    }
}

fn e_field_count(line: u32, col: u32, s: u32, l: u32, n: u32) {
    if err_open(line, col) {
        put_q_src(s, l);
        put_str(" has ");
        put_num(n);
        put_str(" field(s)");
        err_end();
    }
}

fn e_field_order(line: u32, col: u32, ws: u32, wl: u32, gs: u32, gl: u32) {
    if err_open(line, col) {
        put_str("expected field ");
        put_q_src(ws, wl);
        put_str(", found ");
        put_q_src(gs, gl);
        err_end();
    }
}

fn fi_count(head: u32) -> u32 {
    let mut n: u32 = 0;
    let mut p: u32 = head;
    for p != 0 {
        n += 1;
        p = ld(p + FI_NEXT);
    }
    return n;
}

fn check_struct_lit(e: u32, want: u32) -> u32 {
    let line: u32 = nd(e, N_LINE);
    let col: u32 = nd(e, N_COL);
    let si: u32 = find_struct(nd(e, N_A), nd(e, N_B));
    if si == 0 {
        e_unknown_struct(line, col, nd(e, N_A), nd(e, N_B));
        return ty_i32();
    }
    let self_ty: u32 = ty_named(nd(e, N_A), nd(e, N_B));
    if want != 0 && want != self_ty {
        if err_open(line, col) {
            put_str("expected ");
            put_q_ty(want);
            put_str(", found ");
            put_q_src(nd(e, N_A), nd(e, N_B));
            err_end();
        }
        return ty_i32();
    }
    let nf: u32 = fi_count(ld(si + SI_FIELDS));
    if list_len(nd(e, N_C)) != nf {
        e_field_count(line, col, nd(e, N_A), nd(e, N_B), nf);
        return ty_i32();
    }
    let mut lf: u32 = nd(e, N_C);
    let mut f: u32 = ld(si + SI_FIELDS);
    for lf != 0 && !failed() {
        if !src_eq2(nd(lf, N_A), nd(lf, N_B), ld(f + FI_NS), ld(f + FI_NL)) {
            e_field_order(nd(lf, N_LINE), nd(lf, N_COL), ld(f + FI_NS), ld(f + FI_NL),
                          nd(lf, N_A), nd(lf, N_B));
            return ty_i32();
        }
        coerce(nd(lf, N_C), read_ty(ld(f + FI_TY)));
        lf = nd(lf, N_NEXT);
        f = ld(f + FI_NEXT);
    }
    nset(e, N_D, si);
    nset(e, N_TY, self_ty);
    return self_ty;
}

fn e_variant_arity(line: u32, col: u32, s: u32, l: u32, n: u32) {
    if err_open(line, col) {
        put_str("variant ");
        put_q_src(s, l);
        put_str(" takes ");
        put_num(n);
        put_str(" value(s)");
        err_end();
    }
}

fn check_enum_lit(e: u32, want: u32) -> u32 {
    let line: u32 = nd(e, N_LINE);
    let col: u32 = nd(e, N_COL);
    let mut fld: u32 = e;
    let mut args: u32 = 0;
    if nd(e, N_KIND) == E_CALL {
        fld = nd(e, N_A);
        args = nd(e, N_B);
    }
    let base: u32 = nd(fld, N_A);
    let ei: u32 = find_enum(nd(base, N_A), nd(base, N_B));
    let v: u32 = find_variant(ei, nd(fld, N_B), nd(fld, N_C));
    if v == 0 {
        e_no_variant(nd(fld, N_LINE), nd(fld, N_COL), ld(ei + EI_NS), ld(ei + EI_NL),
                     nd(fld, N_B), nd(fld, N_C));
        return ty_i32();
    }
    if list_len(args) != ld(v + VI_NARGS) {
        e_variant_arity(line, col, ld(v + VI_NS), ld(v + VI_NL), ld(v + VI_NARGS));
        return ty_i32();
    }
    let self_ty: u32 = ty_named(ld(ei + EI_NS), ld(ei + EI_NL));
    if want != 0 && want != self_ty {
        if err_open(line, col) {
            put_str("expected ");
            put_q_ty(want);
            put_str(", found ");
            put_q_src(ld(ei + EI_NS), ld(ei + EI_NL));
            err_end();
        }
        return ty_i32();
    }
    let mut a: u32 = args;
    let mut f: u32 = ld(v + VI_PAYLOAD);
    for a != 0 && !failed() {
        coerce(a, read_ty(ld(f + FI_TY)));
        a = nd(a, N_NEXT);
        f = ld(f + FI_NEXT);
    }
    nset(e, N_AUX, v);
    nset(e, N_AUX2, 1);
    nset(e, N_TY, self_ty);
    return self_ty;
}

// --- integer literals that have not settled (S2) ----------------------------

fn retype(e: u32, t: u32) {
    if ty_kind(nd(e, N_TY)) != TYK_INTLIT { return; }
    nset(e, N_TY, t);
    let k: u32 = nd(e, N_KIND);
    if k == E_UNARY { retype(nd(e, N_B), t); return; }
    if k == E_BINARY {
        retype(nd(e, N_B), t);
        let op: u32 = nd(e, N_A);
        if op != P_SHL && op != P_SHR { retype(nd(e, N_C), t); }
    }
}

fn coerce(e: u32, want: u32) -> u32 {
    let got: u32 = check_expr(e, want);
    if failed() { return want; }
    if ty_kind(got) == TYK_INTLIT && is_int_ty(want) && ty_kind(want) != TYK_INTLIT {
        retype(e, want);
        return want;
    }
    if got != want {
        e_expected_ty(nd(e, N_LINE), nd(e, N_COL), want, got);
        return want;
    }
    return want;
}

// --- expressions (SPEC.md S5) ----------------------------------------------

const G_PLACE_MUT: u32 = 0x00C0;
const G_PLACE_ROOT: u32 = 0x00C4;

fn int_want(want: u32) -> u32 {
    if want == 0 { return 0; }
    let k: u32 = ty_kind(want);
    if k == TYK_I32 || k == TYK_U32 { return want; }
    return 0;
}

fn e_unknown_name(line: u32, col: u32, s: u32, l: u32) {
    if err_open(line, col) {
        put_str("unknown name ");
        put_q_src(s, l);
        err_end();
    }
}

fn e_type_mismatch2(line: u32, col: u32, op: u32, lt: u32, rt: u32) {
    if err_open(line, col) {
        put_q_punct(op);
        put_str(": ");
        put_q_ty(lt);
        put_str(" and ");
        put_q_ty(rt);
        put_str(" do not match");
        err_end();
    }
}

fn check_binop_types(line: u32, col: u32, op: u32, lt: u32, rt: u32) {
    if failed() { return; }
    if op == P_SHL || op == P_SHR {
        if !is_int_ty(lt) { e_op_needs_int(line, col, op, lt); return; }
        if ty_kind(rt) != TYK_U32 {
            if err_open(line, col) {
                put_str("shift amount must be ");
                put_ch(96);
                put_str("u32");
                put_ch(96);
                put_str(", found ");
                put_q_ty(rt);
                err_end();
            }
        }
        return;
    }
    if lt != rt { e_type_mismatch2(line, col, op, lt, rt); return; }
    let k: u32 = ty_kind(lt);
    if op == P_EQEQ || op == P_NE {
        if k != TYK_I32 && k != TYK_U32 && k != TYK_BOOL && k != TYK_PTR {
            if err_open(line, col) { put_str("cannot compare "); put_q_ty(lt); err_end(); }
        }
        return;
    }
    if is_cmp(op) {
        if k != TYK_I32 && k != TYK_U32 && k != TYK_PTR {
            if err_open(line, col) { put_str("cannot order "); put_q_ty(lt); err_end(); }
        }
        return;
    }
    if k != TYK_I32 && k != TYK_U32 {
        if err_open(line, col) {
            put_q_punct(op);
            put_str(" requires ");
            put_ch(96);
            put_str("i32");
            put_ch(96);
            put_str(" or ");
            put_ch(96);
            put_str("u32");
            put_ch(96);
            put_str(", found ");
            put_q_ty(lt);
            err_end();
        }
    }
}

fn check_binary(e: u32, want: u32) -> u32 {
    let op: u32 = nd(e, N_A);
    let line: u32 = nd(e, N_LINE);
    let col: u32 = nd(e, N_COL);
    if op == P_ANDAND || op == P_OROR {
        coerce(nd(e, N_B), ty_bool());
        coerce(nd(e, N_C), ty_bool());
        return ty_bool();
    }
    let iw: u32 = int_want(want);
    let cmp: bool = is_cmp(op);

    if op == P_SHL || op == P_SHR {
        let mut lt: u32 = check_expr(nd(e, N_B), iw);
        coerce(nd(e, N_C), ty_u32());
        if failed() { return ty_i32(); }
        if ty_kind(lt) == TYK_INTLIT {
            if iw == 0 {
                nset(e, N_D, ty_intlit());
                return ty_intlit();
            }
            retype(nd(e, N_B), iw);
            lt = iw;
        }
        if !is_int_ty(lt) { e_op_needs_int(line, col, op, lt); return ty_i32(); }
        nset(e, N_D, lt);
        return lt;
    }

    let mut lwant: u32 = iw;
    if cmp { lwant = 0; }
    let mut lt: u32 = check_expr(nd(e, N_B), lwant);
    let mut rwant: u32 = lt;
    if ty_kind(lt) == TYK_INTLIT { rwant = lwant; }
    let mut rt: u32 = check_expr(nd(e, N_C), rwant);
    if failed() { return ty_i32(); }
    let li: bool = ty_kind(lt) == TYK_INTLIT;
    let ri: bool = ty_kind(rt) == TYK_INTLIT;
    if li && !ri {
        retype(nd(e, N_B), rt);
        lt = rt;
    } else if ri && !li {
        retype(nd(e, N_C), lt);
        rt = lt;
    } else if li && ri {
        if !cmp {
            nset(e, N_D, ty_intlit());
            return ty_intlit();
        }
        retype(nd(e, N_B), ty_i32());
        retype(nd(e, N_C), ty_i32());
        lt = ty_i32();
        rt = ty_i32();
    }
    check_binop_types(line, col, op, lt, rt);
    nset(e, N_D, lt);
    if cmp { return ty_bool(); }
    return lt;
}

fn e_arg_count(line: u32, col: u32, s: u32, l: u32, want: u32, got: u32) {
    if err_open(line, col) {
        put_q_src(s, l);
        put_str(" takes ");
        put_num(want);
        put_str(" argument(s), found ");
        put_num(got);
        err_end();
    }
}

fn count_mentions(e: u32, loc: u32) -> u32 {
    if e == 0 { return 0; }
    let k: u32 = nd(e, N_KIND);
    if k == E_IDENT {
        if nd(e, N_AUX2) == 0 && nd(e, N_AUX) == loc && loc != 0 { return 1; }
        return 0;
    }
    if k == E_UNARY || k == E_BORROW { return count_mentions(nd(e, N_B), loc); }
    if k == E_CAST || k == E_FIELD || k == E_DEREF { return count_mentions(nd(e, N_A), loc); }
    if k == E_BINARY {
        return count_mentions(nd(e, N_B), loc) + count_mentions(nd(e, N_C), loc);
    }
    if k == E_INDEX {
        return count_mentions(nd(e, N_A), loc) + count_mentions(nd(e, N_B), loc);
    }
    if k == E_CALL {
        let mut n: u32 = count_mentions(nd(e, N_A), loc);
        let mut a: u32 = nd(e, N_B);
        for a != 0 {
            n += count_mentions(a, loc);
            a = nd(a, N_NEXT);
        }
        return n;
    }
    if k == E_STRUCTLIT {
        let mut n: u32 = 0;
        let mut f: u32 = nd(e, N_C);
        for f != 0 {
            n += count_mentions(nd(f, N_C), loc);
            f = nd(f, N_NEXT);
        }
        return n;
    }
    return 0;
}

fn e_alias(line: u32, col: u32, s: u32, l: u32, twice: u32) {
    if err_open(line, col) {
        put_q_src(s, l);
        if twice == 0 {
            put_str(" is borrowed mutably and also used in the same argument list");
        } else {
            put_str(" is borrowed mutably more than once");
        }
        err_end();
    }
}

// SPEC.md S7 -- one rule.
fn check_aliasing(e: u32) {
    let line: u32 = nd(e, N_LINE);
    let col: u32 = nd(e, N_COL);
    let head: u32 = nd(e, N_B);
    let mut a: u32 = head;
    for a != 0 && !failed() {
        let root: u32 = nd(a, N_D);
        if nd(a, N_KIND) == E_BORROW && nd(a, N_A) != 0 && root != 0 {
            let mut b: u32 = head;
            for b != 0 {
                if b != a && count_mentions(b, root) > 0 {
                    e_alias(line, col, ld(root + LOC_NS), ld(root + LOC_NL), 0);
                    return;
                }
                b = nd(b, N_NEXT);
            }
            if count_mentions(nd(a, N_B), root) > 1 {
                e_alias(line, col, ld(root + LOC_NS), ld(root + LOC_NL), 1);
                return;
            }
        }
        a = nd(a, N_NEXT);
    }
}

fn check_borrow(b: u32, want: u32) {
    let line: u32 = nd(b, N_LINE);
    let col: u32 = nd(b, N_COL);
    let opnd: u32 = nd(b, N_B);
    if nd(opnd, N_KIND) == E_STRUCTLIT {
        err_msg(nd(opnd, N_LINE), nd(opnd, N_COL),
                "struct literal is only allowed as an initializer");
        return;
    }
    if is_enum_lit(opnd) {
        err_msg(nd(opnd, N_LINE), nd(opnd, N_COL),
                "enum literal is only allowed as an initializer");
        return;
    }
    let ty: u32 = check_place(opnd);
    if failed() { return; }
    let mutable: u32 = ld(G_PLACE_MUT);
    let root: u32 = ld(G_PLACE_ROOT);
    let is_mut: u32 = nd(b, N_A);
    if ty_kind(want) != TYK_REF {
        if err_open(line, col) {
            put_str("expected ");
            put_q_ty(want);
            put_str(", found a borrow");
            err_end();
        }
        return;
    }
    if is_mut != 0 && mutable == 0 {
        err_msg(line, col, "cannot borrow an immutable place as `&mut`");
        return;
    }
    let got: u32 = ty_intern(TYK_REF, ty, is_mut);
    if want != got {
        e_expected_ty(line, col, want, got);
        return;
    }
    if root != 0 { st(root + LOC_ADDR, 1); }
    nset(b, N_D, root);
    nset(b, N_TY, got);
}

fn check_call(e: u32) -> u32 {
    let line: u32 = nd(e, N_LINE);
    let col: u32 = nd(e, N_COL);
    let callee: u32 = nd(e, N_A);
    if nd(callee, N_KIND) != E_IDENT {
        err_msg(line, col, "callee must be a function name");
        return ty_i32();
    }
    let fi: u32 = find_fn(nd(callee, N_A), nd(callee, N_B));
    if fi == 0 {
        if err_open(line, col) {
            put_str("unknown function ");
            put_q_src(nd(callee, N_A), nd(callee, N_B));
            err_end();
        }
        return ty_i32();
    }
    let nargs: u32 = list_len(nd(e, N_B));
    if nargs != ld(fi + FN_NPARAMS) {
        e_arg_count(line, col, ld(fi + FN_NS), ld(fi + FN_NL), ld(fi + FN_NPARAMS), nargs);
        return ty_i32();
    }
    let mut a: u32 = nd(e, N_B);
    let mut p: u32 = ld(fi + FN_PARAMS);
    for a != 0 && !failed() {
        if nd(a, N_KIND) == E_BORROW {
            check_borrow(a, ld(p + PI_TY));
        } else {
            coerce(a, ld(p + PI_TY));
        }
        a = nd(a, N_NEXT);
        p = ld(p + PI_NEXT);
    }
    if failed() { return ty_i32(); }
    check_aliasing(e);
    if failed() { return ty_i32(); }
    nset(e, N_D, fi);
    return ld(fi + FN_RET);
}

// --- places ----------------------------------------------------------------

fn root_local(e: u32) -> u32 {
    let mut p: u32 = e;
    for p != 0 {
        let k: u32 = nd(p, N_KIND);
        if k == E_IDENT {
            if nd(p, N_AUX2) != 0 { return 0; }
            return nd(p, N_AUX);
        }
        if k == E_FIELD || k == E_INDEX || k == E_DEREF { p = nd(p, N_A); continue; }
        return 0;
    }
    return 0;
}

fn e_no_field_ty(line: u32, col: u32, t: u32, s: u32, l: u32) {
    if err_open(line, col) {
        put_q_ty(t);
        put_str(" has no field ");
        put_q_src(s, l);
        err_end();
    }
}

fn e_no_field_name(line: u32, col: u32, bs: u32, bl: u32, s: u32, l: u32) {
    if err_open(line, col) {
        put_q_src(bs, bl);
        put_str(" has no field ");
        put_q_src(s, l);
        err_end();
    }
}

// Returns the place type; mutability and root local come back in globals.
fn check_place(e: u32) -> u32 {
    if failed() { return ty_i32(); }
    let k: u32 = nd(e, N_KIND);
    let line: u32 = nd(e, N_LINE);
    let col: u32 = nd(e, N_COL);

    if k == E_IDENT {
        let loc: u32 = lookup(nd(e, N_A), nd(e, N_B));
        if loc == 0 {
            if find_const(nd(e, N_A), nd(e, N_B)) != 0 {
                if err_open(line, col) {
                    put_q_src(nd(e, N_A), nd(e, N_B));
                    put_str(" is a constant, not a place");
                    err_end();
                }
                return ty_i32();
            }
            if find_type_name(nd(e, N_A), nd(e, N_B)) {
                if err_open(line, col) {
                    put_q_src(nd(e, N_A), nd(e, N_B));
                    put_str(" is a type, not a place");
                    err_end();
                }
                return ty_i32();
            }
            e_unknown_name(line, col, nd(e, N_A), nd(e, N_B));
            return ty_i32();
        }
        nset(e, N_AUX, loc);
        nset(e, N_AUX2, 0);
        nset(e, N_TY, read_ty(ld(loc + LOC_TY)));
        st(G_PLACE_MUT, ld(loc + LOC_MUT));
        st(G_PLACE_ROOT, loc);
        return ld(loc + LOC_TY);
    }

    if k == E_FIELD {
        let bt: u32 = check_place(nd(e, N_A));
        if failed() { return ty_i32(); }
        let bmut: u32 = ld(G_PLACE_MUT);
        let broot: u32 = ld(G_PLACE_ROOT);
        if ty_kind(bt) != TYK_NAMED {
            e_no_field_ty(line, col, bt, nd(e, N_B), nd(e, N_C));
            return ty_i32();
        }
        let si: u32 = agg_struct(bt);
        if si == 0 {
            e_no_field_ty(line, col, bt, nd(e, N_B), nd(e, N_C));
            return ty_i32();
        }
        let f: u32 = field_named(ld(si + SI_FIELDS), nd(e, N_B), nd(e, N_C));
        if f == 0 {
            e_no_field_name(line, col, ld(si + SI_NS), ld(si + SI_NL),
                            nd(e, N_B), nd(e, N_C));
            return ty_i32();
        }
        nset(e, N_D, f);
        nset(e, N_TY, read_ty(ld(f + FI_TY)));
        st(G_PLACE_MUT, bmut);
        st(G_PLACE_ROOT, broot);
        return ld(f + FI_TY);
    }

    if k == E_INDEX {
        let bt: u32 = check_expr(nd(e, N_A), 0);
        if failed() { return ty_i32(); }
        if ty_kind(bt) != TYK_SLICE {
            if err_open(line, col) { put_str("cannot index "); put_q_ty(bt); err_end(); }
            return ty_i32();
        }
        coerce(nd(e, N_B), ty_u32());
        if failed() { return ty_i32(); }
        let elem: u32 = ty_arg(bt);
        nset(e, N_D, size_of(elem));
        nset(e, N_TY, read_ty(elem));
        st(G_PLACE_MUT, ty_flag(bt));
        st(G_PLACE_ROOT, root_local(nd(e, N_A)));
        return elem;
    }

    if k == E_DEREF {
        let bt: u32 = check_expr(nd(e, N_A), 0);
        if failed() { return ty_i32(); }
        let bk: u32 = ty_kind(bt);
        if bk == TYK_REF {
            nset(e, N_TY, read_ty(ty_arg(bt)));
            st(G_PLACE_MUT, ty_flag(bt));
            st(G_PLACE_ROOT, root_local(nd(e, N_A)));
            return ty_arg(bt);
        }
        if bk == TYK_PTR {
            if ld(G_UNSAFED) == 0 {
                err_msg(line, col, "raw pointer dereference requires `unsafe`");
                return ty_i32();
            }
            nset(e, N_TY, read_ty(ty_arg(bt)));
            st(G_PLACE_MUT, 1);
            st(G_PLACE_ROOT, root_local(nd(e, N_A)));
            return ty_arg(bt);
        }
        if err_open(line, col) { put_str("cannot dereference "); put_q_ty(bt); err_end(); }
        return ty_i32();
    }

    err_msg(line, col, "expected a place expression");
    return ty_i32();
}

// `s.len` is the one built-in field a slice has (S3).
fn is_slice_len(e: u32) -> bool {
    if !src_eq(nd(e, N_B), nd(e, N_C), "len") { return false; }
    let base: u32 = nd(e, N_A);
    if nd(base, N_KIND) == E_IDENT && find_enum(nd(base, N_A), nd(base, N_B)) != 0 {
        return false;
    }
    // probe without committing: a failure here is not the program's diagnostic
    let saved_err: u32 = ld(G_ERR);
    let saved_out: u32 = ld(G_OUT);
    let saved_ty: u32 = nd(base, N_TY);
    let t: u32 = check_expr(base, 0);
    let bad: bool = failed();
    st(G_ERR, saved_err);
    st(G_OUT, saved_out);
    if saved_ty != 0 { nset(base, N_TY, saved_ty); }
    if bad { return false; }
    return ty_kind(t) == TYK_SLICE;
}

fn check_expr(e: u32, want: u32) -> u32 {
    let t: u32 = check_expr_inner(e, want);
    nset(e, N_TY, t);
    return t;
}

fn check_expr_inner(e: u32, want: u32) -> u32 {
    if failed() { return ty_i32(); }
    let k: u32 = nd(e, N_KIND);
    let line: u32 = nd(e, N_LINE);
    let col: u32 = nd(e, N_COL);

    if k == E_INT { return ty_intlit(); }
    if k == E_CHAR { return ty_u32(); }
    if k == E_BOOL { return ty_bool(); }
    if k == E_STR {
        nset(e, N_AUX, intern_string(nd(e, N_A), nd(e, N_B)));
        return ty_intern(TYK_SLICE, ty_u8(), 0);
    }
    if k == E_STRUCTLIT {
        err_msg(line, col, "struct literal is only allowed as an initializer");
        return ty_i32();
    }
    if k == E_IDENT {
        let loc: u32 = lookup(nd(e, N_A), nd(e, N_B));
        if loc != 0 {
            nset(e, N_AUX, loc);
            nset(e, N_AUX2, 0);
            return read_ty(ld(loc + LOC_TY));
        }
        let ci: u32 = find_const(nd(e, N_A), nd(e, N_B));
        if ci != 0 {
            force_const(ci, line, col);
            if failed() { return ty_i32(); }
            nset(e, N_AUX, ld(ci + CI_VALUE));
            nset(e, N_AUX2, 1);
            return ld(ci + CI_TY);
        }
        if find_fn(nd(e, N_A), nd(e, N_B)) != 0 {
            err_msg(line, col, "functions are not values");
            return ty_i32();
        }
        e_unknown_name(line, col, nd(e, N_A), nd(e, N_B));
        return ty_i32();
    }
    if k == E_UNARY {
        if nd(e, N_A) == P_NOT {
            coerce(nd(e, N_B), ty_bool());
            return ty_bool();
        }
        let t: u32 = check_expr(nd(e, N_B), int_want(want));
        if failed() { return ty_i32(); }
        if !is_int_ty(t) { e_negate(line, col, t); return ty_i32(); }
        return t;
    }
    if k == E_BORROW {
        err_msg(line, col, "a borrow may only appear as a call argument");
        return ty_i32();
    }
    if k == E_CAST {
        let mut src: u32 = check_expr(nd(e, N_A), 0);
        if failed() { return ty_i32(); }
        if ty_kind(src) == TYK_INTLIT {
            retype(nd(e, N_A), ty_i32());
            src = ty_i32();
        }
        let dst: u32 = resolve_ty(nd(e, N_B));
        if failed() { return ty_i32(); }
        let sk: u32 = ty_kind(src);
        let dk: u32 = ty_kind(dst);
        if sk != TYK_I32 && sk != TYK_U32 && sk != TYK_PTR {
            e_cast_from(line, col, src);
            return ty_i32();
        }
        if dk != TYK_I32 && dk != TYK_U32 && dk != TYK_PTR {
            e_cast_to(line, col, dst);
            return ty_i32();
        }
        return dst;
    }
    if k == E_BINARY { return check_binary(e, want); }
    if k == E_CALL {
        if is_enum_lit(e) {
            err_msg(line, col, "enum literal is only allowed as an initializer");
            return ty_i32();
        }
        return check_call(e);
    }
    if k == E_FIELD {
        if is_enum_lit(e) {
            err_msg(line, col, "enum literal is only allowed as an initializer");
            return ty_i32();
        }
        if is_slice_len(e) {
            check_expr(nd(e, N_A), 0);
            if failed() { return ty_i32(); }
            return ty_u32();
        }
    }
    if k == E_FIELD || k == E_INDEX || k == E_DEREF {
        let ty: u32 = check_place(e);
        if failed() { return ty_i32(); }
        if is_aggregate(ty) { return ty; }
        return read_ty(ty);
    }
    err_msg(line, col, "expected expression");
    return ty_i32();
}

// --- the whole check (SPEC.md S4) ------------------------------------------

fn check_program() {
    st(G_TYPES, 0);
    st(G_TY_I32, ty_new(TYK_I32, 0, 0));
    st(G_TY_U32, ty_new(TYK_U32, 0, 0));
    st(G_TY_BOOL, ty_new(TYK_BOOL, 0, 0));
    st(G_TY_U8, ty_new(TYK_U8, 0, 0));
    st(G_TY_VOID, ty_new(TYK_VOID, 0, 0));
    st(G_TY_INTLIT, ty_new(TYK_INTLIT, 0, 0));
    st(G_STRUCTS, 0);
    st(G_STRUCTS_T, 0);
    st(G_ENUMS, 0);
    st(G_ENUMS_T, 0);
    st(G_CONSTS, 0);
    st(G_CONSTS_T, 0);
    st(G_FNS, 0);
    st(G_FNS_T, 0);
    st(G_NFNS, 0);
    st(G_TAKEN, 0);
    st(G_TAKEN_T, 0);
    st(G_STRINGS, 0);
    st(G_STRINGS_T, 0);
    st(G_RODATA, RODATA);
    st(G_TYNAMES, 0);
    st(G_TYNAMES_T, 0);
    st(G_SCOPE, alloc(4096 * 4));
    st(G_MARKS, alloc(512 * 4));
    st(G_SCOPE_N, 0);
    st(G_MARKS_N, 0);

    // pass one: gather declarations. Top level is order-independent (S4)
    let mut d: u32 = ld(G_DECLS);
    for d != 0 && !failed() {
        claim(d);
        d = nd(d, N_NEXT);
    }
    if failed() { return; }
    d = ld(G_DECLS);
    for d != 0 {
        let k: u32 = nd(d, N_KIND);
        if k == D_STRUCT || k == D_ENUM { add_type_name(d); }
        d = nd(d, N_NEXT);
    }
    d = ld(G_DECLS);
    for d != 0 && !failed() {
        if nd(d, N_KIND) == D_STRUCT { declare_struct(d); }
        d = nd(d, N_NEXT);
    }
    if failed() { return; }
    d = ld(G_DECLS);
    for d != 0 && !failed() {
        if nd(d, N_KIND) == D_ENUM { declare_enum(d); }
        d = nd(d, N_NEXT);
    }
    if failed() { return; }
    // consts may reference each other, so register them all before folding
    d = ld(G_DECLS);
    for d != 0 && !failed() {
        if nd(d, N_KIND) == D_CONST { declare_const(d); }
        d = nd(d, N_NEXT);
    }
    if failed() { return; }
    d = ld(G_DECLS);
    for d != 0 && !failed() {
        if nd(d, N_KIND) == D_CONST {
            force_const(nd(d, N_AUX), nd(d, N_LINE), nd(d, N_COL));
        }
        d = nd(d, N_NEXT);
    }
    if failed() { return; }
    let mut index: u32 = 0;
    d = ld(G_DECLS);
    for d != 0 && !failed() {
        if nd(d, N_KIND) == D_FN {
            declare_fn(d, index);
            index += 1;
        }
        d = nd(d, N_NEXT);
    }
    st(G_NFNS, index);
    if failed() { return; }

    // pass two: bodies
    let mut fi: u32 = ld(G_FNS);
    for fi != 0 && !failed() {
        check_fn(fi);
        fi = ld(fi + FN_NEXT);
    }
}

// --- wasm encoding (SPEC.md S11) -------------------------------------------

const SEC_TYPE: u32 = 1;
const SEC_FUNC: u32 = 3;
const SEC_MEM: u32 = 5;
const SEC_GLOBAL: u32 = 6;
const SEC_EXPORT: u32 = 7;
const SEC_CODE: u32 = 10;
const SEC_DATA: u32 = 11;

const OP_UNREACHABLE: u32 = 0x00;
const OP_BLOCK: u32 = 0x02;
const OP_LOOP: u32 = 0x03;
const OP_IF: u32 = 0x04;
const OP_ELSE: u32 = 0x05;
const OP_END: u32 = 0x0B;
const OP_BR: u32 = 0x0C;
const OP_BR_IF: u32 = 0x0D;
const OP_RETURN: u32 = 0x0F;
const OP_CALL: u32 = 0x10;
const OP_DROP: u32 = 0x1A;
const OP_LOCAL_GET: u32 = 0x20;
const OP_LOCAL_SET: u32 = 0x21;
const OP_GLOBAL_GET: u32 = 0x23;
const OP_GLOBAL_SET: u32 = 0x24;
const OP_I32_LOAD: u32 = 0x28;
const OP_I32_LOAD8_U: u32 = 0x2D;
const OP_I32_STORE: u32 = 0x36;
const OP_I32_STORE8: u32 = 0x3A;
const OP_I32_CONST: u32 = 0x41;
const OP_I32_EQZ: u32 = 0x45;
const OP_I32_GE_U: u32 = 0x4F;
const OP_I32_ADD: u32 = 0x6A;
const OP_I32_SUB: u32 = 0x6B;
const OP_I32_MUL: u32 = 0x6C;
const TYPE_I32: u32 = 0x7F;
const BLOCK_VOID: u32 = 0x40;

const MEM_PAGES: u32 = 512;
const SHADOW_TOP: u32 = 0x1000;

const G_B: u32 = 0x00C8;        // cursor into S1, one function body
const G_S: u32 = 0x00CC;        // cursor into S2, one section payload
const G_SIGS: u32 = 0x00D0;
const G_NSIGS: u32 = 0x00D4;
const G_NTEMP: u32 = 0x00D8;
const G_FREE: u32 = 0x00DC;
const G_FREE_N: u32 = 0x00E0;
const G_CTRL: u32 = 0x00E4;
const G_CTRL_N: u32 = 0x00E8;
const G_EFN: u32 = 0x00EC;

const CTRL_BRK: u32 = 1;
const CTRL_LOOP: u32 = 2;
const CTRL_CNT: u32 = 3;
const CTRL_MATCH: u32 = 4;
const CTRL_IF: u32 = 5;

// --- byte writers ----------------------------------------------------------

fn w_ch(g: u32, c: u32) {
    stb(ld(g), c);
    st(g, ld(g) + 1);
}

fn w_u(g: u32, n: u32) {
    let mut x: u32 = n;
    for {
        let byte: u32 = x & 0x7F;
        x = x >> 7;
        if x == 0 {
            w_ch(g, byte);
            break;
        }
        w_ch(g, byte | 0x80);
    }
}

// signed LEB128 of the 32-bit pattern v
fn w_s(g: u32, v: u32) {
    let mut x: i32 = v as i32;
    for {
        let byte: u32 = (x as u32) & 0x7F;
        x = x >> 7;
        let sign: u32 = byte & 0x40;
        if (x == 0 && sign == 0) || (x == -1 && sign != 0) {
            w_ch(g, byte);
            break;
        }
        w_ch(g, byte | 0x80);
    }
}

fn w_copy(g: u32, src: u32, n: u32) {
    for let mut i: u32 = 0; i < n; i += 1 { w_ch(g, ldb(src + i)); }
}

fn leb_u_len(n: u32) -> u32 {
    let mut x: u32 = n;
    let mut k: u32 = 1;
    for x >= 128 {
        x = x >> 7;
        k += 1;
    }
    return k;
}

// body writers
fn b_ch(c: u32) { w_ch(G_B, c); }

fn b_u(n: u32) { w_u(G_B, n); }

fn b_op(c: u32) { w_ch(G_B, c); }

fn b_i32const(v: u32) {
    w_ch(G_B, OP_I32_CONST);
    w_s(G_B, v);
}

fn b_idx(op: u32, i: u32) {
    w_ch(G_B, op);
    w_u(G_B, i);
}

// memarg: alignment, then an offset that is always 0 (S11)
fn b_mem(op: u32, align: u32) {
    w_ch(G_B, op);
    w_u(G_B, align);
    w_u(G_B, 0);
}

fn b_blocked(op: u32, bt: u32) {
    w_ch(G_B, op);
    w_ch(G_B, bt);
}

// section writers
fn s_ch(c: u32) { w_ch(G_S, c); }

fn s_u(n: u32) { w_u(G_S, n); }

// --- temporaries (S11) -----------------------------------------------------

fn temp() -> u32 {
    if ld(G_FREE_N) != 0 {
        st(G_FREE_N, ld(G_FREE_N) - 1);
        return ld(ld(G_FREE) + ld(G_FREE_N) * 4);
    }
    let fi: u32 = ld(G_EFN);
    let i: u32 = ld(fi + FN_NPSLOT) + ld(fi + FN_NLSLOT) + ld(G_NTEMP);
    st(G_NTEMP, ld(G_NTEMP) + 1);
    return i;
}

fn free_push(t: u32) {
    st(ld(G_FREE) + ld(G_FREE_N) * 4, t);
    st(G_FREE_N, ld(G_FREE_N) + 1);
}

fn release1(a: u32) { free_push(a); }

// released highest first, exactly as cool0.py sorts them
fn release2(a: u32, b: u32) {
    if a > b { free_push(a); free_push(b); return; }
    free_push(b);
    free_push(a);
}

fn release3(a: u32, b: u32, c: u32) {
    let mut hi: u32 = a;
    let mut mid: u32 = b;
    let mut lo: u32 = c;
    if mid > hi { let t: u32 = hi; hi = mid; mid = t; }
    if lo > hi { let t: u32 = hi; hi = lo; lo = t; }
    if lo > mid { let t: u32 = mid; mid = lo; lo = t; }
    free_push(hi);
    free_push(mid);
    free_push(lo);
}

// --- control stack ---------------------------------------------------------

fn ctrl_push(k: u32) {
    st(ld(G_CTRL) + ld(G_CTRL_N) * 4, k);
    st(G_CTRL_N, ld(G_CTRL_N) + 1);
}

fn ctrl_pop() { st(G_CTRL_N, ld(G_CTRL_N) - 1); }

fn depth_to(k: u32) -> u32 {
    let n: u32 = ld(G_CTRL_N);
    let mut i: u32 = n;
    for i > 0 {
        i -= 1;
        if ld(ld(G_CTRL) + i * 4) == k { return n - 1 - i; }
    }
    return 0;
}

// --- storage assignment (S11) ----------------------------------------------

fn loc_in_memory(loc: u32) -> bool {
    return is_aggregate(ld(loc + LOC_TY)) || ld(loc + LOC_ADDR) != 0;
}

fn assign_storage(fi: u32) {
    let mut slot: u32 = 0;
    let mut loc: u32 = ld(fi + FN_LOCALS);
    for loc != 0 {
        if ld(loc + LOC_PARAM) != 0 {
            st(loc + LOC_SLOT, slot);
            slot += slot_count(ld(loc + LOC_TY));
        }
        loc = ld(loc + LOC_NEXT);
    }
    st(fi + FN_NPSLOT, slot);
    loc = ld(fi + FN_LOCALS);
    for loc != 0 {
        if ld(loc + LOC_PARAM) == 0 && !loc_in_memory(loc) {
            st(loc + LOC_SLOT, slot);
            slot += slot_count(ld(loc + LOC_TY));
        }
        loc = ld(loc + LOC_NEXT);
    }
    st(fi + FN_NLSLOT, slot - ld(fi + FN_NPSLOT));

    let mut off: u32 = 0;
    let mut align: u32 = 4;
    loc = ld(fi + FN_LOCALS);
    for loc != 0 {
        if loc_in_memory(loc) {
            let a: u32 = align_of(ld(loc + LOC_TY));
            off = align_up(off, a);
            st(loc + LOC_FOFF, off);
            off += size_of(ld(loc + LOC_TY));
            if a > align { align = a; }
        }
        loc = ld(loc + LOC_NEXT);
    }
    if off != 0 { st(fi + FN_FRAME, align_up(off, align)); } else { st(fi + FN_FRAME, 0); }
}

// --- memory access ---------------------------------------------------------

fn load_op(t: u32) {
    let k: u32 = ty_kind(t);
    if k == TYK_BOOL || k == TYK_U8 { b_mem(OP_I32_LOAD8_U, 0); return; }
    b_mem(OP_I32_LOAD, 2);
}

fn store_op(t: u32) {
    let k: u32 = ty_kind(t);
    if k == TYK_BOOL || k == TYK_U8 { b_mem(OP_I32_STORE8, 0); return; }
    b_mem(OP_I32_STORE, 2);
}

fn frame_addr(loc: u32) {
    b_idx(OP_GLOBAL_GET, 0);
    b_i32const(ld(loc + LOC_FOFF));
    b_op(OP_I32_ADD);
}

fn ident_local(e: u32) -> u32 {
    if nd(e, N_AUX2) != 0 { return 0; }
    return nd(e, N_AUX);
}

fn in_wasm_local(e: u32) -> bool {
    if nd(e, N_KIND) != E_IDENT { return false; }
    let loc: u32 = ident_local(e);
    if loc == 0 { return false; }
    return !loc_in_memory(loc);
}

fn place_ty(e: u32) -> u32 {
    let k: u32 = nd(e, N_KIND);
    if k == E_IDENT { return ld(ident_local(e) + LOC_TY); }
    if k == E_FIELD { return ld(nd(e, N_D) + FI_TY); }
    if k == E_INDEX { return ty_arg(nd(nd(e, N_A), N_TY)); }
    return ty_arg(nd(nd(e, N_A), N_TY));
}

fn emit_addr(e: u32) {
    let k: u32 = nd(e, N_KIND);
    if k == E_IDENT { frame_addr(ident_local(e)); return; }
    if k == E_FIELD {
        emit_addr(nd(e, N_A));
        b_i32const(ld(nd(e, N_D) + FI_OFF));
        b_op(OP_I32_ADD);
        return;
    }
    if k == E_DEREF { emit_expr(nd(e, N_A)); return; }
    // E_INDEX -- bounds checked (S5)
    let tp: u32 = temp();
    let tl: u32 = temp();
    let tix: u32 = temp();
    emit_expr(nd(e, N_A));
    b_idx(OP_LOCAL_SET, tl);
    b_idx(OP_LOCAL_SET, tp);
    emit_expr(nd(e, N_B));
    b_idx(OP_LOCAL_SET, tix);
    b_idx(OP_LOCAL_GET, tix);
    b_idx(OP_LOCAL_GET, tl);
    b_op(OP_I32_GE_U);
    b_blocked(OP_IF, BLOCK_VOID);
    b_op(OP_UNREACHABLE);
    b_op(OP_END);
    b_idx(OP_LOCAL_GET, tp);
    b_idx(OP_LOCAL_GET, tix);
    b_i32const(nd(e, N_D));
    b_op(OP_I32_MUL);
    b_op(OP_I32_ADD);
    release3(tp, tl, tix);
}

fn emit_place_load(e: u32, pt: u32) {
    if in_wasm_local(e) {
        let loc: u32 = ident_local(e);
        b_idx(OP_LOCAL_GET, ld(loc + LOC_SLOT));
        if ty_kind(ld(loc + LOC_TY)) == TYK_SLICE {
            b_idx(OP_LOCAL_GET, ld(loc + LOC_SLOT) + 1);
        }
        return;
    }
    if ty_kind(pt) == TYK_SLICE {
        let ta: u32 = temp();
        emit_addr(e);
        b_idx(OP_LOCAL_SET, ta);
        b_idx(OP_LOCAL_GET, ta);
        b_mem(OP_I32_LOAD, 2);
        b_idx(OP_LOCAL_GET, ta);
        b_i32const(4);
        b_op(OP_I32_ADD);
        b_mem(OP_I32_LOAD, 2);
        release1(ta);
        return;
    }
    emit_addr(e);
    load_op(pt);
}

fn emit_load_at(ta: u32, off: u32, t: u32) {
    if ty_kind(t) == TYK_SLICE {
        b_idx(OP_LOCAL_GET, ta);
        b_i32const(off);
        b_op(OP_I32_ADD);
        b_mem(OP_I32_LOAD, 2);
        b_idx(OP_LOCAL_GET, ta);
        b_i32const(off + 4);
        b_op(OP_I32_ADD);
        b_mem(OP_I32_LOAD, 2);
        return;
    }
    b_idx(OP_LOCAL_GET, ta);
    b_i32const(off);
    b_op(OP_I32_ADD);
    load_op(t);
}

// vk 0: the value is expression a1.  vk 1: load a3 from a1 + a2.
fn emit_value(vk: u32, a1: u32, a2: u32, a3: u32) {
    if vk == 0 { emit_expr(a1); return; }
    emit_load_at(a1, a2, a3);
}

// --- expressions -----------------------------------------------------------

fn arith_op(op: u32, signed: bool) -> u32 {
    if op == P_ADD { return 0x6A; }
    if op == P_SUB { return 0x6B; }
    if op == P_MUL { return 0x6C; }
    if op == P_DIV { if signed { return 0x6D; } return 0x6E; }
    if op == P_MOD { if signed { return 0x6F; } return 0x70; }
    if op == P_AND { return 0x71; }
    if op == P_OR { return 0x72; }
    if op == P_XOR { return 0x73; }
    if op == P_SHL { return 0x74; }
    if signed { return 0x75; }
    return 0x76;
}

fn cmp_opcode(op: u32, signed: bool) -> u32 {
    if op == P_EQEQ { return 0x46; }
    if op == P_NE { return 0x47; }
    if op == P_LT { if signed { return 0x48; } return 0x49; }
    if op == P_GT { if signed { return 0x4A; } return 0x4B; }
    if op == P_LE { if signed { return 0x4C; } return 0x4D; }
    if signed { return 0x4E; }
    return 0x4F;
}

fn emit_binary(e: u32) {
    let op: u32 = nd(e, N_A);
    if op == P_ANDAND || op == P_OROR {
        emit_expr(nd(e, N_B));
        b_blocked(OP_IF, TYPE_I32);
        ctrl_push(CTRL_IF);
        if op == P_ANDAND {
            emit_expr(nd(e, N_C));
            b_op(OP_ELSE);
            b_i32const(0);
        } else {
            b_i32const(1);
            b_op(OP_ELSE);
            emit_expr(nd(e, N_C));
        }
        ctrl_pop();
        b_op(OP_END);
        return;
    }
    emit_expr(nd(e, N_B));
    emit_expr(nd(e, N_C));
    if is_cmp(op) {
        b_op(cmp_opcode(op, ty_kind(nd(e, N_D)) == TYK_I32));
        return;
    }
    b_op(arith_op(op, ty_kind(nd(e, N_TY)) == TYK_I32));
}

fn emit_expr(e: u32) {
    let k: u32 = nd(e, N_KIND);
    if k == E_INT || k == E_CHAR || k == E_BOOL { b_i32const(nd(e, N_A)); return; }
    if k == E_STR {
        b_i32const(nd(e, N_AUX));
        b_i32const(nd(e, N_B));
        return;
    }
    if k == E_IDENT {
        let loc: u32 = ident_local(e);
        if loc != 0 { emit_place_load(e, ld(loc + LOC_TY)); return; }
        b_i32const(nd(e, N_AUX));
        return;
    }
    if k == E_CAST { emit_expr(nd(e, N_A)); return; }
    if k == E_UNARY {
        if nd(e, N_A) == P_NOT {
            emit_expr(nd(e, N_B));
            b_op(OP_I32_EQZ);
            return;
        }
        b_i32const(0);
        emit_expr(nd(e, N_B));
        b_op(OP_I32_SUB);
        return;
    }
    if k == E_BINARY { emit_binary(e); return; }
    if k == E_CALL {
        let mut a: u32 = nd(e, N_B);
        for a != 0 {
            if nd(a, N_KIND) == E_BORROW { emit_addr(nd(a, N_B)); } else { emit_expr(a); }
            a = nd(a, N_NEXT);
        }
        b_idx(OP_CALL, ld(nd(e, N_D) + FN_INDEX));
        return;
    }
    if k == E_FIELD && nd(e, N_D) == 0 {
        // a slice's .len
        emit_expr(nd(e, N_A));
        let t: u32 = temp();
        b_idx(OP_LOCAL_SET, t);
        b_op(OP_DROP);
        b_idx(OP_LOCAL_GET, t);
        release1(t);
        return;
    }
    emit_place_load(e, place_ty(e));
}

// --- stores ----------------------------------------------------------------

fn emit_store_common(ak: u32, arg: u32, ty: u32, vk: u32, a1: u32, a2: u32, a3: u32) {
    let ta: u32 = temp();
    if ak == 0 { emit_addr(arg); } else { frame_addr(arg); }
    b_idx(OP_LOCAL_SET, ta);
    if ty_kind(ty) == TYK_SLICE {
        let tp: u32 = temp();
        let tl: u32 = temp();
        emit_value(vk, a1, a2, a3);
        b_idx(OP_LOCAL_SET, tl);
        b_idx(OP_LOCAL_SET, tp);
        b_idx(OP_LOCAL_GET, ta);
        b_idx(OP_LOCAL_GET, tp);
        b_mem(OP_I32_STORE, 2);
        b_idx(OP_LOCAL_GET, ta);
        b_i32const(4);
        b_op(OP_I32_ADD);
        b_idx(OP_LOCAL_GET, tl);
        b_mem(OP_I32_STORE, 2);
        release2(tp, tl);
    } else {
        b_idx(OP_LOCAL_GET, ta);
        emit_value(vk, a1, a2, a3);
        store_op(ty);
    }
    release1(ta);
}

fn emit_store_slots(loc: u32, vk: u32, a1: u32, a2: u32, a3: u32) {
    emit_value(vk, a1, a2, a3);
    if ty_kind(ld(loc + LOC_TY)) == TYK_SLICE {
        b_idx(OP_LOCAL_SET, ld(loc + LOC_SLOT) + 1);
        b_idx(OP_LOCAL_SET, ld(loc + LOC_SLOT));
        return;
    }
    b_idx(OP_LOCAL_SET, ld(loc + LOC_SLOT));
}

fn emit_store_to(place: u32, vk: u32, a1: u32, a2: u32, a3: u32) {
    if in_wasm_local(place) {
        emit_store_slots(ident_local(place), vk, a1, a2, a3);
        return;
    }
    emit_store_common(0, place, place_ty(place), vk, a1, a2, a3);
}

fn emit_store_local(loc: u32, vk: u32, a1: u32, a2: u32, a3: u32) {
    if !loc_in_memory(loc) {
        emit_store_slots(loc, vk, a1, a2, a3);
        return;
    }
    emit_store_common(1, loc, ld(loc + LOC_TY), vk, a1, a2, a3);
}

fn emit_field_store(ta: u32, off: u32, ty: u32, value: u32) {
    if ty_kind(ty) == TYK_SLICE {
        let tp: u32 = temp();
        let tl: u32 = temp();
        emit_expr(value);
        b_idx(OP_LOCAL_SET, tl);
        b_idx(OP_LOCAL_SET, tp);
        b_idx(OP_LOCAL_GET, ta);
        b_i32const(off);
        b_op(OP_I32_ADD);
        b_idx(OP_LOCAL_GET, tp);
        b_mem(OP_I32_STORE, 2);
        b_idx(OP_LOCAL_GET, ta);
        b_i32const(off + 4);
        b_op(OP_I32_ADD);
        b_idx(OP_LOCAL_GET, tl);
        b_mem(OP_I32_STORE, 2);
        release2(tp, tl);
        return;
    }
    b_idx(OP_LOCAL_GET, ta);
    b_i32const(off);
    b_op(OP_I32_ADD);
    emit_expr(value);
    store_op(ty);
}

fn is_agg_lit(e: u32) -> bool {
    let k: u32 = nd(e, N_KIND);
    if k == E_STRUCTLIT { return true; }
    if k == E_FIELD || k == E_CALL { return nd(e, N_AUX2) == 1; }
    return false;
}

// The literal is written straight into the destination -- no copy (S5).
fn emit_agg_init(ta: u32, init: u32) {
    if nd(init, N_KIND) == E_STRUCTLIT {
        let mut lf: u32 = nd(init, N_C);
        let mut f: u32 = ld(nd(init, N_D) + SI_FIELDS);
        for lf != 0 {
            emit_field_store(ta, ld(f + FI_OFF), ld(f + FI_TY), nd(lf, N_C));
            lf = nd(lf, N_NEXT);
            f = ld(f + FI_NEXT);
        }
        return;
    }
    let v: u32 = nd(init, N_AUX);
    b_idx(OP_LOCAL_GET, ta);
    b_i32const(0);
    b_op(OP_I32_ADD);
    b_i32const(ld(v + VI_TAG));
    b_mem(OP_I32_STORE, 2);
    let mut a: u32 = 0;
    if nd(init, N_KIND) == E_CALL { a = nd(init, N_B); }
    let mut f: u32 = ld(v + VI_PAYLOAD);
    for a != 0 {
        emit_field_store(ta, ld(f + FI_OFF), ld(f + FI_TY), a);
        a = nd(a, N_NEXT);
        f = ld(f + FI_NEXT);
    }
}

// --- statements ------------------------------------------------------------

fn emit_epilogue() {
    let frame: u32 = ld(ld(G_EFN) + FN_FRAME);
    if frame != 0 {
        b_idx(OP_GLOBAL_GET, 0);
        b_i32const(frame);
        b_op(OP_I32_ADD);
        b_idx(OP_GLOBAL_SET, 0);
    }
}

fn emit_block(head: u32) {
    let mut s: u32 = head;
    for s != 0 {
        emit_stmt(s);
        s = nd(s, N_NEXT);
    }
}

fn emit_match(s: u32) {
    let ta: u32 = temp();
    emit_addr(nd(s, N_A));
    b_idx(OP_LOCAL_SET, ta);
    b_blocked(OP_BLOCK, BLOCK_VOID);
    ctrl_push(CTRL_MATCH);
    let mut arm: u32 = nd(s, N_B);
    for arm != 0 {
        if nd(arm, N_E) != 0 {
            emit_block(nd(arm, N_D));
        } else {
            let v: u32 = nd(arm, N_AUX);
            b_idx(OP_LOCAL_GET, ta);
            b_i32const(0);
            b_op(OP_I32_ADD);
            b_mem(OP_I32_LOAD, 2);
            b_i32const(ld(v + VI_TAG));
            b_op(cmp_opcode(P_EQEQ, false));
            b_blocked(OP_IF, BLOCK_VOID);
            ctrl_push(CTRL_IF);
            let mut b: u32 = nd(arm, N_C);
            let mut f: u32 = ld(v + VI_PAYLOAD);
            for b != 0 {
                emit_store_local(nd(b, N_AUX), 1, ta, ld(f + FI_OFF), ld(f + FI_TY));
                b = nd(b, N_NEXT);
                f = ld(f + FI_NEXT);
            }
            emit_block(nd(arm, N_D));
            b_idx(OP_BR, depth_to(CTRL_MATCH));
            ctrl_pop();
            b_op(OP_END);
        }
        arm = nd(arm, N_NEXT);
    }
    if nd(s, N_D) == 0 { b_op(OP_UNREACHABLE); }
    ctrl_pop();
    b_op(OP_END);
    release1(ta);
}

fn emit_stmt(s: u32) {
    let k: u32 = nd(s, N_KIND);

    if k == S_LET {
        let loc: u32 = nd(s, N_AUX);
        if is_agg_lit(nd(s, N_D)) {
            let ta: u32 = temp();
            frame_addr(loc);
            b_idx(OP_LOCAL_SET, ta);
            emit_agg_init(ta, nd(s, N_D));
            release1(ta);
            return;
        }
        emit_store_local(loc, 0, nd(s, N_D), 0, 0);
        return;
    }

    if k == S_ASSIGN {
        let op: u32 = nd(s, N_B);
        if op == P_EQ {
            if is_agg_lit(nd(s, N_C)) {
                let ta: u32 = temp();
                emit_addr(nd(s, N_A));
                b_idx(OP_LOCAL_SET, ta);
                emit_agg_init(ta, nd(s, N_C));
                release1(ta);
                return;
            }
            emit_store_to(nd(s, N_A), 0, nd(s, N_C), 0, 0);
            return;
        }
        let base: u32 = assign_base_op(op);
        let ty: u32 = place_ty(nd(s, N_A));
        let signed: bool = ty_kind(read_ty(ty)) == TYK_I32;
        if in_wasm_local(nd(s, N_A)) {
            let loc: u32 = ident_local(nd(s, N_A));
            b_idx(OP_LOCAL_GET, ld(loc + LOC_SLOT));
            emit_expr(nd(s, N_C));
            b_op(arith_op(base, signed));
            b_idx(OP_LOCAL_SET, ld(loc + LOC_SLOT));
            return;
        }
        let ta: u32 = temp();
        emit_addr(nd(s, N_A));
        b_idx(OP_LOCAL_SET, ta);
        b_idx(OP_LOCAL_GET, ta);
        b_idx(OP_LOCAL_GET, ta);
        load_op(ty);
        emit_expr(nd(s, N_C));
        b_op(arith_op(base, signed));
        store_op(ty);
        release1(ta);
        return;
    }

    if k == S_EXPR {
        emit_expr(nd(s, N_A));
        if nd(s, N_AUX) != 0 {
            let n: u32 = slot_count(nd(nd(s, N_A), N_TY));
            for let mut i: u32 = 0; i < n; i += 1 { b_op(OP_DROP); }
        }
        return;
    }

    if k == S_IF {
        emit_expr(nd(s, N_A));
        b_blocked(OP_IF, BLOCK_VOID);
        ctrl_push(CTRL_IF);
        emit_block(nd(s, N_B));
        if nd(s, N_D) != 0 {
            b_op(OP_ELSE);
            emit_block(nd(s, N_C));
        }
        ctrl_pop();
        b_op(OP_END);
        return;
    }

    if k == S_FOR {
        if nd(s, N_A) != 0 { emit_stmt(nd(s, N_A)); }
        b_blocked(OP_BLOCK, BLOCK_VOID);
        ctrl_push(CTRL_BRK);
        b_blocked(OP_LOOP, BLOCK_VOID);
        ctrl_push(CTRL_LOOP);
        if nd(s, N_B) != 0 {
            emit_expr(nd(s, N_B));
            b_op(OP_I32_EQZ);
            b_idx(OP_BR_IF, depth_to(CTRL_BRK));
        }
        b_blocked(OP_BLOCK, BLOCK_VOID);
        ctrl_push(CTRL_CNT);
        emit_block(nd(s, N_D));
        ctrl_pop();
        b_op(OP_END);
        if nd(s, N_C) != 0 { emit_stmt(nd(s, N_C)); }
        b_idx(OP_BR, depth_to(CTRL_LOOP));
        ctrl_pop();
        b_op(OP_END);
        ctrl_pop();
        b_op(OP_END);
        return;
    }

    if k == S_BREAK { b_idx(OP_BR, depth_to(CTRL_BRK)); return; }
    if k == S_CONTINUE { b_idx(OP_BR, depth_to(CTRL_CNT)); return; }

    if k == S_RETURN {
        if nd(s, N_A) != 0 { emit_expr(nd(s, N_A)); }
        emit_epilogue();
        b_op(OP_RETURN);
        return;
    }

    if k == S_MATCH { emit_match(s); return; }
    if k == S_UNSAFE { emit_block(nd(s, N_A)); return; }
}

// --- functions -------------------------------------------------------------

fn emit_fn(fi: u32) {
    assign_storage(fi);
    st(G_B, S1);
    st(G_NTEMP, 0);
    st(G_FREE_N, 0);
    st(G_CTRL_N, 0);
    st(G_EFN, fi);

    let frame: u32 = ld(fi + FN_FRAME);
    if frame != 0 {
        b_idx(OP_GLOBAL_GET, 0);
        b_i32const(frame);
        b_op(OP_I32_SUB);
        b_idx(OP_GLOBAL_SET, 0);
    }
    // a parameter whose address is taken is copied into the frame (S11)
    let mut loc: u32 = ld(fi + FN_LOCALS);
    for loc != 0 {
        if ld(loc + LOC_PARAM) != 0 && ld(loc + LOC_FOFF) != NONE {
            frame_addr(loc);
            if ty_kind(ld(loc + LOC_TY)) == TYK_SLICE {
                let ta: u32 = temp();
                b_idx(OP_LOCAL_SET, ta);
                b_idx(OP_LOCAL_GET, ta);
                b_idx(OP_LOCAL_GET, ld(loc + LOC_SLOT));
                b_mem(OP_I32_STORE, 2);
                b_idx(OP_LOCAL_GET, ta);
                b_i32const(4);
                b_op(OP_I32_ADD);
                b_idx(OP_LOCAL_GET, ld(loc + LOC_SLOT) + 1);
                b_mem(OP_I32_STORE, 2);
                release1(ta);
            } else {
                b_idx(OP_LOCAL_GET, ld(loc + LOC_SLOT));
                store_op(ld(loc + LOC_TY));
            }
        }
        loc = ld(loc + LOC_NEXT);
    }

    emit_block(nd(ld(fi + FN_DECL), N_E));
    emit_epilogue();
    if ty_kind(ld(fi + FN_RET)) != TYK_VOID { b_op(OP_UNREACHABLE); }
    b_op(OP_END);

    let nlocals: u32 = ld(fi + FN_NLSLOT) + ld(G_NTEMP);
    let mut declsize: u32 = 1;
    if nlocals != 0 { declsize = 1 + leb_u_len(nlocals) + 1; }
    let codelen: u32 = ld(G_B) - S1;
    s_u(declsize + codelen);
    if nlocals == 0 {
        s_u(0);
    } else {
        s_u(1);
        s_u(nlocals);
        s_ch(TYPE_I32);
    }
    w_copy(G_S, S1, codelen);
}

// --- the module (SPEC.md S11) ----------------------------------------------

fn sig_of(fi: u32) -> u32 {
    let mut n: u32 = 0;
    let mut p: u32 = ld(fi + FN_PARAMS);
    for p != 0 {
        n += slot_count(ld(p + PI_TY));
        p = ld(p + PI_NEXT);
    }
    // every wasm type here is i32, so the shape is (count, has-result)
    if ty_kind(ld(fi + FN_RET)) == TYK_VOID { return n * 2; }
    return n * 2 + 1;
}

fn type_idx(sig: u32) -> u32 {
    let n: u32 = ld(G_NSIGS);
    for let mut i: u32 = 0; i < n; i += 1 {
        if ld(ld(G_SIGS) + i * 4) == sig { return i; }
    }
    st(ld(G_SIGS) + n * 4, sig);
    st(G_NSIGS, n + 1);
    return n;
}

fn begin_section() { st(G_S, S2); }

fn end_section(id: u32) {
    let n: u32 = ld(G_S) - S2;
    w_ch(G_OUT, id);
    w_u(G_OUT, n);
    w_copy(G_OUT, S2, n);
}

fn emit_module() {
    st(G_SIGS, alloc(1024 * 4));
    st(G_NSIGS, 0);
    st(G_FREE, alloc(1024 * 4));
    st(G_CTRL, alloc(1024 * 4));

    let mut fi: u32 = ld(G_FNS);
    for fi != 0 {
        type_idx(sig_of(fi));
        fi = ld(fi + FN_NEXT);
    }

    out_reset();
    put_ch(0);
    put_ch('a');
    put_ch('s');
    put_ch('m');
    put_ch(1);
    put_ch(0);
    put_ch(0);
    put_ch(0);

    let nfns: u32 = ld(G_NFNS);
    let nsigs: u32 = ld(G_NSIGS);

    if nsigs != 0 {
        begin_section();
        s_u(nsigs);
        for let mut i: u32 = 0; i < nsigs; i += 1 {
            let sig: u32 = ld(ld(G_SIGS) + i * 4);
            let np: u32 = sig / 2;
            s_ch(0x60);
            s_u(np);
            for let mut j: u32 = 0; j < np; j += 1 { s_ch(TYPE_I32); }
            if sig % 2 == 0 {
                s_u(0);
            } else {
                s_u(1);
                s_ch(TYPE_I32);
            }
        }
        end_section(SEC_TYPE);
    }

    if nfns != 0 {
        begin_section();
        s_u(nfns);
        fi = ld(G_FNS);
        for fi != 0 {
            s_u(type_idx(sig_of(fi)));
            fi = ld(fi + FN_NEXT);
        }
        end_section(SEC_FUNC);
    }

    begin_section();
    s_u(1);
    s_ch(0x01);
    s_u(MEM_PAGES);
    s_u(MEM_PAGES);
    end_section(SEC_MEM);

    begin_section();
    s_u(1);
    s_ch(TYPE_I32);
    s_ch(0x01);
    s_ch(OP_I32_CONST);
    w_s(G_S, SHADOW_TOP);
    s_ch(OP_END);
    end_section(SEC_GLOBAL);

    begin_section();
    s_u(nfns + 1);
    fi = ld(G_FNS);
    for fi != 0 {
        s_u(ld(fi + FN_NL));
        w_copy(G_S, SRC + ld(fi + FN_NS), ld(fi + FN_NL));
        s_ch(0x00);
        s_u(ld(fi + FN_INDEX));
        fi = ld(fi + FN_NEXT);
    }
    s_u(6);
    s_ch('m');
    s_ch('e');
    s_ch('m');
    s_ch('o');
    s_ch('r');
    s_ch('y');
    s_ch(0x02);
    s_u(0);
    end_section(SEC_EXPORT);

    if nfns != 0 {
        begin_section();
        s_u(nfns);
        fi = ld(G_FNS);
        for fi != 0 {
            emit_fn(fi);
            fi = ld(fi + FN_NEXT);
        }
        end_section(SEC_CODE);
    }

    let mut sp: u32 = ld(G_STRINGS);
    if sp != 0 {
        let mut nstr: u32 = 0;
        for sp != 0 {
            nstr += 1;
            sp = ld(sp + STR_NEXT);
        }
        begin_section();
        s_u(nstr);
        sp = ld(G_STRINGS);
        for sp != 0 {
            s_ch(0x00);
            s_ch(OP_I32_CONST);
            w_s(G_S, ld(sp + STR_ADDR));
            s_ch(OP_END);
            s_u(ld(sp + STR_LEN));
            w_copy(G_S, ld(sp + STR_PTR), ld(sp + STR_LEN));
            sp = ld(sp + STR_NEXT);
        }
        end_section(SEC_DATA);
    }
}

// --- entry point (SPEC.md S8) ----------------------------------------------

fn compile(src_len_in: u32) -> i32 {
    st(G_SRCLEN, src_len_in);
    st(G_ERR, 0);
    st(G_HEAP, align4(SRC + src_len_in) + 4);
    out_reset();

    lex();
    if !failed() { parse_program(); }
    if !failed() { check_program(); }

    if failed() {
        st(OUT_PTR_ADDR, OUT);
        st(OUT_LEN_ADDR, ld(G_OUT) - OUT);
        return 1;
    }

    emit_module();
    st(OUT_PTR_ADDR, OUT);
    st(OUT_LEN_ADDR, ld(G_OUT) - OUT);
    return 0;
}
