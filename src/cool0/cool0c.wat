              (call $put_ch (i32.const 96))
              (call $put_str (i32.const 0x10006DD) (i32.const 25))
              (call $put_q_ty (local.get $t))
              (call $err_end))))

  (func $e_no_variant (export "e_no_variant") (param $line i32) (param $col i32)
                      (param $ens i32) (param $enl i32) (param $vs i32) (param $vl i32)
