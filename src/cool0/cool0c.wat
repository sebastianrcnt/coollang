  (func $emit_stmt (export "emit_stmt") (param $s i32)
    (local $k i32) (local $loc i32) (local $ta i32) (local $op i32) (local $base i32)
    (local $ty i32) (local $signed i32) (local $n i32) (local $i i32)
    (local.set $k (call $nd (local.get $s) (i32.const 0)))

    (if (i32.eq (local.get $k) (i32.const 30))
        (then
          (local.set $loc (call $nd (local.get $s) (i32.const 40)))
          (if (call $is_agg_lit (call $nd (local.get $s) (i32.const 24)))
              (then
                (local.set $ta (call $temp))
                (call $frame_addr (local.get $loc))
                (call $b_idx (i32.const 33) (local.get $ta))
                (call $emit_agg_init (local.get $ta) (call $nd (local.get $s) (i32.const 24)))
                (call $release1 (local.get $ta))
