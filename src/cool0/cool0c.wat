;; ==========================================================================
;; cool0c.wat -- the cool0 compiler, in WebAssembly text
;;
;; This is NOT an independent implementation. It is a transcription of
;; src/cool0/cool0c.cool0, function by function, in the same order. Every
;; function here corresponds to exactly one function there. When the two
;; disagree, the transcription is what is wrong.
;;
;; That is the whole point of the plan: the design was already checked when
;; cool0c.cool0 was checked against cool0.py, so only copying mistakes are
;; left, and byte parity catches those.
;;
;; The subset cool0c.cool0 is written in has no aggregates and no borrows,
;; so no function needs a shadow frame, every local is a wasm local, and
;; each cool0 function drops to one wasm function.
;;
;; Conventions used throughout:
;;
;;   for COND { BODY }        (block $brk (loop $cont
;;                              (br_if $brk (i32.eqz COND))
;;                              (block $cnt BODY)
;;                              (br $cont)))
;;   break                    (br $brk)         innermost wins in wat
;;   continue                 (br $cnt)
;;   a && b                   (if (result i32) a (then b) (else (i32.const 0)))
;;   a || b                   (if (result i32) a (then (i32.const 1)) (else b))
;;   !a                       (i32.eqz a)
;;   -a                       (i32.sub (i32.const 0) a)
;;   a[i] on []u8             bounds check, then i32.load8_u
;;
;; Named constants are inlined as numbers -- wat has none. The table is
;; SPEC.md plus the const block at the top of cool0c.cool0.
;;
;; String literals live in one data segment at 0x1000000, laid out in first
;; appearance order, exactly as cool0c.cool0 lays out its own.
;; ==========================================================================

(module
  (memory (export "memory") 512 512)

  ;; --- raw memory ---------------------------------------------------------

  (func $ld (export "ld") (param $a i32) (result i32)
    (i32.load (local.get $a)))

  (func $st (export "st") (param $a i32) (param $v i32)
    (i32.store (local.get $a) (local.get $v)))

  (func $ldb (export "ldb") (param $a i32) (result i32)
    (i32.load8_u (local.get $a)))

  (func $stb (export "stb") (param $a i32) (param $v i32)
    (i32.store8 (local.get $a) (local.get $v)))

  (func $align4 (export "align4") (param $v i32) (result i32)
    (i32.mul (i32.div_u (i32.add (local.get $v) (i32.const 3)) (i32.const 4))
             (i32.const 4)))

  (func $alloc (export "alloc") (param $bytes i32) (result i32)
    (local $a i32)
    (local.set $a (call $ld (i32.const 36)))
    (call $st (i32.const 36) (i32.add (local.get $a) (call $align4 (local.get $bytes))))
    (local.get $a))

  (func $zero (export "zero") (param $addr i32) (param $bytes i32)
    (local $i i32)
    (local.set $i (i32.const 0))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.lt_u (local.get $i) (local.get $bytes))))
      (block $cnt
        (call $st (i32.add (local.get $addr) (local.get $i)) (i32.const 0)))
      (local.set $i (i32.add (local.get $i) (i32.const 4)))
      (br $cont))))

  ;; --- output buffer ------------------------------------------------------

  (func $out_reset (export "out_reset")
    (call $st (i32.const 40) (i32.const 16842752)))

  (func $put_ch (export "put_ch") (param $c i32)
    (call $stb (call $ld (i32.const 40)) (local.get $c))
    (call $st (i32.const 40) (i32.add (call $ld (i32.const 40)) (i32.const 1))))

  (func $put_str (export "put_str") (param $s i32) (param $s_len i32)
    (local $i i32)
    (local.set $i (i32.const 0))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.lt_u (local.get $i) (local.get $s_len))))
      (block $cnt
        (if (i32.ge_u (local.get $i) (local.get $s_len)) (then (unreachable)))
        (call $put_ch
          (i32.load8_u (i32.add (local.get $s)
                                (i32.mul (local.get $i) (i32.const 1))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $cont))))

  (func $put_src (export "put_src") (param $start i32) (param $len i32)
    (local $i i32)
    (local.set $i (i32.const 0))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.lt_u (local.get $i) (local.get $len))))
      (block $cnt
        (call $put_ch
          (call $ldb (i32.add (i32.add (i32.const 4096) (local.get $start))
                              (local.get $i)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $cont))))

  (func $put_num (export "put_num") (param $v i32)
    (if (i32.ge_u (local.get $v) (i32.const 10))
        (then (call $put_num (i32.div_u (local.get $v) (i32.const 10)))))
    (call $put_ch (i32.add (i32.const 48) (i32.rem_u (local.get $v) (i32.const 10)))))

  ;; --- diagnostics (SPEC.md S12) ------------------------------------------

  (func $failed (export "failed") (result i32)
    (i32.ne (call $ld (i32.const 20)) (i32.const 0)))

  (func $err_open (export "err_open") (param $line i32) (param $col i32) (result i32)
    (if (call $failed) (then (return (i32.const 0))))
    (call $st (i32.const 20) (i32.const 1))
    (call $out_reset)
    (call $put_num (local.get $line))
    (call $put_ch (i32.const 58))
    (call $put_num (local.get $col))
    (call $put_ch (i32.const 58))
    (call $put_ch (i32.const 32))
    (i32.const 1))

  (func $err_end (export "err_end")
    (call $put_ch (i32.const 10)))

  (func $err_msg (export "err_msg") (param $line i32) (param $col i32)
                 (param $s i32) (param $s_len i32)
    (if (call $err_open (local.get $line) (local.get $col))
        (then (call $put_str (local.get $s) (local.get $s_len))
              (call $err_end))))

  ;; --- tokens -------------------------------------------------------------

  (func $tok (export "tok") (param $i i32) (result i32)
    (i32.add (call $ld (i32.const 48)) (i32.mul (local.get $i) (i32.const 32))))

  (func $tk (export "tk") (param $i i32) (param $f i32) (result i32)
    (call $ld (i32.add (call $tok (local.get $i)) (local.get $f))))

  ;; --- lexer (SPEC.md S2) -------------------------------------------------

  (func $is_alpha (export "is_alpha") (param $b i32) (result i32)
    (if (result i32)
        (if (result i32) (i32.ge_u (local.get $b) (i32.const 65))
            (then (i32.le_u (local.get $b) (i32.const 90)))
            (else (i32.const 0)))
        (then (i32.const 1))
        (else (if (result i32) (i32.ge_u (local.get $b) (i32.const 97))
                  (then (i32.le_u (local.get $b) (i32.const 122)))
                  (else (i32.const 0))))))

  (func $is_digit (export "is_digit") (param $b i32) (result i32)
    (if (result i32) (i32.ge_u (local.get $b) (i32.const 48))
        (then (i32.le_u (local.get $b) (i32.const 57)))
        (else (i32.const 0))))

  (func $is_ident_start (export "is_ident_start") (param $b i32) (result i32)
    (if (result i32) (call $is_alpha (local.get $b))
        (then (i32.const 1))
        (else (i32.eq (local.get $b) (i32.const 95)))))

  (func $is_ident_cont (export "is_ident_cont") (param $b i32) (result i32)
    (if (result i32)
        (if (result i32) (call $is_alpha (local.get $b))
            (then (i32.const 1))
            (else (call $is_digit (local.get $b))))
        (then (i32.const 1))
        (else (i32.eq (local.get $b) (i32.const 95)))))

  (func $src_len (export "src_len") (result i32)
    (call $ld (i32.const 16)))

  (func $at (export "at") (param $i i32) (result i32)
    (call $ldb (i32.add (i32.const 4096) (local.get $i))))

  (func $adv (export "adv") (param $k i32)
    (local $t i32)
    (local.set $t (i32.const 0))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.lt_u (local.get $t) (local.get $k))))
      (block $cnt
        (if (i32.eq (call $at (call $ld (i32.const 24))) (i32.const 10))
            (then (call $st (i32.const 28)
                        (i32.add (call $ld (i32.const 28)) (i32.const 1)))
                  (call $st (i32.const 32) (i32.const 1)))
            (else (call $st (i32.const 32)
                        (i32.add (call $ld (i32.const 32)) (i32.const 1)))))
        (call $st (i32.const 24) (i32.add (call $ld (i32.const 24)) (i32.const 1))))
      (local.set $t (i32.add (local.get $t) (i32.const 1)))
      (br $cont))))

  (func $src_eq (export "src_eq") (param $start i32) (param $len i32)
                (param $s i32) (param $s_len i32) (result i32)
    (local $i i32)
    (if (i32.ne (local.get $len) (local.get $s_len)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.lt_u (local.get $i) (local.get $len))))
      (block $cnt
        (if (i32.ge_u (local.get $i) (local.get $s_len)) (then (unreachable)))
        (if (i32.ne (call $at (i32.add (local.get $start) (local.get $i)))
                    (i32.load8_u (i32.add (local.get $s)
                                          (i32.mul (local.get $i) (i32.const 1)))))
            (then (return (i32.const 0)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $cont)))
    (i32.const 1))

  (func $src_has (export "src_has") (param $i i32) (param $s i32) (param $s_len i32)
                 (result i32)
    (local $k i32)
    (if (i32.gt_u (i32.add (local.get $i) (local.get $s_len)) (call $src_len))
        (then (return (i32.const 0))))
    (local.set $k (i32.const 0))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.lt_u (local.get $k) (local.get $s_len))))
      (block $cnt
        (if (i32.ge_u (local.get $k) (local.get $s_len)) (then (unreachable)))
        (if (i32.ne (call $at (i32.add (local.get $i) (local.get $k)))
                    (i32.load8_u (i32.add (local.get $s)
                                          (i32.mul (local.get $k) (i32.const 1)))))
            (then (return (i32.const 0)))))
      (local.set $k (i32.add (local.get $k) (i32.const 1)))
      (br $cont)))
    (i32.const 1))

  (func $kw_id (export "kw_id") (param $start i32) (param $len i32) (result i32)
    (if (call $src_eq (local.get $start) (local.get $len) (i32.const 0x1000000) (i32.const 2))
        (then (return (i32.const 0))))
    (if (call $src_eq (local.get $start) (local.get $len) (i32.const 0x1000002) (i32.const 6))
        (then (return (i32.const 1))))
    (if (call $src_eq (local.get $start) (local.get $len) (i32.const 0x1000008) (i32.const 4))
        (then (return (i32.const 2))))
    (if (call $src_eq (local.get $start) (local.get $len) (i32.const 0x100000C) (i32.const 5))
        (then (return (i32.const 3))))
    (if (call $src_eq (local.get $start) (local.get $len) (i32.const 0x1000011) (i32.const 3))
        (then (return (i32.const 4))))
    (if (call $src_eq (local.get $start) (local.get $len) (i32.const 0x1000014) (i32.const 3))
        (then (return (i32.const 5))))
    (if (call $src_eq (local.get $start) (local.get $len) (i32.const 0x1000017) (i32.const 2))
        (then (return (i32.const 6))))
    (if (call $src_eq (local.get $start) (local.get $len) (i32.const 0x1000019) (i32.const 4))
        (then (return (i32.const 7))))
    (if (call $src_eq (local.get $start) (local.get $len) (i32.const 0x100001D) (i32.const 3))
        (then (return (i32.const 8))))
    (if (call $src_eq (local.get $start) (local.get $len) (i32.const 0x1000020) (i32.const 5))
        (then (return (i32.const 9))))
    (if (call $src_eq (local.get $start) (local.get $len) (i32.const 0x1000025) (i32.const 8))
        (then (return (i32.const 10))))
    (if (call $src_eq (local.get $start) (local.get $len) (i32.const 0x100002D) (i32.const 6))
        (then (return (i32.const 11))))
    (if (call $src_eq (local.get $start) (local.get $len) (i32.const 0x1000033) (i32.const 5))
        (then (return (i32.const 12))))
    (if (call $src_eq (local.get $start) (local.get $len) (i32.const 0x1000038) (i32.const 6))
        (then (return (i32.const 13))))
    (if (call $src_eq (local.get $start) (local.get $len) (i32.const 0x100003E) (i32.const 2))
        (then (return (i32.const 14))))
    (if (call $src_eq (local.get $start) (local.get $len) (i32.const 0x1000040) (i32.const 4))
        (then (return (i32.const 15))))
    (if (call $src_eq (local.get $start) (local.get $len) (i32.const 0x1000044) (i32.const 5))
        (then (return (i32.const 16))))
    (i32.const -1))

  (func $punct_id (export "punct_id") (param $i i32) (result i32)
    (if (call $src_has (local.get $i) (i32.const 0x1000049) (i32.const 3)) (then (return (i32.const 0))))
    (if (call $src_has (local.get $i) (i32.const 0x100004C) (i32.const 3)) (then (return (i32.const 1))))
    (if (call $src_has (local.get $i) (i32.const 0x100004F) (i32.const 2)) (then (return (i32.const 2))))
    (if (call $src_has (local.get $i) (i32.const 0x1000051) (i32.const 2)) (then (return (i32.const 3))))
    (if (call $src_has (local.get $i) (i32.const 0x1000053) (i32.const 2)) (then (return (i32.const 4))))
    (if (call $src_has (local.get $i) (i32.const 0x1000055) (i32.const 2)) (then (return (i32.const 5))))
    (if (call $src_has (local.get $i) (i32.const 0x1000057) (i32.const 2)) (then (return (i32.const 6))))
    (if (call $src_has (local.get $i) (i32.const 0x1000059) (i32.const 2)) (then (return (i32.const 7))))
    (if (call $src_has (local.get $i) (i32.const 0x100005B) (i32.const 2)) (then (return (i32.const 8))))
    (if (call $src_has (local.get $i) (i32.const 0x100005D) (i32.const 2)) (then (return (i32.const 9))))
    (if (call $src_has (local.get $i) (i32.const 0x100005F) (i32.const 2)) (then (return (i32.const 10))))
    (if (call $src_has (local.get $i) (i32.const 0x1000061) (i32.const 2)) (then (return (i32.const 11))))
    (if (call $src_has (local.get $i) (i32.const 0x1000063) (i32.const 2)) (then (return (i32.const 12))))
    (if (call $src_has (local.get $i) (i32.const 0x1000065) (i32.const 2)) (then (return (i32.const 13))))
    (if (call $src_has (local.get $i) (i32.const 0x1000067) (i32.const 2)) (then (return (i32.const 14))))
    (if (call $src_has (local.get $i) (i32.const 0x1000069) (i32.const 2)) (then (return (i32.const 15))))
    (if (call $src_has (local.get $i) (i32.const 0x100006B) (i32.const 2)) (then (return (i32.const 16))))
    (if (call $src_has (local.get $i) (i32.const 0x100006D) (i32.const 2)) (then (return (i32.const 17))))
    (if (call $src_has (local.get $i) (i32.const 0x100006F) (i32.const 2)) (then (return (i32.const 18))))
    (if (call $src_has (local.get $i) (i32.const 0x1000071) (i32.const 2)) (then (return (i32.const 19))))
    (if (call $src_has (local.get $i) (i32.const 0x1000073) (i32.const 1)) (then (return (i32.const 20))))
    (if (call $src_has (local.get $i) (i32.const 0x1000074) (i32.const 1)) (then (return (i32.const 21))))
    (if (call $src_has (local.get $i) (i32.const 0x1000075) (i32.const 1)) (then (return (i32.const 22))))
    (if (call $src_has (local.get $i) (i32.const 0x1000076) (i32.const 1)) (then (return (i32.const 23))))
    (if (call $src_has (local.get $i) (i32.const 0x1000077) (i32.const 1)) (then (return (i32.const 24))))
    (if (call $src_has (local.get $i) (i32.const 0x1000078) (i32.const 1)) (then (return (i32.const 25))))
    (if (call $src_has (local.get $i) (i32.const 0x1000079) (i32.const 1)) (then (return (i32.const 26))))
    (if (call $src_has (local.get $i) (i32.const 0x100007A) (i32.const 1)) (then (return (i32.const 27))))
    (if (call $src_has (local.get $i) (i32.const 0x100007B) (i32.const 1)) (then (return (i32.const 28))))
    (if (call $src_has (local.get $i) (i32.const 0x100007C) (i32.const 1)) (then (return (i32.const 29))))
    (if (call $src_has (local.get $i) (i32.const 0x100007D) (i32.const 1)) (then (return (i32.const 30))))
    (if (call $src_has (local.get $i) (i32.const 0x100007E) (i32.const 1)) (then (return (i32.const 31))))
    (if (call $src_has (local.get $i) (i32.const 0x100007F) (i32.const 1)) (then (return (i32.const 32))))
    (if (call $src_has (local.get $i) (i32.const 0x1000080) (i32.const 1)) (then (return (i32.const 33))))
    (if (call $src_has (local.get $i) (i32.const 0x1000081) (i32.const 1)) (then (return (i32.const 34))))
    (if (call $src_has (local.get $i) (i32.const 0x1000082) (i32.const 1)) (then (return (i32.const 35))))
    (if (call $src_has (local.get $i) (i32.const 0x1000083) (i32.const 1)) (then (return (i32.const 36))))
    (if (call $src_has (local.get $i) (i32.const 0x1000084) (i32.const 1)) (then (return (i32.const 37))))
    (if (call $src_has (local.get $i) (i32.const 0x1000085) (i32.const 1)) (then (return (i32.const 38))))
    (if (call $src_has (local.get $i) (i32.const 0x1000086) (i32.const 1)) (then (return (i32.const 39))))
    (if (call $src_has (local.get $i) (i32.const 0x1000087) (i32.const 1)) (then (return (i32.const 40))))
    (if (call $src_has (local.get $i) (i32.const 0x1000088) (i32.const 1)) (then (return (i32.const 41))))
    (i32.const -1))

  (func $punct_len (export "punct_len") (param $id i32) (result i32)
    (if (i32.le_u (local.get $id) (i32.const 1)) (then (return (i32.const 3))))
    (if (i32.le_u (local.get $id) (i32.const 19)) (then (return (i32.const 2))))
    (i32.const 1))

  (func $push_tok (export "push_tok") (param $kind i32) (param $start i32)
                  (param $len i32) (param $value i32) (param $line i32)
                  (param $col i32) (param $aux i32)
    (local $t i32)
    (local.set $t (call $tok (call $ld (i32.const 44))))
    (call $st (i32.add (local.get $t) (i32.const 0)) (local.get $kind))
    (call $st (i32.add (local.get $t) (i32.const 4)) (local.get $start))
    (call $st (i32.add (local.get $t) (i32.const 8)) (local.get $len))
    (call $st (i32.add (local.get $t) (i32.const 12)) (local.get $value))
    (call $st (i32.add (local.get $t) (i32.const 16)) (local.get $line))
    (call $st (i32.add (local.get $t) (i32.const 20)) (local.get $col))
    (call $st (i32.add (local.get $t) (i32.const 24)) (local.get $aux))
    (call $st (i32.const 44) (i32.add (call $ld (i32.const 44)) (i32.const 1))))

  (func $escape_of (export "escape_of") (param $e i32) (param $in_string i32)
                   (result i32)
    (if (i32.eq (local.get $e) (i32.const 110)) (then (return (i32.const 10))))
    (if (i32.eq (local.get $e) (i32.const 116)) (then (return (i32.const 9))))
    (if (i32.eq (local.get $e) (i32.const 114)) (then (return (i32.const 13))))
    (if (i32.eq (local.get $e) (i32.const 48)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $e) (i32.const 92)) (then (return (i32.const 92))))
    (if (i32.eq (local.get $e) (i32.const 39)) (then (return (i32.const 39))))
    (if (if (result i32) (local.get $in_string)
            (then (i32.eq (local.get $e) (i32.const 34)))
            (else (i32.const 0)))
        (then (return (i32.const 34))))
    (i32.const -1))

  (func $lex_ident (export "lex_ident")
    (local $sl i32) (local $sc i32) (local $i i32) (local $j i32) (local $id i32)
    (local.set $sl (call $ld (i32.const 28)))
    (local.set $sc (call $ld (i32.const 32)))
    (local.set $i (call $ld (i32.const 24)))
    (local.set $j (local.get $i))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (if (result i32) (i32.lt_u (local.get $j) (call $src_len))
                               (then (call $is_ident_cont (call $at (local.get $j))))
                               (else (i32.const 0)))))
      (block $cnt
        (local.set $j (i32.add (local.get $j) (i32.const 1))))
      (br $cont)))
    (local.set $id (call $kw_id (local.get $i) (i32.sub (local.get $j) (local.get $i))))
    (call $adv (i32.sub (local.get $j) (local.get $i)))
    (if (i32.eq (local.get $id) (i32.const -1))
        (then (call $push_tok (i32.const 1) (local.get $i)
                    (i32.sub (local.get $j) (local.get $i)) (i32.const 0)
                    (local.get $sl) (local.get $sc) (i32.const 0)))
