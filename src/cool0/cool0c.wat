  (func $check_match (param $c i32) (param $s i32)
    (local $scr i32) (local $ty i32) (local $line i32) (local $col i32) (local $ei i32)
    (local $head i32) (local $wild i32) (local $seen i32) (local $a i32)
    (local $al i32) (local $ac i32) (local $ans i32) (local $anl i32) (local $v i32)
    (local $binds i32) (local $nb i32) (local $nargs i32) (local $b i32) (local $f i32)
    (local $loc i32) (local $ad i32) (local $vs i32) (local $vl i32)
    (local.set $scr (call $nd (local.get $c) (local.get $s) (i32.const 12)))
    (local.set $ty (call $check_place (local.get $c) (local.get $scr)))
    (if (call $failed (local.get $c)) (then (return)))
    (local.set $line (call $nd (local.get $c) (local.get $s) (i32.const 4)))
    (local.set $col (call $nd (local.get $c) (local.get $s) (i32.const 8)))
    (if (i32.ne (call $ty_kind (local.get $c) (local.get $ty)) (i32.const 9))
        (then (call $e_match_needs_enum (local.get $c) (local.get $line) (local.get $col)
                                        (local.get $ty))
              (return)))
    (local.set $ei (call $agg_enum (local.get $c) (local.get $ty)))
    (if (i32.eq (local.get $ei) (i32.const 0))
        (then (call $e_match_needs_enum (local.get $c) (local.get $line) (local.get $col)
                                        (local.get $ty))
              (return)))
    (call $nset (local.get $c) (local.get $s) (i32.const 20) (local.get $ei))
    (local.set $head (call $nd (local.get $c) (local.get $s) (i32.const 16)))
    (local.set $wild (i32.const 0))
    (local.set $seen (i32.const 0))
    (local.set $a (local.get $head))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz
        (if (result i32) (i32.ne (local.get $a) (i32.const 0))
            (then (i32.eqz (call $failed (local.get $c))))
            (else (i32.const 0)))))
      (block $cnt
        (local.set $al (call $nd (local.get $c) (local.get $a) (i32.const 4)))
        (local.set $ac (call $nd (local.get $c) (local.get $a) (i32.const 8)))
        (local.set $ans (call $nd (local.get $c) (local.get $a) (i32.const 12)))
        (local.set $anl (call $nd (local.get $c) (local.get $a) (i32.const 16)))
        (if (i32.ne (call $nd (local.get $c) (local.get $a) (i32.const 28)) (i32.const 0))
            (then
              (if (i32.ne (call $nd (local.get $c) (local.get $a) (i32.const 32))
                          (i32.const 0))
                  (then (if (call $err_open (local.get $c) (local.get $al)
                                            (local.get $ac))
                            (then (call $put_ch (local.get $c) (i32.const 96))
                                  (call $put_str (local.get $c) (i32.const 0x10002EA)
                                                 (i32.const 1))
                                  (call $put_ch (local.get $c) (i32.const 96))
                                  (call $put_str (local.get $c) (i32.const 0x100079D)
                                                 (i32.const 21))
                                  (call $err_end (local.get $c))))
                        (return)))
              (local.set $wild (i32.const 1))
              (call $push_scope (local.get $c))
              (call $check_block (local.get $c)
                    (call $nd (local.get $c) (local.get $a) (i32.const 24)))
              (call $pop_scope (local.get $c))
              (local.set $a (call $nd (local.get $c) (local.get $a) (i32.const 32)))
              (br $cnt)))
        (local.set $v (call $find_variant (local.get $c) (local.get $ei) (local.get $ans)
                                          (local.get $anl)))
        (if (i32.eq (local.get $v) (i32.const 0))
            (then (call $e_no_variant (local.get $c) (local.get $al) (local.get $ac)
                        (call $rg (local.get $c) (i32.const 108) (local.get $ei)
                                  (i32.const 28) (i32.const 0))
                        (call $rg (local.get $c) (i32.const 108) (local.get $ei)
                                  (i32.const 28) (i32.const 4))
                        (local.get $ans) (local.get $anl))
                  (return)))
        (if (i32.ne (call $arm_for_variant (local.get $c) (local.get $head)
                          (local.get $ans) (local.get $anl))
                    (local.get $a))
            (then (call $e_dup_arm (local.get $c) (local.get $al) (local.get $ac)
                                   (local.get $ans) (local.get $anl))
                  (return)))
        (call $nset (local.get $c) (local.get $a) (i32.const 40) (local.get $v))
        (local.set $binds (call $nd (local.get $c) (local.get $a) (i32.const 20)))
        (local.set $nb (call $list_len (local.get $c) (local.get $binds)))
        (local.set $nargs (call $rg (local.get $c) (i32.const 96) (local.get $v)
                                    (i32.const 24) (i32.const 16)))
        (if (i32.ne (local.get $nb) (local.get $nargs))
            (then (call $e_bind_arity (local.get $c) (local.get $al) (local.get $ac)
                                      (local.get $ans) (local.get $anl)
                                      (local.get $nargs) (local.get $nb))
                  (return)))
        (call $push_scope (local.get $c))
        (local.set $b (local.get $binds))
        (local.set $f (call $rg (local.get $c) (i32.const 96) (local.get $v)
                                (i32.const 24) (i32.const 12)))
        (block $bbrk (loop $bcont
          (br_if $bbrk (i32.eqz
            (if (result i32) (i32.ne (local.get $b) (i32.const 0))
                (then (i32.eqz (call $failed (local.get $c))))
                (else (i32.const 0)))))
          (block $bcnt
            (local.set $loc (call $declare_local (local.get $c)
                                  (call $nd (local.get $c) (local.get $b) (i32.const 12))
                                  (call $nd (local.get $c) (local.get $b) (i32.const 16))
                                  (call $read_ty (local.get $c)
                                        (call $rg (local.get $c) (i32.const 72)
                                                  (local.get $f) (i32.const 20)
                                                  (i32.const 8)))
                                  (i32.const 0) (i32.const 0)
                                  (call $nd (local.get $c) (local.get $b) (i32.const 4))
                                  (call $nd (local.get $c) (local.get $b) (i32.const 8))))
            (call $nset (local.get $c) (local.get $b) (i32.const 40) (local.get $loc))
            (local.set $b (call $nd (local.get $c) (local.get $b) (i32.const 32)))
            (local.set $f (call $rg (local.get $c) (i32.const 72) (local.get $f)
                                    (i32.const 20) (i32.const 16))))
          (br $bcont)))
        (local.set $ad (call $nd (local.get $c) (local.get $a) (i32.const 24)))
        (call $check_block (local.get $c) (local.get $ad))
        (call $pop_scope (local.get $c))
        (local.set $seen (i32.add (local.get $seen) (i32.const 1)))
        (local.set $a (call $nd (local.get $c) (local.get $a) (i32.const 32))))
      (br $cont)))
    (if (call $failed (local.get $c)) (then (return)))
    (if (if (result i32) (i32.eq (local.get $wild) (i32.const 0))
            (then (i32.ne (local.get $seen)
                          (call $rg (local.get $c) (i32.const 108) (local.get $ei)
                                    (i32.const 28) (i32.const 20))))
            (else (i32.const 0)))
        (then
          (local.set $v (call $rg (local.get $c) (i32.const 108) (local.get $ei)
                                  (i32.const 28) (i32.const 8)))
          (block $vbrk (loop $vcont
            (br_if $vbrk (i32.eqz (i32.ne (local.get $v) (i32.const 0))))
            (block $vcnt
              (local.set $vs (call $rg (local.get $c) (i32.const 96) (local.get $v)
                                       (i32.const 24) (i32.const 0)))
              (local.set $vl (call $rg (local.get $c) (i32.const 96) (local.get $v)
                                       (i32.const 24) (i32.const 4)))
              (if (i32.eq (call $arm_for_variant (local.get $c) (local.get $head)
                                (local.get $vs) (local.get $vl))
                          (i32.const 0))
                  (then (call $e_nonexhaustive (local.get $c) (local.get $line)
                                               (local.get $col) (local.get $vs)
                                               (local.get $vl))
                        (return)))
              (local.set $v (call $rg (local.get $c) (i32.const 96) (local.get $v)
                                      (i32.const 24) (i32.const 20))))
            (br $vcont)))))
    (call $nset (local.get $c) (local.get $s) (i32.const 24) (local.get $wild)))

  ;; ======================================================================
  ;; Initializers
  ;; ======================================================================

  (func $is_enum_lit (param $c i32) (param $e i32) (result i32)
    (local $b i32) (local $base i32)
    (local.set $b (local.get $e))
    (if (i32.eq (call $nd (local.get $c) (local.get $e) (i32.const 0)) (i32.const 10))
        (then (local.set $b (call $nd (local.get $c) (local.get $e) (i32.const 12)))))
    (if (i32.ne (call $nd (local.get $c) (local.get $b) (i32.const 0)) (i32.const 12))
        (then (return (i32.const 0))))
    (local.set $base (call $nd (local.get $c) (local.get $b) (i32.const 12)))
    (if (i32.ne (call $nd (local.get $c) (local.get $base) (i32.const 0)) (i32.const 5))
        (then (return (i32.const 0))))
    (i32.ne (call $find_enum (local.get $c)
                  (call $nd (local.get $c) (local.get $base) (i32.const 12))
                  (call $nd (local.get $c) (local.get $base) (i32.const 16)))
            (i32.const 0)))

  (func $e_copy_agg (param $c i32) (param $line i32) (param $col i32) (param $t i32)
    (if (call $err_open (local.get $c) (local.get $line) (local.get $col))
        (then (call $put_str (local.get $c) (i32.const 0x10007B2) (i32.const 22))
              (call $put_q_ty (local.get $c) (local.get $t))
              (call $err_end (local.get $c)))))

  (func $check_init (param $c i32) (param $e i32) (param $want i32) (result i32)
    (local $t i32) (local $line i32) (local $col i32)
    (if (call $failed (local.get $c)) (then (return (i32.const 1))))
    (if (i32.eq (call $nd (local.get $c) (local.get $e) (i32.const 0)) (i32.const 14))
        (then (return (call $check_struct_lit (local.get $c) (local.get $e)
                            (local.get $want)))))
    (if (call $is_enum_lit (local.get $c) (local.get $e))
        (then (return (call $check_enum_lit (local.get $c) (local.get $e)
                            (local.get $want)))))
    (if (if (result i32) (i32.ne (local.get $want) (i32.const 0))
            (then (i32.eqz (call $is_aggregate (local.get $c) (local.get $want))))
            (else (i32.const 0)))
        (then (return (call $coerce (local.get $c) (local.get $e) (local.get $want)))))
    (local.set $t (call $check_expr (local.get $c) (local.get $e) (local.get $want)))
    (if (call $failed (local.get $c)) (then (return (i32.const 1))))
    (local.set $line (call $nd (local.get $c) (local.get $e) (i32.const 4)))
    (local.set $col (call $nd (local.get $c) (local.get $e) (i32.const 8)))
    (if (call $is_aggregate (local.get $c) (local.get $t))
        (then (call $e_copy_agg (local.get $c) (local.get $line) (local.get $col)
                                (local.get $t))
              (return (i32.const 1))))
    (if (if (result i32) (i32.ne (local.get $want) (i32.const 0))
            (then (i32.ne (local.get $t) (local.get $want)))
            (else (i32.const 0)))
        (then (call $e_expected_ty (local.get $c) (local.get $line) (local.get $col)
                                   (local.get $want) (local.get $t))
              (return (i32.const 1))))
    (local.get $t))

  (func $e_unknown_struct (param $c i32) (param $line i32) (param $col i32)
        (param $s i32) (param $l i32)
    (if (call $err_open (local.get $c) (local.get $line) (local.get $col))
        (then (call $put_str (local.get $c) (i32.const 0x10007C8) (i32.const 15))
              (call $put_q_src (local.get $c) (local.get $s) (local.get $l))
              (call $err_end (local.get $c)))))

  (func $e_field_count (param $c i32) (param $line i32) (param $col i32)
        (param $s i32) (param $l i32) (param $n i32)
    (if (call $err_open (local.get $c) (local.get $line) (local.get $col))
        (then (call $put_q_src (local.get $c) (local.get $s) (local.get $l))
              (call $put_str (local.get $c) (i32.const 0x10007D7) (i32.const 5))
              (call $put_num (local.get $c) (local.get $n))
              (call $put_str (local.get $c) (i32.const 0x10007DC) (i32.const 9))
              (call $err_end (local.get $c)))))

  (func $e_field_order (param $c i32) (param $line i32) (param $col i32)
        (param $ws i32) (param $wl i32) (param $gs i32) (param $gl i32)
    (if (call $err_open (local.get $c) (local.get $line) (local.get $col))
        (then (call $put_str (local.get $c) (i32.const 0x10007E5) (i32.const 15))
              (call $put_q_src (local.get $c) (local.get $ws) (local.get $wl))
              (call $put_str (local.get $c) (i32.const 0x1000214) (i32.const 8))
              (call $put_q_src (local.get $c) (local.get $gs) (local.get $gl))
              (call $err_end (local.get $c)))))

  (func $fi_count (param $c i32) (param $head i32) (result i32)
    (local $n i32) (local $p i32)
    (local.set $n (i32.const 0))
    (local.set $p (local.get $head))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.ne (local.get $p) (i32.const 0))))
      (block $cnt
        (local.set $n (i32.add (local.get $n) (i32.const 1)))
        (local.set $p (call $rg (local.get $c) (i32.const 72) (local.get $p)
                                (i32.const 20) (i32.const 16))))
      (br $cont)))
    (local.get $n))

  (func $check_struct_lit (param $c i32) (param $e i32) (param $want i32) (result i32)
    (local $line i32) (local $col i32) (local $ns i32) (local $nl i32) (local $si i32)
    (local $self_ty i32) (local $fhead i32) (local $nf i32) (local $lits i32)
    (local $lf i32) (local $f i32) (local $ls i32) (local $ll i32)
    (local $fs i32) (local $fl i32) (local $ft i32) (local $v i32)
    (local.set $line (call $nd (local.get $c) (local.get $e) (i32.const 4)))
    (local.set $col (call $nd (local.get $c) (local.get $e) (i32.const 8)))
    (local.set $ns (call $nd (local.get $c) (local.get $e) (i32.const 12)))
    (local.set $nl (call $nd (local.get $c) (local.get $e) (i32.const 16)))
    (local.set $si (call $find_struct (local.get $c) (local.get $ns) (local.get $nl)))
    (if (i32.eq (local.get $si) (i32.const 0))
        (then (call $e_unknown_struct (local.get $c) (local.get $line) (local.get $col)
                                      (local.get $ns) (local.get $nl))
              (return (i32.const 1))))
    (local.set $self_ty (call $ty_named (local.get $c) (local.get $ns) (local.get $nl)))
    (if (if (result i32) (i32.ne (local.get $want) (i32.const 0))
            (then (i32.ne (local.get $want) (local.get $self_ty)))
            (else (i32.const 0)))
        (then (if (call $err_open (local.get $c) (local.get $line) (local.get $col))
                  (then (call $put_str (local.get $c) (i32.const 0x100020B) (i32.const 9))
                        (call $put_q_ty (local.get $c) (local.get $want))
                        (call $put_str (local.get $c) (i32.const 0x1000214) (i32.const 8))
                        (call $put_q_src (local.get $c) (local.get $ns) (local.get $nl))
                        (call $err_end (local.get $c))))
              (return (i32.const 1))))
    (local.set $fhead (call $rg (local.get $c) (i32.const 84) (local.get $si)
                                (i32.const 24) (i32.const 8)))
    (local.set $nf (call $fi_count (local.get $c) (local.get $fhead)))
    (local.set $lits (call $nd (local.get $c) (local.get $e) (i32.const 20)))
    (if (i32.ne (call $list_len (local.get $c) (local.get $lits)) (local.get $nf))
        (then (call $e_field_count (local.get $c) (local.get $line) (local.get $col)
                                   (local.get $ns) (local.get $nl) (local.get $nf))
              (return (i32.const 1))))
    (local.set $lf (local.get $lits))
    (local.set $f (local.get $fhead))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz
        (if (result i32) (i32.ne (local.get $lf) (i32.const 0))
            (then (i32.eqz (call $failed (local.get $c))))
            (else (i32.const 0)))))
      (block $cnt
        (local.set $ls (call $nd (local.get $c) (local.get $lf) (i32.const 12)))
        (local.set $ll (call $nd (local.get $c) (local.get $lf) (i32.const 16)))
        (local.set $fs (call $rg (local.get $c) (i32.const 72) (local.get $f)
                                 (i32.const 20) (i32.const 0)))
        (local.set $fl (call $rg (local.get $c) (i32.const 72) (local.get $f)
                                 (i32.const 20) (i32.const 4)))
        (if (i32.eqz (call $src_eq2 (local.get $c) (local.get $ls) (local.get $ll)
                                    (local.get $fs) (local.get $fl)))
            (then (call $e_field_order (local.get $c)
                        (call $nd (local.get $c) (local.get $lf) (i32.const 4))
                        (call $nd (local.get $c) (local.get $lf) (i32.const 8))
                        (local.get $fs) (local.get $fl) (local.get $ls) (local.get $ll))
                  (return (i32.const 1))))
        (local.set $ft (call $rg (local.get $c) (i32.const 72) (local.get $f)
                                 (i32.const 20) (i32.const 8)))
        (local.set $v (call $nd (local.get $c) (local.get $lf) (i32.const 20)))
        (drop (call $coerce (local.get $c) (local.get $v)
                    (call $read_ty (local.get $c) (local.get $ft))))
        (local.set $lf (call $nd (local.get $c) (local.get $lf) (i32.const 32)))
        (local.set $f (call $rg (local.get $c) (i32.const 72) (local.get $f)
                                (i32.const 20) (i32.const 16))))
      (br $cont)))
    (call $nset (local.get $c) (local.get $e) (i32.const 24) (local.get $si))
    (call $nset (local.get $c) (local.get $e) (i32.const 36) (local.get $self_ty))
    (local.get $self_ty))

  (func $e_variant_arity (param $c i32) (param $line i32) (param $col i32)
