        (then (return (i32.eq (local.get $p) (i32.const 38)))))
    (if (i32.eq (local.get $level) (i32.const 6))
        (then (return (if (result i32) (i32.eq (local.get $p) (i32.const 10))
                          (then (i32.const 1))
                          (else (i32.eq (local.get $p) (i32.const 11)))))))
    (if (i32.eq (local.get $level) (i32.const 7))
