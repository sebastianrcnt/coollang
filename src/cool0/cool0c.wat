        (then (call $put_str (local.get $c) (i32.const 0x100075D) (i32.const 8))
              (call $put_q_src (local.get $c) (local.get $s) (local.get $l))
              (call $put_str (local.get $c) (i32.const 0x1000765) (i32.const 7))
              (call $put_num (local.get $c) (local.get $n))
              (call $put_str (local.get $c) (i32.const 0x10007F4) (i32.const 9))
              (call $err_end (local.get $c)))))

  (func $check_enum_lit (param $c i32) (param $e i32) (param $want i32) (result i32)
    (local $line i32) (local $col i32) (local $fld i32) (local $args i32)
    (local $base i32) (local $bs i32) (local $bl i32) (local $ei i32)
    (local $vs i32) (local $vl i32) (local $v i32) (local $ens i32) (local $enl i32)
    (local $nargs i32) (local $self_ty i32) (local $a i32) (local $f i32) (local $ft i32)
    (local.set $line (call $nd (local.get $c) (local.get $e) (i32.const 4)))
    (local.set $col (call $nd (local.get $c) (local.get $e) (i32.const 8)))
    (local.set $fld (local.get $e))
    (local.set $args (i32.const 0))
    (if (i32.eq (call $nd (local.get $c) (local.get $e) (i32.const 0)) (i32.const 10))
        (then (local.set $fld (call $nd (local.get $c) (local.get $e) (i32.const 12)))
              (local.set $args (call $nd (local.get $c) (local.get $e) (i32.const 16)))))
    (local.set $base (call $nd (local.get $c) (local.get $fld) (i32.const 12)))
    (local.set $bs (call $nd (local.get $c) (local.get $base) (i32.const 12)))
    (local.set $bl (call $nd (local.get $c) (local.get $base) (i32.const 16)))
    (local.set $ei (call $find_enum (local.get $c) (local.get $bs) (local.get $bl)))
    (local.set $vs (call $nd (local.get $c) (local.get $fld) (i32.const 16)))
    (local.set $vl (call $nd (local.get $c) (local.get $fld) (i32.const 20)))
    (local.set $v (call $find_variant (local.get $c) (local.get $ei) (local.get $vs)
                                      (local.get $vl)))
    (local.set $ens (call $rg (local.get $c) (i32.const 108) (local.get $ei)
                              (i32.const 28) (i32.const 0)))
    (local.set $enl (call $rg (local.get $c) (i32.const 108) (local.get $ei)
                              (i32.const 28) (i32.const 4)))
    (if (i32.eq (local.get $v) (i32.const 0))
        (then (call $e_no_variant (local.get $c)
                    (call $nd (local.get $c) (local.get $fld) (i32.const 4))
                    (call $nd (local.get $c) (local.get $fld) (i32.const 8))
                    (local.get $ens) (local.get $enl) (local.get $vs) (local.get $vl))
              (return (i32.const 1))))
    (local.set $nargs (call $rg (local.get $c) (i32.const 96) (local.get $v)
                                (i32.const 24) (i32.const 16)))
    (if (i32.ne (call $list_len (local.get $c) (local.get $args)) (local.get $nargs))
        (then (call $e_variant_arity (local.get $c) (local.get $line) (local.get $col)
                    (call $rg (local.get $c) (i32.const 96) (local.get $v) (i32.const 24)
                              (i32.const 0))
                    (call $rg (local.get $c) (i32.const 96) (local.get $v) (i32.const 24)
                              (i32.const 4))
                    (local.get $nargs))
              (return (i32.const 1))))
    (local.set $self_ty (call $ty_named (local.get $c) (local.get $ens) (local.get $enl)))
    (if (if (result i32) (i32.ne (local.get $want) (i32.const 0))
            (then (i32.ne (local.get $want) (local.get $self_ty)))
            (else (i32.const 0)))
        (then (if (call $err_open (local.get $c) (local.get $line) (local.get $col))
                  (then (call $put_str (local.get $c) (i32.const 0x100020B) (i32.const 9))
                        (call $put_q_ty (local.get $c) (local.get $want))
                        (call $put_str (local.get $c) (i32.const 0x1000214) (i32.const 8))
                        (call $put_q_src (local.get $c) (local.get $ens) (local.get $enl))
                        (call $err_end (local.get $c))))
              (return (i32.const 1))))
    (local.set $a (local.get $args))
    (local.set $f (call $rg (local.get $c) (i32.const 96) (local.get $v) (i32.const 24)
                            (i32.const 12)))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz
        (if (result i32) (i32.ne (local.get $a) (i32.const 0))
            (then (i32.eqz (call $failed (local.get $c))))
            (else (i32.const 0)))))
      (block $cnt
        (local.set $ft (call $rg (local.get $c) (i32.const 72) (local.get $f)
                                 (i32.const 20) (i32.const 8)))
        (drop (call $coerce (local.get $c) (local.get $a)
                    (call $read_ty (local.get $c) (local.get $ft))))
        (local.set $a (call $nd (local.get $c) (local.get $a) (i32.const 32)))
        (local.set $f (call $rg (local.get $c) (i32.const 72) (local.get $f)
                                (i32.const 20) (i32.const 16))))
      (br $cont)))
    (call $nset (local.get $c) (local.get $e) (i32.const 40) (local.get $v))
    (call $nset (local.get $c) (local.get $e) (i32.const 44) (i32.const 1))
    (call $nset (local.get $c) (local.get $e) (i32.const 36) (local.get $self_ty))
    (local.get $self_ty))

  ;; --- integer literals that have not settled (language.md S2) ------------

  (func $retype (param $c i32) (param $e i32) (param $t i32)
    (local $k i32) (local $op i32)
    (if (i32.ne (call $ty_kind (local.get $c)
                      (call $nd (local.get $c) (local.get $e) (i32.const 36)))
                (i32.const 5))
        (then (return)))
    (call $nset (local.get $c) (local.get $e) (i32.const 36) (local.get $t))
    (local.set $k (call $nd (local.get $c) (local.get $e) (i32.const 0)))
    (if (i32.eq (local.get $k) (i32.const 6))
        (then (call $retype (local.get $c)
                    (call $nd (local.get $c) (local.get $e) (i32.const 16))
                    (local.get $t))
              (return)))
    (if (i32.eq (local.get $k) (i32.const 7))
        (then (call $retype (local.get $c)
                    (call $nd (local.get $c) (local.get $e) (i32.const 16))
                    (local.get $t))
              (local.set $op (call $nd (local.get $c) (local.get $e) (i32.const 12)))
              (if (if (result i32) (i32.ne (local.get $op) (i32.const 10))
                      (then (i32.ne (local.get $op) (i32.const 11)))
                      (else (i32.const 0)))
                  (then (call $retype (local.get $c)
                              (call $nd (local.get $c) (local.get $e) (i32.const 20))
                              (local.get $t)))))))

  ;; `&mut T` in a `&T` position, and `[]mut T` in a `[]T` position, drop the
  ;; write permission and nothing else (language.md S3).
  (func $weakens_to (param $c i32) (param $got i32) (param $want i32) (result i32)
    (local $gk i32)
    (local.set $gk (call $ty_kind (local.get $c) (local.get $got)))
    (if (i32.ne (local.get $gk) (call $ty_kind (local.get $c) (local.get $want)))
        (then (return (i32.const 0))))
    (if (if (result i32) (i32.ne (local.get $gk) (i32.const 7))
            (then (i32.ne (local.get $gk) (i32.const 6)))
            (else (i32.const 0)))
        (then (return (i32.const 0))))
    (if (i32.eq (call $ty_flag (local.get $c) (local.get $got)) (i32.const 0))
        (then (return (i32.const 0))))
    (if (i32.ne (call $ty_flag (local.get $c) (local.get $want)) (i32.const 0))
        (then (return (i32.const 0))))
    (i32.eq (call $ty_arg (local.get $c) (local.get $got))
            (call $ty_arg (local.get $c) (local.get $want))))

  (func $coerce (param $c i32) (param $e i32) (param $want i32) (result i32)
    (local $got i32)
    (local.set $got (call $check_expr (local.get $c) (local.get $e) (local.get $want)))
    (if (call $failed (local.get $c)) (then (return (local.get $want))))
    (if (if (result i32) (i32.eq (call $ty_kind (local.get $c) (local.get $got))
                                 (i32.const 5))
            (then (if (result i32) (call $is_int_ty (local.get $c) (local.get $want))
                      (then (i32.ne (call $ty_kind (local.get $c) (local.get $want))
                                    (i32.const 5)))
                      (else (i32.const 0))))
            (else (i32.const 0)))
        (then (call $retype (local.get $c) (local.get $e) (local.get $want))
              (return (local.get $want))))
    (if (call $weakens_to (local.get $c) (local.get $got) (local.get $want))
        (then (return (local.get $want))))
    (if (i32.ne (local.get $got) (local.get $want))
        (then (call $e_expected_ty (local.get $c)
                    (call $nd (local.get $c) (local.get $e) (i32.const 4))
                    (call $nd (local.get $c) (local.get $e) (i32.const 8))
                    (local.get $want) (local.get $got))
              (return (local.get $want))))
    (local.get $want))

  ;; ======================================================================
  ;; Expressions (language.md S5)
  ;; ======================================================================

  (func $int_want (param $c i32) (param $want i32) (result i32)
    (local $k i32)
    (if (i32.eq (local.get $want) (i32.const 0)) (then (return (i32.const 0))))
    (local.set $k (call $ty_kind (local.get $c) (local.get $want)))
    (if (i32.eq (local.get $k) (i32.const 0)) (then (return (local.get $want))))
    (if (i32.eq (local.get $k) (i32.const 1)) (then (return (local.get $want))))
    (i32.const 0))

  (func $e_unknown_name (param $c i32) (param $line i32) (param $col i32)
        (param $s i32) (param $l i32)
    (if (call $err_open (local.get $c) (local.get $line) (local.get $col))
        (then (call $put_str (local.get $c) (i32.const 0x10007FD) (i32.const 13))
              (call $put_q_src (local.get $c) (local.get $s) (local.get $l))
              (call $err_end (local.get $c)))))

  (func $e_type_mismatch2 (param $c i32) (param $line i32) (param $col i32)
        (param $op i32) (param $lt i32) (param $rt i32)
    (if (call $err_open (local.get $c) (local.get $line) (local.get $col))
        (then (call $put_q_punct (local.get $c) (local.get $op))
              (call $put_str (local.get $c) (i32.const 0x100080A) (i32.const 2))
              (call $put_q_ty (local.get $c) (local.get $lt))
              (call $put_str (local.get $c) (i32.const 0x100080C) (i32.const 5))
              (call $put_q_ty (local.get $c) (local.get $rt))
              (call $put_str (local.get $c) (i32.const 0x1000811) (i32.const 13))
              (call $err_end (local.get $c)))))

  (func $check_binop_types (param $c i32) (param $line i32) (param $col i32)
        (param $op i32) (param $lt i32) (param $rt i32)
    (local $k i32)
    (if (call $failed (local.get $c)) (then (return)))
    (if (if (result i32) (i32.eq (local.get $op) (i32.const 10))
            (then (i32.const 1))
            (else (i32.eq (local.get $op) (i32.const 11))))
        (then
          (if (i32.eqz (call $is_int_ty (local.get $c) (local.get $lt)))
              (then (call $e_op_needs_int (local.get $c) (local.get $line)
                          (local.get $col) (local.get $op) (local.get $lt))
                    (return)))
          (if (i32.ne (call $ty_kind (local.get $c) (local.get $rt)) (i32.const 1))
              (then (if (call $err_open (local.get $c) (local.get $line) (local.get $col))
                        (then (call $put_str (local.get $c) (i32.const 0x100081E)
                                             (i32.const 21))
                              (call $put_ch (local.get $c) (i32.const 96))
                              (call $put_str (local.get $c) (i32.const 0x1000262)
                                             (i32.const 3))
                              (call $put_ch (local.get $c) (i32.const 96))
                              (call $put_str (local.get $c) (i32.const 0x1000214)
                                             (i32.const 8))
                              (call $put_q_ty (local.get $c) (local.get $rt))
                              (call $err_end (local.get $c))))))
          (return)))
    (if (i32.ne (local.get $lt) (local.get $rt))
        (then (call $e_type_mismatch2 (local.get $c) (local.get $line) (local.get $col)
                                      (local.get $op) (local.get $lt) (local.get $rt))
              (return)))
    (local.set $k (call $ty_kind (local.get $c) (local.get $lt)))
    (if (if (result i32) (i32.eq (local.get $op) (i32.const 4))
            (then (i32.const 1))
            (else (i32.eq (local.get $op) (i32.const 5))))
        (then
          (if (if (result i32) (i32.ne (local.get $k) (i32.const 0))
                  (then (if (result i32) (i32.ne (local.get $k) (i32.const 1))
                            (then (if (result i32) (i32.ne (local.get $k) (i32.const 2))
                                      (then (i32.ne (local.get $k) (i32.const 8)))
                                      (else (i32.const 0))))
                            (else (i32.const 0))))
                  (else (i32.const 0)))
              (then (if (call $err_open (local.get $c) (local.get $line) (local.get $col))
                        (then (call $put_str (local.get $c) (i32.const 0x1000833)
                                             (i32.const 15))
                              (call $put_q_ty (local.get $c) (local.get $lt))
                              (call $err_end (local.get $c))))))
          (return)))
    (if (call $is_cmp (local.get $op))
        (then
          (if (if (result i32) (i32.ne (local.get $k) (i32.const 0))
                  (then (if (result i32) (i32.ne (local.get $k) (i32.const 1))
                            (then (i32.ne (local.get $k) (i32.const 8)))
                            (else (i32.const 0))))
                  (else (i32.const 0)))
              (then (if (call $err_open (local.get $c) (local.get $line) (local.get $col))
                        (then (call $put_str (local.get $c) (i32.const 0x1000842)
                                             (i32.const 13))
                              (call $put_q_ty (local.get $c) (local.get $lt))
                              (call $err_end (local.get $c))))))
          (return)))
    (if (if (result i32) (i32.ne (local.get $k) (i32.const 0))
            (then (i32.ne (local.get $k) (i32.const 1)))
            (else (i32.const 0)))
        (then (if (call $err_open (local.get $c) (local.get $line) (local.get $col))
                  (then (call $put_q_punct (local.get $c) (local.get $op))
                        (call $put_str (local.get $c) (i32.const 0x100084F) (i32.const 10))
                        (call $put_ch (local.get $c) (i32.const 96))
                        (call $put_str (local.get $c) (i32.const 0x100025F) (i32.const 3))
                        (call $put_ch (local.get $c) (i32.const 96))
                        (call $put_str (local.get $c) (i32.const 0x1000859) (i32.const 4))
                        (call $put_ch (local.get $c) (i32.const 96))
                        (call $put_str (local.get $c) (i32.const 0x1000262) (i32.const 3))
                        (call $put_ch (local.get $c) (i32.const 96))
                        (call $put_str (local.get $c) (i32.const 0x1000214) (i32.const 8))
                        (call $put_q_ty (local.get $c) (local.get $lt))
                        (call $err_end (local.get $c)))))))

  (func $check_binary (param $c i32) (param $e i32) (param $want i32) (result i32)
    (local $op i32) (local $line i32) (local $col i32) (local $eb i32) (local $ec i32)
    (local $iw i32) (local $cmp i32) (local $lt i32) (local $lwant i32)
    (local $rwant i32) (local $rt i32) (local $li i32) (local $ri i32)
    (local.set $op (call $nd (local.get $c) (local.get $e) (i32.const 12)))
    (local.set $line (call $nd (local.get $c) (local.get $e) (i32.const 4)))
    (local.set $col (call $nd (local.get $c) (local.get $e) (i32.const 8)))
    (local.set $eb (call $nd (local.get $c) (local.get $e) (i32.const 16)))
    (local.set $ec (call $nd (local.get $c) (local.get $e) (i32.const 20)))
    (if (if (result i32) (i32.eq (local.get $op) (i32.const 8))
            (then (i32.const 1))
            (else (i32.eq (local.get $op) (i32.const 9))))
        (then (drop (call $coerce (local.get $c) (local.get $eb) (i32.const 3)))
              (drop (call $coerce (local.get $c) (local.get $ec) (i32.const 3)))
              (return (i32.const 3))))
    (local.set $iw (call $int_want (local.get $c) (local.get $want)))
    (local.set $cmp (call $is_cmp (local.get $op)))

    (if (if (result i32) (i32.eq (local.get $op) (i32.const 10))
            (then (i32.const 1))
            (else (i32.eq (local.get $op) (i32.const 11))))
        (then
          (local.set $lt (call $check_expr (local.get $c) (local.get $eb)
                                           (local.get $iw)))
          (drop (call $coerce (local.get $c) (local.get $ec) (i32.const 2)))
          (if (call $failed (local.get $c)) (then (return (i32.const 1))))
          (if (i32.eq (call $ty_kind (local.get $c) (local.get $lt)) (i32.const 5))
              (then
                (if (i32.eq (local.get $iw) (i32.const 0))
                    (then (call $nset (local.get $c) (local.get $e) (i32.const 24)
                                      (i32.const 6))
                          (return (i32.const 6))))
                (call $retype (local.get $c) (local.get $eb) (local.get $iw))
                (local.set $lt (local.get $iw))))
          (if (i32.eqz (call $is_int_ty (local.get $c) (local.get $lt)))
              (then (call $e_op_needs_int (local.get $c) (local.get $line)
                          (local.get $col) (local.get $op) (local.get $lt))
                    (return (i32.const 1))))
          (call $nset (local.get $c) (local.get $e) (i32.const 24) (local.get $lt))
          (return (local.get $lt))))

    (local.set $lwant (local.get $iw))
    (if (local.get $cmp) (then (local.set $lwant (i32.const 0))))
    (local.set $lt (call $check_expr (local.get $c) (local.get $eb) (local.get $lwant)))
    (local.set $rwant (local.get $lt))
    (if (i32.eq (call $ty_kind (local.get $c) (local.get $lt)) (i32.const 5))
        (then (local.set $rwant (local.get $lwant))))
    (local.set $rt (call $check_expr (local.get $c) (local.get $ec) (local.get $rwant)))
    (if (call $failed (local.get $c)) (then (return (i32.const 1))))
    (local.set $li (i32.eq (call $ty_kind (local.get $c) (local.get $lt)) (i32.const 5)))
    (local.set $ri (i32.eq (call $ty_kind (local.get $c) (local.get $rt)) (i32.const 5)))
    (if (if (result i32) (local.get $li)
            (then (i32.eqz (local.get $ri)))
            (else (i32.const 0)))
        (then (call $retype (local.get $c) (local.get $eb) (local.get $rt))
              (local.set $lt (local.get $rt)))
        (else (if (if (result i32) (local.get $ri)
                      (then (i32.eqz (local.get $li)))
                      (else (i32.const 0)))
