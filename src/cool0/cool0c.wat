        (if (i32.eq (call $ty_kind (local.get $t)) (i32.const 3))
            (then (call $e_u8_storage (call $nd (local.get $p) (i32.const 4))
                        (call $nd (local.get $p) (i32.const 8)))
                  (return)))
        (local.set $pi (call $alloc (i32.const 16)))
        (call $st (i32.add (local.get $pi) (i32.const 0)) (call $nd (local.get $p) (i32.const 12)))
        (call $st (i32.add (local.get $pi) (i32.const 4)) (call $nd (local.get $p) (i32.const 16)))
        (call $st (i32.add (local.get $pi) (i32.const 8)) (local.get $t))
        (call $st (i32.add (local.get $pi) (i32.const 12)) (i32.const 0))
        (if (i32.eq (local.get $head) (i32.const 0))
            (then (local.set $head (local.get $pi)))
            (else (call $st (i32.add (local.get $tail) (i32.const 12)) (local.get $pi))))
        (local.set $tail (local.get $pi))
        (local.set $n (i32.add (local.get $n) (i32.const 1)))
        (local.set $p (call $nd (local.get $p) (i32.const 32))))
      (br $cont)))
    (call $st (i32.add (local.get $fi) (i32.const 8)) (local.get $head))
    (call $st (i32.add (local.get $fi) (i32.const 12)) (local.get $n))
    (local.set $rn (call $nd (local.get $d) (i32.const 24)))
    (local.set $ret (call $resolve_ty (local.get $rn)))
    (if (call $failed) (then (return)))
