    (call $b_i32const (i32.const 0))
    (call $b_op (i32.const 106))
    (call $b_i32const (call $ld (i32.add (local.get $v) (i32.const 8))))
    (call $b_mem (i32.const 54) (i32.const 2))
    (local.set $a (i32.const 0))
