              (call $frame_addr (local.get $loc))
              (if (i32.eq (call $ty_kind (call $ld (i32.add (local.get $loc) (i32.const 8))))
                          (i32.const 6))
                  (then
                    (local.set $ta (call $temp))
                    (call $b_idx (i32.const 33) (local.get $ta))
                    (call $b_idx (i32.const 32) (local.get $ta))
                    (call $b_idx (i32.const 32) (call $ld (i32.add (local.get $loc) (i32.const 24))))
                    (call $b_mem (i32.const 54) (i32.const 2))
                    (call $b_idx (i32.const 32) (local.get $ta))
                    (call $b_i32const (i32.const 4))
                    (call $b_op (i32.const 106))
                    (call $b_idx (i32.const 32)
                          (i32.add (call $ld (i32.add (local.get $loc) (i32.const 24)))
                                   (i32.const 1)))
                    (call $b_mem (i32.const 54) (i32.const 2))
