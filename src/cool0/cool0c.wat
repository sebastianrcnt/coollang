    (local.get $n))

  (func $check_struct_lit (export "check_struct_lit") (param $e i32) (param $want i32)
                          (result i32)
    (local $line i32) (local $col i32) (local $si i32) (local $self_ty i32)
    (local $nf i32) (local $lf i32) (local $f i32)
    (local.set $line (call $nd (local.get $e) (i32.const 4)))
    (local.set $col (call $nd (local.get $e) (i32.const 8)))
    (local.set $si (call $find_struct (call $nd (local.get $e) (i32.const 12))
                         (call $nd (local.get $e) (i32.const 16))))
    (if (i32.eq (local.get $si) (i32.const 0))
        (then (call $e_unknown_struct (local.get $line) (local.get $col)
                    (call $nd (local.get $e) (i32.const 12))
                    (call $nd (local.get $e) (i32.const 16)))
              (return (call $ty_i32))))
    (local.set $self_ty (call $ty_named (call $nd (local.get $e) (i32.const 12))
                              (call $nd (local.get $e) (i32.const 16))))
    (if (if (result i32) (i32.ne (local.get $want) (i32.const 0))
            (then (i32.ne (local.get $want) (local.get $self_ty)))
            (else (i32.const 0)))
        (then
          (if (call $err_open (local.get $line) (local.get $col))
              (then (call $put_str (i32.const 0x10001F7) (i32.const 9))
                    (call $put_q_ty (local.get $want))
                    (call $put_str (i32.const 0x1000200) (i32.const 8))
                    (call $put_q_src (call $nd (local.get $e) (i32.const 12))
                          (call $nd (local.get $e) (i32.const 16)))
                    (call $err_end)))
          (return (call $ty_i32))))
    (local.set $nf (call $fi_count (call $ld (i32.add (local.get $si) (i32.const 8)))))
    (if (i32.ne (call $list_len (call $nd (local.get $e) (i32.const 20))) (local.get $nf))
        (then (call $e_field_count (local.get $line) (local.get $col)
                    (call $nd (local.get $e) (i32.const 12))
                    (call $nd (local.get $e) (i32.const 16)) (local.get $nf))
              (return (call $ty_i32))))
    (local.set $lf (call $nd (local.get $e) (i32.const 20)))
    (local.set $f (call $ld (i32.add (local.get $si) (i32.const 8))))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz
        (if (result i32) (i32.ne (local.get $lf) (i32.const 0))
            (then (i32.eqz (call $failed)))
            (else (i32.const 0)))))
      (block $cnt
        (if (i32.eqz (call $src_eq2 (call $nd (local.get $lf) (i32.const 12))
                           (call $nd (local.get $lf) (i32.const 16))
                           (call $ld (i32.add (local.get $f) (i32.const 0)))
                           (call $ld (i32.add (local.get $f) (i32.const 4)))))
            (then (call $e_field_order (call $nd (local.get $lf) (i32.const 4))
                        (call $nd (local.get $lf) (i32.const 8))
                        (call $ld (i32.add (local.get $f) (i32.const 0)))
                        (call $ld (i32.add (local.get $f) (i32.const 4)))
                        (call $nd (local.get $lf) (i32.const 12))
                        (call $nd (local.get $lf) (i32.const 16)))
                  (return (call $ty_i32))))
        (drop (call $coerce (call $nd (local.get $lf) (i32.const 20))
                    (call $read_ty (call $ld (i32.add (local.get $f) (i32.const 8))))))
        (local.set $lf (call $nd (local.get $lf) (i32.const 32)))
        (local.set $f (call $ld (i32.add (local.get $f) (i32.const 16)))))
      (br $cont)))
    (call $nset (local.get $e) (i32.const 24) (local.get $si))
    (call $nset (local.get $e) (i32.const 36) (local.get $self_ty))
    (local.get $self_ty))

  (func $e_variant_arity (export "e_variant_arity") (param $line i32) (param $col i32)
