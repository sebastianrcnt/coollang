        (then (call $put_str (i32.const 0x1000718) (i32.const 8))
              (call $put_q_src (local.get $s) (local.get $l))
              (call $put_str (i32.const 0x1000720) (i32.const 7))
              (call $put_num (local.get $want))
              (call $put_str (i32.const 0x1000727) (i32.const 19))
