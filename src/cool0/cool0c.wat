          (call $nset (local.get $n) (i32.const 12) (local.get $op))
          (call $nset (local.get $n) (i32.const 16) (local.get $lhs))
          (call $nset (local.get $n) (i32.const 20) (local.get $rhs))
          (return (call $deep (local.get $n)
                        (call $max2 (call $depth_of (local.get $lhs))
                                    (call $depth_of (local.get $rhs)))))))
    (local.get $lhs))

  (func $parse_unary (export "parse_unary") (param $asl i32) (result i32)
    (local $e i32) (local $line i32) (local $col i32) (local $t i32) (local $n i32)
