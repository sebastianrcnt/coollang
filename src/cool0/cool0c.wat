          (if (call $eat_kw (i32.const 5))
              (then (call $nset (local.get $n) (i32.const 16) (i32.const 1))))
          (call $nset (local.get $n) (i32.const 12) (call $parse_ty))
          (return (local.get $n))))
    (if (call $eat_p (i32.const 38))
        (then
          (local.set $n (call $node (i32.const 23) (local.get $line) (local.get $col)))
