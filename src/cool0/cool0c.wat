        (call $nset (local.get $n) (i32.const 12) (local.get $op))
        (call $nset (local.get $n) (i32.const 16) (local.get $lhs))
        (call $nset (local.get $n) (i32.const 20) (local.get $rhs))
        (local.set $lhs (call $deep (local.get $n)
                              (call $max2 (call $depth_of (local.get $lhs))
                                          (call $depth_of (local.get $rhs))))))
      (br $cont)))
    (local.get $lhs))

  (func $parse_cmp (export "parse_cmp") (param $asl i32) (result i32)
    (local $lhs i32) (local $line i32) (local $col i32) (local $op i32)
    (local $rhs i32) (local $n i32)
    (local.set $lhs (call $parse_bin (i32.const 3) (local.get $asl)))
    (if (call $failed) (then (return (i32.const 0))))
