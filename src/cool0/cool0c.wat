                (if (call $failed (local.get $c)) (then (return (i32.const 1))))
                (call $nset (local.get $c) (local.get $e) (i32.const 40)
                            (local.get $which))
                (if (i32.eq (local.get $which) (i32.const 1))
                    (then (return (i32.const 2))))
                (local.set $elem (call $ty_arg (local.get $c) (local.get $bt)))
                (return (call $ty_intern (local.get $c) (i32.const 8) (local.get $elem)
                              (i32.const 0)))))))
    (if (if (result i32) (i32.eq (local.get $k) (i32.const 12))
            (then (i32.const 1))
            (else (if (result i32) (i32.eq (local.get $k) (i32.const 11))
                      (then (i32.const 1))
                      (else (i32.eq (local.get $k) (i32.const 13))))))
        (then
          (local.set $ty (call $check_place (local.get $c) (local.get $e)))
          (if (call $failed (local.get $c)) (then (return (i32.const 1))))
          (if (call $is_aggregate (local.get $c) (local.get $ty))
              (then (return (local.get $ty))))
          (return (call $read_ty (local.get $c) (local.get $ty)))))
    (call $err_msg (local.get $c) (local.get $line) (local.get $col)
                   (i32.const 0x100029E) (i32.const 19))
    (i32.const 1))

  ;; ======================================================================
  ;; The whole check (language.md S4)
  ;; ======================================================================

  (func $check_program (export "check_program") (param $c i32)
    (local $d i32) (local $k i32) (local $index i32) (local $fi i32) (local $nfn i32)
    (local.set $d (call $cg (local.get $c) (i32.const 56)))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz
        (if (result i32) (i32.ne (local.get $d) (i32.const 0))
            (then (i32.eqz (call $failed (local.get $c))))
            (else (i32.const 0)))))
      (block $cnt
        (call $claim (local.get $c) (local.get $d))
        (local.set $d (call $nd (local.get $c) (local.get $d) (i32.const 32))))
      (br $cont)))
    (if (call $failed (local.get $c)) (then (return)))
    (local.set $d (call $cg (local.get $c) (i32.const 56)))
    (block $brk2 (loop $cont2
      (br_if $brk2 (i32.eqz (i32.ne (local.get $d) (i32.const 0))))
      (block $cnt2
        (local.set $k (call $nd (local.get $c) (local.get $d) (i32.const 0)))
        (if (if (result i32) (i32.eq (local.get $k) (i32.const 51))
                (then (i32.const 1))
                (else (i32.eq (local.get $k) (i32.const 52))))
            (then (call $add_type_name (local.get $c) (local.get $d))))
        (local.set $d (call $nd (local.get $c) (local.get $d) (i32.const 32))))
      (br $cont2)))
    (local.set $d (call $cg (local.get $c) (i32.const 56)))
    (block $brk3 (loop $cont3
      (br_if $brk3 (i32.eqz
        (if (result i32) (i32.ne (local.get $d) (i32.const 0))
            (then (i32.eqz (call $failed (local.get $c))))
            (else (i32.const 0)))))
      (block $cnt3
        (if (i32.eq (call $nd (local.get $c) (local.get $d) (i32.const 0)) (i32.const 51))
            (then (call $declare_struct (local.get $c) (local.get $d))))
        (local.set $d (call $nd (local.get $c) (local.get $d) (i32.const 32))))
      (br $cont3)))
    (if (call $failed (local.get $c)) (then (return)))
    (local.set $d (call $cg (local.get $c) (i32.const 56)))
    (block $brk4 (loop $cont4
      (br_if $brk4 (i32.eqz
        (if (result i32) (i32.ne (local.get $d) (i32.const 0))
            (then (i32.eqz (call $failed (local.get $c))))
            (else (i32.const 0)))))
      (block $cnt4
        (if (i32.eq (call $nd (local.get $c) (local.get $d) (i32.const 0)) (i32.const 52))
            (then (call $declare_enum (local.get $c) (local.get $d))))
        (local.set $d (call $nd (local.get $c) (local.get $d) (i32.const 32))))
      (br $cont4)))
    (if (call $failed (local.get $c)) (then (return)))
    ;; consts may reference each other, so register them all before folding
    (local.set $d (call $cg (local.get $c) (i32.const 56)))
    (block $brk5 (loop $cont5
      (br_if $brk5 (i32.eqz
        (if (result i32) (i32.ne (local.get $d) (i32.const 0))
            (then (i32.eqz (call $failed (local.get $c))))
            (else (i32.const 0)))))
      (block $cnt5
        (if (i32.eq (call $nd (local.get $c) (local.get $d) (i32.const 0)) (i32.const 53))
            (then (call $declare_const (local.get $c) (local.get $d))))
        (local.set $d (call $nd (local.get $c) (local.get $d) (i32.const 32))))
      (br $cont5)))
    (if (call $failed (local.get $c)) (then (return)))
    (local.set $d (call $cg (local.get $c) (i32.const 56)))
    (block $brk6 (loop $cont6
      (br_if $brk6 (i32.eqz
        (if (result i32) (i32.ne (local.get $d) (i32.const 0))
            (then (i32.eqz (call $failed (local.get $c))))
            (else (i32.const 0)))))
      (block $cnt6
        (if (i32.eq (call $nd (local.get $c) (local.get $d) (i32.const 0)) (i32.const 53))
            (then (drop (call $force_const (local.get $c)
                              (call $nd (local.get $c) (local.get $d) (i32.const 40))
                              (call $nd (local.get $c) (local.get $d) (i32.const 4))
                              (call $nd (local.get $c) (local.get $d) (i32.const 8))))))
        (local.set $d (call $nd (local.get $c) (local.get $d) (i32.const 32))))
      (br $cont6)))
    (if (call $failed (local.get $c)) (then (return)))
    (local.set $index (i32.const 0))
    (local.set $d (call $cg (local.get $c) (i32.const 56)))
    (block $brk7 (loop $cont7
      (br_if $brk7 (i32.eqz
        (if (result i32) (i32.ne (local.get $d) (i32.const 0))
            (then (i32.eqz (call $failed (local.get $c))))
            (else (i32.const 0)))))
      (block $cnt7
        (if (i32.eq (call $nd (local.get $c) (local.get $d) (i32.const 0)) (i32.const 50))
            (then (call $declare_fn (local.get $c) (local.get $d) (local.get $index))
                  (local.set $index (i32.add (local.get $index) (i32.const 1)))))
        (local.set $d (call $nd (local.get $c) (local.get $d) (i32.const 32))))
      (br $cont7)))
    (call $cs (local.get $c) (i32.const 256) (local.get $index))
    (if (call $failed (local.get $c)) (then (return)))
    ;; pass two: bodies
    (local.set $fi (i32.const 1))
    (local.set $nfn (call $cg (local.get $c) (i32.const 152)))
    (block $brk8 (loop $cont8
      (br_if $brk8 (i32.eqz
        (if (result i32) (i32.lt_u (local.get $fi) (local.get $nfn))
            (then (i32.eqz (call $failed (local.get $c))))
            (else (i32.const 0)))))
      (block $cnt8
        (call $check_fn (local.get $c) (local.get $fi))
        (local.set $fi (i32.add (local.get $fi) (i32.const 1))))
      (br $cont8))))

  ;; ======================================================================
  ;; Arena sizing
  ;;
  ;; Every table is bounded by a count of AST nodes of one kind, so one linear
  ;; pass over the node arena sizes all of them exactly.
  ;; ======================================================================

  (func $count_nodes (param $c i32)
    (local $i i32) (local $n i32) (local $k i32)
    (local $tys i32) (local $fields i32) (local $structs i32) (local $variants i32)
    (local $enums i32) (local $consts i32) (local $params i32) (local $fns i32)
    (local $lets i32) (local $binds i32) (local $strs i32)
    (local $h i32) (local $sz i32)
    (local.set $i (i32.const 1))
    (local.set $n (call $cg (local.get $c) (i32.const 40)))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.lt_u (local.get $i) (local.get $n))))
      (block $cnt
        (local.set $k (call $nd (local.get $c) (local.get $i) (i32.const 0)))
        ;; the kinds are distinct, so these tests are independent
        (if (if (result i32) (i32.ge_u (local.get $k) (i32.const 20))
                (then (i32.le_u (local.get $k) (i32.const 24)))
                (else (i32.const 0)))
            (then (local.set $tys (i32.add (local.get $tys) (i32.const 1)))))
        (if (i32.eq (local.get $k) (i32.const 55))
            (then (local.set $fields (i32.add (local.get $fields) (i32.const 1)))))
        (if (i32.eq (local.get $k) (i32.const 51))
            (then (local.set $structs (i32.add (local.get $structs) (i32.const 1)))))
        (if (i32.eq (local.get $k) (i32.const 56))
            (then (local.set $variants (i32.add (local.get $variants) (i32.const 1)))))
        (if (i32.eq (local.get $k) (i32.const 52))
            (then (local.set $enums (i32.add (local.get $enums) (i32.const 1)))))
        (if (i32.eq (local.get $k) (i32.const 53))
            (then (local.set $consts (i32.add (local.get $consts) (i32.const 1)))))
        (if (i32.eq (local.get $k) (i32.const 54))
            (then (local.set $params (i32.add (local.get $params) (i32.const 1)))))
        (if (i32.eq (local.get $k) (i32.const 50))
            (then (local.set $fns (i32.add (local.get $fns) (i32.const 1)))))
        (if (i32.eq (local.get $k) (i32.const 30))
            (then (local.set $lets (i32.add (local.get $lets) (i32.const 1)))))
        (if (i32.eq (local.get $k) (i32.const 41))
            (then (local.set $binds (i32.add (local.get $binds) (i32.const 1)))))
        (if (i32.eq (local.get $k) (i32.const 3))
            (then (local.set $strs (i32.add (local.get $strs) (i32.const 1)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1))))
      (br $cont)))

    (local.set $h (call $cg (local.get $c) (i32.const 312)))

    (local.set $sz (i32.add (local.get $tys) (i32.const 15)))
    (call $cs (local.get $c) (i32.const 60) (local.get $h))
    (call $cs (local.get $c) (i32.const 64) (local.get $sz))
    (local.set $h (i32.add (local.get $h) (i32.mul (local.get $sz) (i32.const 12))))

    (local.set $sz (i32.add (i32.add (local.get $fields) (local.get $tys)) (i32.const 2)))
    (call $cs (local.get $c) (i32.const 72) (local.get $h))
    (call $cs (local.get $c) (i32.const 76) (local.get $sz))
    (call $cs (local.get $c) (i32.const 80) (i32.const 1))
    (local.set $h (i32.add (local.get $h) (i32.mul (local.get $sz) (i32.const 20))))

    (local.set $sz (i32.add (local.get $structs) (i32.const 2)))
    (call $cs (local.get $c) (i32.const 84) (local.get $h))
    (call $cs (local.get $c) (i32.const 88) (local.get $sz))
    (call $cs (local.get $c) (i32.const 92) (i32.const 1))
    (local.set $h (i32.add (local.get $h) (i32.mul (local.get $sz) (i32.const 24))))

    (local.set $sz (i32.add (local.get $variants) (i32.const 2)))
    (call $cs (local.get $c) (i32.const 96) (local.get $h))
    (call $cs (local.get $c) (i32.const 100) (local.get $sz))
    (call $cs (local.get $c) (i32.const 104) (i32.const 1))
    (local.set $h (i32.add (local.get $h) (i32.mul (local.get $sz) (i32.const 24))))

    (local.set $sz (i32.add (local.get $enums) (i32.const 2)))
    (call $cs (local.get $c) (i32.const 108) (local.get $h))
    (call $cs (local.get $c) (i32.const 112) (local.get $sz))
    (call $cs (local.get $c) (i32.const 116) (i32.const 1))
    (local.set $h (i32.add (local.get $h) (i32.mul (local.get $sz) (i32.const 28))))

    (local.set $sz (i32.add (local.get $consts) (i32.const 2)))
    (call $cs (local.get $c) (i32.const 120) (local.get $h))
    (call $cs (local.get $c) (i32.const 124) (local.get $sz))
    (call $cs (local.get $c) (i32.const 128) (i32.const 1))
    (local.set $h (i32.add (local.get $h) (i32.mul (local.get $sz) (i32.const 28))))

    (local.set $sz (i32.add (local.get $params) (i32.const 2)))
    (call $cs (local.get $c) (i32.const 132) (local.get $h))
    (call $cs (local.get $c) (i32.const 136) (local.get $sz))
    (call $cs (local.get $c) (i32.const 140) (i32.const 1))
    (local.set $h (i32.add (local.get $h) (i32.mul (local.get $sz) (i32.const 16))))

    (local.set $sz (i32.add (local.get $fns) (i32.const 2)))
    (call $cs (local.get $c) (i32.const 144) (local.get $h))
    (call $cs (local.get $c) (i32.const 148) (local.get $sz))
    (call $cs (local.get $c) (i32.const 152) (i32.const 1))
    (local.set $h (i32.add (local.get $h) (i32.mul (local.get $sz) (i32.const 52))))

    (local.set $sz (i32.add (i32.add (i32.add (local.get $params) (local.get $lets))
                                     (local.get $binds))
                            (i32.const 2)))
    (call $cs (local.get $c) (i32.const 156) (local.get $h))
    (call $cs (local.get $c) (i32.const 160) (local.get $sz))
    (call $cs (local.get $c) (i32.const 164) (i32.const 1))
    (local.set $h (i32.add (local.get $h) (i32.mul (local.get $sz) (i32.const 36))))
    (local.set $i (local.get $sz))

    (local.set $sz (i32.add (local.get $strs) (i32.const 2)))
    (call $cs (local.get $c) (i32.const 168) (local.get $h))
    (call $cs (local.get $c) (i32.const 172) (local.get $sz))
    (call $cs (local.get $c) (i32.const 176) (i32.const 1))
    (local.set $h (i32.add (local.get $h) (i32.mul (local.get $sz) (i32.const 16))))

    (local.set $sz (i32.add (i32.add (i32.add (i32.add (local.get $structs)
                                                       (local.get $enums))
                                              (local.get $consts))
                                     (local.get $fns))
                            (i32.const 2)))
    (call $cs (local.get $c) (i32.const 180) (local.get $h))
    (call $cs (local.get $c) (i32.const 184) (local.get $sz))
    (call $cs (local.get $c) (i32.const 188) (i32.const 1))
    (local.set $h (i32.add (local.get $h) (i32.mul (local.get $sz) (i32.const 12))))
    (call $cs (local.get $c) (i32.const 192) (local.get $h))
    (call $cs (local.get $c) (i32.const 196) (local.get $sz))
    (call $cs (local.get $c) (i32.const 200) (i32.const 1))
    (local.set $h (i32.add (local.get $h) (i32.mul (local.get $sz) (i32.const 12))))

    ;; scope stack, mark stack
    (local.set $sz (i32.add (local.get $i) (i32.const 2)))
    (call $cs (local.get $c) (i32.const 212) (local.get $h))
    (call $cs (local.get $c) (i32.const 216) (local.get $sz))
    (local.set $h (i32.add (local.get $h) (i32.mul (local.get $sz) (i32.const 4))))
    (local.set $sz (i32.const 136))
    (call $cs (local.get $c) (i32.const 224) (local.get $h))
    (call $cs (local.get $c) (i32.const 228) (local.get $sz))
    (local.set $h (i32.add (local.get $h) (i32.mul (local.get $sz) (i32.const 4))))

    ;; emitter stacks and the signature table
    (call $cs (local.get $c) (i32.const 284) (local.get $h))
    (call $cs (local.get $c) (i32.const 288) (i32.const 512))
    (local.set $h (i32.add (local.get $h) (i32.const 2048)))
    (call $cs (local.get $c) (i32.const 296) (local.get $h))
    (call $cs (local.get $c) (i32.const 300) (i32.const 512))
    (local.set $h (i32.add (local.get $h) (i32.const 2048)))
    (local.set $sz (i32.mul (i32.add (local.get $fns) (i32.const 2)) (i32.const 3)))
    (call $cs (local.get $c) (i32.const 268) (local.get $h))
    (call $cs (local.get $c) (i32.const 272) (local.get $sz))
    (local.set $h (i32.add (local.get $h) (i32.mul (local.get $sz) (i32.const 4))))

    (call $cs (local.get $c) (i32.const 312) (local.get $h)))

  (func $init_types (param $c i32)
    (local $i i32)
    (local.set $i (i32.const 1))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.le_u (local.get $i) (i32.const 6))))
      (block $cnt
        (i32.store (call $ty_at (local.get $c) (local.get $i))
                   (i32.sub (local.get $i) (i32.const 1)))
        (i32.store (i32.add (call $ty_at (local.get $c) (local.get $i)) (i32.const 4))
                   (i32.const 0))
        (i32.store (i32.add (call $ty_at (local.get $c) (local.get $i)) (i32.const 8))
                   (i32.const 0)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $cont)))
    (call $cs (local.get $c) (i32.const 68) (i32.const 7)))

  ;; ======================================================================
  ;; wasm encoding (implementation.md S5)
  ;;
  ;; Two output cursors plus the diagnostic buffer: 0 body (Ctx+260),
  ;; 1 section (Ctx+264), 2 out (Ctx+320).
  ;; ======================================================================

  (func $w_ch (param $c i32) (param $sel i32) (param $ch i32)
    (local $off i32)
    (local.set $off (i32.const 320))
    (if (i32.eq (local.get $sel) (i32.const 0)) (then (local.set $off (i32.const 260))))
    (if (i32.eq (local.get $sel) (i32.const 1)) (then (local.set $off (i32.const 264))))
    (call $stb (call $cg (local.get $c) (local.get $off)) (local.get $ch))
    (call $cs (local.get $c) (local.get $off)
              (i32.add (call $cg (local.get $c) (local.get $off)) (i32.const 1))))

  (func $w_u (param $c i32) (param $sel i32) (param $n i32)
    (local $x i32) (local $byte i32)
    (local.set $x (local.get $n))
    (block $brk (loop $cont
      (block $cnt
        (local.set $byte (i32.and (local.get $x) (i32.const 0x7F)))
        (local.set $x (i32.shr_u (local.get $x) (i32.const 7)))
        (if (i32.eq (local.get $x) (i32.const 0))
            (then (call $w_ch (local.get $c) (local.get $sel) (local.get $byte))
                  (br $brk)))
        (call $w_ch (local.get $c) (local.get $sel)
                    (i32.or (local.get $byte) (i32.const 0x80))))
      (br $cont))))

  ;; signed LEB128 of the 32-bit pattern v
  (func $w_s (param $c i32) (param $sel i32) (param $v i32)
    (local $x i32) (local $byte i32) (local $sign i32)
    (local.set $x (local.get $v))
    (block $brk (loop $cont
      (block $cnt
        (local.set $byte (i32.and (local.get $x) (i32.const 0x7F)))
        (local.set $x (i32.shr_s (local.get $x) (i32.const 7)))
        (local.set $sign (i32.and (local.get $byte) (i32.const 0x40)))
        (if (if (result i32)
                (if (result i32) (i32.eq (local.get $x) (i32.const 0))
                    (then (i32.eq (local.get $sign) (i32.const 0)))
                    (else (i32.const 0)))
                (then (i32.const 1))
                (else (if (result i32) (i32.eq (local.get $x) (i32.const -1))
                          (then (i32.ne (local.get $sign) (i32.const 0)))
                          (else (i32.const 0)))))
            (then (call $w_ch (local.get $c) (local.get $sel) (local.get $byte))
                  (br $brk)))
        (call $w_ch (local.get $c) (local.get $sel)
                    (i32.or (local.get $byte) (i32.const 0x80))))
      (br $cont))))

  (func $w_copy (param $c i32) (param $sel i32) (param $src i32) (param $n i32)
    (local $i i32)
    (local.set $i (i32.const 0))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.lt_u (local.get $i) (local.get $n))))
      (block $cnt
        (call $w_ch (local.get $c) (local.get $sel)
                    (i32.load8_u (i32.add (local.get $src) (local.get $i)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $cont))))

  (func $leb_u_len (param $n i32) (result i32)
    (local $x i32) (local $k i32)
    (local.set $x (local.get $n))
    (local.set $k (i32.const 1))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.ge_u (local.get $x) (i32.const 128))))
      (block $cnt
        (local.set $x (i32.shr_u (local.get $x) (i32.const 7)))
        (local.set $k (i32.add (local.get $k) (i32.const 1))))
      (br $cont)))
    (local.get $k))

  (func $b_op (param $c i32) (param $op i32)
    (call $w_ch (local.get $c) (i32.const 0) (local.get $op)))

  (func $b_i32const (param $c i32) (param $v i32)
    (call $w_ch (local.get $c) (i32.const 0) (i32.const 0x41))
    (call $w_s (local.get $c) (i32.const 0) (local.get $v)))

  (func $b_idx (param $c i32) (param $op i32) (param $i i32)
    (call $w_ch (local.get $c) (i32.const 0) (local.get $op))
    (call $w_u (local.get $c) (i32.const 0) (local.get $i)))

  ;; memarg: alignment, then an offset that is always 0 (implementation.md S5)
  (func $b_mem (param $c i32) (param $op i32) (param $align i32)
    (call $w_ch (local.get $c) (i32.const 0) (local.get $op))
    (call $w_u (local.get $c) (i32.const 0) (local.get $align))
    (call $w_u (local.get $c) (i32.const 0) (i32.const 0)))

  (func $b_blocked (param $c i32) (param $op i32) (param $bt i32)
    (call $w_ch (local.get $c) (i32.const 0) (local.get $op))
    (call $w_ch (local.get $c) (i32.const 0) (local.get $bt)))

  (func $s_ch (param $c i32) (param $ch i32)
    (call $w_ch (local.get $c) (i32.const 1) (local.get $ch)))

  (func $s_u (param $c i32) (param $n i32)
    (call $w_u (local.get $c) (i32.const 1) (local.get $n)))

  ;; --- temporaries (implementation.md S6) ---------------------------------

  (func $temp (param $c i32) (result i32)
    (local $n i32) (local $fi i32) (local $i i32)
    (if (i32.ne (call $cg (local.get $c) (i32.const 292)) (i32.const 0))
        (then (local.set $n (i32.sub (call $cg (local.get $c) (i32.const 292))
                                     (i32.const 1)))
              (call $cs (local.get $c) (i32.const 292) (local.get $n))
              (return (i32.load (i32.add (call $cg (local.get $c) (i32.const 284))
                                         (i32.mul (local.get $n) (i32.const 4)))))))
    (local.set $fi (call $cg (local.get $c) (i32.const 308)))
    (local.set $i (i32.add (i32.add (call $rg (local.get $c) (i32.const 144)
                                              (local.get $fi) (i32.const 52)
                                              (i32.const 40))
                                    (call $rg (local.get $c) (i32.const 144)
                                              (local.get $fi) (i32.const 52)
                                              (i32.const 44)))
                           (call $cg (local.get $c) (i32.const 280))))
    (call $cs (local.get $c) (i32.const 280)
              (i32.add (call $cg (local.get $c) (i32.const 280)) (i32.const 1)))
    (local.get $i))

  (func $free_push (param $c i32) (param $t i32)
    (local $n i32)
    (local.set $n (call $cg (local.get $c) (i32.const 292)))
    (if (i32.ge_u (local.get $n) (call $cg (local.get $c) (i32.const 288)))
        (then (unreachable)))
    (i32.store (i32.add (call $cg (local.get $c) (i32.const 284))
                        (i32.mul (local.get $n) (i32.const 4)))
               (local.get $t))
    (call $cs (local.get $c) (i32.const 292) (i32.add (local.get $n) (i32.const 1))))

  (func $release1 (param $c i32) (param $a i32)
    (call $free_push (local.get $c) (local.get $a)))

  ;; released highest first, exactly as cool0.py sorts them
  (func $release2 (param $c i32) (param $a i32) (param $b i32)
    (if (i32.gt_u (local.get $a) (local.get $b))
        (then (call $free_push (local.get $c) (local.get $a))
              (call $free_push (local.get $c) (local.get $b))
              (return)))
    (call $free_push (local.get $c) (local.get $b))
    (call $free_push (local.get $c) (local.get $a)))

  (func $release3 (param $c i32) (param $a i32) (param $b i32) (param $d i32)
    (local $hi i32) (local $mid i32) (local $lo i32) (local $t i32)
    (local.set $hi (local.get $a))
    (local.set $mid (local.get $b))
    (local.set $lo (local.get $d))
    (if (i32.gt_u (local.get $mid) (local.get $hi))
        (then (local.set $t (local.get $hi)) (local.set $hi (local.get $mid))
              (local.set $mid (local.get $t))))
    (if (i32.gt_u (local.get $lo) (local.get $hi))
        (then (local.set $t (local.get $hi)) (local.set $hi (local.get $lo))
              (local.set $lo (local.get $t))))
    (if (i32.gt_u (local.get $lo) (local.get $mid))
        (then (local.set $t (local.get $mid)) (local.set $mid (local.get $lo))
              (local.set $lo (local.get $t))))
    (call $free_push (local.get $c) (local.get $hi))
    (call $free_push (local.get $c) (local.get $mid))
    (call $free_push (local.get $c) (local.get $lo)))

  ;; --- control stack ------------------------------------------------------

  (func $ctrl_push (param $c i32) (param $k i32)
    (local $n i32)
    (local.set $n (call $cg (local.get $c) (i32.const 304)))
    (if (i32.ge_u (local.get $n) (call $cg (local.get $c) (i32.const 300)))
        (then (unreachable)))
    (i32.store (i32.add (call $cg (local.get $c) (i32.const 296))
                        (i32.mul (local.get $n) (i32.const 4)))
               (local.get $k))
    (call $cs (local.get $c) (i32.const 304) (i32.add (local.get $n) (i32.const 1))))

  (func $ctrl_pop (param $c i32)
    (call $cs (local.get $c) (i32.const 304)
              (i32.sub (call $cg (local.get $c) (i32.const 304)) (i32.const 1))))

  (func $depth_to (param $c i32) (param $k i32) (result i32)
    (local $n i32) (local $i i32)
    (local.set $n (call $cg (local.get $c) (i32.const 304)))
    (local.set $i (local.get $n))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.gt_u (local.get $i) (i32.const 0))))
      (block $cnt
        (local.set $i (i32.sub (local.get $i) (i32.const 1)))
        (if (i32.eq (i32.load (i32.add (call $cg (local.get $c) (i32.const 296))
                                       (i32.mul (local.get $i) (i32.const 4))))
                    (local.get $k))
            (then (return (i32.sub (i32.sub (local.get $n) (i32.const 1))
                                   (local.get $i))))))
      (br $cont)))
    (i32.const 0))

  ;; --- storage assignment (implementation.md S6) --------------------------

  (func $loc_in_memory (param $c i32) (param $loc i32) (result i32)
    (local $t i32)
    (local.set $t (call $rg (local.get $c) (i32.const 156) (local.get $loc) (i32.const 36)
                            (i32.const 8)))
    (if (call $is_aggregate (local.get $c) (local.get $t)) (then (return (i32.const 1))))
    (i32.ne (call $rg (local.get $c) (i32.const 156) (local.get $loc) (i32.const 36)
                      (i32.const 20))
            (i32.const 0)))

  (func $assign_storage (param $c i32) (param $fi i32)
    (local $slot i32) (local $loc i32) (local $t i32) (local $off i32) (local $align i32)
    (local $a i32)
    (local.set $slot (i32.const 0))
    (local.set $loc (call $rg (local.get $c) (i32.const 144) (local.get $fi)
                              (i32.const 52) (i32.const 28)))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.ne (local.get $loc) (i32.const 0))))
      (block $cnt
        (if (i32.ne (call $rg (local.get $c) (i32.const 156) (local.get $loc)
                              (i32.const 36) (i32.const 16))
                    (i32.const 0))
            (then (local.set $t (call $rg (local.get $c) (i32.const 156) (local.get $loc)
                                          (i32.const 36) (i32.const 8)))
                  (call $rs (local.get $c) (i32.const 156) (local.get $loc) (i32.const 36)
                            (i32.const 24) (local.get $slot))
                  (local.set $slot (i32.add (local.get $slot)
                                            (call $slot_count (local.get $c)
                                                  (local.get $t))))))
        (local.set $loc (call $rg (local.get $c) (i32.const 156) (local.get $loc)
                                  (i32.const 36) (i32.const 32))))
      (br $cont)))
    (call $rs (local.get $c) (i32.const 144) (local.get $fi) (i32.const 52) (i32.const 40)
              (local.get $slot))
    (local.set $loc (call $rg (local.get $c) (i32.const 144) (local.get $fi)
                              (i32.const 52) (i32.const 28)))
    (block $brk2 (loop $cont2
      (br_if $brk2 (i32.eqz (i32.ne (local.get $loc) (i32.const 0))))
      (block $cnt2
        (if (if (result i32) (i32.eq (call $rg (local.get $c) (i32.const 156)
                                               (local.get $loc) (i32.const 36)
                                               (i32.const 16))
                                     (i32.const 0))
                (then (i32.eqz (call $loc_in_memory (local.get $c) (local.get $loc))))
                (else (i32.const 0)))
            (then (local.set $t (call $rg (local.get $c) (i32.const 156) (local.get $loc)
                                          (i32.const 36) (i32.const 8)))
                  (call $rs (local.get $c) (i32.const 156) (local.get $loc) (i32.const 36)
                            (i32.const 24) (local.get $slot))
                  (local.set $slot (i32.add (local.get $slot)
                                            (call $slot_count (local.get $c)
                                                  (local.get $t))))))
        (local.set $loc (call $rg (local.get $c) (i32.const 156) (local.get $loc)
                                  (i32.const 36) (i32.const 32))))
      (br $cont2)))
    (call $rs (local.get $c) (i32.const 144) (local.get $fi) (i32.const 52) (i32.const 44)
              (i32.sub (local.get $slot)
                       (call $rg (local.get $c) (i32.const 144) (local.get $fi)
                                 (i32.const 52) (i32.const 40))))
    (local.set $off (i32.const 0))
    (local.set $align (i32.const 4))
    (local.set $loc (call $rg (local.get $c) (i32.const 144) (local.get $fi)
                              (i32.const 52) (i32.const 28)))
    (block $brk3 (loop $cont3
      (br_if $brk3 (i32.eqz (i32.ne (local.get $loc) (i32.const 0))))
      (block $cnt3
        (if (call $loc_in_memory (local.get $c) (local.get $loc))
            (then
              (local.set $t (call $rg (local.get $c) (i32.const 156) (local.get $loc)
                                      (i32.const 36) (i32.const 8)))
              (local.set $a (call $align_of (local.get $c) (local.get $t)))
              (local.set $off (call $align_up (local.get $off) (local.get $a)))
              (call $rs (local.get $c) (i32.const 156) (local.get $loc) (i32.const 36)
                        (i32.const 28) (local.get $off))
              (local.set $off (i32.add (local.get $off)
                                       (call $size_of (local.get $c) (local.get $t))))
              (if (i32.gt_u (local.get $a) (local.get $align))
                  (then (local.set $align (local.get $a))))))
        (local.set $loc (call $rg (local.get $c) (i32.const 156) (local.get $loc)
                                  (i32.const 36) (i32.const 32))))
      (br $cont3)))
    (if (i32.ne (local.get $off) (i32.const 0))
        (then (call $rs (local.get $c) (i32.const 144) (local.get $fi) (i32.const 52)
                        (i32.const 36) (call $align_up (local.get $off)
                                             (local.get $align))))
        (else (call $rs (local.get $c) (i32.const 144) (local.get $fi) (i32.const 52)
                        (i32.const 36) (i32.const 0)))))

  ;; --- memory access ------------------------------------------------------

  (func $load_op (param $c i32) (param $t i32)
    (local $k i32)
    (local.set $k (call $ty_kind (local.get $c) (local.get $t)))
    (if (if (result i32) (i32.eq (local.get $k) (i32.const 2))
            (then (i32.const 1))
            (else (i32.eq (local.get $k) (i32.const 3))))
        (then (call $b_mem (local.get $c) (i32.const 0x2D) (i32.const 0)) (return)))
    (call $b_mem (local.get $c) (i32.const 0x28) (i32.const 2)))

  (func $store_op (param $c i32) (param $t i32)
    (local $k i32)
    (local.set $k (call $ty_kind (local.get $c) (local.get $t)))
    (if (if (result i32) (i32.eq (local.get $k) (i32.const 2))
            (then (i32.const 1))
            (else (i32.eq (local.get $k) (i32.const 3))))
        (then (call $b_mem (local.get $c) (i32.const 0x3A) (i32.const 0)) (return)))
    (call $b_mem (local.get $c) (i32.const 0x36) (i32.const 2)))

  (func $frame_addr (param $c i32) (param $loc i32)
    (call $b_idx (local.get $c) (i32.const 0x23) (i32.const 0))
    (call $b_i32const (local.get $c)
          (call $rg (local.get $c) (i32.const 156) (local.get $loc) (i32.const 36)
                    (i32.const 28)))
    (call $b_op (local.get $c) (i32.const 0x6A)))

  (func $ident_local (param $c i32) (param $e i32) (result i32)
    (if (i32.ne (call $nd (local.get $c) (local.get $e) (i32.const 44)) (i32.const 0))
        (then (return (i32.const 0))))
    (call $nd (local.get $c) (local.get $e) (i32.const 40)))

  (func $in_wasm_local (param $c i32) (param $e i32) (result i32)
    (local $loc i32)
    (if (i32.ne (call $nd (local.get $c) (local.get $e) (i32.const 0)) (i32.const 5))
        (then (return (i32.const 0))))
    (local.set $loc (call $ident_local (local.get $c) (local.get $e)))
    (if (i32.eq (local.get $loc) (i32.const 0)) (then (return (i32.const 0))))
    (i32.eqz (call $loc_in_memory (local.get $c) (local.get $loc))))

  (func $place_ty (param $c i32) (param $e i32) (result i32)
    (local $k i32) (local $base i32)
    (local.set $k (call $nd (local.get $c) (local.get $e) (i32.const 0)))
    (if (i32.eq (local.get $k) (i32.const 5))
        (then (return (call $rg (local.get $c) (i32.const 156)
                            (call $ident_local (local.get $c) (local.get $e))
                            (i32.const 36) (i32.const 8)))))
    (if (i32.eq (local.get $k) (i32.const 12))
        (then (return (call $rg (local.get $c) (i32.const 72)
                            (call $nd (local.get $c) (local.get $e) (i32.const 24))
                            (i32.const 20) (i32.const 8)))))
    (local.set $base (call $nd (local.get $c) (local.get $e) (i32.const 12)))
    (call $ty_arg (local.get $c) (call $nd (local.get $c) (local.get $base) (i32.const 36))))

  (func $emit_addr (param $c i32) (param $e i32)
    (local $k i32) (local $ea i32) (local $eb i32) (local $f i32)
    (local $tp i32) (local $tl i32) (local $tix i32) (local $stride i32)
    (local.set $k (call $nd (local.get $c) (local.get $e) (i32.const 0)))
    (local.set $ea (call $nd (local.get $c) (local.get $e) (i32.const 12)))
    (if (i32.eq (local.get $k) (i32.const 5))
        (then (call $frame_addr (local.get $c)
                    (call $ident_local (local.get $c) (local.get $e)))
              (return)))
    (if (i32.eq (local.get $k) (i32.const 12))
        (then (local.set $f (call $nd (local.get $c) (local.get $e) (i32.const 24)))
              (call $emit_addr (local.get $c) (local.get $ea))
              (call $b_i32const (local.get $c)
                    (call $rg (local.get $c) (i32.const 72) (local.get $f) (i32.const 20)
                              (i32.const 12)))
              (call $b_op (local.get $c) (i32.const 0x6A))
              (return)))
    (if (i32.eq (local.get $k) (i32.const 13))
        (then (call $emit_expr (local.get $c) (local.get $ea)) (return)))
    ;; E_INDEX -- bounds checked (language.md S5)
    (local.set $tp (call $temp (local.get $c)))
    (local.set $tl (call $temp (local.get $c)))
    (local.set $tix (call $temp (local.get $c)))
    (local.set $stride (call $nd (local.get $c) (local.get $e) (i32.const 24)))
    (local.set $eb (call $nd (local.get $c) (local.get $e) (i32.const 16)))
    (call $emit_expr (local.get $c) (local.get $ea))
    (call $b_idx (local.get $c) (i32.const 0x21) (local.get $tl))
    (call $b_idx (local.get $c) (i32.const 0x21) (local.get $tp))
    (call $emit_expr (local.get $c) (local.get $eb))
    (call $b_idx (local.get $c) (i32.const 0x21) (local.get $tix))
    (call $b_idx (local.get $c) (i32.const 0x20) (local.get $tix))
    (call $b_idx (local.get $c) (i32.const 0x20) (local.get $tl))
    (call $b_op (local.get $c) (i32.const 0x4F))
    (call $b_blocked (local.get $c) (i32.const 0x04) (i32.const 0x40))
    (call $b_op (local.get $c) (i32.const 0x00))
    (call $b_op (local.get $c) (i32.const 0x0B))
    (call $b_idx (local.get $c) (i32.const 0x20) (local.get $tp))
    (call $b_idx (local.get $c) (i32.const 0x20) (local.get $tix))
    (call $b_i32const (local.get $c) (local.get $stride))
    (call $b_op (local.get $c) (i32.const 0x6C))
    (call $b_op (local.get $c) (i32.const 0x6A))
    (call $release3 (local.get $c) (local.get $tp) (local.get $tl) (local.get $tix)))

  (func $emit_place_load (param $c i32) (param $e i32) (param $pt i32)
    (local $loc i32) (local $slot i32) (local $lt i32) (local $ta i32)
    (if (call $in_wasm_local (local.get $c) (local.get $e))
        (then
          (local.set $loc (call $ident_local (local.get $c) (local.get $e)))
          (local.set $slot (call $rg (local.get $c) (i32.const 156) (local.get $loc)
                                     (i32.const 36) (i32.const 24)))
          (local.set $lt (call $rg (local.get $c) (i32.const 156) (local.get $loc)
                                   (i32.const 36) (i32.const 8)))
          (call $b_idx (local.get $c) (i32.const 0x20) (local.get $slot))
          (if (i32.eq (call $ty_kind (local.get $c) (local.get $lt)) (i32.const 6))
              (then (call $b_idx (local.get $c) (i32.const 0x20)
                          (i32.add (local.get $slot) (i32.const 1)))))
          (return)))
    (if (i32.eq (call $ty_kind (local.get $c) (local.get $pt)) (i32.const 6))
        (then
          (local.set $ta (call $temp (local.get $c)))
          (call $emit_addr (local.get $c) (local.get $e))
          (call $b_idx (local.get $c) (i32.const 0x21) (local.get $ta))
          (call $b_idx (local.get $c) (i32.const 0x20) (local.get $ta))
          (call $b_mem (local.get $c) (i32.const 0x28) (i32.const 2))
          (call $b_idx (local.get $c) (i32.const 0x20) (local.get $ta))
          (call $b_i32const (local.get $c) (i32.const 4))
          (call $b_op (local.get $c) (i32.const 0x6A))
          (call $b_mem (local.get $c) (i32.const 0x28) (i32.const 2))
          (call $release1 (local.get $c) (local.get $ta))
          (return)))
    (call $emit_addr (local.get $c) (local.get $e))
    (call $load_op (local.get $c) (local.get $pt)))

  (func $emit_load_at (param $c i32) (param $ta i32) (param $off i32) (param $t i32)
    (if (i32.eq (call $ty_kind (local.get $c) (local.get $t)) (i32.const 6))
        (then
          (call $b_idx (local.get $c) (i32.const 0x20) (local.get $ta))
          (call $b_i32const (local.get $c) (local.get $off))
          (call $b_op (local.get $c) (i32.const 0x6A))
          (call $b_mem (local.get $c) (i32.const 0x28) (i32.const 2))
          (call $b_idx (local.get $c) (i32.const 0x20) (local.get $ta))
          (call $b_i32const (local.get $c) (i32.add (local.get $off) (i32.const 4)))
          (call $b_op (local.get $c) (i32.const 0x6A))
          (call $b_mem (local.get $c) (i32.const 0x28) (i32.const 2))
          (return)))
    (call $b_idx (local.get $c) (i32.const 0x20) (local.get $ta))
    (call $b_i32const (local.get $c) (local.get $off))
    (call $b_op (local.get $c) (i32.const 0x6A))
    (call $load_op (local.get $c) (local.get $t)))

  ;; vk 0: the value is expression a1.  vk 1: load a3 from a1 + a2.
  (func $emit_value (param $c i32) (param $vk i32) (param $a1 i32) (param $a2 i32)
        (param $a3 i32)
    (if (i32.eq (local.get $vk) (i32.const 0))
        (then (call $emit_expr (local.get $c) (local.get $a1)) (return)))
    (call $emit_load_at (local.get $c) (local.get $a1) (local.get $a2) (local.get $a3)))

  ;; --- expressions --------------------------------------------------------

  (func $arith_op (param $op i32) (param $signed i32) (result i32)
    (if (i32.eq (local.get $op) (i32.const 33)) (then (return (i32.const 0x6A))))
    (if (i32.eq (local.get $op) (i32.const 34)) (then (return (i32.const 0x6B))))
    (if (i32.eq (local.get $op) (i32.const 35)) (then (return (i32.const 0x6C))))
    (if (i32.eq (local.get $op) (i32.const 36))
        (then (if (local.get $signed) (then (return (i32.const 0x6D))))
              (return (i32.const 0x6E))))
    (if (i32.eq (local.get $op) (i32.const 37))
        (then (if (local.get $signed) (then (return (i32.const 0x6F))))
              (return (i32.const 0x70))))
    (if (i32.eq (local.get $op) (i32.const 38)) (then (return (i32.const 0x71))))
    (if (i32.eq (local.get $op) (i32.const 39)) (then (return (i32.const 0x72))))
    (if (i32.eq (local.get $op) (i32.const 40)) (then (return (i32.const 0x73))))
    (if (i32.eq (local.get $op) (i32.const 10)) (then (return (i32.const 0x74))))
    (if (local.get $signed) (then (return (i32.const 0x75))))
    (i32.const 0x76))

  (func $cmp_opcode (param $op i32) (param $signed i32) (result i32)
    (if (i32.eq (local.get $op) (i32.const 4)) (then (return (i32.const 0x46))))
    (if (i32.eq (local.get $op) (i32.const 5)) (then (return (i32.const 0x47))))
    (if (i32.eq (local.get $op) (i32.const 31))
        (then (if (local.get $signed) (then (return (i32.const 0x48))))
              (return (i32.const 0x49))))
    (if (i32.eq (local.get $op) (i32.const 32))
        (then (if (local.get $signed) (then (return (i32.const 0x4A))))
              (return (i32.const 0x4B))))
    (if (i32.eq (local.get $op) (i32.const 6))
        (then (if (local.get $signed) (then (return (i32.const 0x4C))))
              (return (i32.const 0x4D))))
    (if (local.get $signed) (then (return (i32.const 0x4E))))
    (i32.const 0x4F))

  (func $emit_binary (param $c i32) (param $e i32)
    (local $op i32) (local $eb i32) (local $ec i32) (local $ot i32) (local $rt i32)
    (local.set $op (call $nd (local.get $c) (local.get $e) (i32.const 12)))
    (local.set $eb (call $nd (local.get $c) (local.get $e) (i32.const 16)))
    (local.set $ec (call $nd (local.get $c) (local.get $e) (i32.const 20)))
    (if (if (result i32) (i32.eq (local.get $op) (i32.const 8))
            (then (i32.const 1))
            (else (i32.eq (local.get $op) (i32.const 9))))
        (then
          (call $emit_expr (local.get $c) (local.get $eb))
          (call $b_blocked (local.get $c) (i32.const 0x04) (i32.const 0x7F))
          (call $ctrl_push (local.get $c) (i32.const 5))
          (if (i32.eq (local.get $op) (i32.const 8))
              (then (call $emit_expr (local.get $c) (local.get $ec))
                    (call $b_op (local.get $c) (i32.const 0x05))
                    (call $b_i32const (local.get $c) (i32.const 0)))
              (else (call $b_i32const (local.get $c) (i32.const 1))
                    (call $b_op (local.get $c) (i32.const 0x05))
                    (call $emit_expr (local.get $c) (local.get $ec))))
          (call $ctrl_pop (local.get $c))
          (call $b_op (local.get $c) (i32.const 0x0B))
          (return)))
    (call $emit_expr (local.get $c) (local.get $eb))
    (call $emit_expr (local.get $c) (local.get $ec))
    (if (call $is_cmp (local.get $op))
        (then (local.set $ot (call $nd (local.get $c) (local.get $e) (i32.const 24)))
              (call $b_op (local.get $c)
                    (call $cmp_opcode (local.get $op)
                          (i32.eq (call $ty_kind (local.get $c) (local.get $ot))
                                  (i32.const 0))))
              (return)))
    (local.set $rt (call $nd (local.get $c) (local.get $e) (i32.const 36)))
    (call $b_op (local.get $c)
          (call $arith_op (local.get $op)
                (i32.eq (call $ty_kind (local.get $c) (local.get $rt)) (i32.const 0)))))

  (func $emit_expr (param $c i32) (param $e i32)
    (local $k i32) (local $ea i32) (local $eb i32) (local $ec i32) (local $loc i32)
    (local $lt i32) (local $a i32) (local $fi i32) (local $which i32) (local $t i32)
    (local $stride i32) (local $pt i32)
    (local.set $k (call $nd (local.get $c) (local.get $e) (i32.const 0)))
    (local.set $ea (call $nd (local.get $c) (local.get $e) (i32.const 12)))
    (local.set $eb (call $nd (local.get $c) (local.get $e) (i32.const 16)))
    (if (if (result i32) (i32.eq (local.get $k) (i32.const 1))
            (then (i32.const 1))
            (else (if (result i32) (i32.eq (local.get $k) (i32.const 2))
                      (then (i32.const 1))
                      (else (i32.eq (local.get $k) (i32.const 4))))))
        (then (call $b_i32const (local.get $c) (local.get $ea)) (return)))
    (if (i32.eq (local.get $k) (i32.const 3))
        (then (call $b_i32const (local.get $c)
                    (call $nd (local.get $c) (local.get $e) (i32.const 40)))
              (call $b_i32const (local.get $c) (local.get $eb))
              (return)))
    (if (i32.eq (local.get $k) (i32.const 5))
        (then
          (local.set $loc (call $ident_local (local.get $c) (local.get $e)))
          (if (i32.ne (local.get $loc) (i32.const 0))
              (then (local.set $lt (call $rg (local.get $c) (i32.const 156)
                                             (local.get $loc) (i32.const 36)
                                             (i32.const 8)))
                    (call $emit_place_load (local.get $c) (local.get $e) (local.get $lt))
                    (return)))
          (call $b_i32const (local.get $c)
                (call $nd (local.get $c) (local.get $e) (i32.const 40)))
          (return)))
    (if (i32.eq (local.get $k) (i32.const 9))
        (then (call $emit_expr (local.get $c) (local.get $ea)) (return)))
    (if (i32.eq (local.get $k) (i32.const 6))
        (then
          (if (i32.eq (local.get $ea) (i32.const 41))
              (then (call $emit_expr (local.get $c) (local.get $eb))
                    (call $b_op (local.get $c) (i32.const 0x45))
                    (return)))
          (call $b_i32const (local.get $c) (i32.const 0))
          (call $emit_expr (local.get $c) (local.get $eb))
          (call $b_op (local.get $c) (i32.const 0x6B))
          (return)))
    (if (i32.eq (local.get $k) (i32.const 16))
        (then
          ;; the two operands already are the (ptr, len) pair
          (local.set $ec (call $nd (local.get $c) (local.get $e) (i32.const 20)))
          (call $emit_expr (local.get $c) (local.get $eb))
          (call $emit_expr (local.get $c) (local.get $ec))
          (return)))
    (if (i32.eq (local.get $k) (i32.const 17))
        (then
          (local.set $stride (call $nd (local.get $c) (local.get $e) (i32.const 24)))
          (call $emit_expr (local.get $c) (local.get $ea))
          (call $emit_expr (local.get $c) (local.get $eb))
          (call $b_i32const (local.get $c) (local.get $stride))
          (call $b_op (local.get $c) (i32.const 0x6C))
          (call $b_op (local.get $c) (i32.const 0x6A))
          (return)))
    (if (i32.eq (local.get $k) (i32.const 7))
        (then (call $emit_binary (local.get $c) (local.get $e)) (return)))
    (if (i32.eq (local.get $k) (i32.const 10))
        (then
          (local.set $a (local.get $eb))
          (block $brk (loop $cont
            (br_if $brk (i32.eqz (i32.ne (local.get $a) (i32.const 0))))
            (block $cnt
              (if (i32.eq (call $nd (local.get $c) (local.get $a) (i32.const 0))
                          (i32.const 8))
                  (then (call $emit_addr (local.get $c)
                              (call $nd (local.get $c) (local.get $a) (i32.const 16))))
                  (else (call $emit_expr (local.get $c) (local.get $a))))
              (local.set $a (call $nd (local.get $c) (local.get $a) (i32.const 32))))
            (br $cont)))
          (local.set $fi (call $nd (local.get $c) (local.get $e) (i32.const 24)))
          (call $b_idx (local.get $c) (i32.const 0x10)
                (call $rg (local.get $c) (i32.const 144) (local.get $fi) (i32.const 52)
                          (i32.const 20)))
          (return)))
    (if (if (result i32) (i32.eq (local.get $k) (i32.const 12))
            (then (i32.eq (call $nd (local.get $c) (local.get $e) (i32.const 24))
                          (i32.const 0)))
            (else (i32.const 0)))
        (then
          ;; a slice's built-in field: 1 is `len`, 2 is `ptr`
          (local.set $which (call $nd (local.get $c) (local.get $e) (i32.const 40)))
          (call $emit_expr (local.get $c) (local.get $ea))
          (if (i32.eq (local.get $which) (i32.const 2))
              (then (call $b_op (local.get $c) (i32.const 0x1A)) (return)))
          (local.set $t (call $temp (local.get $c)))
          (call $b_idx (local.get $c) (i32.const 0x21) (local.get $t))
          (call $b_op (local.get $c) (i32.const 0x1A))
          (call $b_idx (local.get $c) (i32.const 0x20) (local.get $t))
          (call $release1 (local.get $c) (local.get $t))
          (return)))
    (local.set $pt (call $place_ty (local.get $c) (local.get $e)))
    (call $emit_place_load (local.get $c) (local.get $e) (local.get $pt)))

  ;; --- stores -------------------------------------------------------------

  (func $emit_store_common (param $c i32) (param $ak i32) (param $arg i32)
        (param $ty i32) (param $vk i32) (param $a1 i32) (param $a2 i32) (param $a3 i32)
    (local $ta i32) (local $tp i32) (local $tl i32)
    (local.set $ta (call $temp (local.get $c)))
    (if (i32.eq (local.get $ak) (i32.const 0))
        (then (call $emit_addr (local.get $c) (local.get $arg)))
        (else (call $frame_addr (local.get $c) (local.get $arg))))
    (call $b_idx (local.get $c) (i32.const 0x21) (local.get $ta))
    (if (i32.eq (call $ty_kind (local.get $c) (local.get $ty)) (i32.const 6))
        (then
          (local.set $tp (call $temp (local.get $c)))
          (local.set $tl (call $temp (local.get $c)))
          (call $emit_value (local.get $c) (local.get $vk) (local.get $a1)
                            (local.get $a2) (local.get $a3))
          (call $b_idx (local.get $c) (i32.const 0x21) (local.get $tl))
          (call $b_idx (local.get $c) (i32.const 0x21) (local.get $tp))
          (call $b_idx (local.get $c) (i32.const 0x20) (local.get $ta))
          (call $b_idx (local.get $c) (i32.const 0x20) (local.get $tp))
          (call $b_mem (local.get $c) (i32.const 0x36) (i32.const 2))
          (call $b_idx (local.get $c) (i32.const 0x20) (local.get $ta))
          (call $b_i32const (local.get $c) (i32.const 4))
          (call $b_op (local.get $c) (i32.const 0x6A))
          (call $b_idx (local.get $c) (i32.const 0x20) (local.get $tl))
          (call $b_mem (local.get $c) (i32.const 0x36) (i32.const 2))
          (call $release2 (local.get $c) (local.get $tp) (local.get $tl)))
        (else
          (call $b_idx (local.get $c) (i32.const 0x20) (local.get $ta))
          (call $emit_value (local.get $c) (local.get $vk) (local.get $a1)
                            (local.get $a2) (local.get $a3))
          (call $store_op (local.get $c) (local.get $ty))))
    (call $release1 (local.get $c) (local.get $ta)))

  (func $emit_store_slots (param $c i32) (param $loc i32) (param $vk i32)
        (param $a1 i32) (param $a2 i32) (param $a3 i32)
    (local $slot i32) (local $lt i32)
    (local.set $slot (call $rg (local.get $c) (i32.const 156) (local.get $loc)
                               (i32.const 36) (i32.const 24)))
    (local.set $lt (call $rg (local.get $c) (i32.const 156) (local.get $loc)
                             (i32.const 36) (i32.const 8)))
    (call $emit_value (local.get $c) (local.get $vk) (local.get $a1) (local.get $a2)
                      (local.get $a3))
    (if (i32.eq (call $ty_kind (local.get $c) (local.get $lt)) (i32.const 6))
        (then (call $b_idx (local.get $c) (i32.const 0x21)
                    (i32.add (local.get $slot) (i32.const 1)))
              (call $b_idx (local.get $c) (i32.const 0x21) (local.get $slot))
              (return)))
    (call $b_idx (local.get $c) (i32.const 0x21) (local.get $slot)))

  (func $emit_store_to (param $c i32) (param $place i32) (param $vk i32)
        (param $a1 i32) (param $a2 i32) (param $a3 i32)
    (if (call $in_wasm_local (local.get $c) (local.get $place))
        (then (call $emit_store_slots (local.get $c)
                    (call $ident_local (local.get $c) (local.get $place))
                    (local.get $vk) (local.get $a1) (local.get $a2) (local.get $a3))
              (return)))
    (call $emit_store_common (local.get $c) (i32.const 0) (local.get $place)
          (call $place_ty (local.get $c) (local.get $place))
          (local.get $vk) (local.get $a1) (local.get $a2) (local.get $a3)))

  (func $emit_store_local (param $c i32) (param $loc i32) (param $vk i32)
        (param $a1 i32) (param $a2 i32) (param $a3 i32)
    (if (i32.eqz (call $loc_in_memory (local.get $c) (local.get $loc)))
        (then (call $emit_store_slots (local.get $c) (local.get $loc) (local.get $vk)
                    (local.get $a1) (local.get $a2) (local.get $a3))
              (return)))
    (call $emit_store_common (local.get $c) (i32.const 1) (local.get $loc)
          (call $rg (local.get $c) (i32.const 156) (local.get $loc) (i32.const 36)
                    (i32.const 8))
          (local.get $vk) (local.get $a1) (local.get $a2) (local.get $a3)))

  (func $emit_field_store (param $c i32) (param $ta i32) (param $off i32)
        (param $ty i32) (param $value i32)
    (local $tp i32) (local $tl i32)
    (if (i32.eq (call $ty_kind (local.get $c) (local.get $ty)) (i32.const 6))
        (then
          (local.set $tp (call $temp (local.get $c)))
          (local.set $tl (call $temp (local.get $c)))
          (call $emit_expr (local.get $c) (local.get $value))
          (call $b_idx (local.get $c) (i32.const 0x21) (local.get $tl))
          (call $b_idx (local.get $c) (i32.const 0x21) (local.get $tp))
          (call $b_idx (local.get $c) (i32.const 0x20) (local.get $ta))
          (call $b_i32const (local.get $c) (local.get $off))
          (call $b_op (local.get $c) (i32.const 0x6A))
          (call $b_idx (local.get $c) (i32.const 0x20) (local.get $tp))
          (call $b_mem (local.get $c) (i32.const 0x36) (i32.const 2))
          (call $b_idx (local.get $c) (i32.const 0x20) (local.get $ta))
          (call $b_i32const (local.get $c) (i32.add (local.get $off) (i32.const 4)))
          (call $b_op (local.get $c) (i32.const 0x6A))
          (call $b_idx (local.get $c) (i32.const 0x20) (local.get $tl))
          (call $b_mem (local.get $c) (i32.const 0x36) (i32.const 2))
          (call $release2 (local.get $c) (local.get $tp) (local.get $tl))
          (return)))
    (call $b_idx (local.get $c) (i32.const 0x20) (local.get $ta))
    (call $b_i32const (local.get $c) (local.get $off))
    (call $b_op (local.get $c) (i32.const 0x6A))
    (call $emit_expr (local.get $c) (local.get $value))
    (call $store_op (local.get $c) (local.get $ty)))

  (func $is_agg_lit (param $c i32) (param $e i32) (result i32)
    (local $k i32)
    (local.set $k (call $nd (local.get $c) (local.get $e) (i32.const 0)))
    (if (i32.eq (local.get $k) (i32.const 14)) (then (return (i32.const 1))))
    (if (if (result i32) (i32.eq (local.get $k) (i32.const 12))
            (then (i32.const 1))
            (else (i32.eq (local.get $k) (i32.const 10))))
        (then (return (i32.eq (call $nd (local.get $c) (local.get $e) (i32.const 44))
                              (i32.const 1)))))
    (i32.const 0))

  ;; The literal is written straight into the destination -- no copy.
  (func $emit_agg_init (param $c i32) (param $ta i32) (param $init i32)
    (local $si i32) (local $lf i32) (local $f i32) (local $v i32) (local $a i32)
    (if (i32.eq (call $nd (local.get $c) (local.get $init) (i32.const 0)) (i32.const 14))
        (then
          (local.set $si (call $nd (local.get $c) (local.get $init) (i32.const 24)))
          (local.set $lf (call $nd (local.get $c) (local.get $init) (i32.const 20)))
          (local.set $f (call $rg (local.get $c) (i32.const 84) (local.get $si)
                                  (i32.const 24) (i32.const 8)))
          (block $brk (loop $cont
            (br_if $brk (i32.eqz (i32.ne (local.get $lf) (i32.const 0))))
            (block $cnt
              (call $emit_field_store (local.get $c) (local.get $ta)
                    (call $rg (local.get $c) (i32.const 72) (local.get $f) (i32.const 20)
                              (i32.const 12))
                    (call $rg (local.get $c) (i32.const 72) (local.get $f) (i32.const 20)
                              (i32.const 8))
                    (call $nd (local.get $c) (local.get $lf) (i32.const 20)))
              (local.set $lf (call $nd (local.get $c) (local.get $lf) (i32.const 32)))
              (local.set $f (call $rg (local.get $c) (i32.const 72) (local.get $f)
                                      (i32.const 20) (i32.const 16))))
            (br $cont)))
          (return)))
    (local.set $v (call $nd (local.get $c) (local.get $init) (i32.const 40)))
    (call $b_idx (local.get $c) (i32.const 0x20) (local.get $ta))
    (call $b_i32const (local.get $c) (i32.const 0))
    (call $b_op (local.get $c) (i32.const 0x6A))
    (call $b_i32const (local.get $c)
          (call $rg (local.get $c) (i32.const 96) (local.get $v) (i32.const 24)
                    (i32.const 8)))
    (call $b_mem (local.get $c) (i32.const 0x36) (i32.const 2))
    (local.set $a (i32.const 0))
    (if (i32.eq (call $nd (local.get $c) (local.get $init) (i32.const 0)) (i32.const 10))
        (then (local.set $a (call $nd (local.get $c) (local.get $init) (i32.const 16)))))
    (local.set $f (call $rg (local.get $c) (i32.const 96) (local.get $v) (i32.const 24)
                            (i32.const 12)))
    (block $brk2 (loop $cont2
      (br_if $brk2 (i32.eqz (i32.ne (local.get $a) (i32.const 0))))
      (block $cnt2
        (call $emit_field_store (local.get $c) (local.get $ta)
              (call $rg (local.get $c) (i32.const 72) (local.get $f) (i32.const 20)
                        (i32.const 12))
              (call $rg (local.get $c) (i32.const 72) (local.get $f) (i32.const 20)
                        (i32.const 8))
              (local.get $a))
        (local.set $a (call $nd (local.get $c) (local.get $a) (i32.const 32)))
        (local.set $f (call $rg (local.get $c) (i32.const 72) (local.get $f)
                                (i32.const 20) (i32.const 16))))
      (br $cont2))))

  ;; --- statements ---------------------------------------------------------

  (func $emit_epilogue (param $c i32)
    (local $frame i32)
    (local.set $frame (call $rg (local.get $c) (i32.const 144)
                                (call $cg (local.get $c) (i32.const 308))
                                (i32.const 52) (i32.const 36)))
    (if (i32.ne (local.get $frame) (i32.const 0))
        (then (call $b_idx (local.get $c) (i32.const 0x23) (i32.const 0))
              (call $b_i32const (local.get $c) (local.get $frame))
              (call $b_op (local.get $c) (i32.const 0x6A))
              (call $b_idx (local.get $c) (i32.const 0x24) (i32.const 0)))))

  (func $emit_block (param $c i32) (param $head i32)
    (local $s i32)
    (local.set $s (local.get $head))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.ne (local.get $s) (i32.const 0))))
      (block $cnt
        (call $emit_stmt (local.get $c) (local.get $s))
        (local.set $s (call $nd (local.get $c) (local.get $s) (i32.const 32))))
      (br $cont))))

  (func $emit_match (param $c i32) (param $s i32)
    (local $ta i32) (local $scr i32) (local $arm i32) (local $body i32) (local $v i32)
    (local $b i32) (local $f i32)
    (local.set $ta (call $temp (local.get $c)))
    (local.set $scr (call $nd (local.get $c) (local.get $s) (i32.const 12)))
    (call $emit_addr (local.get $c) (local.get $scr))
    (call $b_idx (local.get $c) (i32.const 0x21) (local.get $ta))
    (call $b_blocked (local.get $c) (i32.const 0x02) (i32.const 0x40))
    (call $ctrl_push (local.get $c) (i32.const 4))
    (local.set $arm (call $nd (local.get $c) (local.get $s) (i32.const 16)))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.ne (local.get $arm) (i32.const 0))))
      (block $cnt
        (local.set $body (call $nd (local.get $c) (local.get $arm) (i32.const 24)))
        (if (i32.ne (call $nd (local.get $c) (local.get $arm) (i32.const 28))
                    (i32.const 0))
            (then (call $emit_block (local.get $c) (local.get $body)))
            (else
              (local.set $v (call $nd (local.get $c) (local.get $arm) (i32.const 40)))
              (call $b_idx (local.get $c) (i32.const 0x20) (local.get $ta))
              (call $b_i32const (local.get $c) (i32.const 0))
              (call $b_op (local.get $c) (i32.const 0x6A))
              (call $b_mem (local.get $c) (i32.const 0x28) (i32.const 2))
              (call $b_i32const (local.get $c)
                    (call $rg (local.get $c) (i32.const 96) (local.get $v) (i32.const 24)
                              (i32.const 8)))
              (call $b_op (local.get $c) (call $cmp_opcode (i32.const 4) (i32.const 0)))
              (call $b_blocked (local.get $c) (i32.const 0x04) (i32.const 0x40))
              (call $ctrl_push (local.get $c) (i32.const 5))
              (local.set $b (call $nd (local.get $c) (local.get $arm) (i32.const 20)))
              (local.set $f (call $rg (local.get $c) (i32.const 96) (local.get $v)
                                      (i32.const 24) (i32.const 12)))
              (block $bbrk (loop $bcont
                (br_if $bbrk (i32.eqz (i32.ne (local.get $b) (i32.const 0))))
                (block $bcnt
                  (call $emit_store_local (local.get $c)
                        (call $nd (local.get $c) (local.get $b) (i32.const 40))
                        (i32.const 1) (local.get $ta)
                        (call $rg (local.get $c) (i32.const 72) (local.get $f)
                                  (i32.const 20) (i32.const 12))
                        (call $rg (local.get $c) (i32.const 72) (local.get $f)
                                  (i32.const 20) (i32.const 8)))
                  (local.set $b (call $nd (local.get $c) (local.get $b) (i32.const 32)))
                  (local.set $f (call $rg (local.get $c) (i32.const 72) (local.get $f)
                                          (i32.const 20) (i32.const 16))))
                (br $bcont)))
              (call $emit_block (local.get $c) (local.get $body))
              (call $b_idx (local.get $c) (i32.const 0x0C)
                    (call $depth_to (local.get $c) (i32.const 4)))
              (call $ctrl_pop (local.get $c))
              (call $b_op (local.get $c) (i32.const 0x0B))))
        (local.set $arm (call $nd (local.get $c) (local.get $arm) (i32.const 32))))
      (br $cont)))
    (if (i32.eq (call $nd (local.get $c) (local.get $s) (i32.const 24)) (i32.const 0))
        (then (call $b_op (local.get $c) (i32.const 0x00))))
    (call $ctrl_pop (local.get $c))
    (call $b_op (local.get $c) (i32.const 0x0B))
    (call $release1 (local.get $c) (local.get $ta)))

  (func $emit_stmt (param $c i32) (param $s i32)
    (local $k i32) (local $sa i32) (local $sb i32) (local $sc i32) (local $sd i32)
    (local $loc i32) (local $ta i32) (local $op i32) (local $base i32) (local $ty i32)
    (local $signed i32) (local $slot i32) (local $et i32) (local $n i32) (local $i i32)
    (local.set $k (call $nd (local.get $c) (local.get $s) (i32.const 0)))
    (local.set $sa (call $nd (local.get $c) (local.get $s) (i32.const 12)))
    (local.set $sb (call $nd (local.get $c) (local.get $s) (i32.const 16)))
    (local.set $sc (call $nd (local.get $c) (local.get $s) (i32.const 20)))
    (local.set $sd (call $nd (local.get $c) (local.get $s) (i32.const 24)))

    (if (i32.eq (local.get $k) (i32.const 30))
        (then
          (local.set $loc (call $nd (local.get $c) (local.get $s) (i32.const 40)))
          (if (call $is_agg_lit (local.get $c) (local.get $sd))
              (then (local.set $ta (call $temp (local.get $c)))
                    (call $frame_addr (local.get $c) (local.get $loc))
                    (call $b_idx (local.get $c) (i32.const 0x21) (local.get $ta))
                    (call $emit_agg_init (local.get $c) (local.get $ta) (local.get $sd))
                    (call $release1 (local.get $c) (local.get $ta))
                    (return)))
          (call $emit_store_local (local.get $c) (local.get $loc) (i32.const 0)
                                  (local.get $sd) (i32.const 0) (i32.const 0))
          (return)))

    (if (i32.eq (local.get $k) (i32.const 31))
        (then
          (local.set $op (local.get $sb))
          (if (i32.eq (local.get $op) (i32.const 30))
              (then
                (if (call $is_agg_lit (local.get $c) (local.get $sc))
                    (then (local.set $ta (call $temp (local.get $c)))
                          (call $emit_addr (local.get $c) (local.get $sa))
                          (call $b_idx (local.get $c) (i32.const 0x21) (local.get $ta))
                          (call $emit_agg_init (local.get $c) (local.get $ta)
                                               (local.get $sc))
                          (call $release1 (local.get $c) (local.get $ta))
                          (return)))
                (call $emit_store_to (local.get $c) (local.get $sa) (i32.const 0)
                                     (local.get $sc) (i32.const 0) (i32.const 0))
                (return)))
          (local.set $base (call $assign_base_op (local.get $op)))
          (local.set $ty (call $place_ty (local.get $c) (local.get $sa)))
          (local.set $signed (i32.eq (call $ty_kind (local.get $c)
                                           (call $read_ty (local.get $c) (local.get $ty)))
                                     (i32.const 0)))
          (if (call $in_wasm_local (local.get $c) (local.get $sa))
              (then
                (local.set $loc (call $ident_local (local.get $c) (local.get $sa)))
                (local.set $slot (call $rg (local.get $c) (i32.const 156) (local.get $loc)
                                           (i32.const 36) (i32.const 24)))
                (call $b_idx (local.get $c) (i32.const 0x20) (local.get $slot))
                (call $emit_expr (local.get $c) (local.get $sc))
                (call $b_op (local.get $c) (call $arith_op (local.get $base)
                                                (local.get $signed)))
                (call $b_idx (local.get $c) (i32.const 0x21) (local.get $slot))
                (return)))
          (local.set $ta (call $temp (local.get $c)))
          (call $emit_addr (local.get $c) (local.get $sa))
          (call $b_idx (local.get $c) (i32.const 0x21) (local.get $ta))
          (call $b_idx (local.get $c) (i32.const 0x20) (local.get $ta))
          (call $b_idx (local.get $c) (i32.const 0x20) (local.get $ta))
          (call $load_op (local.get $c) (local.get $ty))
          (call $emit_expr (local.get $c) (local.get $sc))
          (call $b_op (local.get $c) (call $arith_op (local.get $base)
                                          (local.get $signed)))
          (call $store_op (local.get $c) (local.get $ty))
          (call $release1 (local.get $c) (local.get $ta))
          (return)))

    (if (i32.eq (local.get $k) (i32.const 32))
        (then
          (call $emit_expr (local.get $c) (local.get $sa))
          (if (i32.ne (call $nd (local.get $c) (local.get $s) (i32.const 40))
                      (i32.const 0))
              (then
                (local.set $et (call $nd (local.get $c) (local.get $sa) (i32.const 36)))
                (local.set $n (call $slot_count (local.get $c) (local.get $et)))
                (local.set $i (i32.const 0))
                (block $brk (loop $cont
                  (br_if $brk (i32.eqz (i32.lt_u (local.get $i) (local.get $n))))
                  (block $cnt (call $b_op (local.get $c) (i32.const 0x1A)))
                  (local.set $i (i32.add (local.get $i) (i32.const 1)))
                  (br $cont)))))
          (return)))

    (if (i32.eq (local.get $k) (i32.const 33))
        (then
          (call $emit_expr (local.get $c) (local.get $sa))
          (call $b_blocked (local.get $c) (i32.const 0x04) (i32.const 0x40))
          (call $ctrl_push (local.get $c) (i32.const 5))
          (call $emit_block (local.get $c) (local.get $sb))
          (if (i32.ne (local.get $sd) (i32.const 0))
              (then (call $b_op (local.get $c) (i32.const 0x05))
                    (call $emit_block (local.get $c) (local.get $sc))))
          (call $ctrl_pop (local.get $c))
          (call $b_op (local.get $c) (i32.const 0x0B))
          (return)))

    (if (i32.eq (local.get $k) (i32.const 34))
        (then
          (if (i32.ne (local.get $sa) (i32.const 0))
              (then (call $emit_stmt (local.get $c) (local.get $sa))))
          (call $b_blocked (local.get $c) (i32.const 0x02) (i32.const 0x40))
          (call $ctrl_push (local.get $c) (i32.const 1))
          (call $b_blocked (local.get $c) (i32.const 0x03) (i32.const 0x40))
          (call $ctrl_push (local.get $c) (i32.const 2))
          (if (i32.ne (local.get $sb) (i32.const 0))
              (then (call $emit_expr (local.get $c) (local.get $sb))
                    (call $b_op (local.get $c) (i32.const 0x45))
                    (call $b_idx (local.get $c) (i32.const 0x0D)
                          (call $depth_to (local.get $c) (i32.const 1)))))
          (call $b_blocked (local.get $c) (i32.const 0x02) (i32.const 0x40))
          (call $ctrl_push (local.get $c) (i32.const 3))
          (call $emit_block (local.get $c) (local.get $sd))
          (call $ctrl_pop (local.get $c))
          (call $b_op (local.get $c) (i32.const 0x0B))
          (if (i32.ne (local.get $sc) (i32.const 0))
              (then (call $emit_stmt (local.get $c) (local.get $sc))))
          (call $b_idx (local.get $c) (i32.const 0x0C)
                (call $depth_to (local.get $c) (i32.const 2)))
          (call $ctrl_pop (local.get $c))
          (call $b_op (local.get $c) (i32.const 0x0B))
          (call $ctrl_pop (local.get $c))
          (call $b_op (local.get $c) (i32.const 0x0B))
          (return)))

    (if (i32.eq (local.get $k) (i32.const 35))
        (then (call $b_idx (local.get $c) (i32.const 0x0C)
                    (call $depth_to (local.get $c) (i32.const 1)))
              (return)))
    (if (i32.eq (local.get $k) (i32.const 36))
        (then (call $b_idx (local.get $c) (i32.const 0x0C)
                    (call $depth_to (local.get $c) (i32.const 3)))
              (return)))

    (if (i32.eq (local.get $k) (i32.const 37))
        (then (if (i32.ne (local.get $sa) (i32.const 0))
                  (then (call $emit_expr (local.get $c) (local.get $sa))))
              (call $emit_epilogue (local.get $c))
              (call $b_op (local.get $c) (i32.const 0x0F))
              (return)))

    (if (i32.eq (local.get $k) (i32.const 38))
        (then (call $emit_match (local.get $c) (local.get $s)) (return)))
    (if (i32.eq (local.get $k) (i32.const 39))
        (then (call $emit_block (local.get $c) (local.get $sa)) (return))))

  ;; --- functions ----------------------------------------------------------

  (func $emit_fn (param $c i32) (param $fi i32)
    (local $frame i32) (local $loc i32) (local $slot i32) (local $lt i32)
    (local $ta i32) (local $d i32) (local $body i32) (local $ret i32)
    (local $nlocals i32) (local $declsize i32) (local $codelen i32)
    (call $assign_storage (local.get $c) (local.get $fi))
    (call $cs (local.get $c) (i32.const 260) (i32.const 0x800000))
    (call $cs (local.get $c) (i32.const 280) (i32.const 0))
    (call $cs (local.get $c) (i32.const 292) (i32.const 0))
    (call $cs (local.get $c) (i32.const 304) (i32.const 0))
    (call $cs (local.get $c) (i32.const 308) (local.get $fi))

    (local.set $frame (call $rg (local.get $c) (i32.const 144) (local.get $fi)
                                (i32.const 52) (i32.const 36)))
    (if (i32.ne (local.get $frame) (i32.const 0))
        (then (call $b_idx (local.get $c) (i32.const 0x23) (i32.const 0))
              (call $b_i32const (local.get $c) (local.get $frame))
              (call $b_op (local.get $c) (i32.const 0x6B))
              (call $b_idx (local.get $c) (i32.const 0x24) (i32.const 0))
              (call $b_idx (local.get $c) (i32.const 0x23) (i32.const 0))
              (call $b_i32const (local.get $c) (i32.const 0x1800000))
              (call $b_op (local.get $c) (i32.const 0x49))
              (call $b_blocked (local.get $c) (i32.const 0x04) (i32.const 0x40))
              (call $b_op (local.get $c) (i32.const 0x00))
              (call $b_op (local.get $c) (i32.const 0x0B))))
    ;; a parameter whose address is taken is copied into the frame
    (local.set $loc (call $rg (local.get $c) (i32.const 144) (local.get $fi)
                              (i32.const 52) (i32.const 28)))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.ne (local.get $loc) (i32.const 0))))
      (block $cnt
        (if (if (result i32) (i32.ne (call $rg (local.get $c) (i32.const 156)
                                               (local.get $loc) (i32.const 36)
                                               (i32.const 16))
                                     (i32.const 0))
                (then (i32.ne (call $rg (local.get $c) (i32.const 156) (local.get $loc)
                                        (i32.const 36) (i32.const 28))
                              (i32.const -1)))
                (else (i32.const 0)))
            (then
              (local.set $slot (call $rg (local.get $c) (i32.const 156) (local.get $loc)
                                         (i32.const 36) (i32.const 24)))
              (local.set $lt (call $rg (local.get $c) (i32.const 156) (local.get $loc)
                                       (i32.const 36) (i32.const 8)))
              (call $frame_addr (local.get $c) (local.get $loc))
              (if (i32.eq (call $ty_kind (local.get $c) (local.get $lt)) (i32.const 6))
                  (then
                    (local.set $ta (call $temp (local.get $c)))
                    (call $b_idx (local.get $c) (i32.const 0x21) (local.get $ta))
                    (call $b_idx (local.get $c) (i32.const 0x20) (local.get $ta))
                    (call $b_idx (local.get $c) (i32.const 0x20) (local.get $slot))
                    (call $b_mem (local.get $c) (i32.const 0x36) (i32.const 2))
                    (call $b_idx (local.get $c) (i32.const 0x20) (local.get $ta))
                    (call $b_i32const (local.get $c) (i32.const 4))
                    (call $b_op (local.get $c) (i32.const 0x6A))
                    (call $b_idx (local.get $c) (i32.const 0x20)
                          (i32.add (local.get $slot) (i32.const 1)))
                    (call $b_mem (local.get $c) (i32.const 0x36) (i32.const 2))
                    (call $release1 (local.get $c) (local.get $ta)))
                  (else
                    (call $b_idx (local.get $c) (i32.const 0x20) (local.get $slot))
                    (call $store_op (local.get $c) (local.get $lt))))))
        (local.set $loc (call $rg (local.get $c) (i32.const 156) (local.get $loc)
                                  (i32.const 36) (i32.const 32))))
      (br $cont)))

    (local.set $d (call $rg (local.get $c) (i32.const 144) (local.get $fi) (i32.const 52)
                            (i32.const 24)))
    (local.set $body (call $nd (local.get $c) (local.get $d) (i32.const 28)))
    (call $emit_block (local.get $c) (local.get $body))
    (call $emit_epilogue (local.get $c))
    (local.set $ret (call $rg (local.get $c) (i32.const 144) (local.get $fi)
                              (i32.const 52) (i32.const 16)))
    (if (i32.ne (call $ty_kind (local.get $c) (local.get $ret)) (i32.const 4))
        (then (call $b_op (local.get $c) (i32.const 0x00))))
    (call $b_op (local.get $c) (i32.const 0x0B))

    (local.set $nlocals (i32.add (call $rg (local.get $c) (i32.const 144) (local.get $fi)
                                           (i32.const 52) (i32.const 44))
                                 (call $cg (local.get $c) (i32.const 280))))
    (local.set $declsize (i32.const 1))
    (if (i32.ne (local.get $nlocals) (i32.const 0))
        (then (local.set $declsize (i32.add (i32.add (i32.const 1)
                                                     (call $leb_u_len (local.get $nlocals)))
                                            (i32.const 1)))))
    (local.set $codelen (i32.sub (call $cg (local.get $c) (i32.const 260))
                                 (i32.const 0x800000)))
    (call $s_u (local.get $c) (i32.add (local.get $declsize) (local.get $codelen)))
    (if (i32.eq (local.get $nlocals) (i32.const 0))
        (then (call $s_u (local.get $c) (i32.const 0)))
        (else (call $s_u (local.get $c) (i32.const 1))
              (call $s_u (local.get $c) (local.get $nlocals))
              (call $s_ch (local.get $c) (i32.const 0x7F))))
    (call $w_copy (local.get $c) (i32.const 1) (i32.const 0x800000) (local.get $codelen)))

  ;; --- the module (implementation.md S4) ----------------------------------

  (func $sig_of (param $c i32) (param $fi i32) (result i32)
    (local $n i32) (local $p i32) (local $ret i32)
    (local.set $n (i32.const 0))
    (local.set $p (call $rg (local.get $c) (i32.const 144) (local.get $fi) (i32.const 52)
                            (i32.const 8)))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.ne (local.get $p) (i32.const 0))))
      (block $cnt
        (local.set $n (i32.add (local.get $n)
                               (call $slot_count (local.get $c)
                                     (call $rg (local.get $c) (i32.const 132)
                                               (local.get $p) (i32.const 16)
                                               (i32.const 8)))))
        (local.set $p (call $rg (local.get $c) (i32.const 132) (local.get $p)
                                (i32.const 16) (i32.const 12))))
      (br $cont)))
    ;; every wasm type here is i32, so the shape is (count, has-result)
    (local.set $ret (call $rg (local.get $c) (i32.const 144) (local.get $fi)
                              (i32.const 52) (i32.const 16)))
    (if (i32.eq (call $ty_kind (local.get $c) (local.get $ret)) (i32.const 4))
        (then (return (i32.mul (local.get $n) (i32.const 2)))))
    (i32.add (i32.mul (local.get $n) (i32.const 2)) (i32.const 1)))

  (func $type_idx (param $c i32) (param $sig i32) (result i32)
    (local $n i32) (local $i i32)
    (local.set $n (call $cg (local.get $c) (i32.const 276)))
    (local.set $i (i32.const 0))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.lt_u (local.get $i) (local.get $n))))
      (block $cnt
        (if (i32.eq (i32.load (i32.add (call $cg (local.get $c) (i32.const 268))
                                       (i32.mul (local.get $i) (i32.const 4))))
                    (local.get $sig))
            (then (return (local.get $i)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $cont)))
    (if (i32.ge_u (local.get $n) (call $cg (local.get $c) (i32.const 272)))
        (then (unreachable)))
    (i32.store (i32.add (call $cg (local.get $c) (i32.const 268))
                        (i32.mul (local.get $n) (i32.const 4)))
               (local.get $sig))
    (call $cs (local.get $c) (i32.const 276) (i32.add (local.get $n) (i32.const 1)))
    (local.get $n))

  (func $begin_section (param $c i32)
    (call $cs (local.get $c) (i32.const 264) (i32.const 0xA00000)))

  (func $end_section (param $c i32) (param $id i32)
    (local $n i32)
    (local.set $n (i32.sub (call $cg (local.get $c) (i32.const 264)) (i32.const 0xA00000)))
    (call $w_ch (local.get $c) (i32.const 2) (local.get $id))
    (call $w_u (local.get $c) (i32.const 2) (local.get $n))
    (call $w_copy (local.get $c) (i32.const 2) (i32.const 0xA00000) (local.get $n)))

  (func $emit_module (export "emit_module") (param $c i32)
    (local $fi i32) (local $nfn i32) (local $nfns i32) (local $nsigs i32)
    (local $i i32) (local $sig i32) (local $np i32) (local $j i32) (local $sp2 i32)
    (local $nstr i32)
    (local.set $nfn (call $cg (local.get $c) (i32.const 152)))
    (local.set $fi (i32.const 1))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.lt_u (local.get $fi) (local.get $nfn))))
      (block $cnt
        (drop (call $type_idx (local.get $c) (call $sig_of (local.get $c) (local.get $fi))))
        (local.set $fi (i32.add (local.get $fi) (i32.const 1))))
      (br $cont)))

    (call $out_reset (local.get $c))
    (call $put_ch (local.get $c) (i32.const 0))
    (call $put_ch (local.get $c) (i32.const 97))
    (call $put_ch (local.get $c) (i32.const 115))
    (call $put_ch (local.get $c) (i32.const 109))
    (call $put_ch (local.get $c) (i32.const 1))
    (call $put_ch (local.get $c) (i32.const 0))
    (call $put_ch (local.get $c) (i32.const 0))
    (call $put_ch (local.get $c) (i32.const 0))

    (local.set $nfns (call $cg (local.get $c) (i32.const 256)))
    (local.set $nsigs (call $cg (local.get $c) (i32.const 276)))

    (if (i32.ne (local.get $nsigs) (i32.const 0))
        (then
          (call $begin_section (local.get $c))
          (call $s_u (local.get $c) (local.get $nsigs))
          (local.set $i (i32.const 0))
          (block $sbrk (loop $scont
            (br_if $sbrk (i32.eqz (i32.lt_u (local.get $i) (local.get $nsigs))))
            (block $scnt
              (local.set $sig (i32.load (i32.add (call $cg (local.get $c) (i32.const 268))
                                                 (i32.mul (local.get $i) (i32.const 4)))))
              (local.set $np (i32.div_u (local.get $sig) (i32.const 2)))
              (call $s_ch (local.get $c) (i32.const 0x60))
              (call $s_u (local.get $c) (local.get $np))
              (local.set $j (i32.const 0))
              (block $pbrk (loop $pcont
                (br_if $pbrk (i32.eqz (i32.lt_u (local.get $j) (local.get $np))))
                (block $pcnt (call $s_ch (local.get $c) (i32.const 0x7F)))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $pcont)))
              (if (i32.eq (i32.rem_u (local.get $sig) (i32.const 2)) (i32.const 0))
                  (then (call $s_u (local.get $c) (i32.const 0)))
                  (else (call $s_u (local.get $c) (i32.const 1))
                        (call $s_ch (local.get $c) (i32.const 0x7F)))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $scont)))
          (call $end_section (local.get $c) (i32.const 1))))

    (if (i32.ne (local.get $nfns) (i32.const 0))
        (then
          (call $begin_section (local.get $c))
          (call $s_u (local.get $c) (local.get $nfns))
          (local.set $fi (i32.const 1))
          (block $fbrk (loop $fcont
            (br_if $fbrk (i32.eqz (i32.lt_u (local.get $fi) (local.get $nfn))))
            (block $fcnt
              (call $s_u (local.get $c)
                    (call $type_idx (local.get $c)
                          (call $sig_of (local.get $c) (local.get $fi))))
              (local.set $fi (i32.add (local.get $fi) (i32.const 1))))
            (br $fcont)))
          (call $end_section (local.get $c) (i32.const 3))))

    (call $begin_section (local.get $c))
    (call $s_u (local.get $c) (i32.const 1))
    (call $s_ch (local.get $c) (i32.const 0x01))
    (call $s_u (local.get $c) (i32.const 512))
    (call $s_u (local.get $c) (i32.const 512))
    (call $end_section (local.get $c) (i32.const 5))

    (call $begin_section (local.get $c))
    (call $s_u (local.get $c) (i32.const 1))
    (call $s_ch (local.get $c) (i32.const 0x7F))
    (call $s_ch (local.get $c) (i32.const 0x01))
    (call $s_ch (local.get $c) (i32.const 0x41))
    (call $w_s (local.get $c) (i32.const 1) (i32.const 0x2000000))
    (call $s_ch (local.get $c) (i32.const 0x0B))
    (call $end_section (local.get $c) (i32.const 6))

    (call $begin_section (local.get $c))
    (call $s_u (local.get $c) (i32.add (local.get $nfns) (i32.const 1)))
    (local.set $fi (i32.const 1))
    (block $ebrk (loop $econt
      (br_if $ebrk (i32.eqz (i32.lt_u (local.get $fi) (local.get $nfn))))
      (block $ecnt
        (call $s_u (local.get $c)
              (call $rg (local.get $c) (i32.const 144) (local.get $fi) (i32.const 52)
                        (i32.const 4)))
        (call $w_copy (local.get $c) (i32.const 1)
              (i32.add (i32.const 0x1000)
                       (call $rg (local.get $c) (i32.const 144) (local.get $fi)
                                 (i32.const 52) (i32.const 0)))
              (call $rg (local.get $c) (i32.const 144) (local.get $fi) (i32.const 52)
                        (i32.const 4)))
        (call $s_ch (local.get $c) (i32.const 0x00))
        (call $s_u (local.get $c)
              (call $rg (local.get $c) (i32.const 144) (local.get $fi) (i32.const 52)
                        (i32.const 20)))
        (local.set $fi (i32.add (local.get $fi) (i32.const 1))))
      (br $econt)))
    (call $s_u (local.get $c) (i32.const 6))
    (call $s_ch (local.get $c) (i32.const 109))
    (call $s_ch (local.get $c) (i32.const 101))
    (call $s_ch (local.get $c) (i32.const 109))
    (call $s_ch (local.get $c) (i32.const 111))
    (call $s_ch (local.get $c) (i32.const 114))
    (call $s_ch (local.get $c) (i32.const 121))
    (call $s_ch (local.get $c) (i32.const 0x02))
    (call $s_u (local.get $c) (i32.const 0))
    (call $end_section (local.get $c) (i32.const 7))

    (if (i32.ne (local.get $nfns) (i32.const 0))
        (then
          (call $begin_section (local.get $c))
          (call $s_u (local.get $c) (local.get $nfns))
          (local.set $fi (i32.const 1))
          (block $cbrk (loop $ccont
            (br_if $cbrk (i32.eqz (i32.lt_u (local.get $fi) (local.get $nfn))))
            (block $ccnt
              (call $emit_fn (local.get $c) (local.get $fi))
              (local.set $fi (i32.add (local.get $fi) (i32.const 1))))
            (br $ccont)))
          (call $end_section (local.get $c) (i32.const 10))))

    (if (i32.gt_u (call $cg (local.get $c) (i32.const 176)) (i32.const 1))
        (then
          (local.set $nstr (i32.sub (call $cg (local.get $c) (i32.const 176))
                                    (i32.const 1)))
          (call $begin_section (local.get $c))
          (call $s_u (local.get $c) (local.get $nstr))
          (local.set $sp2 (i32.const 1))
          (block $dbrk (loop $dcont
            (br_if $dbrk (i32.eqz (i32.lt_u (local.get $sp2)
                                            (call $cg (local.get $c) (i32.const 176)))))
            (block $dcnt
              (call $s_ch (local.get $c) (i32.const 0x00))
              (call $s_ch (local.get $c) (i32.const 0x41))
              (call $w_s (local.get $c) (i32.const 1)
                    (call $rg (local.get $c) (i32.const 168) (local.get $sp2)
                              (i32.const 16) (i32.const 8)))
              (call $s_ch (local.get $c) (i32.const 0x0B))
              (call $s_u (local.get $c)
                    (call $rg (local.get $c) (i32.const 168) (local.get $sp2)
                              (i32.const 16) (i32.const 4)))
              (call $w_copy (local.get $c) (i32.const 1)
                    (call $rg (local.get $c) (i32.const 168) (local.get $sp2)
                              (i32.const 16) (i32.const 0))
                    (call $rg (local.get $c) (i32.const 168) (local.get $sp2)
                              (i32.const 16) (i32.const 4)))
              (local.set $sp2 (i32.add (local.get $sp2) (i32.const 1))))
            (br $dcont)))
          (call $end_section (local.get $c) (i32.const 11)))))

  ;; The arenas grow up from the source and S1 is fixed. If the heap ever
  ;; reaches it, two compiler-owned regions alias. cool0.py enforces the same
  ;; limit so the two never diverge (implementation.md S7).
  (func $e_too_large (param $c i32)
    (call $err_msg (local.get $c) (i32.const 1) (i32.const 1)
                   (i32.const 0x1000AA2) (i32.const 46)))

  (func $heap_fits (param $c i32) (result i32)
    (i32.le_u (call $cg (local.get $c) (i32.const 312)) (i32.const 0x800000)))

  ;; ======================================================================
  ;; Entry point (implementation.md S7)
  ;;
  ;; Ctx is an aggregate local in cool0c.cool0, so it lives in the shadow
  ;; frame. 324 bytes rounded to 368 -- Counts sits beside it.
  ;; ======================================================================

  (func $compile (export "compile") (param $src_len_in i32) (result i32)
    (local $c i32) (local $heap0 i32) (local $ntok_max i32) (local $tok_bytes i32)
    (local $nmax i32) (local $nodes_at i32)
    (global.set $sp (i32.sub (global.get $sp) (i32.const 368)))
    (if (i32.lt_u (global.get $sp) (i32.const 0x1800000)) (then (unreachable)))
    (local.set $c (global.get $sp))

    (local.set $heap0 (i32.add (call $align4 (i32.add (i32.const 0x1000)
                                                      (local.get $src_len_in)))
                               (i32.const 4)))
    (local.set $ntok_max (i32.add (local.get $src_len_in) (i32.const 1)))
    (local.set $tok_bytes (i32.mul (local.get $ntok_max) (i32.const 28)))

    ;; Ctx{ ... } -- written straight into the frame, field by field
    (call $cs (local.get $c) (i32.const 0) (i32.const 0x1000))
    (call $cs (local.get $c) (i32.const 4) (local.get $src_len_in))
    (call $cs (local.get $c) (i32.const 8) (i32.const 0))
    (call $cs (local.get $c) (i32.const 12) (i32.const 1))
    (call $cs (local.get $c) (i32.const 16) (i32.const 1))
    (call $cs (local.get $c) (i32.const 20) (local.get $heap0))
    (call $cs (local.get $c) (i32.const 24) (local.get $ntok_max))
    (call $cs (local.get $c) (i32.const 28) (i32.const 0))
    (call $cs (local.get $c) (i32.const 40) (i32.const 1))
    (call $cs (local.get $c) (i32.const 44) (i32.const 0))
    (call $cs (local.get $c) (i32.const 48) (i32.const 0))
    (call $cs (local.get $c) (i32.const 52) (i32.const 0))
    (call $cs (local.get $c) (i32.const 56) (i32.const 0))
    (call $cs (local.get $c) (i32.const 312)
              (i32.add (local.get $heap0) (local.get $tok_bytes)))
    (call $cs (local.get $c) (i32.const 204) (i32.const 0x1000000))
    (call $cs (local.get $c) (i32.const 208) (i32.const 0))
    (call $cs (local.get $c) (i32.const 220) (i32.const 0))
    (call $cs (local.get $c) (i32.const 232) (i32.const 0))
    (call $cs (local.get $c) (i32.const 236) (i32.const 0))
    (call $cs (local.get $c) (i32.const 240) (i32.const 0))
    (call $cs (local.get $c) (i32.const 244) (i32.const 0))
    (call $cs (local.get $c) (i32.const 248) (i32.const 0))
    (call $cs (local.get $c) (i32.const 252) (i32.const 0))
    (call $cs (local.get $c) (i32.const 256) (i32.const 0))
    (call $cs (local.get $c) (i32.const 276) (i32.const 0))
    (call $cs (local.get $c) (i32.const 280) (i32.const 0))
    (call $cs (local.get $c) (i32.const 292) (i32.const 0))
    (call $cs (local.get $c) (i32.const 304) (i32.const 0))
    (call $cs (local.get $c) (i32.const 308) (i32.const 0))
    (call $cs (local.get $c) (i32.const 316) (i32.const 0))
    (call $cs (local.get $c) (i32.const 320) (i32.const 0x1010000))

    ;; before lexing: the token arena alone can reach S1
    (if (i32.eqz (call $heap_fits (local.get $c)))
        (then (call $e_too_large (local.get $c))))
    (if (i32.eq (call $cg (local.get $c) (i32.const 316)) (i32.const 0))
        (then (call $lex (local.get $c))))

    ;; The node arena is sized from the token count, not the source length.
    (if (i32.eq (call $cg (local.get $c) (i32.const 316)) (i32.const 0))
        (then
          (local.set $nmax (i32.add (call $cg (local.get $c) (i32.const 28))
                                    (i32.const 2)))
          (local.set $nodes_at (call $cg (local.get $c) (i32.const 312)))
          (call $cs (local.get $c) (i32.const 32) (local.get $nodes_at))
          (call $cs (local.get $c) (i32.const 36) (local.get $nmax))
          (call $cs (local.get $c) (i32.const 40) (i32.const 1))
          (call $cs (local.get $c) (i32.const 312)
                    (i32.add (local.get $nodes_at)
                             (i32.mul (local.get $nmax) (i32.const 52))))
          (if (i32.eqz (call $heap_fits (local.get $c)))
              (then (call $e_too_large (local.get $c))))
          (if (i32.eq (call $cg (local.get $c) (i32.const 316)) (i32.const 0))
              (then (call $parse_program (local.get $c))))
          (i32.store (i32.const 0x44) (local.get $nodes_at))
          (i32.store (i32.const 0x40) (call $cg (local.get $c) (i32.const 56)))))

    ;; Every checker table is bounded by a count of AST nodes of one kind, so
    ;; one linear pass sizes all of them exactly (count_nodes in cool0c.cool0).
    ;; Here the arenas are laid out one after another from the heap cursor.
    (if (i32.eq (call $cg (local.get $c) (i32.const 316)) (i32.const 0))
        (then
          (call $count_nodes (local.get $c))
          (if (i32.eqz (call $heap_fits (local.get $c)))
              (then (call $e_too_large (local.get $c))))
          (call $init_types (local.get $c))
          (if (i32.eq (call $cg (local.get $c) (i32.const 316)) (i32.const 0))
              (then (call $check_program (local.get $c))))
          (if (i32.eq (call $cg (local.get $c) (i32.const 316)) (i32.const 0))
              (then (call $emit_module (local.get $c))))))

    ;; debug window for the workbench
    (i32.store (i32.const 0x30) (local.get $heap0))
    (i32.store (i32.const 0x2C) (call $cg (local.get $c) (i32.const 28)))
    (i32.store (i32.const 0x14) (call $cg (local.get $c) (i32.const 316)))

    (i32.store (i32.const 0x00) (i32.const 0x1010000))
    (i32.store (i32.const 0x04) (i32.sub (call $cg (local.get $c) (i32.const 320))
                                         (i32.const 0x1010000)))
    (global.set $sp (i32.add (global.get $sp) (i32.const 368)))
    (if (i32.ne (call $cg (local.get $c) (i32.const 316)) (i32.const 0))
        (then (return (i32.const 1))))
    (i32.const 0))

  ;; string literals, first appearance order, exactly as cool0c.cool0 lays out its own
  (data (i32.const 0x1000000)
    "fnstructenumconstletmutifelseforbreakcontinuereturnmatchunsafeastruefalsesliceslice_muto"
    "ffset<<=>>=->=>==!=<=>=&&||<<>>+=-=*=/=%=&=|=^=(){}[],;:.=<>+-*/%&|^!invalid digit in in"
    "teger literalinteger literal has no digitsinteger literal out of rangeunterminated chara"
    "cter literalempty character literalunknown escape sequenceinvalid character in character"
    " literalunterminated string literalinvalid character in string literalnon-ascii byte in "
    "sourceunexpected characterend of fileinteger literalcharacter literalstring literalexpec"
    "ted , found expected identifierexpression nests too deeplytype nests too deeplyi32u32boo"
    "lu8expected typecomparison operators cannot be chainedexpected expressionblock nests too"
    " deeplyexpression statement must be a call_expected `fn`, `struct`, `enum` or `const`voi"
    "d[]mut []&mut unknown type string literals do not fit below the shadow stackduplicate to"
    "p-level name  is a built-in type namestruct fieldenum payload cannot have aggregate type"
    "  cannot have borrow type duplicate field duplicate variant const must have type i32, u3"
    "2 or bool, found const  depends on itself is not a constantcannot cast from cannot cast "
    "to cannot negate cannot apply  to  requires bool operands requires integer operandsdivis"
    "ion by zero in constant expression is not allowed in a constant expressionnot a constant"
    " expressionduplicate parameter cannot pass aggregate  by value is storage-only; use cann"
    "ot return aggregate cannot return a slice (wasm 1.0 has a single result)cannot return a "
    "borrow is already declared in this scope shadows a top-level namefunction  must return a"
    " value on every pathcannot assign to an immutable place requires an integer, found , fou"
    "nd no value is storage-only; there are no u8 localsa borrow cannot be bound to a locallo"
    "cal cannot have type  outside of a loopfunction has no return type requires an enum, fou"
    "nd  has no variant duplicate arm for variant  takes  binding(s), found non-exhaustive ma"
    "tch: missing  must be the last armcannot copy aggregate unknown struct  has  field(s)exp"
    "ected field  value(s)unknown name :  and  do not matchshift amount must be cannot compar"
    "e cannot order  requires  or  argument(s), found  is borrowed mutably and also used in t"
    "he same argument list is borrowed mutably more than oncestruct literal is only allowed a"
    "s an initializerenum literal is only allowed as an initializer, found a borrowcannot bor"
    "row an immutable place as `&mut`callee must be a function nameunknown function  has no f"
    "ield  is a constant, not a place is a type, not a placecannot index raw pointer derefere"
    "nce requires `unsafe`cannot dereference expected a place expressionlenptrexpected a raw "
    "pointer, found functions are not valuesa borrow may only appear as a call argumentprogra"
    "m is too large for the compiler's memory"
  )
)
