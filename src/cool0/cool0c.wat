  ;; --- expressions (SPEC.md S5) -------------------------------------------

  (func $is_cmp (export "is_cmp") (param $p i32) (result i32)
    (if (i32.eq (local.get $p) (i32.const 4)) (then (return (i32.const 1))))
    (if (i32.eq (local.get $p) (i32.const 5)) (then (return (i32.const 1))))
