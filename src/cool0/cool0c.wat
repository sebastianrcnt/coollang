  (func $check_enum_lit (export "check_enum_lit") (param $e i32) (param $want i32)
                        (result i32)
    (local $line i32) (local $col i32) (local $fld i32) (local $args i32)
    (local $base i32) (local $ei i32) (local $v i32) (local $self_ty i32)
    (local $a i32) (local $f i32)
    (local.set $line (call $nd (local.get $e) (i32.const 4)))
    (local.set $col (call $nd (local.get $e) (i32.const 8)))
    (local.set $fld (local.get $e))
    (local.set $args (i32.const 0))
    (if (i32.eq (call $nd (local.get $e) (i32.const 0)) (i32.const 10))
        (then (local.set $fld (call $nd (local.get $e) (i32.const 12)))
              (local.set $args (call $nd (local.get $e) (i32.const 16)))))
    (local.set $base (call $nd (local.get $fld) (i32.const 12)))
    (local.set $ei (call $find_enum (call $nd (local.get $base) (i32.const 12))
                         (call $nd (local.get $base) (i32.const 16))))
    (local.set $v (call $find_variant (local.get $ei) (call $nd (local.get $fld) (i32.const 16))
                        (call $nd (local.get $fld) (i32.const 20))))
    (if (i32.eq (local.get $v) (i32.const 0))
        (then (call $e_no_variant (call $nd (local.get $fld) (i32.const 4))
                    (call $nd (local.get $fld) (i32.const 8))
                    (call $ld (i32.add (local.get $ei) (i32.const 0)))
                    (call $ld (i32.add (local.get $ei) (i32.const 4)))
                    (call $nd (local.get $fld) (i32.const 16))
                    (call $nd (local.get $fld) (i32.const 20)))
              (return (call $ty_i32))))
    (if (i32.ne (call $list_len (local.get $args))
                (call $ld (i32.add (local.get $v) (i32.const 16))))
        (then (call $e_variant_arity (local.get $line) (local.get $col)
                    (call $ld (i32.add (local.get $v) (i32.const 0)))
                    (call $ld (i32.add (local.get $v) (i32.const 4)))
                    (call $ld (i32.add (local.get $v) (i32.const 16))))
              (return (call $ty_i32))))
    (local.set $self_ty (call $ty_named (call $ld (i32.add (local.get $ei) (i32.const 0)))
                              (call $ld (i32.add (local.get $ei) (i32.const 4)))))
    (if (if (result i32) (i32.ne (local.get $want) (i32.const 0))
            (then (i32.ne (local.get $want) (local.get $self_ty)))
            (else (i32.const 0)))
        (then
          (if (call $err_open (local.get $line) (local.get $col))
              (then (call $put_str (i32.const 0x10001F7) (i32.const 9))
                    (call $put_q_ty (local.get $want))
                    (call $put_str (i32.const 0x1000200) (i32.const 8))
                    (call $put_q_src (call $ld (i32.add (local.get $ei) (i32.const 0)))
                          (call $ld (i32.add (local.get $ei) (i32.const 4))))
                    (call $err_end)))
          (return (call $ty_i32))))
    (local.set $a (local.get $args))
    (local.set $f (call $ld (i32.add (local.get $v) (i32.const 12))))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz
        (if (result i32) (i32.ne (local.get $a) (i32.const 0))
            (then (i32.eqz (call $failed)))
            (else (i32.const 0)))))
      (block $cnt
        (drop (call $coerce (local.get $a)
                    (call $read_ty (call $ld (i32.add (local.get $f) (i32.const 8))))))
        (local.set $a (call $nd (local.get $a) (i32.const 32)))
        (local.set $f (call $ld (i32.add (local.get $f) (i32.const 16)))))
      (br $cont)))
    (call $nset (local.get $e) (i32.const 40) (local.get $v))
    (call $nset (local.get $e) (i32.const 44) (i32.const 1))
    (call $nset (local.get $e) (i32.const 36) (local.get $self_ty))
    (local.get $self_ty))

  ;; --- integer literals that have not settled (S2) ------------------------

  (func $retype (export "retype") (param $e i32) (param $t i32)
    (local $k i32) (local $op i32)
    (if (i32.ne (call $ty_kind (call $nd (local.get $e) (i32.const 36))) (i32.const 5))
        (then (return)))
    (call $nset (local.get $e) (i32.const 36) (local.get $t))
    (local.set $k (call $nd (local.get $e) (i32.const 0)))
    (if (i32.eq (local.get $k) (i32.const 6))
        (then (call $retype (call $nd (local.get $e) (i32.const 16)) (local.get $t))
              (return)))
    (if (i32.eq (local.get $k) (i32.const 7))
        (then
          (call $retype (call $nd (local.get $e) (i32.const 16)) (local.get $t))
          (local.set $op (call $nd (local.get $e) (i32.const 12)))
          (if (if (result i32) (i32.ne (local.get $op) (i32.const 10))
                  (then (i32.ne (local.get $op) (i32.const 11)))
                  (else (i32.const 0)))
              (then (call $retype (call $nd (local.get $e) (i32.const 20)) (local.get $t)))))))

  (func $coerce (export "coerce") (param $e i32) (param $want i32) (result i32)
    (local $got i32)
    (local.set $got (call $check_expr (local.get $e) (local.get $want)))
    (if (call $failed) (then (return (local.get $want))))
    (if (if (result i32)
            (if (result i32) (i32.eq (call $ty_kind (local.get $got)) (i32.const 5))
                (then (call $is_int_ty (local.get $want)))
                (else (i32.const 0)))
            (then (i32.ne (call $ty_kind (local.get $want)) (i32.const 5)))
            (else (i32.const 0)))
        (then (call $retype (local.get $e) (local.get $want))
              (return (local.get $want))))
    (if (i32.ne (local.get $got) (local.get $want))
        (then (call $e_expected_ty (call $nd (local.get $e) (i32.const 4))
                    (call $nd (local.get $e) (i32.const 8)) (local.get $want) (local.get $got))
              (return (local.get $want))))
    (local.get $want))

  ;; --- expressions (SPEC.md S5) -------------------------------------------

  (func $int_want (export "int_want") (param $want i32) (result i32)
    (local $k i32)
    (if (i32.eq (local.get $want) (i32.const 0)) (then (return (i32.const 0))))
    (local.set $k (call $ty_kind (local.get $want)))
    (if (if (result i32) (i32.eq (local.get $k) (i32.const 0))
            (then (i32.const 1))
            (else (i32.eq (local.get $k) (i32.const 1))))
        (then (return (local.get $want))))
    (i32.const 0))

  (func $e_unknown_name (export "e_unknown_name") (param $line i32) (param $col i32)
                        (param $s i32) (param $l i32)
    (if (call $err_open (local.get $line) (local.get $col))
        (then (call $put_str (i32.const 0x10007B8) (i32.const 13))
              (call $put_q_src (local.get $s) (local.get $l))
              (call $err_end))))

  (func $e_type_mismatch2 (export "e_type_mismatch2") (param $line i32) (param $col i32)
                          (param $op i32) (param $lt i32) (param $rt i32)
    (if (call $err_open (local.get $line) (local.get $col))
        (then (call $put_q_punct (local.get $op))
              (call $put_str (i32.const 0x10007C5) (i32.const 2))
              (call $put_q_ty (local.get $lt))
              (call $put_str (i32.const 0x10007C7) (i32.const 5))
              (call $put_q_ty (local.get $rt))
              (call $put_str (i32.const 0x10007CC) (i32.const 13))
              (call $err_end))))

  (func $check_binop_types (export "check_binop_types") (param $line i32) (param $col i32)
                           (param $op i32) (param $lt i32) (param $rt i32)
    (local $k i32)
    (if (call $failed) (then (return)))
    (if (if (result i32) (i32.eq (local.get $op) (i32.const 10))
            (then (i32.const 1))
            (else (i32.eq (local.get $op) (i32.const 11))))
        (then
          (if (i32.eqz (call $is_int_ty (local.get $lt)))
              (then (call $e_op_needs_int (local.get $line) (local.get $col)
                          (local.get $op) (local.get $lt))
                    (return)))
          (if (i32.ne (call $ty_kind (local.get $rt)) (i32.const 1))
              (then (if (call $err_open (local.get $line) (local.get $col))
                        (then (call $put_str (i32.const 0x10007D9) (i32.const 21))
                              (call $put_ch (i32.const 96))
                              (call $put_str (i32.const 0x100024E) (i32.const 3))
                              (call $put_ch (i32.const 96))
                              (call $put_str (i32.const 0x1000200) (i32.const 8))
                              (call $put_q_ty (local.get $rt))
                              (call $err_end)))))
          (return)))
    (if (i32.ne (local.get $lt) (local.get $rt))
        (then (call $e_type_mismatch2 (local.get $line) (local.get $col)
                    (local.get $op) (local.get $lt) (local.get $rt))
              (return)))
    (local.set $k (call $ty_kind (local.get $lt)))
    (if (if (result i32) (i32.eq (local.get $op) (i32.const 4))
            (then (i32.const 1))
            (else (i32.eq (local.get $op) (i32.const 5))))
        (then
          (if (if (result i32)
                  (if (result i32)
                      (if (result i32) (i32.ne (local.get $k) (i32.const 0))
                          (then (i32.ne (local.get $k) (i32.const 1)))
                          (else (i32.const 0)))
                      (then (i32.ne (local.get $k) (i32.const 2)))
                      (else (i32.const 0)))
                  (then (i32.ne (local.get $k) (i32.const 8)))
                  (else (i32.const 0)))
              (then (if (call $err_open (local.get $line) (local.get $col))
                        (then (call $put_str (i32.const 0x10007EE) (i32.const 15))
                              (call $put_q_ty (local.get $lt))
                              (call $err_end)))))
          (return)))
    (if (call $is_cmp (local.get $op))
        (then
          (if (if (result i32)
                  (if (result i32) (i32.ne (local.get $k) (i32.const 0))
                      (then (i32.ne (local.get $k) (i32.const 1)))
                      (else (i32.const 0)))
                  (then (i32.ne (local.get $k) (i32.const 8)))
                  (else (i32.const 0)))
              (then (if (call $err_open (local.get $line) (local.get $col))
                        (then (call $put_str (i32.const 0x10007FD) (i32.const 13))
                              (call $put_q_ty (local.get $lt))
                              (call $err_end)))))
          (return)))
    (if (if (result i32) (i32.ne (local.get $k) (i32.const 0))
            (then (i32.ne (local.get $k) (i32.const 1)))
            (else (i32.const 0)))
        (then (if (call $err_open (local.get $line) (local.get $col))
                  (then (call $put_q_punct (local.get $op))
                        (call $put_str (i32.const 0x100080A) (i32.const 10))
                        (call $put_ch (i32.const 96))
                        (call $put_str (i32.const 0x100024B) (i32.const 3))
                        (call $put_ch (i32.const 96))
                        (call $put_str (i32.const 0x1000814) (i32.const 4))
                        (call $put_ch (i32.const 96))
                        (call $put_str (i32.const 0x100024E) (i32.const 3))
                        (call $put_ch (i32.const 96))
                        (call $put_str (i32.const 0x1000200) (i32.const 8))
                        (call $put_q_ty (local.get $lt))
                        (call $err_end))))))

  (func $check_binary (export "check_binary") (param $e i32) (param $want i32) (result i32)
    (local $op i32) (local $line i32) (local $col i32) (local $iw i32) (local $cmpf i32)
    (local $lt i32) (local $lwant i32) (local $rwant i32) (local $rt i32)
    (local $li i32) (local $ri i32)
    (local.set $op (call $nd (local.get $e) (i32.const 12)))
    (local.set $line (call $nd (local.get $e) (i32.const 4)))
    (local.set $col (call $nd (local.get $e) (i32.const 8)))
    (if (if (result i32) (i32.eq (local.get $op) (i32.const 8))
            (then (i32.const 1))
            (else (i32.eq (local.get $op) (i32.const 9))))
        (then
          (drop (call $coerce (call $nd (local.get $e) (i32.const 16)) (call $ty_bool)))
          (drop (call $coerce (call $nd (local.get $e) (i32.const 20)) (call $ty_bool)))
          (return (call $ty_bool))))
    (local.set $iw (call $int_want (local.get $want)))
    (local.set $cmpf (call $is_cmp (local.get $op)))

    (if (if (result i32) (i32.eq (local.get $op) (i32.const 10))
            (then (i32.const 1))
            (else (i32.eq (local.get $op) (i32.const 11))))
        (then
          (local.set $lt (call $check_expr (call $nd (local.get $e) (i32.const 16))
                               (local.get $iw)))
          (drop (call $coerce (call $nd (local.get $e) (i32.const 20)) (call $ty_u32)))
          (if (call $failed) (then (return (call $ty_i32))))
          (if (i32.eq (call $ty_kind (local.get $lt)) (i32.const 5))
              (then
                (if (i32.eq (local.get $iw) (i32.const 0))
                    (then (call $nset (local.get $e) (i32.const 24) (call $ty_intlit))
                          (return (call $ty_intlit))))
                (call $retype (call $nd (local.get $e) (i32.const 16)) (local.get $iw))
                (local.set $lt (local.get $iw))))
          (if (i32.eqz (call $is_int_ty (local.get $lt)))
              (then (call $e_op_needs_int (local.get $line) (local.get $col)
                          (local.get $op) (local.get $lt))
                    (return (call $ty_i32))))
          (call $nset (local.get $e) (i32.const 24) (local.get $lt))
          (return (local.get $lt))))

    (local.set $lwant (local.get $iw))
    (if (local.get $cmpf) (then (local.set $lwant (i32.const 0))))
    (local.set $lt (call $check_expr (call $nd (local.get $e) (i32.const 16))
                         (local.get $lwant)))
    (local.set $rwant (local.get $lt))
    (if (i32.eq (call $ty_kind (local.get $lt)) (i32.const 5))
        (then (local.set $rwant (local.get $lwant))))
    (local.set $rt (call $check_expr (call $nd (local.get $e) (i32.const 20))
                         (local.get $rwant)))
    (if (call $failed) (then (return (call $ty_i32))))
    (local.set $li (i32.eq (call $ty_kind (local.get $lt)) (i32.const 5)))
    (local.set $ri (i32.eq (call $ty_kind (local.get $rt)) (i32.const 5)))
    (if (if (result i32) (local.get $li)
            (then (i32.eqz (local.get $ri)))
            (else (i32.const 0)))
        (then (call $retype (call $nd (local.get $e) (i32.const 16)) (local.get $rt))
              (local.set $lt (local.get $rt)))
        (else (if (if (result i32) (local.get $ri)
                      (then (i32.eqz (local.get $li)))
                      (else (i32.const 0)))
          (then (call $retype (call $nd (local.get $e) (i32.const 20)) (local.get $lt))
                (local.set $rt (local.get $lt)))
          (else (if (if (result i32) (local.get $li)
                        (then (local.get $ri))
                        (else (i32.const 0)))
            (then
              (if (i32.eqz (local.get $cmpf))
                  (then (call $nset (local.get $e) (i32.const 24) (call $ty_intlit))
                        (return (call $ty_intlit))))
              (call $retype (call $nd (local.get $e) (i32.const 16)) (call $ty_i32))
              (call $retype (call $nd (local.get $e) (i32.const 20)) (call $ty_i32))
              (local.set $lt (call $ty_i32))
              (local.set $rt (call $ty_i32))))))))
    (call $check_binop_types (local.get $line) (local.get $col) (local.get $op)
          (local.get $lt) (local.get $rt))
    (call $nset (local.get $e) (i32.const 24) (local.get $lt))
    (if (local.get $cmpf) (then (return (call $ty_bool))))
    (local.get $lt))

  (func $e_arg_count (export "e_arg_count") (param $line i32) (param $col i32)
                     (param $s i32) (param $l i32) (param $want i32) (param $got i32)
    (if (call $err_open (local.get $line) (local.get $col))
        (then (call $put_q_src (local.get $s) (local.get $l))
              (call $put_str (i32.const 0x1000720) (i32.const 7))
              (call $put_num (local.get $want))
              (call $put_str (i32.const 0x1000818) (i32.const 20))
              (call $put_num (local.get $got))
              (call $err_end))))

  (func $count_mentions (export "count_mentions") (param $e i32) (param $loc i32)
                        (result i32)
    (local $k i32) (local $n i32) (local $a i32) (local $f i32)
    (if (i32.eq (local.get $e) (i32.const 0)) (then (return (i32.const 0))))
    (local.set $k (call $nd (local.get $e) (i32.const 0)))
    (if (i32.eq (local.get $k) (i32.const 5))
        (then
          (if (if (result i32)
                  (if (result i32) (i32.eq (call $nd (local.get $e) (i32.const 44)) (i32.const 0))
                      (then (i32.eq (call $nd (local.get $e) (i32.const 40)) (local.get $loc)))
                      (else (i32.const 0)))
                  (then (i32.ne (local.get $loc) (i32.const 0)))
                  (else (i32.const 0)))
              (then (return (i32.const 1))))
          (return (i32.const 0))))
    (if (if (result i32) (i32.eq (local.get $k) (i32.const 6))
            (then (i32.const 1))
            (else (i32.eq (local.get $k) (i32.const 8))))
        (then (return (call $count_mentions (call $nd (local.get $e) (i32.const 16))
                            (local.get $loc)))))
    (if (if (result i32)
            (if (result i32) (i32.eq (local.get $k) (i32.const 9))
                (then (i32.const 1))
                (else (i32.eq (local.get $k) (i32.const 12))))
            (then (i32.const 1))
            (else (i32.eq (local.get $k) (i32.const 13))))
        (then (return (call $count_mentions (call $nd (local.get $e) (i32.const 12))
                            (local.get $loc)))))
    (if (i32.eq (local.get $k) (i32.const 7))
        (then (return (i32.add (call $count_mentions (call $nd (local.get $e) (i32.const 16))
                                     (local.get $loc))
                               (call $count_mentions (call $nd (local.get $e) (i32.const 20))
                                     (local.get $loc))))))
    (if (i32.eq (local.get $k) (i32.const 11))
        (then (return (i32.add (call $count_mentions (call $nd (local.get $e) (i32.const 12))
                                     (local.get $loc))
                               (call $count_mentions (call $nd (local.get $e) (i32.const 16))
                                     (local.get $loc))))))
    (if (i32.eq (local.get $k) (i32.const 10))
        (then
          (local.set $n (call $count_mentions (call $nd (local.get $e) (i32.const 12))
                              (local.get $loc)))
          (local.set $a (call $nd (local.get $e) (i32.const 16)))
          (block $brk (loop $cont
            (br_if $brk (i32.eqz (i32.ne (local.get $a) (i32.const 0))))
            (block $cnt
              (local.set $n (i32.add (local.get $n)
                                     (call $count_mentions (local.get $a) (local.get $loc))))
              (local.set $a (call $nd (local.get $a) (i32.const 32))))
            (br $cont)))
          (return (local.get $n))))
    (if (i32.eq (local.get $k) (i32.const 14))
        (then
          (local.set $n (i32.const 0))
          (local.set $f (call $nd (local.get $e) (i32.const 20)))
          (block $brk2 (loop $cont2
            (br_if $brk2 (i32.eqz (i32.ne (local.get $f) (i32.const 0))))
            (block $cnt2
              (local.set $n (i32.add (local.get $n)
                                     (call $count_mentions (call $nd (local.get $f) (i32.const 20))
                                           (local.get $loc))))
              (local.set $f (call $nd (local.get $f) (i32.const 32))))
            (br $cont2)))
          (return (local.get $n))))
    (i32.const 0))

  (func $e_alias (export "e_alias") (param $line i32) (param $col i32)
                 (param $s i32) (param $l i32) (param $twice i32)
    (if (call $err_open (local.get $line) (local.get $col))
        (then (call $put_q_src (local.get $s) (local.get $l))
              (if (i32.eq (local.get $twice) (i32.const 0))
                  (then (call $put_str (i32.const 0x100082C) (i32.const 60)))
                  (else (call $put_str (i32.const 0x1000868) (i32.const 35))))
              (call $err_end))))

  (func $check_aliasing (export "check_aliasing") (param $e i32)
    (local $line i32) (local $col i32) (local $head i32) (local $a i32)
    (local $root i32) (local $b i32)
    (local.set $line (call $nd (local.get $e) (i32.const 4)))
    (local.set $col (call $nd (local.get $e) (i32.const 8)))
    (local.set $head (call $nd (local.get $e) (i32.const 16)))
    (local.set $a (local.get $head))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz
        (if (result i32) (i32.ne (local.get $a) (i32.const 0))
            (then (i32.eqz (call $failed)))
            (else (i32.const 0)))))
      (block $cnt
        (local.set $root (call $nd (local.get $a) (i32.const 24)))
        (if (if (result i32)
                (if (result i32) (i32.eq (call $nd (local.get $a) (i32.const 0)) (i32.const 8))
                    (then (i32.ne (call $nd (local.get $a) (i32.const 12)) (i32.const 0)))
                    (else (i32.const 0)))
                (then (i32.ne (local.get $root) (i32.const 0)))
                (else (i32.const 0)))
            (then
              (local.set $b (local.get $head))
              (block $brk2 (loop $cont2
                (br_if $brk2 (i32.eqz (i32.ne (local.get $b) (i32.const 0))))
                (block $cnt2
                  (if (if (result i32) (i32.ne (local.get $b) (local.get $a))
                          (then (i32.gt_u (call $count_mentions (local.get $b) (local.get $root))
                                          (i32.const 0)))
                          (else (i32.const 0)))
                      (then (call $e_alias (local.get $line) (local.get $col)
                                  (call $ld (i32.add (local.get $root) (i32.const 0)))
                                  (call $ld (i32.add (local.get $root) (i32.const 4)))
                                  (i32.const 0))
                            (return)))
                  (local.set $b (call $nd (local.get $b) (i32.const 32))))
                (br $cont2)))
              (if (i32.gt_u (call $count_mentions (call $nd (local.get $a) (i32.const 16))
                                  (local.get $root)) (i32.const 1))
                  (then (call $e_alias (local.get $line) (local.get $col)
                              (call $ld (i32.add (local.get $root) (i32.const 0)))
                              (call $ld (i32.add (local.get $root) (i32.const 4)))
                              (i32.const 1))
                        (return)))))
        (local.set $a (call $nd (local.get $a) (i32.const 32))))
      (br $cont))))

  (func $check_borrow (export "check_borrow") (param $b i32) (param $want i32)
    (local $line i32) (local $col i32) (local $opnd i32) (local $ty i32)
    (local $mutable i32) (local $root i32) (local $is_mut i32) (local $got i32)
