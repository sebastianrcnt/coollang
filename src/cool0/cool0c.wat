      (block $cnt
        (if (if (result i32)
                (i32.ne (call $ld (i32.add (local.get $loc) (i32.const 16))) (i32.const 0))
                (then (i32.ne (call $ld (i32.add (local.get $loc) (i32.const 28)))
                              (i32.const -1)))
                (else (i32.const 0)))
