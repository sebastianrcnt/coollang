              (then (call $emit_expr (call $nd (local.get $s) (i32.const 16)))
                    (call $b_op (i32.const 69))
                    (call $b_idx (i32.const 13) (call $depth_to (i32.const 1)))))
          (call $b_blocked (i32.const 2) (i32.const 64))
          (call $ctrl_push (i32.const 3))
          (call $emit_block (call $nd (local.get $s) (i32.const 24)))
          (call $ctrl_pop)
