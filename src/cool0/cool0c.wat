  (func $check_place (param $c i32) (param $e i32) (result i32)
    (local $k i32) (local $line i32) (local $col i32) (local $ea i32) (local $eb i32)
    (local $ec i32) (local $loc i32) (local $lt i32) (local $bt i32) (local $bmut i32)
