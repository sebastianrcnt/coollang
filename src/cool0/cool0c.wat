  (func $is_enum_lit (export "is_enum_lit") (param $e i32) (result i32)
    (local $b i32) (local $base i32)
    (local.set $b (local.get $e))
    (if (i32.eq (call $nd (local.get $e) (i32.const 0)) (i32.const 10))
        (then (local.set $b (call $nd (local.get $e) (i32.const 12)))))
    (if (i32.ne (call $nd (local.get $b) (i32.const 0)) (i32.const 12))
        (then (return (i32.const 0))))
    (local.set $base (call $nd (local.get $b) (i32.const 12)))
    (if (i32.ne (call $nd (local.get $base) (i32.const 0)) (i32.const 5))
        (then (return (i32.const 0))))
    (i32.ne (call $find_enum (call $nd (local.get $base) (i32.const 12))
                  (call $nd (local.get $base) (i32.const 16))) (i32.const 0)))

  (func $e_copy_agg (export "e_copy_agg") (param $line i32) (param $col i32) (param $t i32)
