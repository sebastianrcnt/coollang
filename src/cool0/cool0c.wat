                          (else (if (result i32) (i32.eq (local.get $b) (i32.const 13))
                                    (then (i32.const 1))
                                    (else (i32.eq (local.get $b) (i32.const 32))))))))
            (then (call $adv (local.get $c) (i32.const 1))
                  (br $cnt)))
        (if (if (result i32) (i32.eq (local.get $b) (i32.const 47))
                (then (if (result i32)
                          (i32.lt_u (i32.add (local.get $i) (i32.const 1)) (local.get $n))
                          (then (i32.eq (call $src_at (local.get $c)
                                              (i32.add (local.get $i) (i32.const 1)))
                                        (i32.const 47)))
                          (else (i32.const 0))))
                (else (i32.const 0)))
            (then (call $lex_comment (local.get $c))
                  (br $cnt)))
        (if (call $is_ident_start (local.get $b))
            (then (call $lex_ident (local.get $c)) (br $cnt)))
        (if (call $is_digit (local.get $b))
            (then (call $lex_number (local.get $c)) (br $cnt)))
        (if (i32.eq (local.get $b) (i32.const 39))
            (then (call $lex_char (local.get $c)) (br $cnt)))
        (if (i32.eq (local.get $b) (i32.const 34))
            (then (call $lex_string (local.get $c)) (br $cnt)))
        (local.set $p (call $punct_id (local.get $c) (local.get $i)))
        (if (i32.eq (local.get $p) (i32.const -1))
            (then (local.set $el (call $cg (local.get $c) (i32.const 12)))
                  (local.set $ec (call $cg (local.get $c) (i32.const 16)))
                  (call $err_msg (local.get $c) (local.get $el) (local.get $ec)
                                 (i32.const 0x10001BE) (i32.const 20))
                  (return)))
        (local.set $sl (call $cg (local.get $c) (i32.const 12)))
        (local.set $sc (call $cg (local.get $c) (i32.const 16)))
        (call $adv (local.get $c) (call $punct_len (local.get $p)))
        (call $push_tok (local.get $c) (i32.const 6) (local.get $i)
                        (call $punct_len (local.get $p)) (local.get $p)
                        (local.get $sl) (local.get $sc) (i32.const 0)))
      (br $cont)))
    (if (call $failed (local.get $c)) (then (return)))
    (local.set $ep (call $cg (local.get $c) (i32.const 8)))
    (local.set $el (call $cg (local.get $c) (i32.const 12)))
    (local.set $ec (call $cg (local.get $c) (i32.const 16)))
    (call $push_tok (local.get $c) (i32.const 0) (local.get $ep) (i32.const 0)
                    (i32.const 0) (local.get $el) (local.get $ec) (i32.const 0)))

  ;; ======================================================================
  ;; AST
  ;;
  ;; struct Node is 52 bytes: kind 0, line 4, col 8, a 12, b 16, c 20, d 24,
  ;; e 28, next 32, ty 36, aux 40, aux2 44, depth 48. Arena at Ctx+32,
  ;; count at Ctx+40. Index 0 means "none".
  ;; ======================================================================

  (func $np (param $c i32) (param $n i32) (result i32)
    (if (i32.ge_u (local.get $n) (call $cg (local.get $c) (i32.const 36)))
        (then (unreachable)))
    (i32.add (call $cg (local.get $c) (i32.const 32))
             (i32.mul (local.get $n) (i32.const 52))))

  (func $nd (param $c i32) (param $n i32) (param $f i32) (result i32)
    (i32.load (i32.add (call $np (local.get $c) (local.get $n)) (local.get $f))))

  (func $nset (param $c i32) (param $n i32) (param $f i32) (param $v i32)
    (i32.store (i32.add (call $np (local.get $c) (local.get $n)) (local.get $f))
               (local.get $v)))

  (func $node (export "node") (param $c i32) (param $kind i32) (param $line i32)
        (param $col i32) (result i32)
    (local $n i32) (local $p i32) (local $i i32)
    (local.set $n (call $cg (local.get $c) (i32.const 40)))
    (local.set $p (call $np (local.get $c) (local.get $n)))
    (local.set $i (i32.const 0))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.lt_u (local.get $i) (i32.const 52))))
      (block $cnt (i32.store (i32.add (local.get $p) (local.get $i)) (i32.const 0)))
      (local.set $i (i32.add (local.get $i) (i32.const 4)))
      (br $cont)))
    (i32.store (local.get $p) (local.get $kind))
    (i32.store (i32.add (local.get $p) (i32.const 4)) (local.get $line))
    (i32.store (i32.add (local.get $p) (i32.const 8)) (local.get $col))
    (i32.store (i32.add (local.get $p) (i32.const 48)) (i32.const 1))
    (call $cs (local.get $c) (i32.const 40) (i32.add (local.get $n) (i32.const 1)))
    (local.get $n))

  ;; --- token cursor -------------------------------------------------------

  (func $cur_kind (param $c i32) (result i32)
    (call $tk (local.get $c) (call $cg (local.get $c) (i32.const 44)) (i32.const 0)))

  (func $cur_val (param $c i32) (result i32)
    (call $tk (local.get $c) (call $cg (local.get $c) (i32.const 44)) (i32.const 12)))

  (func $cur_line (param $c i32) (result i32)
    (call $tk (local.get $c) (call $cg (local.get $c) (i32.const 44)) (i32.const 16)))

  (func $cur_col (param $c i32) (result i32)
    (call $tk (local.get $c) (call $cg (local.get $c) (i32.const 44)) (i32.const 20)))

  (func $bump (param $c i32)
    (call $cs (local.get $c) (i32.const 44)
              (i32.add (call $cg (local.get $c) (i32.const 44)) (i32.const 1))))

  (func $at_p (param $c i32) (param $p i32) (result i32)
    (if (result i32) (i32.eq (call $cur_kind (local.get $c)) (i32.const 6))
        (then (i32.eq (call $cur_val (local.get $c)) (local.get $p)))
        (else (i32.const 0))))

  (func $at_kw (param $c i32) (param $k i32) (result i32)
    (if (result i32) (i32.eq (call $cur_kind (local.get $c)) (i32.const 5))
        (then (i32.eq (call $cur_val (local.get $c)) (local.get $k)))
        (else (i32.const 0))))

  (func $eat_p (param $c i32) (param $p i32) (result i32)
    (if (call $at_p (local.get $c) (local.get $p))
        (then (call $bump (local.get $c)) (return (i32.const 1))))
    (i32.const 0))

  (func $eat_kw (param $c i32) (param $k i32) (result i32)
    (if (call $at_kw (local.get $c) (local.get $k))
        (then (call $bump (local.get $c)) (return (i32.const 1))))
    (i32.const 0))

  ;; --- rendering tokens into diagnostics ----------------------------------
  ;;
  ;; The punct and keyword spellings are the same bytes the lexer matched on,
  ;; so they are read straight out of the one data segment.

  (func $put_punct (param $c i32) (param $p i32)
    (local $a i32) (local $l i32)
    ;; three-byte, then two-byte, then one-byte -- same order as the table
    (if (i32.le_u (local.get $p) (i32.const 1))
        (then (call $put_str (local.get $c)
                    (i32.add (i32.const 0x100005D) (i32.mul (local.get $p) (i32.const 3)))
                    (i32.const 3))
              (return)))
    (if (i32.le_u (local.get $p) (i32.const 19))
        (then (call $put_str (local.get $c)
                    (i32.add (i32.const 0x1000063)
                             (i32.mul (i32.sub (local.get $p) (i32.const 2))
                                      (i32.const 2)))
                    (i32.const 2))
              (return)))
    (call $put_str (local.get $c)
                   (i32.add (i32.const 0x1000087) (i32.sub (local.get $p) (i32.const 20)))
                   (i32.const 1)))

  (func $put_kw (param $c i32) (param $k i32)
    (if (i32.eq (local.get $k) (i32.const 0))
        (then (call $put_str (local.get $c) (i32.const 0x1000000) (i32.const 2)) (return)))
    (if (i32.eq (local.get $k) (i32.const 1))
        (then (call $put_str (local.get $c) (i32.const 0x1000002) (i32.const 6)) (return)))
    (if (i32.eq (local.get $k) (i32.const 2))
        (then (call $put_str (local.get $c) (i32.const 0x1000008) (i32.const 4)) (return)))
    (if (i32.eq (local.get $k) (i32.const 3))
        (then (call $put_str (local.get $c) (i32.const 0x100000C) (i32.const 5)) (return)))
    (if (i32.eq (local.get $k) (i32.const 4))
        (then (call $put_str (local.get $c) (i32.const 0x1000011) (i32.const 3)) (return)))
    (if (i32.eq (local.get $k) (i32.const 5))
        (then (call $put_str (local.get $c) (i32.const 0x1000014) (i32.const 3)) (return)))
    (if (i32.eq (local.get $k) (i32.const 6))
        (then (call $put_str (local.get $c) (i32.const 0x1000017) (i32.const 2)) (return)))
    (if (i32.eq (local.get $k) (i32.const 7))
        (then (call $put_str (local.get $c) (i32.const 0x1000019) (i32.const 4)) (return)))
    (if (i32.eq (local.get $k) (i32.const 8))
        (then (call $put_str (local.get $c) (i32.const 0x100001D) (i32.const 3)) (return)))
    (if (i32.eq (local.get $k) (i32.const 9))
        (then (call $put_str (local.get $c) (i32.const 0x1000020) (i32.const 5)) (return)))
    (if (i32.eq (local.get $k) (i32.const 10))
        (then (call $put_str (local.get $c) (i32.const 0x1000025) (i32.const 8)) (return)))
    (if (i32.eq (local.get $k) (i32.const 11))
        (then (call $put_str (local.get $c) (i32.const 0x100002D) (i32.const 6)) (return)))
    (if (i32.eq (local.get $k) (i32.const 12))
        (then (call $put_str (local.get $c) (i32.const 0x1000033) (i32.const 5)) (return)))
    (if (i32.eq (local.get $k) (i32.const 13))
        (then (call $put_str (local.get $c) (i32.const 0x1000038) (i32.const 6)) (return)))
    (if (i32.eq (local.get $k) (i32.const 14))
        (then (call $put_str (local.get $c) (i32.const 0x100003E) (i32.const 2)) (return)))
    (if (i32.eq (local.get $k) (i32.const 15))
        (then (call $put_str (local.get $c) (i32.const 0x1000040) (i32.const 4)) (return)))
    (if (i32.eq (local.get $k) (i32.const 16))
        (then (call $put_str (local.get $c) (i32.const 0x1000044) (i32.const 5)) (return)))
    (if (i32.eq (local.get $k) (i32.const 17))
        (then (call $put_str (local.get $c) (i32.const 0x1000049) (i32.const 5)) (return)))
    (if (i32.eq (local.get $k) (i32.const 18))
        (then (call $put_str (local.get $c) (i32.const 0x100004E) (i32.const 9)) (return)))
    (call $put_str (local.get $c) (i32.const 0x1000057) (i32.const 6)))

  ;; Token.describe() in cool0.py
  (func $put_describe (param $c i32) (param $i i32)
    (local $k i32)
    (local.set $k (call $tk (local.get $c) (local.get $i) (i32.const 0)))
    (if (i32.eq (local.get $k) (i32.const 0))
        (then (call $put_str (local.get $c) (i32.const 0x10001D2) (i32.const 11)) (return)))
    (if (i32.eq (local.get $k) (i32.const 2))
        (then (call $put_str (local.get $c) (i32.const 0x10001DD) (i32.const 15)) (return)))
    (if (i32.eq (local.get $k) (i32.const 3))
        (then (call $put_str (local.get $c) (i32.const 0x10001EC) (i32.const 17)) (return)))
    (if (i32.eq (local.get $k) (i32.const 4))
        (then (call $put_str (local.get $c) (i32.const 0x10001FD) (i32.const 14)) (return)))
    (call $put_ch (local.get $c) (i32.const 96))
    (call $put_src (local.get $c) (call $tk (local.get $c) (local.get $i) (i32.const 4))
                                  (call $tk (local.get $c) (local.get $i) (i32.const 8)))
    (call $put_ch (local.get $c) (i32.const 96)))

  (func $e_expected_p (param $c i32) (param $p i32)
    (local $line i32) (local $col i32) (local $i i32)
    (local.set $line (call $cur_line (local.get $c)))
    (local.set $col (call $cur_col (local.get $c)))
    (local.set $i (call $cg (local.get $c) (i32.const 44)))
    (if (call $err_open (local.get $c) (local.get $line) (local.get $col))
        (then (call $put_str (local.get $c) (i32.const 0x100020B) (i32.const 9))
              (call $put_ch (local.get $c) (i32.const 96))
              (call $put_punct (local.get $c) (local.get $p))
              (call $put_ch (local.get $c) (i32.const 96))
              (call $put_str (local.get $c) (i32.const 0x1000214) (i32.const 8))
              (call $put_describe (local.get $c) (local.get $i))
              (call $err_end (local.get $c)))))

  (func $e_expected_kw (param $c i32) (param $k i32)
    (local $line i32) (local $col i32) (local $i i32)
    (local.set $line (call $cur_line (local.get $c)))
    (local.set $col (call $cur_col (local.get $c)))
    (local.set $i (call $cg (local.get $c) (i32.const 44)))
    (if (call $err_open (local.get $c) (local.get $line) (local.get $col))
        (then (call $put_str (local.get $c) (i32.const 0x100020B) (i32.const 9))
              (call $put_ch (local.get $c) (i32.const 96))
              (call $put_kw (local.get $c) (local.get $k))
              (call $put_ch (local.get $c) (i32.const 96))
              (call $put_str (local.get $c) (i32.const 0x1000214) (i32.const 8))
              (call $put_describe (local.get $c) (local.get $i))
              (call $err_end (local.get $c)))))

  (func $e_expected_str (param $c i32) (param $sp i32) (param $sl i32)
    (local $line i32) (local $col i32) (local $i i32)
    (local.set $line (call $cur_line (local.get $c)))
    (local.set $col (call $cur_col (local.get $c)))
    (local.set $i (call $cg (local.get $c) (i32.const 44)))
    (if (call $err_open (local.get $c) (local.get $line) (local.get $col))
        (then (call $put_str (local.get $c) (local.get $sp) (local.get $sl))
              (call $put_str (local.get $c) (i32.const 0x1000214) (i32.const 8))
              (call $put_describe (local.get $c) (local.get $i))
              (call $err_end (local.get $c)))))

  (func $expect_p (param $c i32) (param $p i32)
    (if (call $failed (local.get $c)) (then (return)))
    (if (call $at_p (local.get $c) (local.get $p))
        (then (call $bump (local.get $c)) (return)))
    (call $e_expected_p (local.get $c) (local.get $p)))

  (func $expect_kw (param $c i32) (param $k i32)
    (if (call $failed (local.get $c)) (then (return)))
    (if (call $at_kw (local.get $c) (local.get $k))
        (then (call $bump (local.get $c)) (return)))
    (call $e_expected_kw (local.get $c) (local.get $k)))

  ;; Returns the token index of the identifier, or NONE.
  (func $expect_ident (param $c i32) (result i32)
    (local $i i32)
    (if (call $failed (local.get $c)) (then (return (i32.const -1))))
    (if (i32.ne (call $cur_kind (local.get $c)) (i32.const 1))
        (then (call $e_expected_str (local.get $c) (i32.const 0x100021C) (i32.const 19))
              (return (i32.const -1))))
    (local.set $i (call $cg (local.get $c) (i32.const 44)))
    (call $bump (local.get $c))
    (local.get $i))

  ;; --- depth guards -------------------------------------------------------

  (func $e_deep_expr (param $c i32) (param $line i32) (param $col i32)
    (call $err_msg (local.get $c) (local.get $line) (local.get $col)
                   (i32.const 0x100022F) (i32.const 27)))

  (func $deep (param $c i32) (param $n i32) (param $maxd i32) (result i32)
    (if (i32.gt_u (i32.add (local.get $maxd) (i32.const 1)) (i32.const 64))
        (then (call $e_deep_expr (local.get $c)
                    (call $nd (local.get $c) (local.get $n) (i32.const 4))
                    (call $nd (local.get $c) (local.get $n) (i32.const 8)))
              (return (local.get $n))))
    (call $nset (local.get $c) (local.get $n) (i32.const 48)
                (i32.add (local.get $maxd) (i32.const 1)))
    (local.get $n))

  (func $depth_of (param $c i32) (param $n i32) (result i32)
    (if (i32.eq (local.get $n) (i32.const 0)) (then (return (i32.const 0))))
    (call $nd (local.get $c) (local.get $n) (i32.const 48)))

  (func $max2 (param $a i32) (param $b i32) (result i32)
    (if (i32.gt_u (local.get $a) (local.get $b)) (then (return (local.get $a))))
    (local.get $b))

  (func $depth_list (param $c i32) (param $head i32) (result i32)
    (local $d i32) (local $p i32)
    (local.set $d (i32.const 0))
    (local.set $p (local.get $head))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.ne (local.get $p) (i32.const 0))))
      (block $cnt
        (local.set $d (call $max2 (local.get $d)
                                  (call $depth_of (local.get $c) (local.get $p))))
        (local.set $p (call $nd (local.get $c) (local.get $p) (i32.const 32))))
      (br $cont)))
    (local.get $d))

  ;; --- types (language.md S3) ---------------------------------------------

  (func $parse_ty (param $c i32) (result i32)
    (local $t i32)
    (if (call $failed (local.get $c)) (then (return (i32.const 0))))
    (if (i32.ge_u (call $cg (local.get $c) (i32.const 48)) (i32.const 64))
        (then (call $err_msg (local.get $c) (call $cur_line (local.get $c))
                             (call $cur_col (local.get $c))
                             (i32.const 0x100024A) (i32.const 21))
              (return (i32.const 0))))
    (call $cs (local.get $c) (i32.const 48)
              (i32.add (call $cg (local.get $c) (i32.const 48)) (i32.const 1)))
    (local.set $t (call $parse_ty_inner (local.get $c)))
    (call $cs (local.get $c) (i32.const 48)
              (i32.sub (call $cg (local.get $c) (i32.const 48)) (i32.const 1)))
    (local.get $t))

  (func $parse_ty_inner (param $c i32) (result i32)
    (local $line i32) (local $col i32) (local $n i32) (local $inner i32)
    (local $s i32) (local $l i32)
    (local.set $line (call $cur_line (local.get $c)))
    (local.set $col (call $cur_col (local.get $c)))
    (if (call $eat_p (local.get $c) (i32.const 24))
        (then (call $expect_p (local.get $c) (i32.const 25))
              (local.set $n (call $node (local.get $c) (i32.const 22)
                                        (local.get $line) (local.get $col)))
              (if (call $eat_kw (local.get $c) (i32.const 5))
                  (then (call $nset (local.get $c) (local.get $n) (i32.const 16)
                                    (i32.const 1))))
              (local.set $inner (call $parse_ty (local.get $c)))
              (call $nset (local.get $c) (local.get $n) (i32.const 12) (local.get $inner))
              (return (local.get $n))))
    (if (call $eat_p (local.get $c) (i32.const 38))
        (then (local.set $n (call $node (local.get $c) (i32.const 23)
                                        (local.get $line) (local.get $col)))
              (if (call $eat_kw (local.get $c) (i32.const 5))
                  (then (call $nset (local.get $c) (local.get $n) (i32.const 16)
                                    (i32.const 1))))
              (local.set $inner (call $parse_ty (local.get $c)))
              (call $nset (local.get $c) (local.get $n) (i32.const 12) (local.get $inner))
              (return (local.get $n))))
    (if (call $eat_p (local.get $c) (i32.const 35))
        (then (local.set $n (call $node (local.get $c) (i32.const 24)
                                        (local.get $line) (local.get $col)))
              (local.set $inner (call $parse_ty (local.get $c)))
              (call $nset (local.get $c) (local.get $n) (i32.const 12) (local.get $inner))
              (return (local.get $n))))
    (if (i32.eq (call $cur_kind (local.get $c)) (i32.const 1))
        (then
          (local.set $s (call $tk (local.get $c) (call $cg (local.get $c) (i32.const 44))
                                  (i32.const 4)))
          (local.set $l (call $tk (local.get $c) (call $cg (local.get $c) (i32.const 44))
                                  (i32.const 8)))
          (call $bump (local.get $c))
          (if (call $src_eq (local.get $c) (local.get $s) (local.get $l)
                            (i32.const 0x100025F) (i32.const 3))
              (then (local.set $n (call $node (local.get $c) (i32.const 20)
                                              (local.get $line) (local.get $col)))
                    (call $nset (local.get $c) (local.get $n) (i32.const 12) (i32.const 0))
                    (return (local.get $n))))
          (if (call $src_eq (local.get $c) (local.get $s) (local.get $l)
                            (i32.const 0x1000262) (i32.const 3))
              (then (local.set $n (call $node (local.get $c) (i32.const 20)
                                              (local.get $line) (local.get $col)))
                    (call $nset (local.get $c) (local.get $n) (i32.const 12) (i32.const 1))
                    (return (local.get $n))))
          (if (call $src_eq (local.get $c) (local.get $s) (local.get $l)
                            (i32.const 0x1000265) (i32.const 4))
