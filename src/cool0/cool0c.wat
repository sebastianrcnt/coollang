          (if (if (result i32) (i32.eq (local.get $bop) (i32.const 8))
                  (then (i32.const 1))
                  (else (i32.eq (local.get $bop) (i32.const 9))))
              (then
                (if (if (result i32) (i32.ne (call $ty_kind (local.get $lt)) (i32.const 2))
                        (then (i32.const 1))
                        (else (i32.ne (call $ty_kind (local.get $rt)) (i32.const 2))))
