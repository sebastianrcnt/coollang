  (func $op_at_level (export "op_at_level") (param $p i32) (param $level i32)
                     (result i32)
    (if (i32.eq (local.get $level) (i32.const 0))
        (then (return (i32.eq (local.get $p) (i32.const 9)))))
    (if (i32.eq (local.get $level) (i32.const 1))
