  (func $find_variant (export "find_variant") (param $ei i32) (param $s i32)
                      (param $l i32) (result i32)
    (local $v i32)
    (local.set $v (call $ld (i32.add (local.get $ei) (i32.const 8))))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.ne (local.get $v) (i32.const 0))))
      (block $cnt
        (if (call $src_eq2 (call $ld (i32.add (local.get $v) (i32.const 0)))
                  (call $ld (i32.add (local.get $v) (i32.const 4)))
                  (local.get $s) (local.get $l))
            (then (return (local.get $v))))
        (local.set $v (call $ld (i32.add (local.get $v) (i32.const 20)))))
      (br $cont)))
    (i32.const 0))

  (func $arm_for_variant (export "arm_for_variant") (param $head i32) (param $s i32)
                         (param $l i32) (result i32)
    (local $a i32)
    (local.set $a (local.get $head))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.ne (local.get $a) (i32.const 0))))
      (block $cnt
        (if (if (result i32) (i32.eq (call $nd (local.get $a) (i32.const 28)) (i32.const 0))
                (then (call $src_eq2 (call $nd (local.get $a) (i32.const 12))
                            (call $nd (local.get $a) (i32.const 16))
                            (local.get $s) (local.get $l)))
                (else (i32.const 0)))
            (then (return (local.get $a))))
        (local.set $a (call $nd (local.get $a) (i32.const 32))))
      (br $cont)))
    (i32.const 0))

