    (local.set $a (local.get $head))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.ne (local.get $a) (i32.const 0))))
      (block $cnt
        (if (i32.eqz (call $diverges (local.get $c)
                           (call $nd (local.get $c) (local.get $a) (i32.const 24))))
            (then (return (i32.const 0))))
        (local.set $a (call $nd (local.get $c) (local.get $a) (i32.const 32))))
      (br $cont)))
    (i32.const 1))

  (func $arm_count (param $c i32) (param $head i32) (result i32)
    (local $n i32) (local $a i32)
    (local.set $n (i32.const 0))
    (local.set $a (local.get $head))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.ne (local.get $a) (i32.const 0))))
      (block $cnt
        (local.set $n (i32.add (local.get $n) (i32.const 1)))
        (local.set $a (call $nd (local.get $c) (local.get $a) (i32.const 32))))
      (br $cont)))
    (local.get $n))

  (func $diverges (param $c i32) (param $head i32) (result i32)
    (local $s i32) (local $k i32) (local $ei i32) (local $arms i32) (local $full i32)
    (local.set $s (local.get $head))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.ne (local.get $s) (i32.const 0))))
      (block $cnt
        (local.set $k (call $nd (local.get $c) (local.get $s) (i32.const 0)))
        (if (i32.eq (local.get $k) (i32.const 37)) (then (return (i32.const 1))))
        (if (i32.eq (local.get $k) (i32.const 35)) (then (return (i32.const 1))))
        (if (i32.eq (local.get $k) (i32.const 36)) (then (return (i32.const 1))))
        (if (i32.eq (local.get $k) (i32.const 33))
            (then (if (if (result i32)
                          (i32.ne (call $nd (local.get $c) (local.get $s) (i32.const 24))
                                  (i32.const 0))
                          (then (if (result i32)
                                    (call $diverges (local.get $c)
                                          (call $nd (local.get $c) (local.get $s)
                                                    (i32.const 16)))
                                    (then (call $diverges (local.get $c)
                                                (call $nd (local.get $c) (local.get $s)
                                                          (i32.const 20))))
                                    (else (i32.const 0))))
                          (else (i32.const 0)))
                      (then (return (i32.const 1))))))
        (if (i32.eq (local.get $k) (i32.const 34))
            (then (if (if (result i32)
                          (i32.eq (call $nd (local.get $c) (local.get $s) (i32.const 16))
                                  (i32.const 0))
                          (then (i32.eqz (call $has_break (local.get $c)
                                               (call $nd (local.get $c) (local.get $s)
                                                         (i32.const 24)))))
                          (else (i32.const 0)))
                      (then (return (i32.const 1))))))
        (if (i32.eq (local.get $k) (i32.const 38))
            (then
              (local.set $ei (call $nd (local.get $c) (local.get $s) (i32.const 20)))
              (local.set $arms (call $nd (local.get $c) (local.get $s) (i32.const 16)))
              (local.set $full (i32.ne (call $nd (local.get $c) (local.get $s)
                                             (i32.const 24))
                                       (i32.const 0)))
              (if (if (result i32) (i32.eqz (local.get $full))
                      (then (i32.ne (local.get $ei) (i32.const 0)))
                      (else (i32.const 0)))
                  (then (local.set $full
                          (i32.eq (call $arm_count (local.get $c) (local.get $arms))
                                  (call $rg (local.get $c) (i32.const 108) (local.get $ei)
                                            (i32.const 28) (i32.const 20))))))
              (if (if (result i32) (local.get $full)
                      (then (call $arms_all_diverge (local.get $c) (local.get $arms)))
                      (else (i32.const 0)))
                  (then (return (i32.const 1))))))
        (if (i32.eq (local.get $k) (i32.const 39))
            (then (if (call $diverges (local.get $c)
                            (call $nd (local.get $c) (local.get $s) (i32.const 12)))
                      (then (return (i32.const 1))))))
        (local.set $s (call $nd (local.get $c) (local.get $s) (i32.const 32))))
      (br $cont)))
    (i32.const 0))

  ;; ======================================================================
  ;; Checking a function body
  ;; ======================================================================

  (func $e_missing_return (param $c i32) (param $line i32) (param $col i32)
        (param $s i32) (param $l i32)
    (if (call $err_open (local.get $c) (local.get $line) (local.get $col))
        (then (call $put_str (local.get $c) (i32.const 0x1000619) (i32.const 9))
              (call $put_q_src (local.get $c) (local.get $s) (local.get $l))
              (call $put_str (local.get $c) (i32.const 0x1000622) (i32.const 34))
              (call $err_end (local.get $c)))))

  (func $check_fn (param $c i32) (param $fi i32)
    (local $d i32) (local $p i32) (local $pi i32) (local $loc i32) (local $body i32)
    (local $ret i32)
    (local.set $d (call $rg (local.get $c) (i32.const 144) (local.get $fi) (i32.const 52)
                            (i32.const 24)))
    (call $cs (local.get $c) (i32.const 236) (local.get $fi))
    (call $cs (local.get $c) (i32.const 220) (i32.const 0))
    (call $cs (local.get $c) (i32.const 232) (i32.const 0))
    (call $cs (local.get $c) (i32.const 240) (i32.const 0))
    (call $cs (local.get $c) (i32.const 244) (i32.const 0))
    (call $push_scope (local.get $c))
    (local.set $p (call $nd (local.get $c) (local.get $d) (i32.const 20)))
    (local.set $pi (call $rg (local.get $c) (i32.const 144) (local.get $fi) (i32.const 52)
                             (i32.const 8)))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz
        (if (result i32) (i32.ne (local.get $p) (i32.const 0))
            (then (if (result i32) (i32.ne (local.get $pi) (i32.const 0))
                      (then (i32.eqz (call $failed (local.get $c))))
                      (else (i32.const 0))))
            (else (i32.const 0)))))
      (block $cnt
        (local.set $loc (call $declare_local (local.get $c)
                              (call $nd (local.get $c) (local.get $p) (i32.const 12))
                              (call $nd (local.get $c) (local.get $p) (i32.const 16))
                              (call $rg (local.get $c) (i32.const 132) (local.get $pi)
                                        (i32.const 16) (i32.const 8))
                              (i32.const 0) (i32.const 1)
                              (call $nd (local.get $c) (local.get $p) (i32.const 4))
                              (call $nd (local.get $c) (local.get $p) (i32.const 8))))
        (call $nset (local.get $c) (local.get $p) (i32.const 40) (local.get $loc))
        (local.set $p (call $nd (local.get $c) (local.get $p) (i32.const 32)))
        (local.set $pi (call $rg (local.get $c) (i32.const 132) (local.get $pi)
                                 (i32.const 16) (i32.const 12))))
      (br $cont)))
    (local.set $body (call $nd (local.get $c) (local.get $d) (i32.const 28)))
    (call $check_block (local.get $c) (local.get $body))
    (if (call $failed (local.get $c)) (then (return)))
    (local.set $ret (call $rg (local.get $c) (i32.const 144) (local.get $fi)
                              (i32.const 52) (i32.const 16)))
    (if (if (result i32) (i32.ne (call $ty_kind (local.get $c) (local.get $ret))
                                 (i32.const 4))
            (then (i32.eqz (call $diverges (local.get $c) (local.get $body))))
            (else (i32.const 0)))
        (then (call $e_missing_return (local.get $c)
                    (call $nd (local.get $c) (local.get $d) (i32.const 4))
                    (call $nd (local.get $c) (local.get $d) (i32.const 8))
                    (call $nd (local.get $c) (local.get $d) (i32.const 12))
                    (call $nd (local.get $c) (local.get $d) (i32.const 16)))
              (return)))
    (call $pop_scope (local.get $c)))

  (func $check_block (param $c i32) (param $head i32)
    (local $s i32)
    (call $push_scope (local.get $c))
    (local.set $s (local.get $head))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz
        (if (result i32) (i32.ne (local.get $s) (i32.const 0))
            (then (i32.eqz (call $failed (local.get $c))))
            (else (i32.const 0)))))
      (block $cnt
        (call $check_stmt (local.get $c) (local.get $s))
        (local.set $s (call $nd (local.get $c) (local.get $s) (i32.const 32))))
      (br $cont)))
    (call $pop_scope (local.get $c)))

  (func $e_immutable_place (param $c i32) (param $line i32) (param $col i32)
    (call $err_msg (local.get $c) (local.get $line) (local.get $col)
                   (i32.const 0x1000644) (i32.const 35)))

  (func $e_op_needs_int (param $c i32) (param $line i32) (param $col i32)
        (param $op i32) (param $t i32)
    (if (call $err_open (local.get $c) (local.get $line) (local.get $col))
        (then (call $put_q_punct (local.get $c) (local.get $op))
              (call $put_str (local.get $c) (i32.const 0x1000667) (i32.const 28))
              (call $put_q_ty (local.get $c) (local.get $t))
              (call $err_end (local.get $c)))))

  (func $e_no_value (param $c i32) (param $line i32) (param $col i32) (param $t i32)
    (if (call $err_open (local.get $c) (local.get $line) (local.get $col))
        (then (call $put_str (local.get $c) (i32.const 0x100020B) (i32.const 9))
              (call $put_q_ty (local.get $c) (local.get $t))
              (call $put_str (local.get $c) (i32.const 0x1000683) (i32.const 16))
              (call $err_end (local.get $c)))))

  (func $e_u8_local (param $c i32) (param $line i32) (param $col i32)
    (if (call $err_open (local.get $c) (local.get $line) (local.get $col))
        (then (call $put_ch (local.get $c) (i32.const 96))
              (call $put_str (local.get $c) (i32.const 0x1000269) (i32.const 2))
              (call $put_ch (local.get $c) (i32.const 96))
              (call $put_str (local.get $c) (i32.const 0x1000693) (i32.const 40))
              (call $err_end (local.get $c)))))

  (func $check_local_ty (param $c i32) (param $t i32) (param $line i32) (param $col i32)
    (local $k i32)
    (local.set $k (call $ty_kind (local.get $c) (local.get $t)))
    (if (i32.eq (local.get $k) (i32.const 3))
        (then (call $e_u8_local (local.get $c) (local.get $line) (local.get $col))
              (return)))
    (if (i32.eq (local.get $k) (i32.const 7))
        (then (call $err_msg (local.get $c) (local.get $line) (local.get $col)
                             (i32.const 0x10006BB) (i32.const 35))
              (return)))
    (if (i32.eq (local.get $k) (i32.const 4))
        (then (if (call $err_open (local.get $c) (local.get $line) (local.get $col))
                  (then (call $put_str (local.get $c) (i32.const 0x10006DE)
                                       (i32.const 23))
                        (call $put_ch (local.get $c) (i32.const 96))
                        (call $put_str (local.get $c) (i32.const 0x1000315)
                                       (i32.const 4))
                        (call $put_ch (local.get $c) (i32.const 96))
                        (call $err_end (local.get $c)))))))

  ;; the base operator behind a compound assignment
  (func $assign_base_op (param $p i32) (result i32)
    (if (i32.eq (local.get $p) (i32.const 12)) (then (return (i32.const 33))))
    (if (i32.eq (local.get $p) (i32.const 13)) (then (return (i32.const 34))))
    (if (i32.eq (local.get $p) (i32.const 14)) (then (return (i32.const 35))))
    (if (i32.eq (local.get $p) (i32.const 15)) (then (return (i32.const 36))))
    (if (i32.eq (local.get $p) (i32.const 16)) (then (return (i32.const 37))))
    (if (i32.eq (local.get $p) (i32.const 17)) (then (return (i32.const 38))))
    (if (i32.eq (local.get $p) (i32.const 18)) (then (return (i32.const 39))))
    (if (i32.eq (local.get $p) (i32.const 19)) (then (return (i32.const 40))))
    (if (i32.eq (local.get $p) (i32.const 0)) (then (return (i32.const 10))))
    (i32.const 11))

  (func $check_stmt (param $c i32) (param $s i32)
    (local $k i32) (local $line i32) (local $col i32)
    (local $sa i32) (local $sb i32) (local $sc i32) (local $sd i32) (local $se i32)
    (local $tn i32) (local $declared i32) (local $t i32) (local $loc i32)
    (local $ty i32) (local $want i32) (local $op i32) (local $base i32)
    (local $ret i32) (local $fi i32)
    (if (call $failed (local.get $c)) (then (return)))
    (local.set $k (call $nd (local.get $c) (local.get $s) (i32.const 0)))
    (local.set $line (call $nd (local.get $c) (local.get $s) (i32.const 4)))
    (local.set $col (call $nd (local.get $c) (local.get $s) (i32.const 8)))
    (local.set $sa (call $nd (local.get $c) (local.get $s) (i32.const 12)))
    (local.set $sb (call $nd (local.get $c) (local.get $s) (i32.const 16)))
    (local.set $sc (call $nd (local.get $c) (local.get $s) (i32.const 20)))
    (local.set $sd (call $nd (local.get $c) (local.get $s) (i32.const 24)))

    (if (i32.eq (local.get $k) (i32.const 30))
        (then
          (local.set $tn (local.get $sc))
          (local.set $declared (i32.const 0))
          (if (i32.ne (local.get $tn) (i32.const 0))
              (then (local.set $declared (call $resolve_ty (local.get $c) (local.get $tn)))
                    (if (call $failed (local.get $c)) (then (return)))
                    (call $check_local_ty (local.get $c) (local.get $declared)
                                          (local.get $line) (local.get $col))
                    (if (call $failed (local.get $c)) (then (return)))))
          (local.set $t (call $check_init (local.get $c) (local.get $sd)
                                          (local.get $declared)))
          (if (call $failed (local.get $c)) (then (return)))
          (if (i32.eq (local.get $declared) (i32.const 0))
              (then
                (if (i32.eq (call $ty_kind (local.get $c) (local.get $t)) (i32.const 5))
                    (then (local.set $t (i32.const 1))
                          (call $retype (local.get $c) (local.get $sd) (local.get $t))))
                (call $check_local_ty (local.get $c) (local.get $t) (local.get $line)
                                      (local.get $col))
                (if (call $failed (local.get $c)) (then (return))))
              (else (local.set $t (local.get $declared))))
          (local.set $se (call $nd (local.get $c) (local.get $s) (i32.const 28)))
          (local.set $loc (call $declare_local (local.get $c) (local.get $sa)
                                (local.get $sb) (local.get $t) (local.get $se)
                                (i32.const 0) (local.get $line) (local.get $col)))
          (call $nset (local.get $c) (local.get $s) (i32.const 40) (local.get $loc))
          (return)))

    (if (i32.eq (local.get $k) (i32.const 31))
        (then
          (local.set $ty (call $check_place (local.get $c) (local.get $sa)))
          (if (call $failed (local.get $c)) (then (return)))
          (if (i32.eq (call $cg (local.get $c) (i32.const 248)) (i32.const 0))
              (then (call $e_immutable_place (local.get $c) (local.get $line)
                                             (local.get $col))
                    (return)))
          (local.set $want (call $read_ty (local.get $c) (local.get $ty)))
          (local.set $op (local.get $sb))
          (if (i32.eq (local.get $op) (i32.const 30))
              (then (drop (call $check_init (local.get $c) (local.get $sc)
                                (local.get $want)))
                    (return)))
          (local.set $base (call $assign_base_op (local.get $op)))
          (if (if (result i32) (i32.eq (local.get $base) (i32.const 10))
                  (then (i32.const 1))
                  (else (i32.eq (local.get $base) (i32.const 11))))
              (then (if (i32.eqz (call $is_int_ty (local.get $c) (local.get $want)))
                        (then (call $e_op_needs_int (local.get $c) (local.get $line)
                                    (local.get $col) (local.get $base) (local.get $want))
                              (return)))
                    (drop (call $coerce (local.get $c) (local.get $sc) (i32.const 2)))
                    (return)))
          (drop (call $coerce (local.get $c) (local.get $sc) (local.get $want)))
          (if (call $failed (local.get $c)) (then (return)))
          (call $check_binop_types (local.get $c) (local.get $line) (local.get $col)
                                   (local.get $base) (local.get $want) (local.get $want))
          (return)))

    (if (i32.eq (local.get $k) (i32.const 32))
        (then
          (local.set $t (call $check_expr (local.get $c) (local.get $sa) (i32.const 0)))
          (if (call $failed (local.get $c)) (then (return)))
          (if (i32.ne (call $ty_kind (local.get $c) (local.get $t)) (i32.const 4))
              (then (call $nset (local.get $c) (local.get $s) (i32.const 40)
                                (i32.const 1))))
          (return)))

    (if (i32.eq (local.get $k) (i32.const 33))
        (then
          (drop (call $coerce (local.get $c) (local.get $sa) (i32.const 3)))
          (if (call $failed (local.get $c)) (then (return)))
          (call $check_block (local.get $c) (local.get $sb))
          (if (i32.ne (local.get $sd) (i32.const 0))
              (then (call $check_block (local.get $c) (local.get $sc))))
          (return)))

    (if (i32.eq (local.get $k) (i32.const 34))
        (then
          (call $push_scope (local.get $c))
          (if (i32.ne (local.get $sa) (i32.const 0))
              (then (call $check_stmt (local.get $c) (local.get $sa))))
          (if (i32.ne (local.get $sb) (i32.const 0))
              (then (drop (call $coerce (local.get $c) (local.get $sb) (i32.const 3)))))
          (call $cs (local.get $c) (i32.const 240)
                    (i32.add (call $cg (local.get $c) (i32.const 240)) (i32.const 1)))
          (call $check_block (local.get $c) (local.get $sd))
          (if (i32.ne (local.get $sc) (i32.const 0))
              (then (call $check_stmt (local.get $c) (local.get $sc))))
          (call $cs (local.get $c) (i32.const 240)
                    (i32.sub (call $cg (local.get $c) (i32.const 240)) (i32.const 1)))
          (call $pop_scope (local.get $c))
          (return)))

    (if (if (result i32) (i32.eq (local.get $k) (i32.const 35))
            (then (i32.const 1))
            (else (i32.eq (local.get $k) (i32.const 36))))
        (then
          (if (i32.eq (call $cg (local.get $c) (i32.const 240)) (i32.const 0))
              (then (if (call $err_open (local.get $c) (local.get $line) (local.get $col))
                        (then (call $put_ch (local.get $c) (i32.const 96))
                              (if (i32.eq (local.get $k) (i32.const 35))
                                  (then (call $put_str (local.get $c) (i32.const 0x1000020)
                                                       (i32.const 5)))
                                  (else (call $put_str (local.get $c) (i32.const 0x1000025)
                                                       (i32.const 8))))
                              (call $put_ch (local.get $c) (i32.const 96))
                              (call $put_str (local.get $c) (i32.const 0x10006F5)
                                             (i32.const 18))
                              (call $err_end (local.get $c))))))
          (return)))

    (if (i32.eq (local.get $k) (i32.const 37))
        (then
          (local.set $fi (call $cg (local.get $c) (i32.const 236)))
          (local.set $ret (call $rg (local.get $c) (i32.const 144) (local.get $fi)
                                    (i32.const 52) (i32.const 16)))
          (if (i32.eq (local.get $sa) (i32.const 0))
              (then (if (i32.ne (call $ty_kind (local.get $c) (local.get $ret))
                                (i32.const 4))
                        (then (call $e_no_value (local.get $c) (local.get $line)
                                    (local.get $col) (local.get $ret))))
                    (return)))
          (if (i32.eq (call $ty_kind (local.get $c) (local.get $ret)) (i32.const 4))
              (then (call $err_msg (local.get $c) (local.get $line) (local.get $col)
                                   (i32.const 0x1000707) (i32.const 27))
                    (return)))
          (drop (call $coerce (local.get $c) (local.get $sa) (local.get $ret)))
          (return)))

    (if (i32.eq (local.get $k) (i32.const 38))
        (then (call $check_match (local.get $c) (local.get $s)) (return)))

    (if (i32.eq (local.get $k) (i32.const 39))
        (then
          (call $cs (local.get $c) (i32.const 244)
                    (i32.add (call $cg (local.get $c) (i32.const 244)) (i32.const 1)))
          (call $check_block (local.get $c) (local.get $sa))
          (call $cs (local.get $c) (i32.const 244)
                    (i32.sub (call $cg (local.get $c) (i32.const 244)) (i32.const 1)))
          (return))))

  ;; ======================================================================
  ;; match (language.md S6)
  ;; ======================================================================

  (func $e_match_needs_enum (param $c i32) (param $line i32) (param $col i32)
        (param $t i32)
    (if (call $err_open (local.get $c) (local.get $line) (local.get $col))
        (then (call $put_ch (local.get $c) (i32.const 96))
              (call $put_str (local.get $c) (i32.const 0x1000033) (i32.const 5))
              (call $put_ch (local.get $c) (i32.const 96))
              (call $put_str (local.get $c) (i32.const 0x1000722) (i32.const 25))
              (call $put_q_ty (local.get $c) (local.get $t))
              (call $err_end (local.get $c)))))

  (func $e_no_variant (param $c i32) (param $line i32) (param $col i32)
        (param $ens i32) (param $enl i32) (param $vs i32) (param $vl i32)
    (if (call $err_open (local.get $c) (local.get $line) (local.get $col))
        (then (call $put_q_src (local.get $c) (local.get $ens) (local.get $enl))
              (call $put_str (local.get $c) (i32.const 0x100073B) (i32.const 16))
              (call $put_q_src (local.get $c) (local.get $vs) (local.get $vl))
              (call $err_end (local.get $c)))))

  (func $e_dup_arm (param $c i32) (param $line i32) (param $col i32)
