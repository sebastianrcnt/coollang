  (func $parse_bin (export "parse_bin") (param $level i32) (param $asl i32) (result i32)
    (local $lhs i32) (local $line i32) (local $col i32) (local $op i32)
    (local $rhs i32) (local $n i32)
    (if (call $failed) (then (return (i32.const 0))))
    (if (i32.eq (local.get $level) (i32.const 2))
        (then (return (call $parse_cmp (local.get $asl)))))
    (if (i32.ge_u (local.get $level) (i32.const 9))
        (then (return (call $parse_unary (local.get $asl)))))
    (local.set $lhs (call $parse_bin (i32.add (local.get $level) (i32.const 1))
                          (local.get $asl)))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz
        (if (result i32)
            (if (result i32) (i32.eqz (call $failed))
                (then (i32.eq (call $cur_kind) (i32.const 6)))
                (else (i32.const 0)))
            (then (call $op_at_level (call $cur_val) (local.get $level)))
            (else (i32.const 0)))))
      (block $cnt
        (local.set $line (call $cur_line))
        (local.set $col (call $cur_col))
        (local.set $op (call $cur_val))
        (call $bump)
        (local.set $rhs (call $parse_bin (i32.add (local.get $level) (i32.const 1))
                              (local.get $asl)))
