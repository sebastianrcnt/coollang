  (func $check_init (export "check_init") (param $e i32) (param $want i32) (result i32)
    (local $t i32)
    (if (call $failed) (then (return (call $ty_i32))))
    (if (i32.eq (call $nd (local.get $e) (i32.const 0)) (i32.const 14))
        (then (return (call $check_struct_lit (local.get $e) (local.get $want)))))
    (if (call $is_enum_lit (local.get $e))
        (then (return (call $check_enum_lit (local.get $e) (local.get $want)))))
    (if (if (result i32) (i32.ne (local.get $want) (i32.const 0))
            (then (i32.eqz (call $is_aggregate (local.get $want))))
            (else (i32.const 0)))
        (then (return (call $coerce (local.get $e) (local.get $want)))))
    (local.set $t (call $check_expr (local.get $e) (local.get $want)))
    (if (call $failed) (then (return (call $ty_i32))))
    (if (call $is_aggregate (local.get $t))
        (then (call $e_copy_agg (call $nd (local.get $e) (i32.const 4))
                    (call $nd (local.get $e) (i32.const 8)) (local.get $t))
              (return (call $ty_i32))))
    (if (if (result i32) (i32.ne (local.get $want) (i32.const 0))
            (then (i32.ne (local.get $t) (local.get $want)))
            (else (i32.const 0)))
        (then (call $e_expected_ty (call $nd (local.get $e) (i32.const 4))
                    (call $nd (local.get $e) (i32.const 8)) (local.get $want) (local.get $t))
              (return (call $ty_i32))))
    (local.get $t))

