  ;; Returns the value; the type comes back in G_CETY (180).
  (func $const_expr (export "const_expr") (param $e i32) (param $want i32) (result i32)
    (local $iwant i32) (local $k i32) (local $line i32) (local $col i32)
    (local $ci i32)
    (local $cv i32) (local $ct i32) (local $dst i32) (local $dk i32)
    (local $uop i32) (local $sub_want i32) (local $uv i32) (local $ut i32)
    (local $bop i32) (local $cmpf i32) (local $lwant i32) (local $lv i32) (local $lt i32)
    (local $rwant i32) (local $rv i32) (local $rt i32) (local $bt i32) (local $sh i32)
    (local $signed i32)
    (if (call $failed)
        (then (call $st (i32.const 180) (call $ty_i32)) (return (i32.const 0))))
    (local.set $iwant (i32.const 0))
    (if (if (result i32)
            (if (result i32) (i32.ne (local.get $want) (i32.const 0))
                (then (call $is_int_ty (local.get $want)))
                (else (i32.const 0)))
            (then (i32.ne (call $ty_kind (local.get $want)) (i32.const 5)))
            (else (i32.const 0)))
        (then (local.set $iwant (local.get $want))))
    (local.set $k (call $nd (local.get $e) (i32.const 0)))
    (local.set $line (call $nd (local.get $e) (i32.const 4)))
    (local.set $col (call $nd (local.get $e) (i32.const 8)))

    (if (i32.eq (local.get $k) (i32.const 1))
        (then (call $st (i32.const 180) (call $ty_intlit))
              (return (call $nd (local.get $e) (i32.const 12)))))
    (if (i32.eq (local.get $k) (i32.const 2))
        (then (call $st (i32.const 180) (call $ty_u32))
              (return (call $nd (local.get $e) (i32.const 12)))))
    (if (i32.eq (local.get $k) (i32.const 4))
        (then (call $st (i32.const 180) (call $ty_bool))
              (return (call $nd (local.get $e) (i32.const 12)))))
    (if (i32.eq (local.get $k) (i32.const 5))
        (then
          (local.set $ci (call $find_const (call $nd (local.get $e) (i32.const 12))
                               (call $nd (local.get $e) (i32.const 16))))
          (if (i32.ne (local.get $ci) (i32.const 0))
              (then
                (drop (call $force_const (local.get $ci) (local.get $line) (local.get $col)))
                (call $st (i32.const 180) (call $ld (i32.add (local.get $ci) (i32.const 8))))
                (return (call $ld (i32.add (local.get $ci) (i32.const 12))))))
          (call $e_not_const (local.get $line) (local.get $col)
                (call $nd (local.get $e) (i32.const 12))
                (call $nd (local.get $e) (i32.const 16)))
          (call $st (i32.const 180) (call $ty_i32))
          (return (i32.const 0))))
    (if (i32.eq (local.get $k) (i32.const 9))
        (then
          (local.set $cv (call $const_expr (call $nd (local.get $e) (i32.const 12))
                               (i32.const 0)))
          (local.set $ct (call $ld (i32.const 180)))
          (local.set $dst (call $resolve_ty (call $nd (local.get $e) (i32.const 16))))
          (if (call $failed)
              (then (call $st (i32.const 180) (call $ty_i32)) (return (i32.const 0))))
          (if (if (result i32) (i32.eqz (call $is_int_ty (local.get $ct)))
                  (then (i32.ne (call $ty_kind (local.get $ct)) (i32.const 8)))
                  (else (i32.const 0)))
              (then (call $e_cast_from (local.get $line) (local.get $col) (local.get $ct))
                    (call $st (i32.const 180) (call $ty_i32))
                    (return (i32.const 0))))
          (local.set $dk (call $ty_kind (local.get $dst)))
          (if (if (result i32)
                  (if (result i32) (i32.ne (local.get $dk) (i32.const 0))
                      (then (i32.ne (local.get $dk) (i32.const 1)))
                      (else (i32.const 0)))
                  (then (i32.ne (local.get $dk) (i32.const 8)))
                  (else (i32.const 0)))
              (then (call $e_cast_to (local.get $line) (local.get $col) (local.get $dst))
                    (call $st (i32.const 180) (call $ty_i32))
                    (return (i32.const 0))))
          (call $st (i32.const 180) (local.get $dst))
          (return (local.get $cv))))
    (if (i32.eq (local.get $k) (i32.const 6))
        (then
          (local.set $uop (call $nd (local.get $e) (i32.const 12)))
          (local.set $sub_want (call $ty_bool))
          (if (i32.eq (local.get $uop) (i32.const 34))
              (then (local.set $sub_want (local.get $want))))
          (local.set $uv (call $const_expr (call $nd (local.get $e) (i32.const 16))
                               (local.get $sub_want)))
          (local.set $ut (call $ld (i32.const 180)))
          (if (call $failed)
              (then (call $st (i32.const 180) (call $ty_i32)) (return (i32.const 0))))
          (if (i32.eq (local.get $uop) (i32.const 34))
              (then
                (if (i32.eqz (call $is_int_ty (local.get $ut)))
                    (then (call $e_negate (local.get $line) (local.get $col) (local.get $ut))
                          (call $st (i32.const 180) (call $ty_i32))
                          (return (i32.const 0))))
                (call $st (i32.const 180) (local.get $ut))
                (return (i32.sub (i32.const 0) (local.get $uv)))))
          (if (i32.ne (call $ty_kind (local.get $ut)) (i32.const 2))
              (then (call $e_not_bool (local.get $line) (local.get $col) (local.get $ut))
                    (call $st (i32.const 180) (call $ty_i32))
                    (return (i32.const 0))))
          (call $st (i32.const 180) (call $ty_bool))
          (return (i32.sub (i32.const 1) (local.get $uv)))))
    (if (i32.eq (local.get $k) (i32.const 7))
        (then
          (local.set $bop (call $nd (local.get $e) (i32.const 12)))
          (local.set $cmpf
            (if (result i32) (call $is_cmp (local.get $bop))
                (then (i32.const 1))
                (else (if (result i32) (i32.eq (local.get $bop) (i32.const 8))
