  (func $check_match (export "check_match") (param $s i32)
    (local $ty i32) (local $line i32) (local $col i32) (local $ei i32)
    (local $head i32) (local $wild i32) (local $seen i32) (local $a i32)
    (local $al i32) (local $ac i32) (local $v i32) (local $nb i32)
    (local $b i32) (local $f i32) (local $v2 i32)
    (local.set $ty (call $check_place (call $nd (local.get $s) (i32.const 12))))
    (if (call $failed) (then (return)))
    (local.set $line (call $nd (local.get $s) (i32.const 4)))
    (local.set $col (call $nd (local.get $s) (i32.const 8)))
    (if (i32.ne (call $ty_kind (local.get $ty)) (i32.const 9))
        (then (call $e_match_needs_enum (local.get $line) (local.get $col) (local.get $ty))
              (return)))
    (local.set $ei (call $agg_enum (local.get $ty)))
    (if (i32.eq (local.get $ei) (i32.const 0))
        (then (call $e_match_needs_enum (local.get $line) (local.get $col) (local.get $ty))
              (return)))
    (call $nset (local.get $s) (i32.const 20) (local.get $ei))
    (local.set $head (call $nd (local.get $s) (i32.const 16)))
    (local.set $wild (i32.const 0))
    (local.set $seen (i32.const 0))
    (local.set $a (local.get $head))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz
        (if (result i32) (i32.ne (local.get $a) (i32.const 0))
            (then (i32.eqz (call $failed)))
            (else (i32.const 0)))))
      (block $cnt
        (local.set $al (call $nd (local.get $a) (i32.const 4)))
        (local.set $ac (call $nd (local.get $a) (i32.const 8)))
        (if (i32.ne (call $nd (local.get $a) (i32.const 28)) (i32.const 0))
            (then
              (if (i32.ne (call $nd (local.get $a) (i32.const 32)) (i32.const 0))
                  (then (if (call $err_open (local.get $al) (local.get $ac))
                            (then (call $put_ch (i32.const 96))
                                  (call $put_str (i32.const 0x10002D6) (i32.const 1))
                                  (call $put_ch (i32.const 96))
                                  (call $put_str (i32.const 0x1000758) (i32.const 21))
                                  (call $err_end)))
                        (return)))
              (local.set $wild (i32.const 1))
              (call $push_scope)
              (call $check_block (call $nd (local.get $a) (i32.const 24)))
              (call $pop_scope)
              (local.set $a (call $nd (local.get $a) (i32.const 32)))
              (br $cnt)))
        (local.set $v (call $find_variant (local.get $ei) (call $nd (local.get $a) (i32.const 12))
                            (call $nd (local.get $a) (i32.const 16))))
        (if (i32.eq (local.get $v) (i32.const 0))
            (then (call $e_no_variant (local.get $al) (local.get $ac)
                        (call $ld (i32.add (local.get $ei) (i32.const 0)))
                        (call $ld (i32.add (local.get $ei) (i32.const 4)))
                        (call $nd (local.get $a) (i32.const 12))
                        (call $nd (local.get $a) (i32.const 16)))
                  (return)))
        (if (i32.ne (call $arm_for_variant (local.get $head) (call $nd (local.get $a) (i32.const 12))
                          (call $nd (local.get $a) (i32.const 16))) (local.get $a))
            (then (call $e_dup_arm (local.get $al) (local.get $ac)
                        (call $nd (local.get $a) (i32.const 12))
                        (call $nd (local.get $a) (i32.const 16)))
                  (return)))
        (call $nset (local.get $a) (i32.const 40) (local.get $v))
        (local.set $nb (call $list_len (call $nd (local.get $a) (i32.const 20))))
        (if (i32.ne (local.get $nb) (call $ld (i32.add (local.get $v) (i32.const 16))))
            (then (call $e_bind_arity (local.get $al) (local.get $ac)
                        (call $nd (local.get $a) (i32.const 12))
                        (call $nd (local.get $a) (i32.const 16))
                        (call $ld (i32.add (local.get $v) (i32.const 16))) (local.get $nb))
                  (return)))
        (call $push_scope)
        (local.set $b (call $nd (local.get $a) (i32.const 20)))
        (local.set $f (call $ld (i32.add (local.get $v) (i32.const 12))))
        (block $brk2 (loop $cont2
          (br_if $brk2 (i32.eqz
            (if (result i32) (i32.ne (local.get $b) (i32.const 0))
                (then (i32.eqz (call $failed)))
                (else (i32.const 0)))))
          (block $cnt2
            (call $nset (local.get $b) (i32.const 40)
                  (call $declare_local (call $nd (local.get $b) (i32.const 12))
                        (call $nd (local.get $b) (i32.const 16))
                        (call $read_ty (call $ld (i32.add (local.get $f) (i32.const 8))))
                        (i32.const 0) (i32.const 0)
                        (call $nd (local.get $b) (i32.const 4))
                        (call $nd (local.get $b) (i32.const 8))))
            (local.set $b (call $nd (local.get $b) (i32.const 32)))
            (local.set $f (call $ld (i32.add (local.get $f) (i32.const 16)))))
          (br $cont2)))
        (call $check_block (call $nd (local.get $a) (i32.const 24)))
        (call $pop_scope)
        (local.set $seen (i32.add (local.get $seen) (i32.const 1)))
        (local.set $a (call $nd (local.get $a) (i32.const 32))))
      (br $cont)))
    (if (call $failed) (then (return)))
    (if (if (result i32) (i32.eq (local.get $wild) (i32.const 0))
            (then (i32.ne (local.get $seen) (call $ld (i32.add (local.get $ei) (i32.const 20)))))
            (else (i32.const 0)))
        (then
          (local.set $v2 (call $ld (i32.add (local.get $ei) (i32.const 8))))
          (block $brk3 (loop $cont3
            (br_if $brk3 (i32.eqz (i32.ne (local.get $v2) (i32.const 0))))
            (block $cnt3
              (if (i32.eq (call $arm_for_variant (local.get $head)
                                (call $ld (i32.add (local.get $v2) (i32.const 0)))
                                (call $ld (i32.add (local.get $v2) (i32.const 4))))
                          (i32.const 0))
                  (then (call $e_nonexhaustive (local.get $line) (local.get $col)
                              (call $ld (i32.add (local.get $v2) (i32.const 0)))
                              (call $ld (i32.add (local.get $v2) (i32.const 4))))
                        (return)))
              (local.set $v2 (call $ld (i32.add (local.get $v2) (i32.const 20)))))
            (br $cont3)))))
    (call $nset (local.get $s) (i32.const 24) (local.get $wild)))

