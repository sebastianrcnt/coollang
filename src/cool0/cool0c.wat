                                    (local.get $line) (local.get $col)))
          (call $nset (local.get $c) (local.get $n) (i32.const 12) (local.get $p))
          (call $nset (local.get $c) (local.get $n) (i32.const 16) (local.get $ix))
          (return (call $deep (local.get $c) (local.get $n)
                        (call $max2 (call $depth_of (local.get $c) (local.get $p))
                                    (call $depth_of (local.get $c) (local.get $ix)))))))
    (if (call $at_p (local.get $c) (i32.const 20))
        (then (call $bump (local.get $c))
              (local.set $e (call $parse_expr (local.get $c) (i32.const 1)))
              (call $expect_p (local.get $c) (i32.const 21))
              (return (local.get $e))))
    (if (i32.eq (local.get $k) (i32.const 1))
        (then
          (local.set $s (call $tk (local.get $c) (call $cg (local.get $c) (i32.const 44))
                                  (i32.const 4)))
          (local.set $l (call $tk (local.get $c) (call $cg (local.get $c) (i32.const 44))
                                  (i32.const 8)))
          (call $bump (local.get $c))
          (if (if (result i32) (local.get $asl)
                  (then (call $at_p (local.get $c) (i32.const 22)))
                  (else (i32.const 0)))
              (then (return (call $parse_struct_lit (local.get $c) (local.get $line)
                                  (local.get $col) (local.get $s) (local.get $l)))))
          (local.set $n (call $node (local.get $c) (i32.const 5)
                                    (local.get $line) (local.get $col)))
          (call $nset (local.get $c) (local.get $n) (i32.const 12) (local.get $s))
          (call $nset (local.get $c) (local.get $n) (i32.const 16) (local.get $l))
          (return (local.get $n))))
    (call $e_expected_str (local.get $c) (i32.const 0x100029E) (i32.const 19))
    (i32.const 0))

  (func $parse_struct_lit (param $c i32) (param $line i32) (param $col i32)
        (param $s i32) (param $l i32) (result i32)
    (local $head i32) (local $tail i32) (local $fline i32) (local $fcol i32)
    (local $it i32) (local $v i32) (local $f i32) (local $n i32)
    (call $expect_p (local.get $c) (i32.const 22))
    (local.set $head (i32.const 0))
    (local.set $tail (i32.const 0))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz
        (if (result i32) (i32.eqz (call $failed (local.get $c)))
            (then (i32.eqz (call $at_p (local.get $c) (i32.const 23))))
            (else (i32.const 0)))))
      (block $cnt
        (local.set $fline (call $cur_line (local.get $c)))
        (local.set $fcol (call $cur_col (local.get $c)))
        (local.set $it (call $expect_ident (local.get $c)))
        (br_if $brk (i32.eq (local.get $it) (i32.const -1)))
        (call $expect_p (local.get $c) (i32.const 28))
        (local.set $v (call $parse_expr (local.get $c) (i32.const 1)))
        (local.set $f (call $node (local.get $c) (i32.const 15)
                                  (local.get $fline) (local.get $fcol)))
        (call $nset (local.get $c) (local.get $f) (i32.const 12)
                    (call $tk (local.get $c) (local.get $it) (i32.const 4)))
        (call $nset (local.get $c) (local.get $f) (i32.const 16)
                    (call $tk (local.get $c) (local.get $it) (i32.const 8)))
        (call $nset (local.get $c) (local.get $f) (i32.const 20) (local.get $v))
        (call $nset (local.get $c) (local.get $f) (i32.const 48)
                    (call $depth_of (local.get $c) (local.get $v)))
        (if (i32.eq (local.get $head) (i32.const 0))
            (then (local.set $head (local.get $f)))
            (else (call $nset (local.get $c) (local.get $tail) (i32.const 32)
                              (local.get $f))))
        (local.set $tail (local.get $f))
        (br_if $brk (i32.eqz (call $eat_p (local.get $c) (i32.const 26)))))
      (br $cont)))
    (call $expect_p (local.get $c) (i32.const 23))
    (local.set $n (call $node (local.get $c) (i32.const 14) (local.get $line)
                              (local.get $col)))
    (call $nset (local.get $c) (local.get $n) (i32.const 12) (local.get $s))
    (call $nset (local.get $c) (local.get $n) (i32.const 16) (local.get $l))
    (call $nset (local.get $c) (local.get $n) (i32.const 20) (local.get $head))
    (call $deep (local.get $c) (local.get $n)
                (call $depth_list (local.get $c) (local.get $head))))

  ;; --- statements (language.md S6) ----------------------------------------

  (func $parse_block (param $c i32) (result i32)
    (local $head i32) (local $tail i32) (local $s i32)
    (if (call $failed (local.get $c)) (then (return (i32.const 0))))
    (if (i32.ge_u (call $cg (local.get $c) (i32.const 52)) (i32.const 64))
        (then (call $err_msg (local.get $c) (call $cur_line (local.get $c))
                             (call $cur_col (local.get $c))
                             (i32.const 0x10002B1) (i32.const 22))
              (return (i32.const 0))))
    (call $cs (local.get $c) (i32.const 52)
              (i32.add (call $cg (local.get $c) (i32.const 52)) (i32.const 1)))
    (call $expect_p (local.get $c) (i32.const 22))
    (local.set $head (i32.const 0))
    (local.set $tail (i32.const 0))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz
        (if (result i32) (i32.eqz (call $failed (local.get $c)))
            (then (i32.eqz (call $at_p (local.get $c) (i32.const 23))))
            (else (i32.const 0)))))
      (block $cnt
        (if (i32.eq (call $cur_kind (local.get $c)) (i32.const 0))
            (then (call $e_expected_p (local.get $c) (i32.const 23))
                  (return (i32.const 0))))
        (local.set $s (call $parse_stmt (local.get $c)))
        (if (call $failed (local.get $c)) (then (return (i32.const 0))))
        (if (i32.eq (local.get $head) (i32.const 0))
            (then (local.set $head (local.get $s)))
            (else (call $nset (local.get $c) (local.get $tail) (i32.const 32)
                              (local.get $s))))
        (local.set $tail (local.get $s)))
      (br $cont)))
    (call $expect_p (local.get $c) (i32.const 23))
    (call $cs (local.get $c) (i32.const 52)
              (i32.sub (call $cg (local.get $c) (i32.const 52)) (i32.const 1)))
    (local.get $head))

  (func $is_assign_op (param $p i32) (result i32)
    (if (i32.eq (local.get $p) (i32.const 30)) (then (return (i32.const 1))))
    (if (i32.ge_u (local.get $p) (i32.const 12))
        (then (if (i32.le_u (local.get $p) (i32.const 19))
                  (then (return (i32.const 1))))))
    (if (i32.eq (local.get $p) (i32.const 0)) (then (return (i32.const 1))))
    (i32.eq (local.get $p) (i32.const 1)))

  (func $parse_stmt (param $c i32) (result i32)
    (local $line i32) (local $col i32) (local $s i32) (local $n i32) (local $b i32)
    (local $v i32)
    (if (call $failed (local.get $c)) (then (return (i32.const 0))))
    (local.set $line (call $cur_line (local.get $c)))
    (local.set $col (call $cur_col (local.get $c)))
    (if (call $at_kw (local.get $c) (i32.const 4))
        (then (local.set $s (call $parse_let (local.get $c)))
              (call $expect_p (local.get $c) (i32.const 27))
              (return (local.get $s))))
    (if (call $at_kw (local.get $c) (i32.const 6))
        (then (return (call $parse_if (local.get $c)))))
    (if (call $at_kw (local.get $c) (i32.const 8))
        (then (return (call $parse_for (local.get $c)))))
    (if (call $at_kw (local.get $c) (i32.const 12))
        (then (return (call $parse_match (local.get $c)))))
    (if (call $at_kw (local.get $c) (i32.const 13))
        (then (call $bump (local.get $c))
              (local.set $n (call $node (local.get $c) (i32.const 39)
                                        (local.get $line) (local.get $col)))
              (local.set $b (call $parse_block (local.get $c)))
              (call $nset (local.get $c) (local.get $n) (i32.const 12) (local.get $b))
              (return (local.get $n))))
    (if (call $eat_kw (local.get $c) (i32.const 9))
        (then (call $expect_p (local.get $c) (i32.const 27))
              (return (call $node (local.get $c) (i32.const 35)
                                  (local.get $line) (local.get $col)))))
    (if (call $eat_kw (local.get $c) (i32.const 10))
        (then (call $expect_p (local.get $c) (i32.const 27))
              (return (call $node (local.get $c) (i32.const 36)
                                  (local.get $line) (local.get $col)))))
    (if (call $eat_kw (local.get $c) (i32.const 11))
        (then (local.set $n (call $node (local.get $c) (i32.const 37)
                                        (local.get $line) (local.get $col)))
              (if (call $eat_p (local.get $c) (i32.const 27))
                  (then (return (local.get $n))))
              (local.set $v (call $parse_expr (local.get $c) (i32.const 0)))
              (call $nset (local.get $c) (local.get $n) (i32.const 12) (local.get $v))
              (call $expect_p (local.get $c) (i32.const 27))
              (return (local.get $n))))
    (local.set $s (call $parse_simple_stmt (local.get $c)))
    (call $expect_p (local.get $c) (i32.const 27))
    (local.get $s))

  ;; Assignment or a call statement. The caller eats the `;`.
  (func $parse_simple_stmt (param $c i32) (result i32)
    (local $line i32) (local $col i32) (local $e i32) (local $op i32) (local $v i32)
    (local $n i32)
    (if (call $failed (local.get $c)) (then (return (i32.const 0))))
    (local.set $line (call $cur_line (local.get $c)))
    (local.set $col (call $cur_col (local.get $c)))
    (local.set $e (call $parse_expr (local.get $c) (i32.const 0)))
    (if (call $failed (local.get $c)) (then (return (i32.const 0))))
    (if (if (result i32) (i32.eq (call $cur_kind (local.get $c)) (i32.const 6))
            (then (call $is_assign_op (call $cur_val (local.get $c))))
            (else (i32.const 0)))
        (then
          (local.set $op (call $cur_val (local.get $c)))
          (call $bump (local.get $c))
          (local.set $v (call $parse_expr (local.get $c) (i32.const 1)))
          (local.set $n (call $node (local.get $c) (i32.const 31)
                                    (local.get $line) (local.get $col)))
          (call $nset (local.get $c) (local.get $n) (i32.const 12) (local.get $e))
          (call $nset (local.get $c) (local.get $n) (i32.const 16) (local.get $op))
          (call $nset (local.get $c) (local.get $n) (i32.const 20) (local.get $v))
          (return (local.get $n))))
    (if (i32.ne (call $nd (local.get $c) (local.get $e) (i32.const 0)) (i32.const 10))
        (then (call $err_msg (local.get $c) (local.get $line) (local.get $col)
                             (i32.const 0x10002C7) (i32.const 35))
              (return (i32.const 0))))
    (local.set $n (call $node (local.get $c) (i32.const 32)
                              (local.get $line) (local.get $col)))
    (call $nset (local.get $c) (local.get $n) (i32.const 12) (local.get $e))
    (local.get $n))

  (func $parse_let (param $c i32) (result i32)
    (local $line i32) (local $col i32) (local $n i32) (local $it i32) (local $t i32)
    (local $init i32)
    (local.set $line (call $cur_line (local.get $c)))
    (local.set $col (call $cur_col (local.get $c)))
    (call $expect_kw (local.get $c) (i32.const 4))
    (local.set $n (call $node (local.get $c) (i32.const 30)
                              (local.get $line) (local.get $col)))
    (if (call $eat_kw (local.get $c) (i32.const 5))
        (then (call $nset (local.get $c) (local.get $n) (i32.const 28) (i32.const 1))))
    (local.set $it (call $expect_ident (local.get $c)))
    (if (i32.eq (local.get $it) (i32.const -1)) (then (return (local.get $n))))
    (call $nset (local.get $c) (local.get $n) (i32.const 12)
                (call $tk (local.get $c) (local.get $it) (i32.const 4)))
    (call $nset (local.get $c) (local.get $n) (i32.const 16)
                (call $tk (local.get $c) (local.get $it) (i32.const 8)))
    (if (call $eat_p (local.get $c) (i32.const 28))
        (then (local.set $t (call $parse_ty (local.get $c)))
              (call $nset (local.get $c) (local.get $n) (i32.const 20) (local.get $t))))
    (call $expect_p (local.get $c) (i32.const 30))
    (local.set $init (call $parse_expr (local.get $c) (i32.const 1)))
    (call $nset (local.get $c) (local.get $n) (i32.const 24) (local.get $init))
    (local.get $n))

  (func $parse_if (param $c i32) (result i32)
    (local $line i32) (local $col i32) (local $n i32) (local $cond i32)
    (local $then i32) (local $els i32)
    (local.set $line (call $cur_line (local.get $c)))
    (local.set $col (call $cur_col (local.get $c)))
    (call $expect_kw (local.get $c) (i32.const 6))
    (local.set $n (call $node (local.get $c) (i32.const 33)
                              (local.get $line) (local.get $col)))
    (local.set $cond (call $parse_expr (local.get $c) (i32.const 0)))
    (call $nset (local.get $c) (local.get $n) (i32.const 12) (local.get $cond))
    (local.set $then (call $parse_block (local.get $c)))
    (call $nset (local.get $c) (local.get $n) (i32.const 16) (local.get $then))
    (if (call $eat_kw (local.get $c) (i32.const 7))
        (then
          (call $nset (local.get $c) (local.get $n) (i32.const 24) (i32.const 1))
          (if (call $at_kw (local.get $c) (i32.const 6))
              (then
                ;; an else-if chain is recursion too; it counts as block nesting
                (if (i32.ge_u (call $cg (local.get $c) (i32.const 52)) (i32.const 64))
                    (then (call $err_msg (local.get $c) (call $cur_line (local.get $c))
                                         (call $cur_col (local.get $c))
                                         (i32.const 0x10002B1) (i32.const 22))
                          (return (local.get $n))))
                (call $cs (local.get $c) (i32.const 52)
                          (i32.add (call $cg (local.get $c) (i32.const 52)) (i32.const 1)))
                (local.set $els (call $parse_if (local.get $c)))
                (call $nset (local.get $c) (local.get $n) (i32.const 20) (local.get $els))
                (call $cs (local.get $c) (i32.const 52)
                          (i32.sub (call $cg (local.get $c) (i32.const 52)) (i32.const 1))))
              (else
                (local.set $els (call $parse_block (local.get $c)))
                (call $nset (local.get $c) (local.get $n) (i32.const 20)
                            (local.get $els))))))
    (local.get $n))

  (func $parse_for (param $c i32) (result i32)
    (local $line i32) (local $col i32) (local $n i32) (local $body i32)
    (local $init i32) (local $cond i32) (local $post i32)
    (local.set $line (call $cur_line (local.get $c)))
    (local.set $col (call $cur_col (local.get $c)))
    (call $expect_kw (local.get $c) (i32.const 8))
    (local.set $n (call $node (local.get $c) (i32.const 34)
                              (local.get $line) (local.get $col)))
    (if (call $at_p (local.get $c) (i32.const 22))
        (then (local.set $body (call $parse_block (local.get $c)))
              (call $nset (local.get $c) (local.get $n) (i32.const 24) (local.get $body))
              (return (local.get $n))))
    (if (call $at_kw (local.get $c) (i32.const 4))
        (then
          (local.set $init (call $parse_let (local.get $c)))
          (call $nset (local.get $c) (local.get $n) (i32.const 12) (local.get $init))
          (call $expect_p (local.get $c) (i32.const 27))
          (local.set $cond (call $parse_expr (local.get $c) (i32.const 0)))
          (call $nset (local.get $c) (local.get $n) (i32.const 16) (local.get $cond))
          (call $expect_p (local.get $c) (i32.const 27))
          (local.set $post (call $parse_simple_stmt (local.get $c)))
          (call $nset (local.get $c) (local.get $n) (i32.const 20) (local.get $post))
          (local.set $body (call $parse_block (local.get $c)))
          (call $nset (local.get $c) (local.get $n) (i32.const 24) (local.get $body))
          (return (local.get $n))))
    (local.set $cond (call $parse_expr (local.get $c) (i32.const 0)))
    (call $nset (local.get $c) (local.get $n) (i32.const 16) (local.get $cond))
    (local.set $body (call $parse_block (local.get $c)))
    (call $nset (local.get $c) (local.get $n) (i32.const 24) (local.get $body))
    (local.get $n))

  (func $parse_match (param $c i32) (result i32)
    (local $line i32) (local $col i32) (local $n i32) (local $scr i32)
    (local $head i32) (local $tail i32) (local $aline i32) (local $acol i32)
    (local $arm i32) (local $ts i32) (local $tl i32) (local $it i32)
    (local $bh i32) (local $bt i32) (local $bline i32) (local $bcol i32)
    (local $bi i32) (local $b i32) (local $body i32)
    (local.set $line (call $cur_line (local.get $c)))
    (local.set $col (call $cur_col (local.get $c)))
    (call $expect_kw (local.get $c) (i32.const 12))
    (local.set $n (call $node (local.get $c) (i32.const 38)
                              (local.get $line) (local.get $col)))
    (local.set $scr (call $parse_expr (local.get $c) (i32.const 0)))
    (call $nset (local.get $c) (local.get $n) (i32.const 12) (local.get $scr))
    (call $expect_p (local.get $c) (i32.const 22))
    (local.set $head (i32.const 0))
    (local.set $tail (i32.const 0))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz
        (if (result i32) (i32.eqz (call $failed (local.get $c)))
            (then (i32.eqz (call $at_p (local.get $c) (i32.const 23))))
            (else (i32.const 0)))))
      (block $cnt
        (local.set $aline (call $cur_line (local.get $c)))
        (local.set $acol (call $cur_col (local.get $c)))
        (local.set $arm (call $node (local.get $c) (i32.const 40)
                                    (local.get $aline) (local.get $acol)))
        (local.set $ts (call $tk (local.get $c) (call $cg (local.get $c) (i32.const 44))
                                 (i32.const 4)))
        (local.set $tl (call $tk (local.get $c) (call $cg (local.get $c) (i32.const 44))
                                 (i32.const 8)))
        (if (if (result i32) (i32.eq (call $cur_kind (local.get $c)) (i32.const 1))
                (then (call $src_eq (local.get $c) (local.get $ts) (local.get $tl)
                                    (i32.const 0x10002EA) (i32.const 1)))
                (else (i32.const 0)))
            (then (call $bump (local.get $c))
                  (call $nset (local.get $c) (local.get $arm) (i32.const 28)
                              (i32.const 1)))
            (else
              (local.set $it (call $expect_ident (local.get $c)))
              (br_if $brk (i32.eq (local.get $it) (i32.const -1)))
              (call $nset (local.get $c) (local.get $arm) (i32.const 12)
                          (call $tk (local.get $c) (local.get $it) (i32.const 4)))
              (call $nset (local.get $c) (local.get $arm) (i32.const 16)
                          (call $tk (local.get $c) (local.get $it) (i32.const 8)))
              (if (call $eat_p (local.get $c) (i32.const 20))
                  (then
                    (local.set $bh (i32.const 0))
                    (local.set $bt (i32.const 0))
                    (block $bbrk (loop $bcont
                      (br_if $bbrk (i32.eqz
                        (if (result i32) (i32.eqz (call $failed (local.get $c)))
                            (then (i32.eqz (call $at_p (local.get $c) (i32.const 21))))
                            (else (i32.const 0)))))
                      (block $bcnt
                        (local.set $bline (call $cur_line (local.get $c)))
                        (local.set $bcol (call $cur_col (local.get $c)))
                        (local.set $bi (call $expect_ident (local.get $c)))
                        (br_if $bbrk (i32.eq (local.get $bi) (i32.const -1)))
                        (local.set $b (call $node (local.get $c) (i32.const 41)
                                                  (local.get $bline) (local.get $bcol)))
                        (call $nset (local.get $c) (local.get $b) (i32.const 12)
                                    (call $tk (local.get $c) (local.get $bi) (i32.const 4)))
                        (call $nset (local.get $c) (local.get $b) (i32.const 16)
                                    (call $tk (local.get $c) (local.get $bi) (i32.const 8)))
                        (if (i32.eq (local.get $bh) (i32.const 0))
                            (then (local.set $bh (local.get $b)))
                            (else (call $nset (local.get $c) (local.get $bt) (i32.const 32)
                                              (local.get $b))))
                        (local.set $bt (local.get $b))
                        (br_if $bbrk (i32.eqz (call $eat_p (local.get $c) (i32.const 26)))))
                      (br $bcont)))
                    (call $expect_p (local.get $c) (i32.const 21))
                    (call $nset (local.get $c) (local.get $arm) (i32.const 20)
                                (local.get $bh))))))
        (call $expect_p (local.get $c) (i32.const 3))
        (local.set $body (call $parse_block (local.get $c)))
        (call $nset (local.get $c) (local.get $arm) (i32.const 24) (local.get $body))
        (if (i32.eq (local.get $head) (i32.const 0))
            (then (local.set $head (local.get $arm)))
            (else (call $nset (local.get $c) (local.get $tail) (i32.const 32)
                              (local.get $arm))))
        (local.set $tail (local.get $arm)))
      (br $cont)))
    (call $expect_p (local.get $c) (i32.const 23))
    (call $nset (local.get $c) (local.get $n) (i32.const 16) (local.get $head))
    (local.get $n))

  ;; --- declarations (language.md S4) --------------------------------------

  (func $parse_fn (param $c i32) (result i32)
    (local $line i32) (local $col i32) (local $n i32) (local $it i32)
    (local $head i32) (local $tail i32) (local $pline i32) (local $pcol i32)
    (local $pi i32) (local $p i32) (local $pt i32) (local $r i32) (local $body i32)
    (local.set $line (call $cur_line (local.get $c)))
    (local.set $col (call $cur_col (local.get $c)))
    (call $expect_kw (local.get $c) (i32.const 0))
    (local.set $n (call $node (local.get $c) (i32.const 50)
                              (local.get $line) (local.get $col)))
    (local.set $it (call $expect_ident (local.get $c)))
    (if (i32.eq (local.get $it) (i32.const -1)) (then (return (local.get $n))))
    (call $nset (local.get $c) (local.get $n) (i32.const 12)
                (call $tk (local.get $c) (local.get $it) (i32.const 4)))
    (call $nset (local.get $c) (local.get $n) (i32.const 16)
                (call $tk (local.get $c) (local.get $it) (i32.const 8)))
    (call $expect_p (local.get $c) (i32.const 20))
    (local.set $head (i32.const 0))
    (local.set $tail (i32.const 0))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz
        (if (result i32) (i32.eqz (call $failed (local.get $c)))
            (then (i32.eqz (call $at_p (local.get $c) (i32.const 21))))
            (else (i32.const 0)))))
      (block $cnt
        (local.set $pline (call $cur_line (local.get $c)))
        (local.set $pcol (call $cur_col (local.get $c)))
        (local.set $pi (call $expect_ident (local.get $c)))
        (br_if $brk (i32.eq (local.get $pi) (i32.const -1)))
        (call $expect_p (local.get $c) (i32.const 28))
        (local.set $p (call $node (local.get $c) (i32.const 54)
                                  (local.get $pline) (local.get $pcol)))
        (call $nset (local.get $c) (local.get $p) (i32.const 12)
                    (call $tk (local.get $c) (local.get $pi) (i32.const 4)))
        (call $nset (local.get $c) (local.get $p) (i32.const 16)
                    (call $tk (local.get $c) (local.get $pi) (i32.const 8)))
        (local.set $pt (call $parse_ty (local.get $c)))
        (call $nset (local.get $c) (local.get $p) (i32.const 20) (local.get $pt))
        (if (i32.eq (local.get $head) (i32.const 0))
            (then (local.set $head (local.get $p)))
            (else (call $nset (local.get $c) (local.get $tail) (i32.const 32)
                              (local.get $p))))
        (local.set $tail (local.get $p))
        (br_if $brk (i32.eqz (call $eat_p (local.get $c) (i32.const 26)))))
      (br $cont)))
    (call $expect_p (local.get $c) (i32.const 21))
    (call $nset (local.get $c) (local.get $n) (i32.const 20) (local.get $head))
    (if (call $eat_p (local.get $c) (i32.const 2))
        (then (local.set $r (call $parse_ty (local.get $c)))
              (call $nset (local.get $c) (local.get $n) (i32.const 24) (local.get $r))))
    (local.set $body (call $parse_block (local.get $c)))
    (call $nset (local.get $c) (local.get $n) (i32.const 28) (local.get $body))
    (local.get $n))

  (func $parse_struct (param $c i32) (result i32)
    (local $line i32) (local $col i32) (local $n i32) (local $it i32)
    (local $head i32) (local $tail i32) (local $fline i32) (local $fcol i32)
    (local $fi i32) (local $f i32) (local $ft i32)
    (local.set $line (call $cur_line (local.get $c)))
    (local.set $col (call $cur_col (local.get $c)))
    (call $expect_kw (local.get $c) (i32.const 1))
    (local.set $n (call $node (local.get $c) (i32.const 51)
                              (local.get $line) (local.get $col)))
    (local.set $it (call $expect_ident (local.get $c)))
    (if (i32.eq (local.get $it) (i32.const -1)) (then (return (local.get $n))))
    (call $nset (local.get $c) (local.get $n) (i32.const 12)
                (call $tk (local.get $c) (local.get $it) (i32.const 4)))
    (call $nset (local.get $c) (local.get $n) (i32.const 16)
                (call $tk (local.get $c) (local.get $it) (i32.const 8)))
    (call $expect_p (local.get $c) (i32.const 22))
    (local.set $head (i32.const 0))
    (local.set $tail (i32.const 0))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz
        (if (result i32) (i32.eqz (call $failed (local.get $c)))
            (then (i32.eqz (call $at_p (local.get $c) (i32.const 23))))
            (else (i32.const 0)))))
      (block $cnt
        (local.set $fline (call $cur_line (local.get $c)))
        (local.set $fcol (call $cur_col (local.get $c)))
        (local.set $fi (call $expect_ident (local.get $c)))
        (br_if $brk (i32.eq (local.get $fi) (i32.const -1)))
        (call $expect_p (local.get $c) (i32.const 28))
        (local.set $f (call $node (local.get $c) (i32.const 55)
                                  (local.get $fline) (local.get $fcol)))
        (call $nset (local.get $c) (local.get $f) (i32.const 12)
                    (call $tk (local.get $c) (local.get $fi) (i32.const 4)))
        (call $nset (local.get $c) (local.get $f) (i32.const 16)
                    (call $tk (local.get $c) (local.get $fi) (i32.const 8)))
        (local.set $ft (call $parse_ty (local.get $c)))
        (call $nset (local.get $c) (local.get $f) (i32.const 20) (local.get $ft))
        (if (i32.eq (local.get $head) (i32.const 0))
            (then (local.set $head (local.get $f)))
            (else (call $nset (local.get $c) (local.get $tail) (i32.const 32)
                              (local.get $f))))
        (local.set $tail (local.get $f))
        (br_if $brk (i32.eqz (call $eat_p (local.get $c) (i32.const 26)))))
      (br $cont)))
    (call $expect_p (local.get $c) (i32.const 23))
    (call $nset (local.get $c) (local.get $n) (i32.const 20) (local.get $head))
    (local.get $n))

  (func $parse_enum (param $c i32) (result i32)
    (local $line i32) (local $col i32) (local $n i32) (local $it i32)
    (local $head i32) (local $tail i32) (local $vline i32) (local $vcol i32)
    (local $vi i32) (local $v i32) (local $ph i32) (local $pt i32) (local $t i32)
    (local.set $line (call $cur_line (local.get $c)))
    (local.set $col (call $cur_col (local.get $c)))
    (call $expect_kw (local.get $c) (i32.const 2))
    (local.set $n (call $node (local.get $c) (i32.const 52)
                              (local.get $line) (local.get $col)))
    (local.set $it (call $expect_ident (local.get $c)))
    (if (i32.eq (local.get $it) (i32.const -1)) (then (return (local.get $n))))
    (call $nset (local.get $c) (local.get $n) (i32.const 12)
                (call $tk (local.get $c) (local.get $it) (i32.const 4)))
    (call $nset (local.get $c) (local.get $n) (i32.const 16)
                (call $tk (local.get $c) (local.get $it) (i32.const 8)))
    (call $expect_p (local.get $c) (i32.const 22))
    (local.set $head (i32.const 0))
    (local.set $tail (i32.const 0))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz
        (if (result i32) (i32.eqz (call $failed (local.get $c)))
            (then (i32.eqz (call $at_p (local.get $c) (i32.const 23))))
            (else (i32.const 0)))))
      (block $cnt
        (local.set $vline (call $cur_line (local.get $c)))
        (local.set $vcol (call $cur_col (local.get $c)))
        (local.set $vi (call $expect_ident (local.get $c)))
        (br_if $brk (i32.eq (local.get $vi) (i32.const -1)))
        (local.set $v (call $node (local.get $c) (i32.const 56)
                                  (local.get $vline) (local.get $vcol)))
        (call $nset (local.get $c) (local.get $v) (i32.const 12)
                    (call $tk (local.get $c) (local.get $vi) (i32.const 4)))
        (call $nset (local.get $c) (local.get $v) (i32.const 16)
                    (call $tk (local.get $c) (local.get $vi) (i32.const 8)))
        (if (call $eat_p (local.get $c) (i32.const 20))
            (then
              (local.set $ph (i32.const 0))
              (local.set $pt (i32.const 0))
              (block $pbrk (loop $pcont
                (br_if $pbrk (i32.eqz
                  (if (result i32) (i32.eqz (call $failed (local.get $c)))
                      (then (i32.eqz (call $at_p (local.get $c) (i32.const 21))))
                      (else (i32.const 0)))))
                (block $pcnt
                  (local.set $t (call $parse_ty (local.get $c)))
                  (br_if $pbrk (i32.eq (local.get $t) (i32.const 0)))
                  (if (i32.eq (local.get $ph) (i32.const 0))
                      (then (local.set $ph (local.get $t)))
                      (else (call $nset (local.get $c) (local.get $pt) (i32.const 32)
                                        (local.get $t))))
                  (local.set $pt (local.get $t))
                  (br_if $pbrk (i32.eqz (call $eat_p (local.get $c) (i32.const 26)))))
                (br $pcont)))
              (call $expect_p (local.get $c) (i32.const 21))
              (call $nset (local.get $c) (local.get $v) (i32.const 20) (local.get $ph))))
        (if (i32.eq (local.get $head) (i32.const 0))
            (then (local.set $head (local.get $v)))
            (else (call $nset (local.get $c) (local.get $tail) (i32.const 32)
                              (local.get $v))))
        (local.set $tail (local.get $v))
        (br_if $brk (i32.eqz (call $eat_p (local.get $c) (i32.const 26)))))
      (br $cont)))
    (call $expect_p (local.get $c) (i32.const 23))
    (call $nset (local.get $c) (local.get $n) (i32.const 20) (local.get $head))
    (local.get $n))

  (func $parse_const (param $c i32) (result i32)
    (local $line i32) (local $col i32) (local $n i32) (local $it i32) (local $t i32)
    (local $v i32)
    (local.set $line (call $cur_line (local.get $c)))
    (local.set $col (call $cur_col (local.get $c)))
    (call $expect_kw (local.get $c) (i32.const 3))
    (local.set $n (call $node (local.get $c) (i32.const 53)
                              (local.get $line) (local.get $col)))
    (local.set $it (call $expect_ident (local.get $c)))
    (if (i32.eq (local.get $it) (i32.const -1)) (then (return (local.get $n))))
    (call $nset (local.get $c) (local.get $n) (i32.const 12)
                (call $tk (local.get $c) (local.get $it) (i32.const 4)))
    (call $nset (local.get $c) (local.get $n) (i32.const 16)
                (call $tk (local.get $c) (local.get $it) (i32.const 8)))
    (call $expect_p (local.get $c) (i32.const 28))
    (local.set $t (call $parse_ty (local.get $c)))
    (call $nset (local.get $c) (local.get $n) (i32.const 20) (local.get $t))
    (call $expect_p (local.get $c) (i32.const 30))
    (local.set $v (call $parse_expr (local.get $c) (i32.const 0)))
    (call $nset (local.get $c) (local.get $n) (i32.const 24) (local.get $v))
    (call $expect_p (local.get $c) (i32.const 27))
    (local.get $n))

  (func $parse_program (export "parse_program") (param $c i32)
    (local $head i32) (local $tail i32) (local $d i32)
    (call $cs (local.get $c) (i32.const 44) (i32.const 0))
    (call $cs (local.get $c) (i32.const 48) (i32.const 0))
    (call $cs (local.get $c) (i32.const 52) (i32.const 0))
    (local.set $head (i32.const 0))
    (local.set $tail (i32.const 0))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz
        (if (result i32) (i32.eqz (call $failed (local.get $c)))
            (then (i32.ne (call $cur_kind (local.get $c)) (i32.const 0)))
            (else (i32.const 0)))))
      (block $cnt
        (local.set $d (i32.const 0))
        (if (call $at_kw (local.get $c) (i32.const 0))
            (then (local.set $d (call $parse_fn (local.get $c))))
            (else (if (call $at_kw (local.get $c) (i32.const 1))
              (then (local.set $d (call $parse_struct (local.get $c))))
              (else (if (call $at_kw (local.get $c) (i32.const 2))
                (then (local.set $d (call $parse_enum (local.get $c))))
                (else (if (call $at_kw (local.get $c) (i32.const 3))
                  (then (local.set $d (call $parse_const (local.get $c))))
                  (else (call $e_expected_str (local.get $c)
                                              (i32.const 0x10002EB) (i32.const 42))
                        (return)))))))))
        (if (call $failed (local.get $c)) (then (return)))
        (if (i32.eq (local.get $head) (i32.const 0))
            (then (local.set $head (local.get $d)))
            (else (call $nset (local.get $c) (local.get $tail) (i32.const 32)
                              (local.get $d))))
        (local.set $tail (local.get $d)))
      (br $cont)))
    (call $cs (local.get $c) (i32.const 56) (local.get $head)))

  ;; ======================================================================
  ;; Types, interned (language.md S3)
  ;;
  ;; `enum Ty` is 12 bytes: tag at 0, then two payload words at 4 and 8.
  ;; Tags: 0 I32, 1 U32, 2 Bool, 3 U8, 4 Void, 5 IntLit,
  ;;       6 Slice(elem, mut), 7 Ref(inner, mut), 8 Ptr(inner),
  ;;       9 Named(name start, name len).
  ;; The arena is Ctx+60, the count Ctx+68. Indices 1..6 are the primitives.
  ;; ======================================================================

  (func $ty_at (param $c i32) (param $t i32) (result i32)
    (if (i32.ge_u (local.get $t) (call $cg (local.get $c) (i32.const 64)))
        (then (unreachable)))
    (i32.add (call $cg (local.get $c) (i32.const 60))
             (i32.mul (local.get $t) (i32.const 12))))

  (func $ty_kind (param $c i32) (param $t i32) (result i32)
    (i32.load (call $ty_at (local.get $c) (local.get $t))))

  (func $ty_arg (param $c i32) (param $t i32) (result i32)
    (if (i32.lt_u (call $ty_kind (local.get $c) (local.get $t)) (i32.const 6))
        (then (return (i32.const 0))))
    (i32.load (i32.add (call $ty_at (local.get $c) (local.get $t)) (i32.const 4))))

  (func $ty_flag (param $c i32) (param $t i32) (result i32)
    (local $k i32)
    (local.set $k (call $ty_kind (local.get $c) (local.get $t)))
    (if (i32.lt_u (local.get $k) (i32.const 6)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $k) (i32.const 8)) (then (return (i32.const 0))))
    (i32.load (i32.add (call $ty_at (local.get $c) (local.get $t)) (i32.const 8))))

  (func $ty_put (param $c i32) (param $kind i32) (param $arg i32) (param $flag i32)
        (result i32)
    (local $n i32) (local $p i32)
    (local.set $n (call $cg (local.get $c) (i32.const 68)))
    (local.set $p (call $ty_at (local.get $c) (local.get $n)))
    (i32.store (local.get $p) (local.get $kind))
    (i32.store (i32.add (local.get $p) (i32.const 4)) (local.get $arg))
    (i32.store (i32.add (local.get $p) (i32.const 8))
               (if (result i32) (i32.eq (local.get $kind) (i32.const 8))
                   (then (i32.const 0))
                   (else (local.get $flag))))
    (call $cs (local.get $c) (i32.const 68) (i32.add (local.get $n) (i32.const 1)))
    (local.get $n))

  (func $ty_intern (param $c i32) (param $kind i32) (param $arg i32) (param $flag i32)
        (result i32)
    (local $n i32) (local $p i32)
    (local.set $n (call $cg (local.get $c) (i32.const 68)))
    (local.set $p (i32.const 7))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.lt_u (local.get $p) (local.get $n))))
      (block $cnt
        (if (if (result i32)
                (i32.eq (call $ty_kind (local.get $c) (local.get $p)) (local.get $kind))
                (then (if (result i32)
                          (i32.eq (call $ty_arg (local.get $c) (local.get $p))
                                  (local.get $arg))
                          (then (i32.eq (call $ty_flag (local.get $c) (local.get $p))
                                        (local.get $flag)))
                          (else (i32.const 0))))
                (else (i32.const 0)))
            (then (return (local.get $p)))))
      (local.set $p (i32.add (local.get $p) (i32.const 1)))
      (br $cont)))
    (call $ty_put (local.get $c) (local.get $kind) (local.get $arg) (local.get $flag)))

  ;; two source slices, same bytes
  (func $src_eq2 (param $c i32) (param $s1 i32) (param $l1 i32)
        (param $s2 i32) (param $l2 i32) (result i32)
    (local $i i32)
    (if (i32.ne (local.get $l1) (local.get $l2)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.lt_u (local.get $i) (local.get $l1))))
      (block $cnt
        (if (i32.ne (call $src_at (local.get $c) (i32.add (local.get $s1) (local.get $i)))
                    (call $src_at (local.get $c) (i32.add (local.get $s2) (local.get $i))))
            (then (return (i32.const 0)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $cont)))
    (i32.const 1))

  ;; Named types compare by text, not by where the name was written.
  (func $ty_named (param $c i32) (param $start i32) (param $len i32) (result i32)
    (local $n i32) (local $p i32)
    (local.set $n (call $cg (local.get $c) (i32.const 68)))
    (local.set $p (i32.const 7))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.lt_u (local.get $p) (local.get $n))))
      (block $cnt
        (if (i32.eq (call $ty_kind (local.get $c) (local.get $p)) (i32.const 9))
            (then (if (call $src_eq2 (local.get $c)
                             (call $ty_arg (local.get $c) (local.get $p))
                             (call $ty_flag (local.get $c) (local.get $p))
                             (local.get $start) (local.get $len))
                      (then (return (local.get $p)))))))
      (local.set $p (i32.add (local.get $p) (i32.const 1)))
      (br $cont)))
    (call $ty_put (local.get $c) (i32.const 9) (local.get $start) (local.get $len)))

  (func $is_int_ty (param $c i32) (param $t i32) (result i32)
    (local $k i32)
    (local.set $k (call $ty_kind (local.get $c) (local.get $t)))
    (if (i32.eq (local.get $k) (i32.const 0)) (then (return (i32.const 1))))
    (if (i32.eq (local.get $k) (i32.const 1)) (then (return (i32.const 1))))
    (i32.eq (local.get $k) (i32.const 5)))

  (func $is_aggregate (param $c i32) (param $t i32) (result i32)
    (i32.eq (call $ty_kind (local.get $c) (local.get $t)) (i32.const 9)))

  ;; The type a place yields when read: u8 reads as u32 (language.md S3).
  (func $read_ty (param $c i32) (param $t i32) (result i32)
    (if (i32.eq (call $ty_kind (local.get $c) (local.get $t)) (i32.const 3))
        (then (return (i32.const 2))))
    (local.get $t))

  (func $slot_count (param $c i32) (param $t i32) (result i32)
    (if (i32.eq (call $ty_kind (local.get $c) (local.get $t)) (i32.const 6))
        (then (return (i32.const 2))))
    (i32.const 1))

  ;; ty_str() in cool0.py
  (func $put_ty (param $c i32) (param $t i32)
    (local $k i32) (local $arg i32) (local $flag i32)
    (local.set $k (call $ty_kind (local.get $c) (local.get $t)))
    (local.set $arg (call $ty_arg (local.get $c) (local.get $t)))
    (local.set $flag (call $ty_flag (local.get $c) (local.get $t)))
    (if (i32.eq (local.get $k) (i32.const 0))
        (then (call $put_str (local.get $c) (i32.const 0x100025F) (i32.const 3)) (return)))
    (if (i32.eq (local.get $k) (i32.const 1))
        (then (call $put_str (local.get $c) (i32.const 0x1000262) (i32.const 3)) (return)))
    (if (i32.eq (local.get $k) (i32.const 2))
        (then (call $put_str (local.get $c) (i32.const 0x1000265) (i32.const 4)) (return)))
    (if (i32.eq (local.get $k) (i32.const 3))
        (then (call $put_str (local.get $c) (i32.const 0x1000269) (i32.const 2)) (return)))
    (if (i32.eq (local.get $k) (i32.const 4))
        (then (call $put_str (local.get $c) (i32.const 0x1000315) (i32.const 4)) (return)))
    (if (i32.eq (local.get $k) (i32.const 5))
        (then (call $put_str (local.get $c) (i32.const 0x10001DD) (i32.const 15)) (return)))
    (if (i32.eq (local.get $k) (i32.const 6))
        (then (if (i32.ne (local.get $flag) (i32.const 0))
                  (then (call $put_str (local.get $c) (i32.const 0x1000319) (i32.const 6)))
                  (else (call $put_str (local.get $c) (i32.const 0x100031F) (i32.const 2))))
              (call $put_ty (local.get $c) (local.get $arg))
              (return)))
    (if (i32.eq (local.get $k) (i32.const 7))
        (then (if (i32.ne (local.get $flag) (i32.const 0))
                  (then (call $put_str (local.get $c) (i32.const 0x1000321) (i32.const 5)))
                  (else (call $put_str (local.get $c) (i32.const 0x1000099) (i32.const 1))))
              (call $put_ty (local.get $c) (local.get $arg))
              (return)))
    (if (i32.eq (local.get $k) (i32.const 8))
        (then (call $put_str (local.get $c) (i32.const 0x1000096) (i32.const 1))
              (call $put_ty (local.get $c) (local.get $arg))
              (return)))
    (call $put_src (local.get $c) (local.get $arg) (local.get $flag)))

  (func $put_q_ty (param $c i32) (param $t i32)
    (call $put_ch (local.get $c) (i32.const 96))
    (call $put_ty (local.get $c) (local.get $t))
    (call $put_ch (local.get $c) (i32.const 96)))

  (func $put_q_src (param $c i32) (param $s i32) (param $l i32)
    (call $put_ch (local.get $c) (i32.const 96))
    (call $put_src (local.get $c) (local.get $s) (local.get $l))
    (call $put_ch (local.get $c) (i32.const 96)))

  ;; ======================================================================
  ;; Declaration tables
  ;;
  ;;  arena       ptr   count  record size   fields
  ;;  fields       72      80  20   ns 0 nl 4 ty 8 off 12 next 16
  ;;  structs      84      92  24   ns 0 nl 4 fields 8 bytes 12 align 16 next 20
  ;;  variants     96     104  24   ns 0 nl 4 tag 8 payload 12 nargs 16 next 20
  ;;  enums       108     116  28   ns 0 nl 4 variants 8 bytes 12 align 16
  ;;                                nvar 20 next 24
  ;;  consts      120     128  28   ns 0 nl 4 ty 8 value 12 state 16 decl 20 next 24
  ;;  params      132     140  16   ns 0 nl 4 ty 8 next 12
  ;;  fns         144     152  52   ns 0 nl 4 params 8 nparams 12 ret 16 index 20
  ;;                                decl 24 locals 28 ltail 32 frame 36
  ;;                                npslot 40 nlslot 44 next 48
  ;;  locals      156     164  36   ns 0 nl 4 ty 8 is_mut 12 is_param 16 addr 20
  ;;                                slot 24 foff 28 next 32
  ;;  strs        168     176  16   ptr 0 len 4 addr 8 next 12
  ;;  taken       180     188  12   ns 0 nl 4 next 8
  ;;  tynames     192     200  12   ns 0 nl 4 next 8
  ;; ======================================================================

  ;; every table stores its length one word above its base, so one check here
  ;; covers all eleven of them
  (func $rec (param $c i32) (param $arena i32) (param $i i32) (param $size i32)
        (result i32)
    (if (i32.ge_u (local.get $i)
                  (call $cg (local.get $c) (i32.add (local.get $arena) (i32.const 4))))
        (then (unreachable)))
    (i32.add (call $cg (local.get $c) (local.get $arena))
             (i32.mul (local.get $i) (local.get $size))))

  (func $rg (param $c i32) (param $arena i32) (param $i i32) (param $size i32)
        (param $f i32) (result i32)
    (i32.load (i32.add (call $rec (local.get $c) (local.get $arena) (local.get $i)
                              (local.get $size))
                       (local.get $f))))

  (func $rs (param $c i32) (param $arena i32) (param $i i32) (param $size i32)
        (param $f i32) (param $v i32)
    (i32.store (i32.add (call $rec (local.get $c) (local.get $arena) (local.get $i)
                              (local.get $size))
                        (local.get $f))
               (local.get $v)))

  ;; --- lookups ------------------------------------------------------------

  (func $find_named (param $c i32) (param $arena i32) (param $count i32)
        (param $size i32) (param $s i32) (param $l i32) (result i32)
    (local $n i32) (local $p i32)
    (local.set $n (call $cg (local.get $c) (local.get $count)))
    (local.set $p (i32.const 1))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.lt_u (local.get $p) (local.get $n))))
      (block $cnt
        (if (call $src_eq2 (local.get $c)
                  (call $rg (local.get $c) (local.get $arena) (local.get $p)
                            (local.get $size) (i32.const 0))
                  (call $rg (local.get $c) (local.get $arena) (local.get $p)
                            (local.get $size) (i32.const 4))
                  (local.get $s) (local.get $l))
            (then (return (local.get $p)))))
      (local.set $p (i32.add (local.get $p) (i32.const 1)))
      (br $cont)))
    (i32.const 0))

  (func $find_struct (param $c i32) (param $s i32) (param $l i32) (result i32)
    (call $find_named (local.get $c) (i32.const 84) (i32.const 92) (i32.const 24)
                      (local.get $s) (local.get $l)))

  (func $find_enum (param $c i32) (param $s i32) (param $l i32) (result i32)
    (call $find_named (local.get $c) (i32.const 108) (i32.const 116) (i32.const 28)
                      (local.get $s) (local.get $l)))

  (func $find_const (param $c i32) (param $s i32) (param $l i32) (result i32)
    (call $find_named (local.get $c) (i32.const 120) (i32.const 128) (i32.const 28)
                      (local.get $s) (local.get $l)))

  (func $find_fn (param $c i32) (param $s i32) (param $l i32) (result i32)
    (call $find_named (local.get $c) (i32.const 144) (i32.const 152) (i32.const 52)
                      (local.get $s) (local.get $l)))

  (func $find_type_name (param $c i32) (param $s i32) (param $l i32) (result i32)
    (i32.ne (call $find_named (local.get $c) (i32.const 192) (i32.const 200)
                              (i32.const 12) (local.get $s) (local.get $l))
            (i32.const 0)))

  (func $find_taken (param $c i32) (param $s i32) (param $l i32) (result i32)
    (i32.ne (call $find_named (local.get $c) (i32.const 180) (i32.const 188)
                              (i32.const 12) (local.get $s) (local.get $l))
            (i32.const 0)))

  ;; The aggregate info behind a named type
  (func $agg_struct (param $c i32) (param $t i32) (result i32)
    (call $find_struct (local.get $c) (call $ty_arg (local.get $c) (local.get $t))
                       (call $ty_flag (local.get $c) (local.get $t))))

  (func $agg_enum (param $c i32) (param $t i32) (result i32)
    (call $find_enum (local.get $c) (call $ty_arg (local.get $c) (local.get $t))
                     (call $ty_flag (local.get $c) (local.get $t))))

  (func $size_of (param $c i32) (param $t i32) (result i32)
    (local $k i32) (local $s i32) (local $e i32)
    (local.set $k (call $ty_kind (local.get $c) (local.get $t)))
    (if (i32.eq (local.get $k) (i32.const 2)) (then (return (i32.const 1))))
    (if (i32.eq (local.get $k) (i32.const 3)) (then (return (i32.const 1))))
    (if (i32.eq (local.get $k) (i32.const 6)) (then (return (i32.const 8))))
    (if (i32.eq (local.get $k) (i32.const 9))
        (then
          (local.set $s (call $agg_struct (local.get $c) (local.get $t)))
          (if (i32.ne (local.get $s) (i32.const 0))
              (then (return (call $rg (local.get $c) (i32.const 84) (local.get $s)
                                      (i32.const 24) (i32.const 12)))))
          (local.set $e (call $agg_enum (local.get $c) (local.get $t)))
          (if (i32.ne (local.get $e) (i32.const 0))
              (then (return (call $rg (local.get $c) (i32.const 108) (local.get $e)
                                      (i32.const 28) (i32.const 12)))))
          (return (i32.const 0))))
    (i32.const 4))

  (func $align_of (param $c i32) (param $t i32) (result i32)
    (local $k i32) (local $s i32) (local $e i32)
    (local.set $k (call $ty_kind (local.get $c) (local.get $t)))
    (if (i32.eq (local.get $k) (i32.const 2)) (then (return (i32.const 1))))
    (if (i32.eq (local.get $k) (i32.const 3)) (then (return (i32.const 1))))
    (if (i32.eq (local.get $k) (i32.const 9))
        (then
          (local.set $s (call $agg_struct (local.get $c) (local.get $t)))
          (if (i32.ne (local.get $s) (i32.const 0))
              (then (return (call $rg (local.get $c) (i32.const 84) (local.get $s)
                                      (i32.const 24) (i32.const 16)))))
          (local.set $e (call $agg_enum (local.get $c) (local.get $t)))
          (if (i32.ne (local.get $e) (i32.const 0))
              (then (return (call $rg (local.get $c) (i32.const 108) (local.get $e)
                                      (i32.const 28) (i32.const 16)))))
          (return (i32.const 1))))
    (i32.const 4))

  (func $align_up (param $x i32) (param $a i32) (result i32)
    (i32.mul (i32.div_u (i32.sub (i32.add (local.get $x) (local.get $a)) (i32.const 1))
                        (local.get $a))
             (local.get $a)))

  ;; --- resolving type syntax to types -------------------------------------

  (func $e_unknown_type (param $c i32) (param $line i32) (param $col i32)
        (param $s i32) (param $l i32)
    (if (call $err_open (local.get $c) (local.get $line) (local.get $col))
        (then (call $put_str (local.get $c) (i32.const 0x1000326) (i32.const 13))
              (call $put_q_src (local.get $c) (local.get $s) (local.get $l))
              (call $err_end (local.get $c)))))

  (func $resolve_ty (param $c i32) (param $t i32) (result i32)
    (local $k i32) (local $a i32) (local $b i32) (local $inner i32)
    (if (i32.eq (local.get $t) (i32.const 0)) (then (return (i32.const 5))))
    (local.set $k (call $nd (local.get $c) (local.get $t) (i32.const 0)))
    (local.set $a (call $nd (local.get $c) (local.get $t) (i32.const 12)))
    (local.set $b (call $nd (local.get $c) (local.get $t) (i32.const 16)))
    (if (i32.eq (local.get $k) (i32.const 20))
        (then (if (i32.eq (local.get $a) (i32.const 0)) (then (return (i32.const 1))))
              (if (i32.eq (local.get $a) (i32.const 1)) (then (return (i32.const 2))))
              (if (i32.eq (local.get $a) (i32.const 2)) (then (return (i32.const 3))))
              (return (i32.const 4))))
    (if (i32.eq (local.get $k) (i32.const 21))
        (then (if (call $find_type_name (local.get $c) (local.get $a) (local.get $b))
                  (then (return (call $ty_named (local.get $c) (local.get $a)
                                      (local.get $b)))))
              (call $e_unknown_type (local.get $c)
                    (call $nd (local.get $c) (local.get $t) (i32.const 4))
                    (call $nd (local.get $c) (local.get $t) (i32.const 8))
                    (local.get $a) (local.get $b))
              (return (i32.const 1))))
    (if (i32.eq (local.get $k) (i32.const 22))
        (then (local.set $inner (call $resolve_ty (local.get $c) (local.get $a)))
              (return (call $ty_intern (local.get $c) (i32.const 6) (local.get $inner)
                            (local.get $b)))))
    (if (i32.eq (local.get $k) (i32.const 23))
        (then (local.set $inner (call $resolve_ty (local.get $c) (local.get $a)))
              (return (call $ty_intern (local.get $c) (i32.const 7) (local.get $inner)
                            (local.get $b)))))
    (local.set $inner (call $resolve_ty (local.get $c) (local.get $a)))
    (call $ty_intern (local.get $c) (i32.const 8) (local.get $inner) (i32.const 0)))

  ;; --- string interning (implementation.md S4) ----------------------------

  (func $bytes_eq (param $p1 i32) (param $l1 i32) (param $p2 i32) (param $l2 i32)
        (result i32)
    (local $i i32)
    (if (i32.ne (local.get $l1) (local.get $l2)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.lt_u (local.get $i) (local.get $l1))))
      (block $cnt
        (if (i32.ne (i32.load8_u (i32.add (local.get $p1) (local.get $i)))
                    (i32.load8_u (i32.add (local.get $p2) (local.get $i))))
            (then (return (i32.const 0)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $cont)))
    (i32.const 1))

  ;; rodata grows up and the shadow-stack floor is above it (implementation.md S7).
  ;; If they meet, the compiled program's literals overlap its own frames.
  (func $intern_string (param $c i32) (param $ptr i32) (param $len i32)
        (param $line i32) (param $col i32) (result i32)
    (local $n i32) (local $p i32) (local $addr i32) (local $r i32)
    (local.set $n (call $cg (local.get $c) (i32.const 176)))
    (local.set $p (i32.const 1))
    (block $brk (loop $cont
      (br_if $brk (i32.eqz (i32.lt_u (local.get $p) (local.get $n))))
      (block $cnt
        (if (call $bytes_eq (call $rg (local.get $c) (i32.const 168) (local.get $p)
                                      (i32.const 16) (i32.const 0))
                            (call $rg (local.get $c) (i32.const 168) (local.get $p)
                                      (i32.const 16) (i32.const 4))
                            (local.get $ptr) (local.get $len))
            (then (return (call $rg (local.get $c) (i32.const 168) (local.get $p)
                                    (i32.const 16) (i32.const 8))))))
      (local.set $p (i32.add (local.get $p) (i32.const 1)))
      (br $cont)))
    (local.set $addr (call $cg (local.get $c) (i32.const 204)))
    (if (i32.gt_u (i32.add (local.get $addr) (local.get $len)) (i32.const 0x1800000))
        (then (call $err_msg (local.get $c) (local.get $line) (local.get $col)
                             (i32.const 0x1000333) (i32.const 49))
              (return (local.get $addr))))
    (local.set $r (call $rec (local.get $c) (i32.const 168) (local.get $n) (i32.const 16)))
    (i32.store (local.get $r) (local.get $ptr))
    (i32.store (i32.add (local.get $r) (i32.const 4)) (local.get $len))
    (i32.store (i32.add (local.get $r) (i32.const 8)) (local.get $addr))
    (i32.store (i32.add (local.get $r) (i32.const 12)) (i32.const 0))
    (call $cs (local.get $c) (i32.const 176) (i32.add (local.get $n) (i32.const 1)))
    (call $cs (local.get $c) (i32.const 204) (i32.add (local.get $addr) (local.get $len)))
    (local.get $addr))

  ;; ======================================================================
  ;; Declaration collection (language.md S4)
  ;; ======================================================================

  (func $e_dup_toplevel (param $c i32) (param $line i32) (param $col i32)
        (param $s i32) (param $l i32)
    (if (call $err_open (local.get $c) (local.get $line) (local.get $col))
        (then (call $put_str (local.get $c) (i32.const 0x1000364) (i32.const 25))
              (call $put_q_src (local.get $c) (local.get $s) (local.get $l))
              (call $err_end (local.get $c)))))

  (func $e_builtin_name (param $c i32) (param $line i32) (param $col i32)
        (param $s i32) (param $l i32)
    (if (call $err_open (local.get $c) (local.get $line) (local.get $col))
        (then (call $put_q_src (local.get $c) (local.get $s) (local.get $l))
              (call $put_str (local.get $c) (i32.const 0x100037D) (i32.const 24))
              (call $err_end (local.get $c)))))

  (func $claim (param $c i32) (param $d i32)
    (local $s i32) (local $l i32) (local $line i32) (local $col i32) (local $n i32)
    (local $r i32)
    (local.set $s (call $nd (local.get $c) (local.get $d) (i32.const 12)))
    (local.set $l (call $nd (local.get $c) (local.get $d) (i32.const 16)))
    (local.set $line (call $nd (local.get $c) (local.get $d) (i32.const 4)))
    (local.set $col (call $nd (local.get $c) (local.get $d) (i32.const 8)))
    (if (call $find_taken (local.get $c) (local.get $s) (local.get $l))
        (then (call $e_dup_toplevel (local.get $c) (local.get $line) (local.get $col)
                                    (local.get $s) (local.get $l))
              (return)))
    (if (if (result i32) (call $src_eq (local.get $c) (local.get $s) (local.get $l)
                                       (i32.const 0x100025F) (i32.const 3))
            (then (i32.const 1))
            (else (if (result i32) (call $src_eq (local.get $c) (local.get $s)
                                         (local.get $l) (i32.const 0x1000262)
                                         (i32.const 3))
                      (then (i32.const 1))
                      (else (if (result i32) (call $src_eq (local.get $c) (local.get $s)
                                                   (local.get $l) (i32.const 0x1000265)
                                                   (i32.const 4))
                                (then (i32.const 1))
                                (else (call $src_eq (local.get $c) (local.get $s)
                                            (local.get $l) (i32.const 0x1000269)
                                            (i32.const 2))))))))
        (then (call $e_builtin_name (local.get $c) (local.get $line) (local.get $col)
                                    (local.get $s) (local.get $l))
              (return)))
    (local.set $n (call $cg (local.get $c) (i32.const 188)))
    (local.set $r (call $rec (local.get $c) (i32.const 180) (local.get $n) (i32.const 12)))
    (i32.store (local.get $r) (local.get $s))
    (i32.store (i32.add (local.get $r) (i32.const 4)) (local.get $l))
    (i32.store (i32.add (local.get $r) (i32.const 8)) (i32.const 0))
    (call $cs (local.get $c) (i32.const 188) (i32.add (local.get $n) (i32.const 1))))

  (func $add_type_name (param $c i32) (param $d i32)
    (local $n i32) (local $r i32)
    (local.set $n (call $cg (local.get $c) (i32.const 200)))
    (local.set $r (call $rec (local.get $c) (i32.const 192) (local.get $n) (i32.const 12)))
    (i32.store (local.get $r) (call $nd (local.get $c) (local.get $d) (i32.const 12)))
    (i32.store (i32.add (local.get $r) (i32.const 4))
               (call $nd (local.get $c) (local.get $d) (i32.const 16)))
    (i32.store (i32.add (local.get $r) (i32.const 8)) (i32.const 0))
    (call $cs (local.get $c) (i32.const 200) (i32.add (local.get $n) (i32.const 1))))

  (func $e_field_ty (param $c i32) (param $line i32) (param $col i32) (param $what i32)
        (param $kind i32) (param $t i32)
    (if (call $err_open (local.get $c) (local.get $line) (local.get $col))
        (then (if (i32.eq (local.get $what) (i32.const 0))
                  (then (call $put_str (local.get $c) (i32.const 0x1000395)
                                       (i32.const 12)))
                  (else (call $put_str (local.get $c) (i32.const 0x10003A1)
                                       (i32.const 12))))
              (if (i32.eq (local.get $kind) (i32.const 0))
                  (then (call $put_str (local.get $c) (i32.const 0x10003AD)
                                       (i32.const 28)))
                  (else (call $put_str (local.get $c) (i32.const 0x10003C9)
                                       (i32.const 25))))
              (call $put_q_ty (local.get $c) (local.get $t))
              (call $err_end (local.get $c)))))

  ;; Fields and payloads hold no aggregates and no borrows (language.md S4).
  (func $check_field_ty (param $c i32) (param $t i32) (param $line i32) (param $col i32)
        (param $what i32)
    (if (call $is_aggregate (local.get $c) (local.get $t))
        (then (call $e_field_ty (local.get $c) (local.get $line) (local.get $col)
                                (local.get $what) (i32.const 0) (local.get $t))
              (return)))
    (if (i32.eq (call $ty_kind (local.get $c) (local.get $t)) (i32.const 7))
        (then (call $e_field_ty (local.get $c) (local.get $line) (local.get $col)
                                (local.get $what) (i32.const 1) (local.get $t)))))

  (func $e_dup_field (param $c i32) (param $line i32) (param $col i32)
        (param $s i32) (param $l i32)
    (if (call $err_open (local.get $c) (local.get $line) (local.get $col))
        (then (call $put_str (local.get $c) (i32.const 0x10003E2) (i32.const 16))
              (call $put_q_src (local.get $c) (local.get $s) (local.get $l))
              (call $err_end (local.get $c)))))

  (func $e_dup_variant (param $c i32) (param $line i32) (param $col i32)
