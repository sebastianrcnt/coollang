          (call $store_op (local.get $ty))
          (call $release1 (local.get $ta))
          (return)))

    (if (i32.eq (local.get $k) (i32.const 32))
        (then
          (call $emit_expr (call $nd (local.get $s) (i32.const 12)))
          (if (i32.ne (call $nd (local.get $s) (i32.const 40)) (i32.const 0))
              (then
                (local.set $n (call $slot_count (call $nd (call $nd (local.get $s) (i32.const 12))
                                                      (i32.const 36))))
