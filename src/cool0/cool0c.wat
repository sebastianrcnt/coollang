          (call $b_blocked (i32.const 4) (i32.const 64))
          (call $ctrl_push (i32.const 5))
          (call $emit_block (call $nd (local.get $s) (i32.const 16)))
          (if (i32.ne (call $nd (local.get $s) (i32.const 24)) (i32.const 0))
              (then (call $b_op (i32.const 5))
                    (call $emit_block (call $nd (local.get $s) (i32.const 20)))))
          (call $ctrl_pop)
          (call $b_op (i32.const 11))
