                                                   (i32.const 27))
                                    (call $err_end (local.get $c))))
                          (return (i32.const 1))))
                (if (call $find_type_name (local.get $c) (local.get $ea) (local.get $eb))
                    (then (if (call $err_open (local.get $c) (local.get $line)
                                              (local.get $col))
