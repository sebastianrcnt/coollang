        (then
          (local.set $op (call $nd (local.get $s) (i32.const 16)))
          (if (i32.eq (local.get $op) (i32.const 30))
              (then
                (if (call $is_agg_lit (call $nd (local.get $s) (i32.const 20)))
                    (then
                      (local.set $ta (call $temp))
                      (call $emit_addr (call $nd (local.get $s) (i32.const 12)))
                      (call $b_idx (i32.const 33) (local.get $ta))
                      (call $emit_agg_init (local.get $ta)
                            (call $nd (local.get $s) (i32.const 20)))
                      (call $release1 (local.get $ta))
                      (return)))
                (call $emit_store_to (call $nd (local.get $s) (i32.const 12)) (i32.const 0)
                      (call $nd (local.get $s) (i32.const 20)) (i32.const 0) (i32.const 0))
                (return)))
          (local.set $base (call $assign_base_op (local.get $op)))
          (local.set $ty (call $place_ty (call $nd (local.get $s) (i32.const 12))))
          (local.set $signed (i32.eq (call $ty_kind (call $read_ty (local.get $ty)))
                                     (i32.const 0)))
          (if (call $in_wasm_local (call $nd (local.get $s) (i32.const 12)))
              (then
                (local.set $loc (call $ident_local (call $nd (local.get $s) (i32.const 12))))
                (call $b_idx (i32.const 32) (call $ld (i32.add (local.get $loc) (i32.const 24))))
                (call $emit_expr (call $nd (local.get $s) (i32.const 20)))
                (call $b_op (call $arith_op (local.get $base) (local.get $signed)))
                (call $b_idx (i32.const 33) (call $ld (i32.add (local.get $loc) (i32.const 24))))
                (return)))
          (local.set $ta (call $temp))
          (call $emit_addr (call $nd (local.get $s) (i32.const 12)))
          (call $b_idx (i32.const 33) (local.get $ta))
          (call $b_idx (i32.const 32) (local.get $ta))
          (call $b_idx (i32.const 32) (local.get $ta))
          (call $load_op (local.get $ty))
