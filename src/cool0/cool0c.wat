                    (call $store_op (call $ld (i32.add (local.get $loc) (i32.const 8))))))))
        (local.set $loc (call $ld (i32.add (local.get $loc) (i32.const 32)))))
      (br $cont)))
    (call $emit_block (call $nd (call $ld (i32.add (local.get $fi) (i32.const 24)))
                            (i32.const 28)))
    (call $emit_epilogue)
