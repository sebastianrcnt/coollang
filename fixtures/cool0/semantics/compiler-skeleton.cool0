// expect: fixture() == 42

const T_EOF: u32 = 0;
const T_NUM: u32 = 1;
const T_PLUS: u32 = 2;

struct Token { kind: u32, value: u32, at: u32 }

enum Node {
    Num(u32),
    Add(u32, u32),
}

struct Ctx {
    src: []u8,
    toks: []mut Token,
    ntok: u32,
    nodes: []mut Node,
    nnode: u32,
    pos: u32,
    err: u32,
}

fn is_digit(c: u32) -> bool {
    return c >= 48 && c <= 57;
}

fn push_tok(c: &mut Ctx, kind: u32, value: u32, at: u32) {
    if c.^.ntok >= c.^.toks.len {
        c.^.err = 2;
        return;
    }
    let n = c.^.ntok;
    c.^.toks[n] = Token{ kind: kind, value: value, at: at };
    c.^.ntok = n + 1;
}

fn lex(c: &mut Ctx) {
    let mut i: u32 = 0;
    for i < c.^.src.len {
        let ch = c.^.src[i];
        if ch == 32 {
            i += 1;
        } else if is_digit(ch) {
            let start = i;
            let mut v: u32 = 0;
            for i < c.^.src.len && is_digit(c.^.src[i]) {
                v = v * 10 + (c.^.src[i] - 48);
                i += 1;
            }
            push_tok(c, T_NUM, v, start);
        } else if ch == 43 {
            push_tok(c, T_PLUS, 0, i);
            i += 1;
        } else {
            c.^.err = 1;
            return;
        }
    }
    push_tok(c, T_EOF, 0, i);
}

fn alloc_node(c: &mut Ctx) -> u32 {
    if c.^.nnode >= c.^.nodes.len {
        c.^.err = 3;
        return 0;
    }
    let n = c.^.nnode;
    c.^.nnode = n + 1;
    return n;
}

fn peek(c: &Ctx) -> u32 {
    return c.^.toks[c.^.pos].kind;
}

fn parse_primary(c: &mut Ctx) -> u32 {
    if peek(c) != T_NUM {
        c.^.err = 4;
        return 0;
    }
    let p = c.^.pos;
    let v = c.^.toks[p].value;
    c.^.pos = p + 1;
    let n = alloc_node(c);
    c.^.nodes[n] = Node.Num(v);
    return n;
}

fn parse_add(c: &mut Ctx) -> u32 {
    let mut lhs = parse_primary(c);
    for peek(c) == T_PLUS {
        c.^.pos += 1;
        let rhs = parse_primary(c);
        if c.^.err != 0 {
            return 0;
        }
        let n = alloc_node(c);
        c.^.nodes[n] = Node.Add(lhs, rhs);
        lhs = n;
    }
    return lhs;
}

fn eval(c: &Ctx, n: u32) -> u32 {
    match c.^.nodes[n] {
        Num(v) => { return v; }
        Add(l, r) => { return eval(c, l) + eval(c, r); }
    }
}

fn run(src: []u8) -> u32 {
    unsafe {
        let toks = slice_mut(65536 as *Token, 64);
        let nodes = slice_mut(69632 as *Node, 64);
        let mut c: Ctx = Ctx{
            src: src,
            toks: toks,
            ntok: 0,
            nodes: nodes,
            nnode: 0,
            pos: 0,
            err: 0,
        };
        lex(&mut c);
        if c.err != 0 {
            return 0;
        }
        let root = parse_add(&mut c);
        if c.err != 0 {
            return 0;
        }
        return eval(&c, root);
    }
}

fn fixture() -> u32 {
    return run("12 + 30");
}
